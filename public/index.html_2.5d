<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>IP 가디언즈: 특허 패스트트랙 서바이벌</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
/* ===========================================================================
   Design tokens — "심사서류 × 네온 서바이벌"
   Paper-stamp bureaucracy rendered on a void-black esports stage.
   ========================================================================= */
:root{
  --void:#05060a;
  --void-2:#0b0e16;
  --paper:#ece7d8;
  --ink:#12141c;
  --stamp:#ff2d2d;
  --l3:#00ffcc;   /* 우선심사 패스트트랙 */
  --l2:#0088ff;   /* 의견제출통지 */
  --l1:#aa00ff;   /* 아이디어 구상 */
  --lava:#ff3a12;
  --gold:#ffcc00;
  --rule:rgba(236,231,216,.18);
  --mono:'Chakra Petch',ui-monospace,Menlo,monospace;
  --kr:'Noto Sans KR',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:var(--void);color:var(--paper);font-family:var(--kr)}
canvas{display:block}
button{font-family:var(--mono);cursor:pointer;border:none;background:none;color:inherit}
button:focus-visible,input:focus-visible{outline:2px solid var(--l3);outline-offset:2px}

#stage{position:fixed;inset:0}
#hud{position:fixed;inset:0;pointer-events:none;z-index:10}
.panel{pointer-events:auto}

/* ---------------------------------------------------- top status bar ---- */
#topbar{
  position:absolute;top:0;left:0;right:0;display:flex;align-items:stretch;
  gap:1px;background:var(--rule);border-bottom:1px solid var(--rule);
}
.tb{background:rgba(5,6,10,.82);backdrop-filter:blur(8px);padding:9px 14px;display:flex;flex-direction:column;gap:2px}
.tb .k{font-family:var(--mono);font-size:9px;letter-spacing:.18em;color:rgba(236,231,216,.45)}
.tb .v{font-family:var(--mono);font-size:15px;font-weight:700;letter-spacing:.04em}
#tbTitle{flex:1;justify-content:center}
#tbTitle .v{font-family:var(--kr);font-weight:900;font-size:14px;letter-spacing:.02em}
#tbTitle .v b{color:var(--l3)}
#vAlive{color:var(--l3)}
#vPing.bad{color:var(--stamp)}

/* ------------------------------------------ signature: 심사단계 스탬프 ---- */
#layerStack{
  position:absolute;left:18px;top:96px;display:flex;flex-direction:column;gap:8px;width:196px;
}
.doc{
  position:relative;background:rgba(236,231,216,.06);border:1px solid var(--rule);
  padding:10px 12px 11px;transition:.28s cubic-bezier(.2,.8,.2,1);
  clip-path:polygon(0 0,100% 0,100% calc(100% - 11px),calc(100% - 11px) 100%,0 100%);
}
.doc::after{
  content:'';position:absolute;right:0;bottom:0;width:11px;height:11px;
  background:var(--rule);clip-path:polygon(0 100%,100% 0,100% 100%);
}
.doc .no{font-family:var(--mono);font-size:9px;letter-spacing:.2em;color:rgba(236,231,216,.4)}
.doc .nm{font-size:12.5px;font-weight:700;margin-top:3px;line-height:1.3}
.doc .alt{font-family:var(--mono);font-size:9px;letter-spacing:.14em;color:rgba(236,231,216,.35);margin-top:3px}
.doc.on{background:rgba(236,231,216,.1);transform:translateX(10px)}
.doc.on .nm{color:var(--layer-c)}
.doc.on{border-color:var(--layer-c);box-shadow:-3px 0 0 var(--layer-c),0 0 26px -6px var(--layer-c)}
.doc.on::before{
  content:'심사중';position:absolute;right:12px;top:9px;font-family:var(--mono);
  font-size:9px;letter-spacing:.16em;color:var(--stamp);border:1.5px solid var(--stamp);
  padding:1px 5px;transform:rotate(-7deg);animation:stamp .5s cubic-bezier(.2,1.5,.4,1)
}
@keyframes stamp{from{transform:rotate(-7deg) scale(2.1);opacity:0}to{transform:rotate(-7deg) scale(1);opacity:1}}
.doc[data-l="3"]{--layer-c:var(--l3)} .doc[data-l="2"]{--layer-c:var(--l2)} .doc[data-l="1"]{--layer-c:var(--l1)}

/* ------------------------------------------------------- roster (right) -- */
#roster{position:absolute;right:18px;top:96px;width:212px;display:flex;flex-direction:column;gap:6px}
.rname{font-family:var(--mono);font-size:9px;letter-spacing:.2em;color:rgba(236,231,216,.4);margin-bottom:2px}
.rrow{
  display:flex;align-items:center;gap:8px;padding:7px 10px;
  background:rgba(11,14,22,.8);border:1px solid var(--rule);border-left-width:3px;font-size:12px;
}
.rrow.dead{opacity:.35;text-decoration:line-through}
.rrow .lay{margin-left:auto;font-family:var(--mono);font-size:10px;letter-spacing:.1em;opacity:.7}
.rrow .you{font-family:var(--mono);font-size:8px;letter-spacing:.14em;background:var(--paper);color:var(--ink);padding:1px 4px}

/* --------------------------------------------------- spectator controls -- */
#spec{
  position:absolute;left:50%;bottom:26px;transform:translateX(-50%);
  display:none;flex-direction:column;align-items:center;gap:10px;width:min(560px,94vw)
}
#spec.show{display:flex}
#specTargets{display:flex;gap:6px;flex-wrap:wrap;justify-content:center}
.tgt{
  border:1px solid var(--rule);background:rgba(11,14,22,.85);padding:6px 12px;
  font-size:11px;letter-spacing:.06em;font-family:var(--kr);transition:.15s
}
.tgt.sel{background:var(--paper);color:var(--ink);border-color:var(--paper)}
.tgt:hover:not(.sel){border-color:var(--paper)}
#specBtns{display:flex;gap:10px;width:100%}
.act{
  flex:1;position:relative;overflow:hidden;padding:13px 10px 12px;border:1px solid;
  background:rgba(11,14,22,.88);text-align:left;transition:.18s
}
.act .t{font-size:13px;font-weight:700;font-family:var(--kr);letter-spacing:.01em}
.act .s{font-family:var(--mono);font-size:9px;letter-spacing:.15em;opacity:.55;margin-top:3px}
.act .cd{position:absolute;left:0;bottom:0;height:2px;width:0%;transition:width .1s linear}
#actCheer{border-color:var(--gold);color:var(--gold)} #actCheer .cd{background:var(--gold)}
#actDrop{border-color:var(--stamp);color:var(--stamp)} #actDrop .cd{background:var(--stamp)}
.act:disabled{opacity:.35;cursor:not-allowed}
.act:not(:disabled):hover{transform:translateY(-2px)}

/* -------------------------------------------------------------- toasts --- */
#toasts{position:absolute;left:50%;top:78px;transform:translateX(-50%);display:flex;flex-direction:column;gap:5px;align-items:center;width:max-content;max-width:80vw}
.toast{
  font-size:12px;padding:7px 15px;background:rgba(11,14,22,.92);border:1px solid var(--rule);
  border-left:3px solid var(--paper);animation:tin .3s cubic-bezier(.2,.9,.3,1)
}
.toast.cheer{border-left-color:var(--gold)} .toast.obstacle{border-left-color:var(--stamp)}
.toast.kill{border-left-color:var(--lava)}
@keyframes tin{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}

/* ------------------------------------------------------------- overlays -- */
.screen{
  position:absolute;inset:0;display:none;align-items:center;justify-content:center;
  background:radial-gradient(120% 90% at 50% 40%,rgba(5,6,10,.72),rgba(5,6,10,.97));
  pointer-events:auto;z-index:20
}
.screen.show{display:flex}
.card{width:min(500px,92vw);border:1px solid var(--rule);background:rgba(11,14,22,.96);padding:34px 32px 30px}
.eyebrow{font-family:var(--mono);font-size:10px;letter-spacing:.32em;color:var(--stamp)}
h1{font-size:29px;font-weight:900;line-height:1.18;margin:11px 0 6px;letter-spacing:-.01em}
h1 em{font-style:normal;color:var(--l3)}
.sub{font-size:13px;line-height:1.75;color:rgba(236,231,216,.6)}
.field{margin-top:22px}
.field label{display:block;font-family:var(--mono);font-size:9px;letter-spacing:.2em;color:rgba(236,231,216,.45);margin-bottom:6px}
input[type=text]{
  width:100%;padding:12px 14px;background:rgba(236,231,216,.06);border:1px solid var(--rule);
  color:var(--paper);font-family:var(--kr);font-size:15px
}
.modes{display:flex;gap:8px;margin-top:10px}
.mode{flex:1;padding:11px;border:1px solid var(--rule);font-size:12px;font-family:var(--kr);transition:.15s}
.mode.sel{background:var(--paper);color:var(--ink);border-color:var(--paper);font-weight:700}
.cta{
  width:100%;margin-top:22px;padding:15px;background:var(--l3);color:var(--ink);
  font-size:15px;font-weight:700;letter-spacing:.04em;transition:.18s
}
.cta:hover{background:var(--paper)}
.keys{margin-top:20px;padding-top:16px;border-top:1px solid var(--rule);display:flex;flex-wrap:wrap;gap:6px 16px}
.keys span{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:rgba(236,231,216,.45)}
.keys b{color:var(--paper);font-weight:600}

#countdown{position:absolute;inset:0;display:none;align-items:center;justify-content:center;pointer-events:none;z-index:15}
#countdown.show{display:flex}
#cdNum{font-family:var(--mono);font-size:150px;font-weight:700;line-height:1;color:var(--l3);text-shadow:0 0 60px rgba(0,255,204,.5)}
#cdLabel{position:absolute;bottom:calc(50% - 118px);font-family:var(--mono);font-size:11px;letter-spacing:.36em;color:rgba(236,231,216,.55)}

#result .card{text-align:center}
#resultRank{margin-top:20px;display:flex;flex-direction:column;gap:5px}
.rank{display:flex;gap:12px;align-items:center;padding:9px 13px;background:rgba(236,231,216,.05);border-left:3px solid;font-size:12.5px;text-align:left}
.rank .p{font-family:var(--mono);font-size:15px;font-weight:700;min-width:26px}
#resultHint{margin-top:20px;font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:rgba(236,231,216,.4)}

#deadFlash{position:absolute;inset:0;background:radial-gradient(circle at 50% 60%,transparent 20%,rgba(255,58,18,.5));opacity:0;pointer-events:none;transition:opacity .35s;z-index:12}
#deadFlash.on{opacity:1}

#diag{
  position:absolute;left:18px;bottom:18px;display:none;min-width:270px;
  background:rgba(5,6,10,.94);border:1px solid var(--rule);border-left:3px solid var(--stamp);
  padding:10px 12px;font-family:var(--mono);font-size:10.5px;line-height:1.7;letter-spacing:.02em
}
#diag.show{display:block}
#diag b{display:block;color:var(--stamp);letter-spacing:.2em;margin-bottom:5px;font-size:9px}
#diag .ok{color:var(--l3)} #diag .no{color:var(--stamp)} #diag .wa{color:var(--gold)}
#hint{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);font-family:var(--mono);font-size:10px;letter-spacing:.18em;color:rgba(236,231,216,.35)}
#hint.hide{display:none}

@media (max-width:900px){
  #layerStack{width:150px;top:88px;left:12px} #roster{width:160px;top:88px;right:12px}
  .doc .nm{font-size:11px} h1{font-size:23px}
}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>

<div id="stage"></div>
<div id="deadFlash"></div>

<div id="hud">
  <div id="topbar">
    <div class="tb panel"><span class="k">ROOM</span><span class="v" id="vRoom">—</span></div>
    <div class="tb panel"><span class="k">생존</span><span class="v" id="vAlive">0/0</span></div>
    <div class="tb" id="tbTitle"><span class="k" style="text-align:center">IP GUARDIANS</span><span class="v">특허 <b>패스트트랙</b> 서바이벌</span></div>
    <div class="tb panel"><span class="k">관전자</span><span class="v" id="vSpec">0</span></div>
    <div class="tb panel"><span class="k">RTT</span><span class="v" id="vPing">— ms</span></div>
    <div class="tb panel"><span class="k">FPS</span><span class="v" id="vFps">60</span></div>
  </div>

  <div id="layerStack">
    <div class="doc" data-l="3"><div class="no">LAYER 03</div><div class="nm">우선심사 패스트트랙 레이어</div><div class="alt">FAST-TRACK EXAMINATION</div></div>
    <div class="doc" data-l="2"><div class="no">LAYER 02</div><div class="nm">의견제출통지 레이어</div><div class="alt">OFFICE ACTION</div></div>
    <div class="doc" data-l="1"><div class="no">LAYER 01</div><div class="nm">아이디어 구상 레이어</div><div class="alt">IDEATION</div></div>
  </div>

  <div id="roster"><div class="rname">출원인 명단</div><div id="rosterList"></div></div>

  <div id="toasts"></div>

  <div id="spec" class="panel">
    <div id="specTargets"></div>
    <div id="specBtns">
      <button class="act" id="actCheer"><span class="t">우선심사 발판 지원</span><span class="s">CHEER BOOSTER</span><span class="cd"></span></button>
      <button class="act" id="actDrop"><span class="t">의견제출통지서 투하</span><span class="s">DROP OBSTACLE</span><span class="cd"></span></button>
    </div>
  </div>

  <div id="diag" class="panel"><b>진단 F2</b><div id="diagBody">대기</div></div>
  <div id="hint">WASD 이동 · SPACE 점프 · SHIFT 질주 · 마우스 드래그로 시점 회전</div>
</div>

<div id="countdown"><div id="cdNum">5</div><div id="cdLabel">심사 착수까지</div></div>

<div class="screen show" id="joinScreen">
  <div class="card">
    <div class="eyebrow">KIPO SURVIVAL PROTOCOL · 3-LAYER</div>
    <h1>바닥이 무너지기 전에<br><em>등록결정</em>까지 살아남으세요.</h1>
    <p class="sub">밟은 특허 심사 타일은 0.8초 뒤 붕괴합니다. 무단 카피캣 함정 블록은 0.2초. 3층에서 1층까지 떨어지면 그 아래는 용암입니다. 마지막 한 명이 등록결정을 받습니다.</p>
    <div class="field">
      <label for="nameInput">출원인 이름</label>
      <input type="text" id="nameInput" maxlength="14" placeholder="예: 김심사" autocomplete="off" />
    </div>
    <div class="field">
      <label>참가 방식</label>
      <div class="modes">
        <button class="mode sel" data-mode="player">주자로 참가 (최대 4인)</button>
        <button class="mode" data-mode="spectator">관전 + 개입</button>
      </div>
    </div>
    <button class="cta" id="btnJoin">심사 대기열 입장</button>
    <div class="keys">
      <span><b>WASD</b> 이동</span><span><b>SPACE</b> 점프</span><span><b>SHIFT</b> 질주</span>
      <span><b>드래그</b> 시점</span><span><b>휠</b> 줌</span>
    </div>
  </div>
</div>

<div class="screen" id="result">
  <div class="card">
    <div class="eyebrow" id="resultEyebrow">최종 처분</div>
    <h1 id="resultTitle">등록결정</h1>
    <p class="sub" id="resultSub"></p>
    <div id="resultRank"></div>
    <div id="resultHint">다음 심사 회차 준비 중…</div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
/* ===========================================================================
 * IP Guardians: Fast-Track Survival — WebGL client
 * ---------------------------------------------------------------------------
 *  · Three.js r128, no external control libs (custom orbit-follow rig)
 *  · Client-side prediction for the local runner (authoritative locally,
 *    relayed by the server) + dead reckoning for every remote runner
 *  · Server owns tile fuse timing so collapse is identical on all clients
 * ========================================================================= */
'use strict';

/* ============================ 0. constants ============================== */

const PHYS = {
  GRAVITY: -62,
  JUMP_V: 21.5,
  MOVE: 15.0,
  SPRINT: 21.5,
  ACCEL_GROUND: 120,
  ACCEL_AIR: 42,
  FRICTION: 12,
  MAX_FALL: -90,
  STEP: 1 / 60
};

const PLAYER = {
  HALF_X: 0.78,
  HALF_Z: 0.78,
  HEIGHT: 3.1
};

const NET = {
  SEND_HZ: 20,
  INTERP_DELAY_MS: 110,   // render remotes this far in the past
  EXTRAPOLATE_CAP_MS: 260 // never dead-reckon further than this
};

/* ============================ 1. DOM helpers ============================ */

const $ = (id) => document.getElementById(id);
const dom = {
  stage: $('stage'), vRoom: $('vRoom'), vAlive: $('vAlive'), vSpec: $('vSpec'),
  vPing: $('vPing'), vFps: $('vFps'), rosterList: $('rosterList'), toasts: $('toasts'),
  spec: $('spec'), specTargets: $('specTargets'), actCheer: $('actCheer'), actDrop: $('actDrop'),
  joinScreen: $('joinScreen'), nameInput: $('nameInput'), btnJoin: $('btnJoin'),
  countdown: $('countdown'), cdNum: $('cdNum'), cdLabel: $('cdLabel'),
  result: $('result'), resultTitle: $('resultTitle'), resultSub: $('resultSub'),
  resultRank: $('resultRank'), resultEyebrow: $('resultEyebrow'),
  deadFlash: $('deadFlash'), hint: $('hint'), docs: Array.from(document.querySelectorAll('.doc'))
};

function toast(text, kind) {
  const el = document.createElement('div');
  el.className = 'toast ' + (kind || '');
  el.textContent = text;
  dom.toasts.appendChild(el);
  setTimeout(() => {
    el.style.transition = 'opacity .35s';
    el.style.opacity = '0';
    setTimeout(() => el.remove(), 400);
  }, 3600);
  while (dom.toasts.children.length > 4) dom.toasts.firstChild.remove();
}

/* ============================ 2. game state ============================= */

const G = {
  socket: null,
  selfId: null,
  role: 'player',
  name: '',
  roomId: '—',
  phase: 'waiting',
  phaseEndsAt: 0,
  cfg: null,
  map: null,
  tiles: new Map(),        // tileId -> tileRecord
  layerTiles: { 1: [], 2: [], 3: [] },
  layerY: { 1: 0, 2: 15, 3: 30 },
  lavaY: -20,
  hexSize: 3.2,
  hexThick: 1.0,
  players: new Map(),      // id -> remote record (includes self meta)
  boosters: new Map(),
  obstacles: new Map(),
  selfAlive: true,
  selfLayer: 3,
  steppedTiles: new Set(),
  serverOffset: 0,
  rtt: 0,
  specTarget: null,
  cheerReadyAt: 0,
  dropReadyAt: 0,
  started: false
};

/* ============================ 3. three.js core ========================== */

const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
dom.stage.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x05060a);
scene.fog = new THREE.FogExp2(0x05060a, 0.0075);

const camera = new THREE.PerspectiveCamera(58, window.innerWidth / window.innerHeight, 0.1, 800);
camera.position.set(0, 46, 34);

scene.add(new THREE.HemisphereLight(0x9fd8ff, 0x180a24, 0.75));

const keyLight = new THREE.DirectionalLight(0xffffff, 1.15);
keyLight.position.set(38, 78, 26);
keyLight.castShadow = true;
keyLight.shadow.mapSize.set(2048, 2048);
keyLight.shadow.camera.near = 1;
keyLight.shadow.camera.far = 220;
keyLight.shadow.camera.left = -70;
keyLight.shadow.camera.right = 70;
keyLight.shadow.camera.top = 70;
keyLight.shadow.camera.bottom = -70;
keyLight.shadow.bias = -0.0009;
scene.add(keyLight);
scene.add(keyLight.target);

const rimLight = new THREE.DirectionalLight(0x00ffcc, 0.5);
rimLight.position.set(-30, 20, -34);
scene.add(rimLight);

const lavaLight = new THREE.PointLight(0xff3a12, 2.4, 130, 2);
lavaLight.position.set(0, -14, 0);
scene.add(lavaLight);

/* --- world groups ------------------------------------------------------- */
const worldGroup = new THREE.Group(); scene.add(worldGroup);
const tileGroup = new THREE.Group(); worldGroup.add(tileGroup);
const actorGroup = new THREE.Group(); worldGroup.add(actorGroup);
const fxGroup = new THREE.Group(); worldGroup.add(fxGroup);

/* --- 2.5D 스프라이트 & 텍스처 슬롯 --------------------------------------- *
 * public/assets/ 에 파일을 넣으면 자동 적용됩니다.
 *   character_atlas.png  1536x1024, 알파 필수, 3x2 포즈 시트  ← 캐릭터 핵심
 *   road_texture.png     1024x1024, 타일 상판 (선택, 그레이스케일)
 * 파일이 없으면 캔버스로 그린 폴백 스프라이트가 쓰이므로 항상 동작합니다.  */
const texLoader = new THREE.TextureLoader();
const TEX = { road: null, sprite: null };

/* ── 2.5D 캐릭터 설정 ──────────────────────────────────────────────────── */
const SPRITE = {
  path:   'assets/character_atlas.png',
  cols:   3,
  rows:   2,
  height: 3.45,   // 월드 기준 캐릭터 키
  aspect: 1.0,    // 셀의 가로/세로 비율 (정사각 512x512 기준)
  runFps: 11      // 달리기 프레임 전환 속도 (실제 이동 속도에 비례해 가감)
};

/* 셀 좌표 [col, row] — 좌상단이 [0,0] */
const POSE = {
  idle: [0, 0], run1: [1, 0], run2: [2, 0],
  jump: [0, 1], fall: [1, 1], dead: [2, 1]
};

const OUTLINE_PX      = 0.030;  // 외곽선 두께 (스프라이트 크기 대비). 0이면 끔
const OUTLINE_COLOR   = 0x0a0c12;
const SPRITE_EMISSIVE = 0.62;   // 0=씬 조명 그대로, 1=완전 평면. 2.5D 는 높게
const RING_OPACITY    = 0.9;    // 발밑 플레이어 색 링. 0이면 끔
/* 내려다보는 카메라에서 수직 빌보드는 세로로 눌려 보입니다.
 * 발밑을 축으로 카메라 쪽으로 눕혀 그 왜곡을 상쇄합니다.
 *   0   = 항상 수직 (Don't Starve 처럼 낮은 카메라용)
 *   1   = 완전히 카메라를 마주봄 (항상 원본 비율, 종이 느낌 강함)
 *   0.6 = 절충. 발은 바닥에 붙어 있고 캐릭터는 또렷하게 읽힙니다             */
const BILLBOARD_PITCH = 0.6;

function cellOffset(pose) {
  const c = POSE[pose] || POSE.idle;
  // 텍스처 v 는 아래에서 위로 증가하므로 행을 뒤집습니다
  return [c[0] / SPRITE.cols, (SPRITE.rows - 1 - c[1]) / SPRITE.rows];
}

/* ---------------------------------------------------------------------------
 * 폴백 스프라이트 시트 — character_atlas.png 가 없을 때 캔버스로 그립니다.
 * 미드저니 시트와 동일한 3x2 레이아웃/셀 크기라, 나중에 파일만 넣으면
 * 코드 수정 없이 그대로 교체됩니다.
 * ------------------------------------------------------------------------- */
function makeFallbackSpriteAtlas() {
  const CELL = 512;
  const c = document.createElement('canvas');
  c.width = CELL * SPRITE.cols;
  c.height = CELL * SPRITE.rows;
  const g = c.getContext('2d');

  const SKIN = '#ffd9be', SKIN_D = '#e8b493';
  const HAIR = '#3b2a22', SUIT = '#e9e4d6', SUIT_D = '#c7c0ae';
  const DARK = '#232734', LINE = '#2a1d16';

  function ellipse(x, y, rx, ry, fill, rot) {
    g.save(); g.beginPath();
    g.ellipse(x, y, rx, ry, rot || 0, 0, 6.2832);
    g.fillStyle = fill; g.fill(); g.restore();
  }
  function limb(x1, y1, x2, y2, w, color) {
    g.save(); g.strokeStyle = color; g.lineWidth = w; g.lineCap = 'round';
    g.beginPath(); g.moveTo(x1, y1); g.lineTo(x2, y2); g.stroke(); g.restore();
  }

  /* 한 칸에 치비 캐릭터 한 포즈를 그립니다.
   * p = { lean, armL, armR, legL, legR, headY, squash, face } */
  function drawPose(col, row, p) {
    g.save();
    g.translate(col * CELL, row * CELL);

    const CX = CELL / 2;
    const FOOT = 470;                       // 발바닥 y (셀 하단에서 42px 위)
    const sq = p.squash || 1;
    const HEAD_R = 118 * sq;
    const headY = FOOT - (250 * sq) - (p.headY || 0);
    const bodyY = FOOT - (95 * sq);

    g.save();
    g.translate(CX, 0);
    g.rotate((p.lean || 0) * Math.PI / 180);
    g.translate(-CX, 0);

    // 다리
    limb(CX - 26, bodyY, CX - 26 + (p.legL ? p.legL[0] : 0), FOOT + (p.legL ? p.legL[1] : 0), 40, DARK);
    limb(CX + 26, bodyY, CX + 26 + (p.legR ? p.legR[0] : 0), FOOT + (p.legR ? p.legR[1] : 0), 40, DARK);
    // 신발
    ellipse(CX - 26 + (p.legL ? p.legL[0] : 0), FOOT + (p.legL ? p.legL[1] : 0), 30, 18, '#14161f');
    ellipse(CX + 26 + (p.legR ? p.legR[0] : 0), FOOT + (p.legR ? p.legR[1] : 0), 30, 18, '#14161f');

    // 몸통
    ellipse(CX, bodyY - 62, 82, 78 * sq, SUIT);
    ellipse(CX, bodyY - 22, 70, 44, SUIT_D);
    // 특허 배지
    ellipse(CX, bodyY - 72, 20, 20, '#ffd166');

    // 팔
    limb(CX - 78, bodyY - 92, CX - 78 + (p.armL ? p.armL[0] : -20), bodyY - 92 + (p.armL ? p.armL[1] : 62), 34, SUIT);
    limb(CX + 78, bodyY - 92, CX + 78 + (p.armR ? p.armR[0] : 20), bodyY - 92 + (p.armR ? p.armR[1] : 62), 34, SUIT);
    ellipse(CX - 78 + (p.armL ? p.armL[0] : -20), bodyY - 92 + (p.armL ? p.armL[1] : 62), 24, 24, SKIN);
    ellipse(CX + 78 + (p.armR ? p.armR[0] : 20), bodyY - 92 + (p.armR ? p.armR[1] : 62), 24, 24, SKIN);

    // 머리
    ellipse(CX, headY, HEAD_R, HEAD_R * 0.97, SKIN);
    ellipse(CX - HEAD_R * 0.96, headY + 6, 20, 26, SKIN_D);
    ellipse(CX + HEAD_R * 0.96, headY + 6, 20, 26, SKIN_D);
    // 머리카락 (윗머리 + 앞머리)
    g.save();
    g.beginPath();
    g.ellipse(CX, headY - 12, HEAD_R * 1.03, HEAD_R * 0.96, 0, Math.PI, 0);
    g.fillStyle = HAIR; g.fill();
    g.restore();
    ellipse(CX - 58, headY - 52, 46, 26, HAIR, -0.35);
    ellipse(CX + 6,  headY - 62, 52, 28, HAIR, 0.06);
    ellipse(CX + 62, headY - 50, 42, 24, HAIR, 0.38);

    // 얼굴
    drawFace(CX, headY + 14, HEAD_R, p.face || 'idle');

    g.restore();
    g.restore();
  }

  function drawFace(cx, cy, R, kind) {
    const ex = R * 0.42, ey = 0;
    const IRIS = '#5e3c27';
    function eye(x, open) {
      if (open <= 0) {
        g.save(); g.strokeStyle = LINE; g.lineWidth = 9; g.lineCap = 'round';
        g.beginPath();
        g.moveTo(x - 26, cy + ey + 8);
        g.quadraticCurveTo(x, cy + ey - 18, x + 26, cy + ey + 8);
        g.stroke(); g.restore(); return;
      }
      ellipse(x, cy + ey, 26, 30 * open, '#ffffff');
      ellipse(x, cy + ey + 2, 21, 26 * open, IRIS);
      ellipse(x, cy + ey + 3, 10, 13 * open, '#1d120c');
      ellipse(x - 8, cy + ey - 10 * open, 8, 8 * open, '#ffffff');
      g.save(); g.strokeStyle = LINE; g.lineWidth = 8; g.lineCap = 'round';
      g.beginPath(); g.ellipse(x, cy + ey, 26, 30 * open, 0, Math.PI * 1.05, Math.PI * 1.95);
      g.stroke(); g.restore();
    }
    function xEye(x) {
      g.save(); g.strokeStyle = LINE; g.lineWidth = 10; g.lineCap = 'round';
      g.beginPath();
      g.moveTo(x - 20, cy + ey - 20); g.lineTo(x + 20, cy + ey + 20);
      g.moveTo(x + 20, cy + ey - 20); g.lineTo(x - 20, cy + ey + 20);
      g.stroke(); g.restore();
    }
    function brow(x, tilt) {
      g.save(); g.strokeStyle = LINE; g.lineWidth = 9; g.lineCap = 'round';
      g.translate(x, cy + ey - 46); g.rotate(tilt);
      g.beginPath(); g.moveTo(-24, 6); g.quadraticCurveTo(0, -10, 24, 4);
      g.stroke(); g.restore();
    }
    function mouth(fn, w) {
      g.save(); g.strokeStyle = '#a85449'; g.lineWidth = w || 8;
      g.lineCap = 'round'; g.lineJoin = 'round';
      g.beginPath(); fn(g); g.stroke(); g.restore();
    }
    function blush() {
      g.save(); g.globalAlpha = 0.45; g.fillStyle = '#ff8fb0';
      g.beginPath(); g.ellipse(cx - R * 0.66, cy + 26, 22, 13, 0, 0, 6.2832); g.fill();
      g.beginPath(); g.ellipse(cx + R * 0.66, cy + 26, 22, 13, 0, 0, 6.2832); g.fill();
      g.restore();
    }

    if (kind === 'dead') {
      brow(cx - ex, 0.3); brow(cx + ex, -0.3);
      xEye(cx - ex); xEye(cx + ex);
      mouth((x) => { x.moveTo(cx - 30, cy + 54); x.lineTo(cx - 10, cy + 40);
        x.lineTo(cx + 10, cy + 54); x.lineTo(cx + 30, cy + 40); }, 8);
      return;
    }
    if (kind === 'surprised') {
      brow(cx - ex, -0.22); brow(cx + ex, 0.22);
      eye(cx - ex, 1.15); eye(cx + ex, 1.15); blush();
      mouth((x) => { x.ellipse(cx, cy + 52, 17, 20, 0, 0, 6.2832); }, 8);
      return;
    }
    if (kind === 'effort') {
      brow(cx - ex, 0.24); brow(cx + ex, -0.24);
      eye(cx - ex, 0.72); eye(cx + ex, 0.72);
      mouth((x) => { x.moveTo(cx - 22, cy + 46); x.quadraticCurveTo(cx, cy + 70, cx + 22, cy + 46); }, 9);
      return;
    }
    brow(cx - ex, -0.1); brow(cx + ex, 0.1);
    eye(cx - ex, 1); eye(cx + ex, 1); blush();
    mouth((x) => { x.moveTo(cx - 26, cy + 48); x.quadraticCurveTo(cx, cy + 68, cx + 26, cy + 48); }, 8);
  }

  // 3x2 포즈
  drawPose(0, 0, { face: 'idle',      lean: 0,   armL: [-18, 64], armR: [18, 64] });
  drawPose(1, 0, { face: 'effort',    lean: 7,   armL: [-58, 10], armR: [46, 44],
                   legL: [46, -34], legR: [-40, 0], headY: 8 });
  drawPose(2, 0, { face: 'effort',    lean: 7,   armL: [-46, 44], armR: [58, 10],
                   legL: [-40, 0],  legR: [46, -34] });
  drawPose(0, 1, { face: 'surprised', lean: -3,  armL: [-40, -56], armR: [40, -56],
                   legL: [-14, -46], legR: [14, -30], squash: 1.04, headY: 14 });
  drawPose(1, 1, { face: 'surprised', lean: 4,   armL: [-52, -30], armR: [52, -30],
                   legL: [-20, -18], legR: [22, -26] });
  drawPose(2, 1, { face: 'dead',      lean: 0,   armL: [-64, 20], armR: [64, 20],
                   legL: [-34, -8], legR: [34, -8], squash: 0.94, headY: -18 });

  const tex = new THREE.CanvasTexture(c);
  tex.encoding = THREE.sRGBEncoding;
  return tex;
}

function loadOptionalTexture(url, key, repeat) {
  texLoader.load(
    url,
    (t) => {
      t.wrapS = t.wrapT = THREE.ClampToEdgeWrapping;
      if (repeat) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(repeat, repeat); }
      t.encoding = THREE.sRGBEncoding;
      t.anisotropy = renderer.capabilities.getMaxAnisotropy();
      TEX[key] = t;
      applyTexture(key, t);
    },
    undefined,
    () => { /* 파일 없음 — 폴백 유지 */ }
  );
}

function applyTexture(key, tex) {
  if (key === 'road') {
    for (const rec of G.tiles.values()) { rec.mesh.material.map = tex; rec.mesh.material.needsUpdate = true; }
  } else if (key === 'sprite') {
    // 시트가 늦게 도착해도 이미 만들어진 캐릭터를 그 자리에서 교체합니다
    forEachAvatar((av) => av.setAtlas(tex));
  }
}

function forEachAvatar(fn) {
  for (const rec of G.players.values()) if (rec && rec.avatar) fn(rec.avatar);
  if (typeof local !== 'undefined' && local && local.avatar) fn(local.avatar);
}

TEX.sprite = makeFallbackSpriteAtlas();
loadOptionalTexture(SPRITE.path, 'sprite', 0);
loadOptionalTexture('assets/road_texture.png', 'road', 1);

/* --- lava plane + void grid -------------------------------------------- */
const lavaMat = new THREE.MeshStandardMaterial({
  color: 0xff0000, emissive: 0xff2200, emissiveIntensity: 1.5,
  roughness: 0.42, metalness: 0.0, transparent: true, opacity: 0.94
});
const lavaMesh = new THREE.Mesh(new THREE.PlaneGeometry(340, 340, 48, 48), lavaMat);
lavaMesh.rotation.x = -Math.PI / 2;
lavaMesh.position.y = -20;
scene.add(lavaMesh);
const lavaBase = lavaMesh.geometry.attributes.position.array.slice();

const lavaGlow = new THREE.Mesh(
  new THREE.PlaneGeometry(340, 340),
  new THREE.MeshBasicMaterial({ color: 0xff5522, transparent: true, opacity: 0.25, depthWrite: false })
);
lavaGlow.rotation.x = -Math.PI / 2;
lavaGlow.position.y = -19.2;
scene.add(lavaGlow);

/* ============================ 4. map building ========================== */

const LAYER_COLORS = { 3: 0x00ffcc, 2: 0x0088ff, 1: 0xaa00ff };
const TRAP_COLOR = 0x6b0d12;

let hexGeo = null, trapGeo = null;

function mapCfg() {
  const c = G.cfg || {};
  return {
    HEX_SIZE: c.HEX_SIZE || 3.2,
    HEX_THICKNESS: c.HEX_THICKNESS || 1.0,
    LAVA_Y: (c.LAVA_Y !== undefined ? c.LAVA_Y : -20),
    LAYERS: c.LAYERS || [{ index: 3, y: 30 }, { index: 2, y: 15 }, { index: 1, y: 0 }]
  };
}

function buildMap(map, cfg) {
  lastTransparencyLayer = -1;
  // clear previous map
  for (const rec of G.tiles.values()) {
    tileGroup.remove(rec.mesh);
    rec.mesh.geometry = null;
    rec.mesh.material.dispose();
  }
  G.tiles.clear();
  G.layerTiles = { 1: [], 2: [], 3: [] };

  G.hexSize = cfg.HEX_SIZE;
  G.hexThick = cfg.HEX_THICKNESS;
  G.lavaY = cfg.LAVA_Y;
  lavaMesh.position.y = cfg.LAVA_Y;
  lavaGlow.position.y = cfg.LAVA_Y + 0.8;
  lavaLight.position.y = cfg.LAVA_Y + 6;
  for (const L of cfg.LAYERS) G.layerY[L.index] = L.y;

  if (!hexGeo) {
    hexGeo = new THREE.CylinderGeometry(G.hexSize * 0.965, G.hexSize * 0.9, G.hexThick, 6, 1);
    trapGeo = new THREE.CylinderGeometry(G.hexSize * 0.965, G.hexSize * 0.9, G.hexThick * 1.12, 6, 1);
  }

  // AABB half-extents of a flat-top hexagon: adjacent boxes overlap in X and
  // touch exactly in Z, so the plane is fully covered — no fall-through gaps.
  const halfX = G.hexSize;
  const halfZ = G.hexSize * Math.sqrt(3) / 2;

  for (const t of map.tiles) {
    const base = t.trap ? TRAP_COLOR : LAYER_COLORS[t.layer];
    const mat = new THREE.MeshStandardMaterial({
      color: base,
      emissive: t.trap ? 0x330000 : base,
      emissiveIntensity: t.trap ? 0.5 : 0.22,
      roughness: t.trap ? 0.85 : 0.55,
      metalness: t.trap ? 0.1 : 0.22,
      transparent: true,
      opacity: 1
    });
    if (TEX.road) mat.map = TEX.road;

    const mesh = new THREE.Mesh(t.trap ? trapGeo : hexGeo, mat);
    mesh.position.set(t.x, t.y, t.z);
    mesh.receiveShadow = true;
    mesh.castShadow = false;
    tileGroup.add(mesh);

    const rec = {
      id: t.id, layer: t.layer, trap: !!t.trap,
      x: t.x, y: t.y, z: t.z,
      top: t.y + G.hexThick / 2,
      minX: t.x - halfX, maxX: t.x + halfX,
      minZ: t.z - halfZ, maxZ: t.z + halfZ,
      state: 'idle', warnStart: 0, fuse: 800, breakStart: 0,
      mesh, mat, baseColor: new THREE.Color(base), baseY: t.y
    };
    G.tiles.set(t.id, rec);
    G.layerTiles[t.layer].push(rec);
  }
  applyLayerTransparency(3);
}

/* Upper floors turn translucent once the runner drops below them, so the
 * camera never has an opaque ceiling between it and the player.            */
let lastTransparencyLayer = -1;
function applyLayerTransparency(currentLayer) {
  if (currentLayer === lastTransparencyLayer) return;
  lastTransparencyLayer = currentLayer;
  for (const L of [1, 2, 3]) {
    const target = L > currentLayer ? 0.16 : 1.0;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      rec.targetOpacity = target;
    }
  }
}


/* ============================ 5. 2.5D 캐릭터 ============================= *
 * Paper Mario / Don't Starve / Octopath 계열의 2.5D 방식입니다.
 * 캐릭터는 항상 카메라를 정면으로 마주보는 하나의 판(빌보드)이고,
 * 좌우 방향은 스프라이트를 뒤집어서 표현합니다.
 *
 * 구성 요소
 *   · 외곽선  : 같은 스프라이트를 살짝 키워 어둡게 뒤에 깔아 실루엣을 강조
 *   · 본체    : 3x2 아틀라스에서 포즈 셀을 UV 오프셋으로 선택
 *   · 그림자  : 바닥에 붙는 타원 (공중에 뜨면 작아지고 옅어짐)
 *   · 색 링   : 발밑 플레이어 색 링 (위에서 내려다볼 때 식별의 핵심)
 * ======================================================================== */

function makeNameplate(text, colorHex) {
  const c = document.createElement('canvas');
  c.width = 320; c.height = 84;
  const g = c.getContext('2d');
  g.fillStyle = 'rgba(5,6,10,0.78)';
  g.fillRect(0, 18, 320, 48);
  g.fillStyle = colorHex;
  g.fillRect(0, 18, 5, 48);
  g.font = '700 30px "Noto Sans KR", sans-serif';
  g.fillStyle = '#ece7d8';
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.fillText(text, 164, 43);
  const tex = new THREE.CanvasTexture(c);
  tex.encoding = THREE.sRGBEncoding;
  const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false }));
  spr.scale.set(7.2, 1.9, 1);
  spr.renderOrder = 999;
  return spr;
}

/* 아틀라스에서 한 포즈만 잘라 쓰는 텍스처 인스턴스를 만듭니다 */
function makePoseTexture(atlas) {
  const t = atlas.clone();
  t.wrapS = t.wrapT = THREE.ClampToEdgeWrapping;
  t.repeat.set(1 / SPRITE.cols, 1 / SPRITE.rows);
  const o = cellOffset('idle');
  t.offset.set(o[0], o[1]);
  t.needsUpdate = true;
  return t;
}

function buildAvatar(colorHex, name) {
  const group = new THREE.Group();          // 월드 위치 (회전하지 않음)
  const col = new THREE.Color(colorHex);

  const H = SPRITE.height;
  const W = H * SPRITE.aspect;

  /* 빌보드: 매 프레임 카메라 쪽으로 yaw 만 회전합니다 (항상 수직 유지) */
  const billboard = new THREE.Group();
  group.add(billboard);

  /* 스쿼시&스트레치 전용 그룹. 발밑을 기준으로 눌리고 늘어납니다 */
  const squash = new THREE.Group();
  billboard.add(squash);

  const bodyTex = makePoseTexture(TEX.sprite);
  const bodyMat = new THREE.MeshStandardMaterial({
    map: bodyTex, transparent: true, alphaTest: 0.06,
    roughness: 1.0, metalness: 0.0,
    emissive: 0xffffff, emissiveMap: bodyTex, emissiveIntensity: SPRITE_EMISSIVE,
    side: THREE.DoubleSide, depthWrite: true
  });
  const body = new THREE.Mesh(new THREE.PlaneGeometry(W, H), bodyMat);
  body.position.y = H / 2;
  body.castShadow = true;
  body.renderOrder = 6;
  squash.add(body);

  /* 외곽선 — 같은 텍스처를 검게 칠해 조금 키운 판. 2.5D 의 인상을 좌우합니다 */
  let outline = null, outlineTex = null;
  if (OUTLINE_PX > 0) {
    outlineTex = makePoseTexture(TEX.sprite);
    const outMat = new THREE.MeshBasicMaterial({
      map: outlineTex, color: OUTLINE_COLOR, transparent: true, alphaTest: 0.06,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    });
    const k = 1 + OUTLINE_PX * 2;
    outline = new THREE.Mesh(new THREE.PlaneGeometry(W * k, H * k), outMat);
    // 확대된 만큼 위로 올려 발밑 아래로 삐져나오지 않게 합니다
    outline.position.set(0, H / 2 + H * OUTLINE_PX, -0.012);
    outline.renderOrder = 5;
    squash.add(outline);
  }

  /* 발밑 플레이어 색 링 — 빌보드가 아니라 바닥에 눕습니다 */
  let ring = null;
  if (RING_OPACITY > 0) {
    ring = new THREE.Mesh(
      new THREE.RingGeometry(W * 0.20, W * 0.29, 30),
      new THREE.MeshBasicMaterial({
        color: col, transparent: true, opacity: RING_OPACITY,
        side: THREE.DoubleSide, depthWrite: false, toneMapped: false
      })
    );
    ring.rotation.x = -Math.PI / 2;
    ring.position.y = 0.07;
    group.add(ring);
  }

  const blob = new THREE.Mesh(
    new THREE.CircleGeometry(W * 0.30, 24),
    new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.36, depthWrite: false })
  );
  blob.rotation.x = -Math.PI / 2;
  blob.position.y = 0.05;
  group.add(blob);

  const plate = makeNameplate(name, colorHex);
  plate.position.y = H + 0.85;
  group.add(plate);

  return {
    group, billboard, squash, body, bodyMat, bodyTex,
    outline, outlineTex, ring, plate, blob,
    W, H,
    pose: 'idle',
    runPhase: 0,
    flip: 1,
    landSquash: 0,
    clock: 0,

    /* 미드저니 시트가 나중에 도착하면 그 자리에서 교체 */
    setAtlas(atlas) {
      const nb = makePoseTexture(atlas);
      this.bodyTex = nb;
      this.bodyMat.map = nb;
      this.bodyMat.emissiveMap = nb;
      this.bodyMat.needsUpdate = true;
      if (this.outline) {
        const no = makePoseTexture(atlas);
        this.outlineTex = no;
        this.outline.material.map = no;
        this.outline.material.needsUpdate = true;
      }
      this.pose = null;              // 다음 프레임에 강제로 다시 적용
    }
  };
}

/* 포즈 셀 전환 — UV 오프셋만 바꾸므로 비용이 사실상 0 */
function setPose(av, pose) {
  if (av.pose === pose) return;
  const o = cellOffset(pose);
  av.bodyTex.offset.set(o[0], o[1]);
  if (av.outlineTex) av.outlineTex.offset.set(o[0], o[1]);
  av.pose = pose;
}

/* ---------------------------------------------------------------------------
 * 애니메이션 + 빌보드
 *   dt      : 델타 타임
 *   speed01 : 0~1 정규화된 이동 속도
 *   state   : idle | run | jump | fall | dead
 *   ry      : 캐릭터가 향한 방향 (좌우 뒤집기 판정에 사용)
 * ------------------------------------------------------------------------- */
function animateAvatar(av, dt, speed01, state, ry) {
  if (!av) return;
  av.clock += dt;

  /* --- 빌보드: 카메라 yaw 를 따라가고, 피치는 발밑을 축으로 상쇄 --- */
  av.billboard.rotation.order = 'YXZ';
  av.billboard.rotation.y = cam.yaw;
  av.billboard.rotation.x = -cam.pitch * BILLBOARD_PITCH;

  /* --- 좌우 뒤집기: 진행 방향이 카메라 기준 왼쪽이면 미러 --- */
  if (typeof ry === 'number' && speed01 > 0.06) {
    const fx = Math.sin(ry), fz = Math.cos(ry);          // 캐릭터 전방
    const rx = Math.cos(cam.yaw), rz = -Math.sin(cam.yaw); // 카메라 오른쪽
    const dotR = fx * rx + fz * rz;
    if (Math.abs(dotR) > 0.12) av.flip = dotR > 0 ? 1 : -1;
  }

  /* --- 포즈 선택 --- */
  let pose = 'idle';
  if (state === 'dead') pose = 'dead';
  else if (state === 'jump') pose = 'jump';
  else if (state === 'fall') pose = 'fall';
  else if (state === 'run' || speed01 > 0.12) {
    av.runPhase += dt * SPRITE.runFps * (0.45 + speed01 * 0.85);
    pose = (Math.floor(av.runPhase) % 2 === 0) ? 'run1' : 'run2';
  } else {
    av.runPhase = 0;
  }
  setPose(av, pose);

  /* --- 스쿼시 & 스트레치 --- */
  let sx = 1, sy = 1;
  if (state === 'dead') { sx = 1.10; sy = 0.88; }
  else if (state === 'jump') { sy = 1.16; sx = 0.90; av.landSquash = 1; }
  else if (state === 'fall') { sy = 1.08; sx = 0.95; av.landSquash = 1; }
  else if (av.landSquash > 0) {
    av.landSquash = Math.max(0, av.landSquash - dt * 5.2);
    sy = 1 - av.landSquash * 0.32;
    sx = 1 + av.landSquash * 0.26;
  } else if (pose === 'idle') {
    // 숨쉬는 미세 움직임
    sy = 1 + Math.sin(av.clock * 2.1) * 0.018;
    sx = 1 - Math.sin(av.clock * 2.1) * 0.014;
  } else {
    // 달릴 때 통통 튀는 느낌
    sy = 1 + Math.sin(av.runPhase * Math.PI) * 0.045 * speed01;
    sx = 1 - Math.sin(av.runPhase * Math.PI) * 0.035 * speed01;
  }

  const k = Math.min(1, dt * 18);
  const cur = av.squash.scale;
  cur.x += (sx * av.flip - cur.x) * k;
  cur.y += (sy - cur.y) * k;
  cur.z += (1 - cur.z) * k;

  /* --- 사망: 살짝 가라앉으며 기웁니다 --- */
  if (state === 'dead') {
    av.squash.position.y += (-av.H * 0.10 - av.squash.position.y) * Math.min(1, dt * 5);
    av.squash.rotation.z += (0.22 * av.flip - av.squash.rotation.z) * Math.min(1, dt * 5);
    av.plate.visible = false;
    if (av.ring) av.ring.visible = false;
  } else {
    av.squash.position.y += (0 - av.squash.position.y) * Math.min(1, dt * 8);
    av.squash.rotation.z += (0 - av.squash.rotation.z) * Math.min(1, dt * 8);
    av.plate.visible = true;
    if (av.ring) av.ring.visible = true;
  }
}

/* 공중에 뜨면 그림자를 작고 옅게 — 2.5D 에서 높이를 읽는 유일한 단서입니다 */
function updateGroundShadow(av, feetY, groundY, grounded) {
  if (!av || !av.blob) return;
  const gap = Math.max(0, feetY - groundY);
  const t = THREE.MathUtils.clamp(1 - gap / 16, 0.18, 1);
  av.blob.scale.setScalar(t);
  av.blob.material.opacity = 0.36 * t;
  av.blob.position.y = (groundY - feetY) + 0.05;
  av.blob.visible = gap < 34;
  if (av.ring) {
    av.ring.position.y = grounded ? 0.07 : (groundY - feetY) + 0.07;
    av.ring.scale.setScalar(grounded ? 1 : t);
  }
}

/* ============================ 6. local runner =========================== */

const local = {
  pos: new THREE.Vector3(0, 30.5, 0),
  vel: new THREE.Vector3(0, 0, 0),
  ry: 0,
  grounded: false,
  groundTile: null,
  layer: 3,
  anim: 'idle',
  avatar: null,
  coyote: 0,
  jumpBuffer: 0,
  alive: true,
  color: '#ffcc00'
};

/* ============================ 7. input ================================= */

const keys = Object.create(null);
window.addEventListener('keydown', (e) => {
  if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) e.preventDefault();
  keys[e.code] = true;
  if (e.code === 'Space') local.jumpBuffer = 0.16;
});
window.addEventListener('keyup', (e) => { keys[e.code] = false; });
window.addEventListener('blur', () => { for (const k in keys) keys[k] = false; });

const cam = { yaw: 0, pitch: 0.62, dist: 20, targetDist: 20, height: 3.2, dragging: false, lx: 0, ly: 0 };

renderer.domElement.addEventListener('mousedown', (e) => {
  cam.dragging = true; cam.lx = e.clientX; cam.ly = e.clientY;
});
window.addEventListener('mouseup', () => { cam.dragging = false; });
window.addEventListener('mousemove', (e) => {
  if (!cam.dragging) return;
  cam.yaw -= (e.clientX - cam.lx) * 0.0055;
  cam.pitch = THREE.MathUtils.clamp(cam.pitch + (e.clientY - cam.ly) * 0.0042, 0.08, 1.36);
  cam.lx = e.clientX; cam.ly = e.clientY;
});
renderer.domElement.addEventListener('wheel', (e) => {
  e.preventDefault();
  cam.targetDist = THREE.MathUtils.clamp(cam.targetDist + e.deltaY * 0.02, 10, 46);
}, { passive: false });

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

/* ============================ 8. physics =============================== */

/** AABB overlap test between the runner box and a tile box (XZ plane). */
function aabbOverlapXZ(px, pz, rec) {
  return (px + PLAYER.HALF_X > rec.minX) && (px - PLAYER.HALF_X < rec.maxX) &&
         (pz + PLAYER.HALF_Z > rec.minZ) && (pz - PLAYER.HALF_Z < rec.maxZ);
}

/** Point-in-box test — decides which hex actually *owns* the runner. */
function pointInXZ(px, pz, rec) {
  return px >= rec.minX && px <= rec.maxX && pz >= rec.minZ && pz <= rec.maxZ;
}

/**
 * Sweep the runner's feet from prevY to nextY and return the highest solid
 * surface crossed. Supports tiles (per layer) and spectator boosters.
 */
function findLanding(px, pz, prevY, nextY) {
  let best = null;

  for (const L of [3, 2, 1]) {
    const surf = G.layerY[L] + G.hexThick / 2;
    if (prevY < surf - 0.02) continue;      // already below this floor
    if (nextY > surf) continue;             // haven't reached it yet
    let owner = null, ownerD = Infinity;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      if (!pointInXZ(px, pz, rec)) continue;
      const d = (px - rec.x) * (px - rec.x) + (pz - rec.z) * (pz - rec.z);
      if (d < ownerD) { ownerD = d; owner = rec; }
    }
    if (owner && (!best || surf > best.surf)) best = { surf, tile: owner, layer: L };
  }

  for (const b of G.boosters.values()) {
    const surf = b.y + 0.5;
    if (prevY < surf - 0.02 || nextY > surf) continue;
    const dx = px - b.x, dz = pz - b.z;
    if (dx * dx + dz * dz > 3.6 * 3.6) continue;
    if (!best || surf > best.surf) best = { surf, tile: null, layer: b.layer || currentLayerOf(surf), booster: b };
  }
  return best;
}

/** Is the runner still supported at its current feet height? */
function supportAt(px, pz, feetY) {
  for (const L of [3, 2, 1]) {
    const surf = G.layerY[L] + G.hexThick / 2;
    if (Math.abs(feetY - surf) > 0.12) continue;
    let owner = null, ownerD = Infinity;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      if (!pointInXZ(px, pz, rec)) continue;
      const d = (px - rec.x) * (px - rec.x) + (pz - rec.z) * (pz - rec.z);
      if (d < ownerD) { ownerD = d; owner = rec; }
    }
    if (owner) return { tile: owner, layer: L, surf };
  }
  for (const b of G.boosters.values()) {
    const surf = b.y + 0.5;
    if (Math.abs(feetY - surf) > 0.12) continue;
    const dx = px - b.x, dz = pz - b.z;
    if (dx * dx + dz * dz <= 3.6 * 3.6) return { tile: null, layer: currentLayerOf(surf), surf, booster: b };
  }
  return null;
}

/* 주어진 위치 아래에 있는 가장 가까운 바닥의 y.
 * 2.5D 는 원근 단서가 약해서, 그림자로 높이를 읽게 하는 것이 매우 중요합니다. */
function groundYUnder(px, pz, fromY) {
  let best = G.lavaY;
  for (const L of [1, 2, 3]) {
    const surf = G.layerY[L] + G.hexThick / 2;
    if (surf > fromY + 0.05) continue;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      if (!pointInXZ(px, pz, rec)) continue;
      if (surf > best) best = surf;
      break;
    }
  }
  for (const b of G.boosters.values()) {
    const surf = b.y + 0.5;
    if (surf > fromY + 0.05) continue;
    const dx = px - b.x, dz = pz - b.z;
    if (dx * dx + dz * dz <= 3.6 * 3.6 && surf > best) best = surf;
  }
  return best;
}

function currentLayerOf(y) {
  if (y >= G.layerY[3] - 3) return 3;
  if (y >= G.layerY[2] - 3) return 2;
  return 1;
}

function stepPhysics(dt) {
  if (!local.alive) return;

  // ---- horizontal intent (camera-relative) ----
  const fwd = new THREE.Vector3(-Math.sin(cam.yaw), 0, -Math.cos(cam.yaw));
  const right = new THREE.Vector3(Math.cos(cam.yaw), 0, -Math.sin(cam.yaw));
  const wish = new THREE.Vector3();
  if (keys['KeyW'] || keys['ArrowUp']) wish.add(fwd);
  if (keys['KeyS'] || keys['ArrowDown']) wish.sub(fwd);
  if (keys['KeyD'] || keys['ArrowRight']) wish.add(right);
  if (keys['KeyA'] || keys['ArrowLeft']) wish.sub(right);

  const sprinting = keys['ShiftLeft'] || keys['ShiftRight'];
  const maxSpeed = sprinting ? PHYS.SPRINT : PHYS.MOVE;
  const accel = local.grounded ? PHYS.ACCEL_GROUND : PHYS.ACCEL_AIR;

  if (wish.lengthSq() > 0) {
    wish.normalize();
    local.vel.x += wish.x * accel * dt;
    local.vel.z += wish.z * accel * dt;
    local.ry = Math.atan2(wish.x, wish.z);
  } else if (local.grounded) {
    const f = Math.max(0, 1 - PHYS.FRICTION * dt);
    local.vel.x *= f; local.vel.z *= f;
  }

  const hs = Math.hypot(local.vel.x, local.vel.z);
  if (hs > maxSpeed) {
    local.vel.x = local.vel.x / hs * maxSpeed;
    local.vel.z = local.vel.z / hs * maxSpeed;
  }

  // ---- jump (with coyote time + input buffering) ----
  local.coyote = local.grounded ? 0.11 : Math.max(0, local.coyote - dt);
  local.jumpBuffer = Math.max(0, local.jumpBuffer - dt);
  if (local.jumpBuffer > 0 && local.coyote > 0) {
    local.vel.y = PHYS.JUMP_V;
    local.grounded = false;
    local.coyote = 0;
    local.jumpBuffer = 0;
    local.groundTile = null;
  }

  // ---- integrate ----
  const prevY = local.pos.y;
  local.vel.y = Math.max(PHYS.MAX_FALL, local.vel.y + PHYS.GRAVITY * dt);

  local.pos.x += local.vel.x * dt;
  local.pos.z += local.vel.z * dt;
  const nextY = local.pos.y + local.vel.y * dt;

  // ---- ground resolution ----
  local.grounded = false;
  if (local.vel.y <= 0) {
    const hit = findLanding(local.pos.x, local.pos.z, prevY, nextY);
    if (hit) {
      local.pos.y = hit.surf;
      local.vel.y = 0;
      local.grounded = true;
      local.layer = hit.layer;
      local.groundTile = hit.tile;
      if (hit.tile) onSteppedOn(hit.tile);
    } else {
      local.pos.y = nextY;
    }
  } else {
    local.pos.y = nextY;
  }

  if (local.grounded) {
    const sup = supportAt(local.pos.x, local.pos.z, local.pos.y);
    if (!sup) { local.grounded = false; }
    else {
      local.layer = sup.layer;
      local.groundTile = sup.tile;
      if (sup.tile) onSteppedOn(sup.tile);
    }
  }

  // ---- animation state ----
  if (!local.grounded) local.anim = local.vel.y > 1.5 ? 'jump' : 'fall';
  else local.anim = hs > 1.2 ? 'run' : 'idle';

  // ---- lava / out-of-bounds ----
  if (local.pos.y <= G.lavaY + 1.2) eliminateSelf('lava');
  if (Math.abs(local.pos.x) > 170 || Math.abs(local.pos.z) > 170) eliminateSelf('void');
}

/** Fire tile_step exactly once per tile per round. */
function onSteppedOn(rec) {
  if (!rec || rec.state !== 'idle') return;
  if (G.steppedTiles.has(rec.id)) return;
  if (G.phase !== 'playing') return;
  G.steppedTiles.add(rec.id);
  // optimistic local warning so the feedback is instant; server re-syncs below
  startWarn(rec, rec.trap ? 200 : 800);
  G.socket.emit('tile_step', { tileId: rec.id });
}

function eliminateSelf(cause) {
  if (!local.alive) return;
  local.alive = false;
  G.selfAlive = false;
  local.anim = 'dead';
  dom.deadFlash.classList.add('on');
  setTimeout(() => dom.deadFlash.classList.remove('on'), 700);
  G.socket.emit('player_death', { cause });
  G.role = 'spectator';
  updateSpectatorUI();
  toast('심사 탈락 — 이제 관전자로 개입할 수 있습니다', 'kill');
}

/* ============================ 9. tile FX =============================== */

function startWarn(rec, fuse) {
  if (rec.state === 'gone' || rec.state === 'warn') return;
  rec.state = 'warn';
  rec.warnStart = performance.now();
  rec.fuse = fuse;
}

function breakTile(rec) {
  if (!rec || rec.state === 'gone') return;
  rec.state = 'gone';
  rec.breakStart = performance.now();
  spawnDebris(rec);
}

const debris = [];
const debrisGeo = new THREE.TetrahedronGeometry(0.55);
function spawnDebris(rec) {
  for (let i = 0; i < 6; i++) {
    const m = new THREE.Mesh(debrisGeo, new THREE.MeshStandardMaterial({
      color: rec.baseColor, emissive: rec.baseColor, emissiveIntensity: 0.6, transparent: true
    }));
    m.position.set(rec.x + (Math.random() - 0.5) * 3.4, rec.y, rec.z + (Math.random() - 0.5) * 3.4);
    fxGroup.add(m);
    debris.push({
      mesh: m,
      vel: new THREE.Vector3((Math.random() - 0.5) * 7, Math.random() * 5 + 1.5, (Math.random() - 0.5) * 7),
      spin: new THREE.Vector3(Math.random() * 6, Math.random() * 6, Math.random() * 6),
      life: 1.6
    });
  }
  if (debris.length > 220) {
    const old = debris.splice(0, debris.length - 220);
    old.forEach((d) => { fxGroup.remove(d.mesh); d.mesh.material.dispose(); });
  }
}

function updateDebris(dt) {
  for (let i = debris.length - 1; i >= 0; i--) {
    const d = debris[i];
    d.life -= dt;
    if (d.life <= 0) {
      fxGroup.remove(d.mesh); d.mesh.material.dispose(); debris.splice(i, 1); continue;
    }
    d.vel.y += PHYS.GRAVITY * 0.55 * dt;
    d.mesh.position.addScaledVector(d.vel, dt);
    d.mesh.rotation.x += d.spin.x * dt;
    d.mesh.rotation.y += d.spin.y * dt;
    d.mesh.material.opacity = Math.min(1, d.life / 0.8);
  }
}

function updateTiles(dt, now) {
  for (const rec of G.tiles.values()) {
    const mesh = rec.mesh;

    if (rec.state === 'warn') {
      const p = Math.min(1, (now - rec.warnStart) / rec.fuse);
      const blink = Math.sin(p * Math.PI * (rec.trap ? 16 : 10)) * 0.5 + 0.5;
      rec.mat.emissiveIntensity = 0.3 + blink * 2.6;
      rec.mat.color.copy(rec.baseColor).lerp(new THREE.Color(0xff2d2d), 0.35 + p * 0.55);
      mesh.position.y = rec.baseY + Math.sin(now * 0.05) * 0.09 * p;
      mesh.scale.setScalar(1 - p * 0.06);
    } else if (rec.state === 'gone') {
      const t = (now - rec.breakStart) / 420;
      if (t < 1) {
        mesh.visible = true;
        mesh.position.y = rec.baseY - t * t * 26;
        mesh.rotation.x = t * 1.1;
        mesh.rotation.z = t * 0.8;
        rec.mat.opacity = Math.max(0, 1 - t);
        mesh.scale.setScalar(Math.max(0.01, 1 - t * 0.5));
      } else if (mesh.visible) {
        mesh.visible = false;
      }
      continue;
    } else {
      // idle — breathe the emissive very gently so the grid feels alive
      rec.mat.emissiveIntensity = rec.trap
        ? 0.45 + Math.sin(now * 0.004 + rec.x) * 0.2
        : 0.2 + Math.sin(now * 0.0016 + rec.x * 0.2 + rec.z * 0.2) * 0.07;
      rec.mat.color.copy(rec.baseColor);
    }

    if (rec.targetOpacity !== undefined) {
      rec.mat.opacity += (rec.targetOpacity - rec.mat.opacity) * Math.min(1, dt * 6);
    }
  }
}

/* ============================ 10. boosters & obstacles ================= */

const boosterGeo = new THREE.CylinderGeometry(3.5, 3.2, 0.9, 24);
function spawnBooster(e) {
  const mat = new THREE.MeshStandardMaterial({
    color: 0xffcc00, emissive: 0xffaa00, emissiveIntensity: 1.5,
    metalness: 0.7, roughness: 0.25, transparent: true, opacity: 0.95
  });
  const mesh = new THREE.Mesh(boosterGeo, mat);
  mesh.position.set(e.x, e.y, e.z);
  mesh.castShadow = true;
  fxGroup.add(mesh);

  const ring = new THREE.Mesh(
    new THREE.RingGeometry(3.6, 5.0, 32),
    new THREE.MeshBasicMaterial({ color: 0xffcc00, transparent: true, opacity: 0.5, side: THREE.DoubleSide, depthWrite: false })
  );
  ring.rotation.x = -Math.PI / 2;
  ring.position.set(e.x, e.y + 0.6, e.z);
  fxGroup.add(ring);

  G.boosters.set(e.id, {
    id: e.id, x: e.x, y: e.y, z: e.z, mesh, ring, mat,
    layer: currentLayerOf(e.y), born: performance.now(), ttl: e.ttl || 7000
  });
}

function removeBooster(id) {
  const b = G.boosters.get(id);
  if (!b) return;
  fxGroup.remove(b.mesh); fxGroup.remove(b.ring);
  b.mesh.material.dispose(); b.ring.material.dispose();
  G.boosters.delete(id);
}

function updateBoosters(dt, now) {
  for (const b of G.boosters.values()) {
    const age = now - b.born;
    const left = b.ttl - age;
    b.mesh.rotation.y += dt * 1.1;
    b.ring.rotation.z += dt * 0.6;
    const s = 1 + Math.sin(now * 0.006) * 0.04;
    b.ring.scale.setScalar(s);
    if (left < 1600) {
      const blink = Math.sin(now * 0.03) * 0.5 + 0.5;
      b.mat.opacity = 0.35 + blink * 0.6;
      b.ring.material.opacity = 0.15 + blink * 0.4;
    }
    if (left <= 0) removeBooster(b.id);
  }
}

const obsGeo = new THREE.BoxGeometry(4.6, 0.45, 3.4);
function spawnObstacle(e) {
  const mat = new THREE.MeshStandardMaterial({
    color: 0xece7d8, emissive: 0xff2d2d, emissiveIntensity: 0.35, roughness: 0.85
  });
  const mesh = new THREE.Mesh(obsGeo, mat);
  mesh.position.set(e.x, e.fromY, e.z);
  mesh.rotation.y = Math.random() * 3.14;
  mesh.castShadow = true;
  fxGroup.add(mesh);

  const marker = new THREE.Mesh(
    new THREE.RingGeometry(2.6, 4.0, 24),
    new THREE.MeshBasicMaterial({ color: 0xff2d2d, transparent: true, opacity: 0.65, side: THREE.DoubleSide, depthWrite: false })
  );
  marker.rotation.x = -Math.PI / 2;
  marker.position.set(e.x, e.y + 0.7, e.z);
  fxGroup.add(marker);

  G.obstacles.set(e.id, {
    id: e.id, mesh, marker, mat,
    x: e.x, y: e.y, z: e.z, fromY: e.fromY,
    born: performance.now(), duration: e.durationMs || 1400, impacted: false
  });
}

function updateObstacles(dt, now) {
  for (const o of G.obstacles.values()) {
    const p = Math.min(1, (now - o.born) / o.duration);
    o.mesh.position.y = o.fromY + (o.y + 1.2 - o.fromY) * (p * p);
    o.mesh.rotation.z = Math.sin(p * 9) * 0.3;
    o.marker.material.opacity = 0.25 + (Math.sin(now * 0.02) * 0.5 + 0.5) * 0.55;
    o.marker.scale.setScalar(1.35 - p * 0.35);

    if (p >= 1 && !o.impacted) {
      o.impacted = true;
      // knockback for the local runner if caught in the blast radius
      const dx = local.pos.x - o.x, dz = local.pos.z - o.z;
      const d = Math.hypot(dx, dz);
      if (local.alive && d < 6.5 && Math.abs(local.pos.y - o.y) < 5) {
        const k = (1 - d / 6.5) * 26;
        local.vel.x += (dx / (d || 1)) * k;
        local.vel.z += (dz / (d || 1)) * k;
        local.vel.y = Math.max(local.vel.y, 9);
        local.grounded = false;
      }
      setTimeout(() => removeObstacle(o.id), 520);
    }
  }
}

function removeObstacle(id) {
  const o = G.obstacles.get(id);
  if (!o) return;
  fxGroup.remove(o.mesh); fxGroup.remove(o.marker);
  o.mesh.material.dispose(); o.marker.material.dispose();
  G.obstacles.delete(id);
}

/* ============================ 11. dead reckoning ====================== */
/**
 * Remote runners are rendered INTERP_DELAY_MS in the past and interpolated
 * between the two snapshots that bracket that render time. When the newest
 * snapshot is older than the render time (packet loss / jitter spike) we
 * extrapolate with the last known velocity, capped at EXTRAPOLATE_CAP_MS so
 * a stalled peer never rockets off the map.
 */
class RemoteRunner {
  constructor(meta) {
    this.id = meta.id;
    this.name = meta.name;
    this.color = meta.color;
    this.alive = meta.alive !== false;
    this.layer = meta.layer || 3;
    this.anim = 'idle';
    this.buffer = [];
    this.render = new THREE.Vector3(meta.pos ? meta.pos.x : 0, meta.pos ? meta.pos.y : 30.5, meta.pos ? meta.pos.z : 0);
    this.renderRy = 0;
    this.speed01 = 0;
    this.avatar = buildAvatar(meta.color, meta.name);
    this.avatar.group.position.copy(this.render);
    actorGroup.add(this.avatar.group);
  }

  push(s, localNow) {
    this.buffer.push({
      t: localNow,
      p: new THREE.Vector3(s.p[0], s.p[1], s.p[2]),
      v: new THREE.Vector3(s.v[0], s.v[1], s.v[2]),
      ry: s.ry, anim: s.a, layer: s.l, alive: !!s.al
    });
    if (this.buffer.length > 24) this.buffer.shift();
  }

  update(dt, localNow) {
    const renderTime = localNow - NET.INTERP_DELAY_MS;
    const buf = this.buffer;
    let target = null, vel = null;

    if (buf.length === 0) {
      target = this.render.clone();
    } else if (buf.length === 1 || renderTime <= buf[0].t) {
      target = buf[0].p.clone();
      this.renderRy = buf[0].ry;
      this.anim = buf[0].anim; this.layer = buf[0].layer; this.alive = buf[0].alive;
    } else {
      let a = null, b = null;
      for (let i = buf.length - 1; i > 0; i--) {
        if (buf[i - 1].t <= renderTime && buf[i].t >= renderTime) { a = buf[i - 1]; b = buf[i]; break; }
      }
      if (a && b) {
        // --- interpolation path ---
        const span = Math.max(1, b.t - a.t);
        const k = THREE.MathUtils.clamp((renderTime - a.t) / span, 0, 1);
        target = a.p.clone().lerp(b.p, k);
        this.renderRy = lerpAngle(a.ry, b.ry, k);
        this.anim = k < 0.5 ? a.anim : b.anim;
        this.layer = b.layer; this.alive = b.alive;
        vel = b.v;
      } else {
        // --- dead reckoning (extrapolation) path ---
        const last = buf[buf.length - 1];
        const ahead = Math.min(renderTime - last.t, NET.EXTRAPOLATE_CAP_MS) / 1000;
        target = last.p.clone().addScaledVector(last.v, Math.max(0, ahead));
        this.renderRy = last.ry;
        this.anim = last.anim; this.layer = last.layer; this.alive = last.alive;
        vel = last.v;
      }
    }

    // Critically-damped smoothing removes the residual snap on the seams.
    const smooth = 1 - Math.pow(0.0009, dt);
    this.render.lerp(target, smooth);

    const av = this.avatar;
    av.group.position.copy(this.render);

    this.speed01 = vel ? THREE.MathUtils.clamp(Math.hypot(vel.x, vel.z) / PHYS.SPRINT, 0, 1) : 0;
    animateAvatar(av, dt, this.speed01, this.alive ? this.anim : 'dead', this.renderRy);
    av.group.visible = true;
    updateGroundShadow(av, this.render.y,
      groundYUnder(this.render.x, this.render.z, this.render.y),
      this.anim !== 'jump' && this.anim !== 'fall');
  }

  dispose() {
    actorGroup.remove(this.avatar.group);
  }
}

function lerpAngle(a, b, k) {
  let d = ((b - a + Math.PI) % (Math.PI * 2)) - Math.PI;
  if (d < -Math.PI) d += Math.PI * 2;
  return a + d * k;
}

/* ============================ 12. camera rig ========================== */

const camTarget = new THREE.Vector3();
const camDesired = new THREE.Vector3();

function updateCamera(dt) {
  const focus = local.alive ? local.pos : spectateFocus();

  camTarget.lerp(
    new THREE.Vector3(focus.x, focus.y + cam.height, focus.z),
    Math.min(1, dt * 8)
  );

  // Auto pitch: ease the camera up while the runner is plummeting so the
  // landing zone below stays framed, and pull it down on the top layer.
  const falling = THREE.MathUtils.clamp(-local.vel.y / 45, 0, 1);
  const autoPitch = 0.5 + falling * 0.42;
  cam.pitch = THREE.MathUtils.lerp(cam.pitch, THREE.MathUtils.clamp(cam.pitch, 0.08, 1.36), 1);
  const usedPitch = cam.dragging ? cam.pitch : THREE.MathUtils.lerp(cam.pitch, autoPitch, dt * 0.9);
  if (!cam.dragging) cam.pitch = usedPitch;

  cam.dist += (cam.targetDist - cam.dist) * Math.min(1, dt * 5);

  const horiz = Math.cos(cam.pitch) * cam.dist;
  camDesired.set(
    camTarget.x + Math.sin(cam.yaw) * horiz,
    camTarget.y + Math.sin(cam.pitch) * cam.dist,
    camTarget.z + Math.cos(cam.yaw) * horiz
  );
  camera.position.lerp(camDesired, Math.min(1, dt * 9));
  camera.lookAt(camTarget);

  keyLight.position.set(focus.x + 38, focus.y + 70, focus.z + 26);
  keyLight.target.position.set(focus.x, focus.y, focus.z);
  keyLight.target.updateMatrixWorld();

  applyLayerTransparency(local.alive ? local.layer : currentLayerOf(focus.y));
}

function spectateFocus() {
  if (G.specTarget) {
    const r = G.players.get(G.specTarget);
    if (r && r.alive) return r.render;
  }
  for (const r of G.players.values()) if (r.alive) return r.render;
  return new THREE.Vector3(0, G.layerY[2], 0);
}

/* ============================ 13. HUD ================================= */

function updateLayerStack(layer) {
  for (const d of dom.docs) {
    d.classList.toggle('on', parseInt(d.dataset.l, 10) === layer);
  }
}

function updateRoster() {
  const rows = [];
  const entries = [...G.players.values()].sort((a, b) => (b.alive - a.alive));
  for (const r of entries) {
    const isSelf = r.id === G.selfId;
    rows.push(
      '<div class="rrow' + (r.alive ? '' : ' dead') + '" style="border-left-color:' + (r.color || '#888') + '">' +
      '<span>' + escapeHtml(safeName(r.name)) + '</span>' +
      (isSelf ? '<span class="you">YOU</span>' : '') +
      '<span class="lay">' + (r.alive ? 'L' + (r.layer || 3) : 'OUT') + '</span>' +
      '</div>'
    );
  }
  if (!rows.length) rows.push('<div class="rrow" style="border-left-color:#333;opacity:.5">대기 중…</div>');
  dom.rosterList.innerHTML = rows.join('');
}

/* 어떤 경로로 들어오든 화면에 undefined 가 찍히지 않게 하는 안전망 */
function safeName(v, fallback) {
  if (typeof v === 'string' && v.trim()) return v.trim();
  return fallback || '익명 출원인';
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function updateSpectatorUI() {
  const isSpec = G.role === 'spectator';
  dom.spec.classList.toggle('show', isSpec);
  dom.hint.classList.toggle('hide', isSpec);
  if (!isSpec) return;

  const alive = [...G.players.values()].filter((p) => p.alive);
  if (!G.specTarget || !alive.find((p) => p.id === G.specTarget)) {
    G.specTarget = alive.length ? alive[0].id : null;
  }
  dom.specTargets.innerHTML = alive.length
    ? alive.map((p) =>
        '<button class="tgt' + (p.id === G.specTarget ? ' sel' : '') + '" data-id="' + p.id + '">' +
        escapeHtml(safeName(p.name)) + '</button>').join('')
    : '<span style="font-size:11px;opacity:.5">주자가 없습니다</span>';
}

dom.specTargets.addEventListener('click', (e) => {
  const b = e.target.closest('.tgt');
  if (!b) return;
  G.specTarget = b.dataset.id;
  updateSpectatorUI();
});

dom.actCheer.addEventListener('click', () => {
  if (performance.now() < G.cheerReadyAt) return;
  G.socket.emit('cheer_booster', { targetId: G.specTarget });
});
dom.actDrop.addEventListener('click', () => {
  if (performance.now() < G.dropReadyAt) return;
  G.socket.emit('drop_obstacle', { targetId: G.specTarget });
});

function updateActionCooldowns(now) {
  const cd = (btn, readyAt, total) => {
    const left = readyAt - now;
    const bar = btn.querySelector('.cd');
    if (left > 0) {
      btn.disabled = true;
      bar.style.width = (100 - (left / total) * 100).toFixed(1) + '%';
    } else {
      btn.disabled = G.phase !== 'playing';
      bar.style.width = '100%';
    }
  };
  cd(dom.actCheer, G.cheerReadyAt, G.cfg ? G.cfg.BOOSTER_COOLDOWN_MS : 9000);
  cd(dom.actDrop, G.dropReadyAt, G.cfg ? G.cfg.OBSTACLE_COOLDOWN_MS : 12000);
}

let cdVisible = false;
function updateCountdown() {
  if (G.phase === 'countdown' && G.phaseEndsAt) {
    const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
    dom.cdNum.textContent = Math.ceil(left / 1000);
    dom.cdLabel.textContent = '심사 착수까지';
    if (!cdVisible) { dom.countdown.classList.add('show'); cdVisible = true; }
  } else if (G.phase === 'waiting' && G.phaseEndsAt) {
    const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
    dom.cdNum.textContent = Math.ceil(left / 1000);
    dom.cdLabel.textContent = '출원인 모집 중';
    if (!cdVisible) { dom.countdown.classList.add('show'); cdVisible = true; }
  } else if (cdVisible) {
    dom.countdown.classList.remove('show');
    cdVisible = false;
  }
}

function showResult(data) {
  const won = data.winnerId === G.selfId;
  dom.resultEyebrow.textContent = won ? '최종 처분 · REGISTERED' : '최종 처분 · REJECTED';
  dom.resultTitle.innerHTML = won ? '등록결정' : (data.winnerName ? '거절결정' : '전원 탈락');
  dom.resultSub.textContent = won
    ? '마지막까지 바닥을 지켜냈습니다. 패스트트랙 심사를 통과했습니다.'
    : (data.winnerName ? escapeHtml(data.winnerName) + ' 님이 등록결정을 받았습니다.' : '남은 주자가 없습니다.');
  dom.resultRank.innerHTML = (data.standings || []).map((s) =>
    '<div class="rank" style="border-left-color:' + s.color + '">' +
    '<span class="p">' + (s.placement === 99 ? '—' : s.placement) + '</span>' +
    '<span>' + escapeHtml(s.name) + '</span></div>').join('');
  dom.result.classList.add('show');
}

/* ============================ 14. networking ========================== */

function connect(name, mode) {
  /* polling 으로 먼저 붙은 뒤 websocket 으로 업그레이드합니다.
   * socket.io-client 4.8 부터 tryAllTransports 기본값이 false 라서,
   * websocket 을 첫 transport 로 지정하면 사내 프록시/방화벽이 ws 업그레이드를
   * 막을 때 polling 으로 넘어가지 못하고 연결 자체가 실패합니다.            */
  const socket = io({
    transports: ['polling', 'websocket'],
    tryAllTransports: true,
    upgrade: true,
    reconnectionAttempts: Infinity,
    reconnectionDelayMax: 4000,
    timeout: 8000
  });
  G.socket = socket;
  G.name = name;

  socket.on('connect', () => {
    socket.emit('join', { name, mode });
    // 재연결마다 인터벌이 쌓이지 않도록 기존 것을 먼저 정리
    if (G.pingTimer) clearInterval(G.pingTimer);
    G.pingTimer = setInterval(() => socket.emit('ping_probe', Date.now()), 3000);
    socket.emit('ping_probe', Date.now());
  });

  socket.on('pong_probe', (d) => {
    G.rtt = Date.now() - d.clientSent;
    G.serverOffset = d.serverTime - (d.clientSent + G.rtt / 2);
    dom.vPing.textContent = G.rtt + ' ms';
    dom.vPing.classList.toggle('bad', G.rtt > 160);
  });

  socket.on('server_hello', (d) => { G.cfg = d.config; });

  socket.on('init', (d) => {
    G.selfId = d.selfId;
    G.role = d.role;
    G.roomId = d.roomId;
    G.map = d.map;
    G.cfg = G.cfg || {};
    dom.vRoom.textContent = d.roomId;

    buildMap(d.map, mapCfg());

    for (const b of d.brokenTiles || []) {
      const rec = G.tiles.get(b.id);
      if (!rec) continue;
      if (b.st === 'broken') { rec.state = 'gone'; rec.mesh.visible = false; }
      else startWarn(rec, 800);
    }

    syncPlayers(d.players);
    applyMeta(d.meta);

    if (d.role === 'player') {
      const me = d.players.find((p) => p.id === d.selfId);
      if (me) {
        local.pos.set(me.pos.x, me.pos.y, me.pos.z);
        local.color = me.color;
      }
      local.alive = true;
      G.selfAlive = true;
      if (!local.avatar) {
        local.avatar = buildAvatar(local.color, d.name);
        actorGroup.add(local.avatar.group);
      }
    }
    updateSpectatorUI();
    updateRoster();
    G.started = true;
  });

  socket.on('phase', (meta) => applyMeta(meta));

  socket.on('round_start', (d) => {
    dom.result.classList.remove('show');
    G.steppedTiles.clear();
    syncPlayers(d.players);
    const me = d.players.find((p) => p.id === G.selfId);
    if (me && G.role === 'player') {
      local.pos.set(me.pos.x, me.pos.y, me.pos.z);
      local.vel.set(0, 0, 0);
      local.alive = true;
      local.layer = 3;
      local.anim = 'idle';
      G.selfAlive = true;
      if (local.avatar) {
        local.avatar.squash.rotation.set(0, 0, 0);
        local.avatar.squash.position.y = 0;
        local.avatar.landSquash = 0;
      }
    }
    updateSpectatorUI();
    toast('심사 개시 — 바닥이 무너집니다', 'obstacle');
  });

  socket.on('map_reset', (d) => {
    dom.result.classList.remove('show');
    for (const id of [...G.boosters.keys()]) removeBooster(id);
    for (const id of [...G.obstacles.keys()]) removeObstacle(id);
    G.steppedTiles.clear();
    G.map = d.map;
    buildMap(d.map, mapCfg());
    syncPlayers(d.players);
    applyMeta(d.meta);
    const mine = d.players.find((p) => p.id === G.selfId);
    if (mine) {
      // 관전자였다가 이번 회차에 주자로 승격된 경우도 여기서 처리됩니다.
      G.role = 'player';
      local.alive = true;
      G.selfAlive = true;
      local.color = mine.color;
      local.pos.set(mine.pos.x, mine.pos.y, mine.pos.z);
      local.vel.set(0, 0, 0);
      local.layer = 3;
      local.anim = 'idle';
      if (!local.avatar) {
        local.avatar = buildAvatar(local.color, safeName(mine.name, G.name));
        actorGroup.add(local.avatar.group);
      }
      local.avatar.squash.rotation.set(0, 0, 0);
      local.avatar.squash.position.y = 0;
      local.avatar.squash.scale.set(1, 1, 1);
      local.avatar.landSquash = 0;
    } else {
      G.role = 'spectator';
    }
    updateSpectatorUI();
  });

  socket.on('player_joined', (p) => {
    if (!p || !p.id || p.id === G.selfId) return;
    p.name = safeName(p.name);
    if (!G.players.has(p.id)) G.players.set(p.id, new RemoteRunner(p));
    updateRoster(); updateSpectatorUI();
    toast(p.name + ' 님이 출원했습니다');
  });

  socket.on('player_left', (p) => {
    const r = G.players.get(p.id);
    if (r) { r.dispose(); G.players.delete(p.id); }
    updateRoster(); updateSpectatorUI();
  });

  socket.on('spectator_joined', (s) => {
    if (!s) return;
    toast(safeName(s.name) + ' 님이 관전을 시작했습니다');
  });

  socket.on('state', (snap) => {
    const now = performance.now();
    for (const s of snap.players) {
      if (s.id === G.selfId) continue;         // never overwrite local prediction
      let r = G.players.get(s.id);
      if (!r) continue;
      r.push(s, now);
      r.alive = !!s.al;
      r.layer = s.l;
    }
  });

  socket.on('tile_warn', (d) => {
    const rec = G.tiles.get(d.tileId);
    if (rec) startWarn(rec, d.fuse);
  });

  socket.on('tile_break', (d) => breakTile(G.tiles.get(d.tileId)));

  socket.on('booster_spawn', (e) => {
    spawnBooster(e);
    if (G.role === 'spectator') G.cheerReadyAt = performance.now() + (G.cfg.BOOSTER_COOLDOWN_MS || 9000);
  });
  socket.on('booster_expire', (e) => removeBooster(e.id));

  socket.on('obstacle_drop', (e) => {
    spawnObstacle(e);
    if (G.role === 'spectator') G.dropReadyAt = performance.now() + (G.cfg.OBSTACLE_COOLDOWN_MS || 12000);
  });
  socket.on('obstacle_impact', (e) => { /* tile break arrives via tile_warn/break */ });

  socket.on('eliminated', (d) => {
    const r = G.players.get(d.id);
    if (r) r.alive = false;
    if (d.id !== G.selfId) toast(safeName(d.name) + ' 님 탈락 · ' + d.placement + '위', 'kill');
    updateRoster(); updateSpectatorUI();
  });

  socket.on('game_over', (d) => { showResult(d); updateRoster(); });

  socket.on('toast', (d) => toast(d.text, d.kind));
  socket.on('chat', (d) => toast(safeName(d.name) + ': ' + d.text));

  socket.on('action_denied', (d) => {
    const s = Math.ceil(d.retryInMs / 1000);
    toast('재사용까지 ' + s + '초 남았습니다');
  });

  socket.on('disconnect', (reason) => {
    dom.vRoom.textContent = '연결끊김';
    toast('서버 연결이 끊어졌습니다 — 재연결 중 (' + reason + ')', 'kill');
  });

  /* 연결 자체가 안 되는 상황을 조용히 넘기지 않고 화면에 알립니다.
   * 예전에는 아무 표시 없이 로스터가 "대기 중…" 으로 멈춰 있어서
   * 서버가 죽은 것인지 매칭 대기인지 구분할 수 없었습니다.                  */
  let connectFails = 0;
  socket.on('connect_error', (err) => {
    connectFails++;
    dom.vRoom.textContent = '연결실패';
    dom.vPing.textContent = '— ms';
    dom.vPing.classList.add('bad');
    if (connectFails === 1 || connectFails % 5 === 0) {
      toast('서버에 연결할 수 없습니다 (' + (err && err.message ? err.message : 'unknown') + ') — 재시도 ' + connectFails + '회', 'kill');
    }
    console.error('[IPG] socket connect_error #' + connectFails + ':', err);
  });

  socket.io.on('reconnect', (n) => toast('서버에 다시 연결되었습니다 (' + n + '회 시도)'));
}

function applyMeta(meta) {
  if (!meta) return;
  G.phase = meta.phase;
  G.phaseEndsAt = meta.phaseEndsAt;
  dom.vAlive.textContent = meta.alive + '/' + meta.total;
  dom.vSpec.textContent = meta.spectators;
  dom.vRoom.textContent = meta.roomId || G.roomId;
}

function syncPlayers(list) {
  const seen = new Set();
  for (const p of list) {
    seen.add(p.id);
    if (p.id === G.selfId) {
      G.players.set(p.id, Object.assign(G.players.get(p.id) || {}, {
        id: p.id, name: p.name, color: p.color, alive: p.alive, layer: p.layer, isSelf: true,
        render: local.pos
      }));
      continue;
    }
    let r = G.players.get(p.id);
    if (!r || !(r instanceof RemoteRunner)) {
      if (r && r.dispose) r.dispose();
      r = new RemoteRunner(p);
      G.players.set(p.id, r);
    } else {
      r.alive = p.alive;
      r.layer = p.layer;
    }
  }
  for (const [id, r] of [...G.players]) {
    if (!seen.has(id)) { if (r.dispose) r.dispose(); G.players.delete(id); }
  }
  updateRoster();
}

/* ============================ 15. main loop =========================== */

let lastTime = performance.now();
let accumulator = 0;
let sendAccum = 0;
let fpsAccum = 0, fpsFrames = 0;

function frame() {
  requestAnimationFrame(frame);
  const now = performance.now();
  let dt = (now - lastTime) / 1000;
  lastTime = now;
  if (dt > 0.25) dt = 0.25;

  /* --- fixed-step physics for the local runner --- */
  if (G.started && G.role === 'player' && local.alive && G.phase === 'playing') {
    accumulator += dt;
    let guard = 0;
    while (accumulator >= PHYS.STEP && guard++ < 8) {
      stepPhysics(PHYS.STEP);
      accumulator -= PHYS.STEP;
    }
  } else {
    accumulator = 0;
  }

  /* --- local avatar --- */
  if (local.avatar) {
    local.avatar.group.position.copy(local.pos);
    const sp = THREE.MathUtils.clamp(Math.hypot(local.vel.x, local.vel.z) / PHYS.SPRINT, 0, 1);
    animateAvatar(local.avatar, dt, sp, local.alive ? local.anim : 'dead', local.ry);
    local.avatar.group.visible = true;
    updateGroundShadow(local.avatar, local.pos.y, groundYUnder(local.pos.x, local.pos.z, local.pos.y), local.grounded);
  }

  /* --- remote runners (dead reckoning) --- */
  for (const r of G.players.values()) if (r instanceof RemoteRunner) r.update(dt, now);

  /* --- world --- */
  updateTiles(dt, now);
  updateDebris(dt);
  updateBoosters(dt, now);
  updateObstacles(dt, now);
  updateCamera(dt);

  // lava surface ripple
  const pos = lavaMesh.geometry.attributes.position;
  for (let i = 0; i < pos.count; i++) {
    const bx = lavaBase[i * 3], by = lavaBase[i * 3 + 1];
    pos.array[i * 3 + 2] = Math.sin(bx * 0.06 + now * 0.0011) * 1.1 + Math.cos(by * 0.07 + now * 0.0014) * 1.1;
  }
  pos.needsUpdate = true;
  lavaMat.emissiveIntensity = 1.25 + Math.sin(now * 0.002) * 0.35;

  /* --- 20Hz uplink --- */
  if (G.started && G.socket && G.role === 'player' && local.alive) {
    sendAccum += dt;
    if (sendAccum >= 1 / NET.SEND_HZ) {
      sendAccum = 0;
      G.socket.emit('player_state', {
        p: [local.pos.x, local.pos.y, local.pos.z],
        v: [local.vel.x, local.vel.y, local.vel.z],
        ry: local.ry,
        layer: local.layer,
        anim: local.anim
      });
    }
  }

  /* --- HUD --- */
  updateLayerStack(local.alive ? local.layer : currentLayerOf(spectateFocus().y));
  updateCountdown();
  updateActionCooldowns(now);

  fpsAccum += dt; fpsFrames++;
  if (fpsAccum >= 0.5) {
    dom.vFps.textContent = Math.round(fpsFrames / fpsAccum);
    fpsAccum = 0; fpsFrames = 0;
    updateRoster();
  }

  renderer.render(scene, camera);
}

/* ============================ 15.5 진단 패널 ========================== */
/* 연결이 안 되거나 라운드가 시작되지 않을 때, 어느 단계에서 막혔는지
 * 즉시 확인할 수 있게 합니다. F2 로 토글. join 후 5초간 init 이 오지
 * 않으면 자동으로 펼쳐집니다.                                             */
const diagEl = document.getElementById('diag');
const diagBody = document.getElementById('diagBody');
let diagAuto = false;

function renderDiag() {
  if (!diagEl.classList.contains('show')) return;
  const s = G.socket;
  const conn = s && s.connected;
  const tr = conn && s.io && s.io.engine ? s.io.engine.transport.name : '—';
  const row = (label, ok, val) =>
    '<div>' + label.padEnd(14, ' ').replace(/ /g, '&nbsp;') +
    '<span class="' + (ok === true ? 'ok' : ok === false ? 'no' : 'wa') + '">' + val + '</span></div>';

  diagBody.innerHTML =
    row('socket.io', typeof io !== 'undefined', typeof io !== 'undefined' ? '로드됨' : '없음') +
    row('연결', !!conn, conn ? '연결됨 / ' + tr : '끊김') +
    row('init 수신', G.started, G.started ? '완료' : '대기중') +
    row('룸', !!G.roomId && G.roomId !== '—', G.roomId) +
    row('내 역할', null, G.role) +
    row('타일', G.tiles.size > 0, G.tiles.size + '개') +
    row('주자', null, G.players.size + '명') +
    row('phase', null, G.phase) +
    row('내 아바타', !!local.avatar, local.avatar ? '생성됨' : '없음') +
    row('WebGL', true, renderer.capabilities.isWebGL2 ? 'WebGL2' : 'WebGL1');
}

window.addEventListener('keydown', (e) => {
  if (e.code === 'F2') { e.preventDefault(); diagEl.classList.toggle('show'); renderDiag(); }
});
setInterval(renderDiag, 500);

/* ============================ 16. boot ================================ */

let joinMode = 'player';
document.querySelectorAll('.mode').forEach((b) => {
  b.addEventListener('click', () => {
    document.querySelectorAll('.mode').forEach((x) => x.classList.remove('sel'));
    b.classList.add('sel');
    joinMode = b.dataset.mode;
  });
});

dom.nameInput.value = '심사관' + Math.floor(Math.random() * 900 + 100);


dom.btnJoin.addEventListener('click', () => {
  if (typeof io === 'undefined') {
    alert('socket.io 클라이언트를 불러오지 못했습니다.\n\n' +
          '이 페이지는 반드시 게임 서버(기본 http://localhost:3000)를 통해 열어야 합니다.\n' +
          'index.html 파일을 직접 열거나 다른 포트의 정적 서버로 열면 동작하지 않습니다.');
    return;
  }
  const name = (dom.nameInput.value || '').trim() || '익명출원인';
  dom.joinScreen.classList.remove('show');
  G.role = joinMode;
  connect(name, joinMode);
  updateSpectatorUI();

  // 5초 안에 init 이 안 오면 진단 패널을 자동으로 펼칩니다.
  setTimeout(() => {
    if (!G.started && !diagAuto) {
      diagAuto = true;
      diagEl.classList.add('show');
      renderDiag();
      toast('서버 응답이 없습니다 — 좌하단 진단 패널을 확인하세요', 'kill');
    }
  }, 5000);
});

dom.nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') dom.btnJoin.click(); });

frame();
</script>
</body>
</html>
