/* ============================ 4. map building ========================== */

const LAYER_COLORS = { 3: 0x00ffcc, 2: 0x0088ff, 1: 0xaa00ff };
const TRAP_COLOR = 0x6b0d12;

let hexGeo = null, trapGeo = null;

function mapCfg() {
  const c = G.cfg || {};
  return {
    HEX_SIZE: c.HEX_SIZE || 3.2,
    HEX_THICKNESS: c.HEX_THICKNESS || 1.0,
    LAVA_Y: (c.LAVA_Y !== undefined ? c.LAVA_Y : -20),
    LAYERS: c.LAYERS || [{ index: 3, y: 30 }, { index: 2, y: 15 }, { index: 1, y: 0 }]
  };
}

function buildMap(map, cfg) {
  lastTransparencyLayer = -1;
  // clear previous map
  for (const rec of G.tiles.values()) {
    tileGroup.remove(rec.mesh);
    rec.mesh.geometry = null;
    rec.mesh.material.dispose();
  }
  G.tiles.clear();
  G.layerTiles = { 1: [], 2: [], 3: [] };

  G.hexSize = cfg.HEX_SIZE;
  G.hexThick = cfg.HEX_THICKNESS;
  G.lavaY = cfg.LAVA_Y;
  lavaMesh.position.y = cfg.LAVA_Y;
  lavaGlow.position.y = cfg.LAVA_Y + 0.8;
  lavaLight.position.y = cfg.LAVA_Y + 6;
  for (const L of cfg.LAYERS) G.layerY[L.index] = L.y;

  if (!hexGeo) {
    hexGeo = new THREE.CylinderGeometry(G.hexSize * 0.965, G.hexSize * 0.9, G.hexThick, 6, 1);
    trapGeo = new THREE.CylinderGeometry(G.hexSize * 0.965, G.hexSize * 0.9, G.hexThick * 1.12, 6, 1);
  }

  // AABB half-extents of a flat-top hexagon: adjacent boxes overlap in X and
  // touch exactly in Z, so the plane is fully covered — no fall-through gaps.
  const halfX = G.hexSize;
  const halfZ = G.hexSize * Math.sqrt(3) / 2;

  for (const t of map.tiles) {
    const base = t.trap ? TRAP_COLOR : LAYER_COLORS[t.layer];
    const mat = new THREE.MeshStandardMaterial({
      color: base,
      emissive: t.trap ? 0x330000 : base,
      emissiveIntensity: t.trap ? 0.5 : 0.22,
      roughness: t.trap ? 0.85 : 0.55,
      metalness: t.trap ? 0.1 : 0.22,
      transparent: true,
      opacity: 1
    });
    if (TEX.road) mat.map = TEX.road;

    const mesh = new THREE.Mesh(t.trap ? trapGeo : hexGeo, mat);
    mesh.position.set(t.x, t.y, t.z);
    mesh.receiveShadow = true;
    mesh.castShadow = false;
    tileGroup.add(mesh);

    const rec = {
      id: t.id, layer: t.layer, trap: !!t.trap,
      x: t.x, y: t.y, z: t.z,
      top: t.y + G.hexThick / 2,
      minX: t.x - halfX, maxX: t.x + halfX,
      minZ: t.z - halfZ, maxZ: t.z + halfZ,
      state: 'idle', warnStart: 0, fuse: 800, breakStart: 0,
      mesh, mat, baseColor: new THREE.Color(base), baseY: t.y
    };
    G.tiles.set(t.id, rec);
    G.layerTiles[t.layer].push(rec);
  }
  applyLayerTransparency(3);
}

/* Upper floors turn translucent once the runner drops below them, so the
 * camera never has an opaque ceiling between it and the player.            */
let lastTransparencyLayer = -1;
function applyLayerTransparency(currentLayer) {
  if (currentLayer === lastTransparencyLayer) return;
  lastTransparencyLayer = currentLayer;
  for (const L of [1, 2, 3]) {
    const target = L > currentLayer ? 0.16 : 1.0;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      rec.targetOpacity = target;
    }
  }
}


/* ============================ 4.5 오디오 =============================== *
 * 배경음 + 효과음 관리자.
 *
 *  · 브라우저 자동재생 정책 때문에 첫 사용자 클릭(참가 버튼) 전에는 소리를
 *    낼 수 없습니다. 그래서 join 시점에 unlock() 을 호출합니다.
 *  · 배경음은 HTMLAudioElement 로 스트리밍(mp3 전체를 받지 않아도 시작),
 *    효과음은 Web Audio 버퍼로 재생(지연 없음 + 동시에 여러 개 겹침).
 *  · 파일이 없으면 조용히 넘어갑니다. 오디오 때문에 게임이 멈추지 않습니다.
 *  · 배경음 교체: 아래 BGM 경로만 바꾸면 됩니다.
 *  · 효과음 추가: SFX 에 한 줄 추가하고 Sound.sfx('이름') 을 호출하면 됩니다.
 * ======================================================================= */

/* 게임 상황별 배경음. 지금은 한 파일을 공유합니다.
 * 상황별로 다른 곡을 쓰려면 경로만 나눠 주세요.
 * (같은 경로면 상황이 바뀌어도 끊기지 않고 계속 재생됩니다)             */
const BGM = {
  lobby:  'assets/audio/bgm_main.mp3',   // 대기 / 카운트다운
  play:   'assets/audio/bgm_main.mp3',   // 라운드 진행 중
  result: 'assets/audio/bgm_main.mp3'    // 결과 화면
};

/* 효과음. { 경로, 볼륨 } — 파일이 없으면 그냥 무시됩니다. */
const SFX = {
  start:     { src: 'assets/audio/sfx_start.mp3',     volume: 0.9 },
  tick:      { src: 'assets/audio/sfx_tick.mp3',      volume: 0.6 },
  step:      { src: 'assets/audio/sfx_step.mp3',      volume: 0.5 },
  crack:     { src: 'assets/audio/sfx_crack.mp3',     volume: 0.7 },
  jump:      { src: 'assets/audio/sfx_jump.mp3',      volume: 0.6 },
  land:      { src: 'assets/audio/sfx_land.mp3',      volume: 0.5 },
  death:     { src: 'assets/audio/sfx_death.mp3',     volume: 0.9 },
  eliminate: { src: 'assets/audio/sfx_eliminate.mp3', volume: 0.7 },
  booster:   { src: 'assets/audio/sfx_booster.mp3',   volume: 0.8 },
  obstacle:  { src: 'assets/audio/sfx_obstacle.mp3',  volume: 0.7 },
  impact:    { src: 'assets/audio/sfx_impact.mp3',    volume: 0.8 },
  win:       { src: 'assets/audio/sfx_win.mp3',       volume: 1.0 },
  lose:      { src: 'assets/audio/sfx_lose.mp3',      volume: 0.9 }
};

const Sound = {
  ctx: null,
  master: null, bgmGain: null, sfxGain: null,
  el: null, elSrc: null,          // 현재 재생 중인 배경음
  elNext: null, nextSrc: null,    // 크로스페이드 대상
  buffers: {},                    // 디코딩된 효과음
  missing: {},                    // 없는 파일 (재시도 방지)
  unlocked: false,
  muted: false,
  vol: { master: 0.8, bgm: 0.45, sfx: 0.85 },
  fadeTimer: null,

  /* 설정 저장/복원 (실패해도 무시) */
  load() {
    try {
      const raw = localStorage.getItem('ipg_audio');
      if (raw) {
        const s = JSON.parse(raw);
        if (s && s.vol) Object.assign(this.vol, s.vol);
        this.muted = !!(s && s.muted);
      }
    } catch (e) { /* 저장소를 못 쓰는 환경 */ }
  },
  save() {
    try {
      localStorage.setItem('ipg_audio', JSON.stringify({ vol: this.vol, muted: this.muted }));
    } catch (e) { /* 무시 */ }
  },

  /* 첫 사용자 제스처에서 호출해야 소리가 납니다 */
  unlock() {
    if (this.unlocked) return;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) { this.unlocked = true; return; }   // Web Audio 미지원이어도 배경음은 동작
    try {
      this.ctx = new AC();
      this.master = this.ctx.createGain();
      this.bgmGain = this.ctx.createGain();
      this.sfxGain = this.ctx.createGain();
      this.bgmGain.connect(this.master);
      this.sfxGain.connect(this.master);
      this.master.connect(this.ctx.destination);
      this.applyVolume();
      if (this.ctx.state === 'suspended') this.ctx.resume();
    } catch (e) {
      console.warn('[IPG] 오디오 초기화 실패:', e && e.message);
      this.ctx = null;
    }
    this.unlocked = true;
    for (const key of Object.keys(SFX)) this.preload(key);
  },

  applyVolume() {
    const m = this.muted ? 0 : this.vol.master;
    if (this.master) this.master.gain.value = m;
    if (this.sfxGain) this.sfxGain.gain.value = this.vol.sfx;
    if (this.el) this.el.volume = Math.min(1, m * this.vol.bgm);
    if (this.elNext) this.elNext.volume = 0;
  },

  setVolume(kind, value) {
    this.vol[kind] = Math.max(0, Math.min(1, value));
    this.applyVolume();
    this.save();
  },

  toggleMute() {
    this.muted = !this.muted;
    this.applyVolume();
    if (!this.muted && this.el && this.el.paused) this.el.play().catch(() => {});
    this.save();
    return this.muted;
  },

  /* ---------------- 배경음 ---------------- */
  playBgm(phaseKey) {
    if (!this.unlocked) return;
    const src = BGM[phaseKey] || BGM.play;
    if (!src || this.missing[src]) return;
    if (this.elSrc === src && this.el && !this.el.paused) return;   // 같은 곡이면 유지

    const next = new Audio(src);
    next.loop = true;
    next.volume = 0;
    next.preload = 'auto';
    next.addEventListener('error', () => {
      this.missing[src] = true;
      console.warn('[IPG] 배경음 파일이 없습니다: ' + src);
      if (this.elNext === next) { this.elNext = null; this.nextSrc = null; }
    });

    const started = next.play();
    if (started && started.catch) {
      started.catch((err) => {
        // 자동재생 차단 등. 다음 클릭에서 다시 시도합니다.
        console.warn('[IPG] 배경음 재생 보류:', err && err.name);
      });
    }

    this.elNext = next;
    this.nextSrc = src;
    this.crossfade(900);
  },

  crossfade(ms) {
    if (this.fadeTimer) clearInterval(this.fadeTimer);
    const from = this.el, to = this.elNext;
    const target = this.muted ? 0 : this.vol.master * this.vol.bgm;
    const t0 = performance.now();
    this.fadeTimer = setInterval(() => {
      const k = Math.min(1, (performance.now() - t0) / ms);
      if (to) { try { to.volume = target * k; } catch (e) {} }
      if (from) { try { from.volume = target * (1 - k); } catch (e) {} }
      if (k >= 1) {
        clearInterval(this.fadeTimer);
        this.fadeTimer = null;
        if (from) { try { from.pause(); from.src = ''; } catch (e) {} }
        this.el = to;
        this.elSrc = this.nextSrc;
        this.elNext = null;
        this.nextSrc = null;
      }
    }, 40);
  },

  stopBgm() {
    if (this.fadeTimer) { clearInterval(this.fadeTimer); this.fadeTimer = null; }
    for (const a of [this.el, this.elNext]) {
      if (a) { try { a.pause(); a.src = ''; } catch (e) {} }
    }
    this.el = this.elNext = null;
    this.elSrc = this.nextSrc = null;
  },

  /* ---------------- 효과음 ---------------- */
  preload(key) {
    const def = SFX[key];
    if (!def || !this.ctx || this.buffers[key] || this.missing[def.src]) return;
    fetch(def.src)
      .then((r) => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.arrayBuffer(); })
      .then((buf) => new Promise((res, rej) => {
        // 구형 문법 콜백까지 지원
        const p = this.ctx.decodeAudioData(buf, res, rej);
        if (p && p.then) p.then(res, rej);
      }))
      .then((decoded) => { this.buffers[key] = decoded; })
      .catch(() => { this.missing[def.src] = true; });
  },

  /**
   * 효과음 재생.
   *   opts.pos   : {x,y,z} 를 주면 카메라와의 거리로 음량을 줄입니다
   *   opts.rate  : 재생 속도(피치). 0.9~1.1 로 흔들면 반복이 덜 지루합니다
   *   opts.volume: 추가 배율
   */
  sfx(key, opts) {
    if (!this.unlocked || this.muted || !this.ctx) return;
    const def = SFX[key];
    const buf = this.buffers[key];
    if (!def || !buf) return;

    let vol = def.volume * (opts && opts.volume !== undefined ? opts.volume : 1);
    if (opts && opts.pos) {
      const d = Math.hypot(opts.pos.x - camTarget.x, opts.pos.y - camTarget.y, opts.pos.z - camTarget.z);
      vol *= Math.max(0, 1 - d / 60);
      if (vol <= 0.01) return;
    }

    try {
      const src = this.ctx.createBufferSource();
      src.buffer = buf;
      src.playbackRate.value = (opts && opts.rate) || 1;
      const g = this.ctx.createGain();
      g.gain.value = vol;
      src.connect(g);
      g.connect(this.sfxGain);
      src.start(0);
    } catch (e) { /* 재생 실패는 무시 */ }
  }
};
Sound.load();

/* ============================ 5. 3D 캐릭터 ============================== *
 * 두 가지 경로를 지원합니다.
 *
 *  A) assets/character.glb 가 있으면 → 진짜 3D 모델 + 스켈레탈 애니메이션
 *  B) 없으면 → 절차적 3D 치비 캐릭터 (지오메트리로 조립, 에셋 불필요)
 *
 * 두 경로 모두 동일한 인터페이스를 노출하므로 나머지 코드는 신경 쓰지 않습니다.
 * ======================================================================== */

function makeNameplate(text, colorHex) {
  const c = document.createElement('canvas');
  c.width = 320; c.height = 84;
  const g = c.getContext('2d');
  g.fillStyle = 'rgba(5,6,10,0.78)';
  g.fillRect(0, 18, 320, 48);
  g.fillStyle = colorHex;
  g.fillRect(0, 18, 5, 48);
  g.font = '700 30px "Noto Sans KR", sans-serif';
  g.fillStyle = '#ece7d8';
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.fillText(text, 164, 43);
  const tex = new THREE.CanvasTexture(c);
  tex.encoding = THREE.sRGBEncoding;
  const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false }));
  spr.scale.set(7.2, 1.9, 1);
  spr.renderOrder = 999;
  return spr;
}

/* ---------------------------------------------------------------------------
 * A) GLB 3D 모델 파이프라인
 * ------------------------------------------------------------------------- */
const CHAR = { ready: false, scene: null, clips: {}, scale: 1,
               yOffset: 0, xOffset: 0, zOffset: 0, error: null };

const MODEL_PATH   = 'assets/character.glb';
const MODEL_HEIGHT = 3.30;   // 이 키에 맞춰 자동 스케일. 발끝은 자동으로 y=0
/* Z-up 으로 저장된 모델(누워서 나옴)이면 -Math.PI/2 로 바꾸세요.
 * 콘솔에 "모델이 누워 있는 것 같습니다" 경고가 뜨면 이 값입니다.        */
const MODEL_ROTATION_X = 0;
/* 0 이면 자동 측정. 자동이 실패할 때만 배율을 직접 넣으세요.
 * 콘솔에 "모델 크기를 잴 수 없습니다" 가 뜨면 이 값을 씁니다.            */
const MODEL_SCALE = 0;
/* 애니메이션 클립을 순서로 직접 지정합니다. null 이면 자동.
 * Blender 로 합치면 이름이 전부 'mixamo.com' 이 되어 구분이 안 되므로,
 * 게임에서 동작이 뒤바뀌어 보이면 여기 숫자를 조정하세요.
 *   예: const MODEL_CLIP_INDEX = { idle: 0, run: 1, jump: 2, dead: 3 };   */
const MODEL_CLIP_INDEX = null;

/* Mixamo / Meshy 는 클립 이름이 제각각이라 후보를 넉넉히 둡니다.
 * MODEL_CLIP_ORDER 순서로 배정하며, 배정된 클립은 후보 풀에서 빠집니다.
 * (그래야 "Falling Back Death" 가 fall 로 잘못 잡히지 않습니다)            */
const MODEL_CLIPS = {
  dead: ['death', 'dying', 'die', 'knocked out', 'falling back death', 'dead'],
  run:  ['running', 'run', 'jog', 'sprint', 'fast run'],
  jump: ['jumping', 'jump up', 'jump'],
  fall: ['falling idle', 'falling', 'fall'],
  idle: ['breathing idle', 'idle', 'standing', 'stand', 'tpose', 't-pose']
};
const MODEL_CLIP_ORDER = ['dead', 'run', 'jump', 'fall', 'idle'];

function pickClip(animations, candidates) {
  const lower = animations.map(a => ({ a, n: a.name.toLowerCase() }));
  for (const c of candidates) {
    const hit = lower.find(x => x.n === c);
    if (hit) return hit.a;
  }
  for (const c of candidates) {
    const hit = lower.find(x => x.n.includes(c));
    if (hit) return hit.a;
  }
  return null;
}

/* ---------------------------------------------------------------------------
 * 모델 실측 — 스킨드 메시는 지오메트리 바운딩박스가 실제 렌더 크기와 다릅니다.
 * (bindMatrix / bindMatrixInverse 때문에 노드 스케일이 상쇄되기도 하고,
 *  Blender 익스포트가 정점에 스케일을 구워 넣기도 합니다)
 * 그래서 boneTransform 으로 실제 스키닝된 정점 위치를 계산해 측정합니다.
 * 이 값이 화면에 그려지는 크기와 정확히 일치합니다.
 * ------------------------------------------------------------------------- */
function fmtDim(v) {
  const f = (n) => (Math.abs(n) >= 0.01 || n === 0) ? n.toFixed(2) : n.toExponential(2);
  return f(v.x) + ' x ' + f(v.y) + ' x ' + f(v.z);
}

function measureObject(obj) {
  obj.updateMatrixWorld(true);
  const box = new THREE.Box3();
  const v = new THREE.Vector3();
  let sampled = 0;

  obj.traverse((o) => {
    if (o.isSkinnedMesh && o.geometry && o.skeleton && typeof o.boneTransform === 'function') {
      if (o.skeleton.update) o.skeleton.update();
      const pos = o.geometry.attributes.position;
      if (!pos) return;
      const step = Math.max(1, Math.floor(pos.count / 600));   // 메시당 최대 600점 샘플
      for (let i = 0; i < pos.count; i += step) {
        o.boneTransform(i, v);
        v.applyMatrix4(o.matrixWorld);
        box.expandByPoint(v);
        sampled++;
      }
    } else if (o.isMesh && o.geometry) {
      if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
      if (o.geometry.boundingBox) {
        box.union(o.geometry.boundingBox.clone().applyMatrix4(o.matrixWorld));
        sampled++;
      }
    }
  });

  const size = box.isEmpty() ? new THREE.Vector3() : box.getSize(new THREE.Vector3());
  return { box, size, sampled, valid: sampled > 0 && isFinite(size.y) && size.y > 1e-9 };
}

function loadCharacterModel() {
  if (typeof THREE.GLTFLoader !== 'function') {
    console.warn('[IPG] GLTFLoader 미로드 — 절차적 캐릭터를 사용합니다');
    return;
  }
  const loader = new THREE.GLTFLoader();

  /* Sketchfab 다운로드는 Draco 압축인 경우가 많습니다.
   * DRACOLoader 가 있으면 붙여 줍니다 (없어도 비압축 모델은 정상 동작).  */
  if (typeof THREE.DRACOLoader === 'function') {
    const draco = new THREE.DRACOLoader();
    draco.setDecoderPath('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/libs/draco/');
    loader.setDRACOLoader(draco);
  }

  loader.load(
    MODEL_PATH,
    (gltf) => {
      try {
        applyLoadedModel(gltf);
      } catch (err) {
        console.error('[IPG] 모델 적용 실패:', err);
        CHAR.ready = false;
      }
    },
    undefined,
    (err) => {
      // 조용히 넘기지 않습니다. 파일이 있는데 실패한 것인지 구분되어야 합니다.
      console.warn('[IPG] character.glb 를 불러오지 못했습니다 — 절차적 캐릭터를 사용합니다.',
        (err && (err.message || err.type)) || err);
      CHAR.error = String((err && (err.message || err.type)) || 'not found');
    }
  );
}

function applyLoadedModel(gltf) {
  const root = gltf.scene || (gltf.scenes && gltf.scenes[0]);
  if (!root) { console.warn('[IPG] GLB 에 scene 이 없습니다'); return; }

  /* 모델 자신의 트랜스폼(스케일/회전/위치)은 절대 건드리지 않습니다.
   * Sketchfab 모델은 루트에 0.01 같은 스케일을 갖고 있는 경우가 많아서,
   * 여기를 덮어쓰면 모델이 수백 배로 커지거나 화면 밖으로 나갑니다.
   * 대신 바깥에 컨테이너를 하나 씌우고 거기에만 보정을 겁니다.          */
  if (MODEL_ROTATION_X) root.rotation.x += MODEL_ROTATION_X;
  root.updateMatrixWorld(true);

  /* 여기서 재는 값은 참고용입니다. 최종 배율은 아바타를 조립한 뒤
   * 실제 월드 크기를 다시 재서 보정하므로(fitAvatarScale), 이 단계에서
   * 조금 틀려도 결과는 정확합니다.                                       */
  const m = measureObject(root);
  CHAR.measure = m;
  CHAR.scale = (m.valid && m.size.y > 1e-9) ? (MODEL_HEIGHT / m.size.y) : 1;
  CHAR.yOffset = 0;
  CHAR.xOffset = 0;
  CHAR.zOffset = 0;

  let meshCount = 0, skinned = 0;
  root.traverse((o) => {
    if (!o.isMesh && !o.isSkinnedMesh) return;
    meshCount++;
    if (o.isSkinnedMesh) skinned++;
    o.castShadow = true;
    o.receiveShadow = false;
    o.frustumCulled = false;
    o.visible = true;
    const mats = Array.isArray(o.material) ? o.material : [o.material];
    mats.forEach((m) => {
      if (!m) return;
      if (m.map) m.map.encoding = THREE.sRGBEncoding;
      // 완전 투명하게 저장된 머티리얼을 되살립니다 (간혹 이런 모델이 있습니다)
      if (m.transparent && m.opacity === 0) { m.opacity = 1; m.transparent = false; }
      m.side = THREE.FrontSide;
      m.depthWrite = true;
    });
  });

  const allAnims = (gltf.animations || []).slice();
  let pool = allAnims.slice();
  let matchedByName = 0;
  for (const key of MODEL_CLIP_ORDER) {
    const clip = pickClip(pool, MODEL_CLIPS[key]);
    if (!clip) continue;
    CHAR.clips[key] = clip;
    pool = pool.filter((c) => c !== clip);
    matchedByName++;
  }

  /* Blender 로 합치면 클립 이름이 전부 'mixamo.com' / 'mixamo.com.001' 처럼
   * 나오는 경우가 많습니다. 이러면 이름으로는 구분이 불가능하므로
   * 순서(인덱스) 기준으로 배정합니다. MODEL_CLIP_INDEX 로 직접 지정할 수도
   * 있습니다.                                                             */
  const namesUseless = allAnims.length >= 2 &&
    (matchedByName <= 1 || allAnims.every((a) => /^mixamo\.com/i.test(a.name)));

  if (MODEL_CLIP_INDEX) {
    CHAR.clips = {};
    for (const key of Object.keys(MODEL_CLIP_INDEX)) {
      const idx = MODEL_CLIP_INDEX[key];
      if (allAnims[idx]) CHAR.clips[key] = allAnims[idx];
    }
    CHAR.clipMode = '수동 지정 (MODEL_CLIP_INDEX)';
  } else if (namesUseless) {
    CHAR.clips = {};
    const order = ['idle', 'run', 'jump', 'dead'];
    allAnims.forEach((clip, i) => { if (order[i]) CHAR.clips[order[i]] = clip; });
    CHAR.clipMode = '순서 기준 (이름으로 구분 불가)';
    console.warn(
      '[IPG] 애니메이션 이름이 전부 비슷해서(' + allAnims.map((a) => a.name).join(', ') + ') ' +
      '순서대로 배정했습니다: ' +
      Object.keys(CHAR.clips).map((k, i) => k + '=' + i + '번').join(', ') + '\n' +
      '  순서가 다르면 index.html 에서 이렇게 지정하세요:\n' +
      '  const MODEL_CLIP_INDEX = { idle: 0, run: 1, jump: 2, dead: 3 };'
    );
  } else {
    CHAR.clipMode = '이름 기준';
  }
  /* 남은 구멍 메우기.
   * 애니메이션이 하나도 없는 모델(Sketchfab 다수)에서 undefined 가
   * 클립 맵에 들어가면 이후 전부 터지므로, 값이 있을 때만 채웁니다.     */
  const anims = gltf.animations || [];
  if (!CHAR.clips.idle && anims.length) CHAR.clips.idle = anims[0];
  const fill = (key, src) => { if (!CHAR.clips[key] && src) CHAR.clips[key] = src; };
  fill('fall', CHAR.clips.jump || CHAR.clips.idle);
  fill('jump', CHAR.clips.fall || CHAR.clips.idle);
  fill('run',  CHAR.clips.idle);
  for (const k of Object.keys(CHAR.clips)) {
    if (!CHAR.clips[k]) delete CHAR.clips[k];
  }

  if (meshCount === 0) {
    console.warn('[IPG] GLB 에 메시가 없습니다 — 절차적 캐릭터를 유지합니다');
    return;
  }

  CHAR.scene = root;
  CHAR.size = m.size;
  CHAR.meshCount = meshCount;
  CHAR.skinned = skinned;
  CHAR.animNames = anims.map((a) => a.name);
  CHAR.ready = true;

  console.log(
    '[IPG] 3D 캐릭터 로드 완료\n' +
    '  원본 크기 : ' + fmtDim(m.size) + (m.valid ? '' : '  (측정 실패)') + '\n' +
    '  적용 배율 : ' + CHAR.scale.toFixed(4) + '  (목표 키 ' + MODEL_HEIGHT + ')\n' +
    '  메시      : ' + meshCount + '개 (스킨드 ' + skinned + '개)\n' +
    '  애니메이션: ' + (anims.length ? anims.map((a) => a.name).join(', ') : '없음 (정지 자세로 표시됩니다)') + '\n' +
    '  배정 방식 : ' + (CHAR.clipMode || '이름 기준') + '\n' +
    '  매칭 결과 : ' + (Object.keys(CHAR.clips).length
      ? Object.keys(CHAR.clips).map((k) => k + '=' + CHAR.clips[k].name).join(' / ')
      : '없음')
  );

  if (m.valid && m.size.y > 1e-6 && m.size.z > m.size.y * 1.6) {
    console.warn('[IPG] 모델이 누워 있는 것 같습니다 (깊이 > 높이). ' +
      'index.html 의 MODEL_ROTATION_X 를 -Math.PI/2 로 바꿔 보세요.');
  }

  rebuildAllAvatars();
}

/* 모델이 늦게 도착해도 이미 만들어진 캐릭터를 그 자리에서 교체합니다 */
function rebuildAllAvatars() {
  for (const rec of G.players.values()) {
    if (!rec || !rec.avatar || !rec.avatar.group) continue;
    actorGroup.remove(rec.avatar.group);
    rec.avatar = buildAvatar(rec.color, rec.name);
    actorGroup.add(rec.avatar.group);
  }
  if (typeof local !== 'undefined' && local && local.avatar) {
    actorGroup.remove(local.avatar.group);
    local.avatar = buildAvatar(local.color, G.name || '나');
    actorGroup.add(local.avatar.group);
  }
}

function buildAvatar(colorHex, name) {
  return CHAR.ready ? buildModelAvatar(colorHex, name)
                    : buildProceduralAvatar(colorHex, name);
}

function buildModelAvatar(colorHex, name) {
  const group = new THREE.Group();
  const col = new THREE.Color(colorHex);

  const model = (THREE.SkeletonUtils && THREE.SkeletonUtils.clone)
    ? THREE.SkeletonUtils.clone(CHAR.scene)
    : CHAR.scene.clone(true);

  /* 컨테이너에 담아 보정합니다. 모델 자신의 스케일/회전/위치는 그대로 둡니다.
   * (Sketchfab 모델은 루트에 0.01 같은 스케일을 갖고 있는 경우가 많습니다) */
  const holder = new THREE.Group();
  holder.add(model);
  group.add(holder);
  fitAvatarScale(holder);

  /* 머티리얼을 인스턴스마다 복제해 플레이어 색을 입힙니다.
   * 원본 텍스처는 그대로 두고 발광만 물들여 4인을 구분합니다.
   * 머티리얼 이름에 'accent' 가 들어 있으면 완전히 플레이어 색으로 칠합니다. */
  const skinMats = [];
  model.traverse((o) => {
    if (!o.isMesh && !o.isSkinnedMesh) return;
    const src = Array.isArray(o.material) ? o.material : [o.material];
    const cloned = src.map((m) => {
      if (!m) return m;
      const c = m.clone();
      const nm = (c.name || '').toLowerCase();
      if (nm.includes('accent') || nm.includes('suit')) {
        if (c.color) c.color.copy(col);
      }
      if (c.emissive) {
        c.emissive.copy(col).multiplyScalar(0.16);
        c.emissiveIntensity = 1.0;
      }
      skinMats.push(c);
      return c;
    });
    o.material = Array.isArray(o.material) ? cloned : cloned[0];
  });

  const ring = makeColorRing(col);
  group.add(ring);

  const blob = makeShadowBlob();
  group.add(blob);

  const plate = makeNameplate(name, colorHex);
  plate.position.y = MODEL_HEIGHT + 0.85;
  group.add(plate);

  const mixer = new THREE.AnimationMixer(model);
  const actions = {};
  for (const key of Object.keys(CHAR.clips)) {
    const act = mixer.clipAction(CHAR.clips[key]);
    if (key === 'dead') { act.setLoop(THREE.LoopOnce, 1); act.clampWhenFinished = true; }
    actions[key] = act;
  }
  const startKey = actions.idle ? 'idle' : Object.keys(actions)[0];
  if (startKey) actions[startKey].play();

  return {
    isModel: true,
    group, holder, model, mixer, actions, ring, blob, plate, skinMats,
    height: MODEL_HEIGHT,
    current: startKey || null,
    clock: 0
  };
}

/* ---------------------------------------------------------------------------
 * 조립된 아바타의 실제 월드 크기를 재서 배율을 확정합니다.
 *
 * 모델 하나만 따로 재는 것보다 이 방식이 확실합니다. 부모 계층의 스케일,
 * bindMatrix 상쇄, Blender 가 정점에 구워 넣은 스케일 등 무슨 사정이 있든
 * "화면에 그려지는 크기" 를 직접 재서 맞추기 때문입니다.
 * 한 번 보정한 뒤 다시 재서 오차가 남으면 한 번 더 잡습니다.
 * ------------------------------------------------------------------------- */
function fitAvatarScale(holder) {
  if (MODEL_SCALE > 0) {
    holder.scale.setScalar(MODEL_SCALE);
    const m0 = measureObject(holder);
    if (m0.valid) holder.position.set(-((m0.box.min.x + m0.box.max.x) / 2), -m0.box.min.y,
                                      -((m0.box.min.z + m0.box.max.z) / 2));
    return;
  }

  holder.scale.setScalar(1);
  holder.position.set(0, 0, 0);

  for (let pass = 0; pass < 2; pass++) {
    const m = measureObject(holder);
    if (!m.valid || m.size.y <= 1e-9) {
      console.warn('[IPG] 모델 크기를 잴 수 없습니다. index.html 의 MODEL_SCALE 에 ' +
                   '배율을 직접 넣어 주세요 (예: const MODEL_SCALE = 0.01;)');
      holder.scale.setScalar(1);
      return;
    }
    const k = MODEL_HEIGHT / m.size.y;
    if (Math.abs(k - 1) < 0.002) break;              // 이미 목표 크기
    holder.scale.multiplyScalar(k);
    holder.updateMatrixWorld(true);
  }

  // 발끝을 y=0 에, 가로 중심을 원점에 맞춥니다
  const f = measureObject(holder);
  if (f.valid) {
    holder.position.set(
      -((f.box.min.x + f.box.max.x) / 2),
      -f.box.min.y,
      -((f.box.min.z + f.box.max.z) / 2)
    );
    CHAR.scale = holder.scale.x;
    CHAR.fitted = { h: f.size.y, scale: holder.scale.x };
  }
}

function crossFadeTo(av, key, dur) {
  if (!av.actions || !av.actions[key] || av.current === key) return;
  const next = av.actions[key];
  const prev = av.current ? av.actions[av.current] : null;
  next.reset();
  next.setEffectiveWeight(1);
  next.enabled = true;
  next.play();
  if (prev && prev !== next) prev.crossFadeTo(next, dur === undefined ? 0.18 : dur, false);
  av.current = key;
}

/* ---------------------------------------------------------------------------
 * 공통 부속: 플레이어 색 링 + 접지 그림자
 * ------------------------------------------------------------------------- */
function makeColorRing(col) {
  const ring = new THREE.Mesh(
    new THREE.RingGeometry(0.72, 1.00, 32),
    new THREE.MeshBasicMaterial({
      color: col, transparent: true, opacity: 0.85,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    })
  );
  ring.rotation.x = -Math.PI / 2;
  ring.position.y = 0.07;
  return ring;
}

function makeShadowBlob() {
  const blob = new THREE.Mesh(
    new THREE.CircleGeometry(0.98, 24),
    new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.34, depthWrite: false })
  );
  blob.rotation.x = -Math.PI / 2;
  blob.position.y = 0.05;
  return blob;
}

/* 공중에 뜨면 그림자를 작고 옅게 — 3층에서 낙하할 때 착지 지점을 읽는 단서 */
function updateGroundShadow(av, feetY, groundY, grounded) {
  if (!av || !av.blob) return;
  const gap = Math.max(0, feetY - groundY);
  const t = THREE.MathUtils.clamp(1 - gap / 16, 0.18, 1);
  av.blob.scale.setScalar(t);
  av.blob.material.opacity = 0.34 * t;
  av.blob.position.y = (groundY - feetY) + 0.05;
  av.blob.visible = gap < 34;
  if (av.ring) {
    av.ring.position.y = grounded ? 0.07 : (groundY - feetY) + 0.07;
    av.ring.scale.setScalar(grounded ? 1 : t);
  }
}

/* ---------------------------------------------------------------------------
 * B) 절차적 3D 치비 캐릭터 — character.glb 가 없을 때 쓰이는 폴백.
 *    이미지 에셋을 전혀 쓰지 않고 지오메트리만으로 조립하므로,
 *    씬 조명에 제대로 반응하는 "진짜" 3D 입니다.
 * ------------------------------------------------------------------------- */
const CHIBI = {
  height:  3.30,
  headR:   0.86,   // 머리 반지름. 키우면 더 귀엽고 줄이면 동작이 또렷해집니다
  headY:   2.30,
  skin:    0xffd9be,
  hair:    0x3b2a22,
  shell:   0xf5f0e4,
  dark:    0x1c2030,
  eye:     0x2a1d16
};

function makeLimb(len, rad, limbMat, capMat, capScale) {
  const pivot = new THREE.Group();
  const seg = new THREE.Mesh(new THREE.CapsuleLikeGeometry(rad, len), limbMat);
  seg.position.y = -len / 2;
  seg.castShadow = true;
  pivot.add(seg);
  const cap = new THREE.Mesh(new THREE.SphereGeometry(rad * 1.32, 14, 12), capMat);
  cap.position.y = -len;
  if (capScale) cap.scale.set(capScale[0], capScale[1], capScale[2]);
  cap.castShadow = true;
  pivot.add(cap);
  return pivot;
}

/* three r128 에는 CapsuleGeometry 가 없어서 원기둥으로 대체합니다 */
THREE.CapsuleLikeGeometry = function (rad, len) {
  return new THREE.CylinderGeometry(rad, rad * 0.94, len, 12);
};

function buildProceduralAvatar(colorHex, name) {
  const group = new THREE.Group();
  const col = new THREE.Color(colorHex);
  const C = CHIBI;

  const suitMat = new THREE.MeshStandardMaterial({
    color: col, roughness: 0.45, metalness: 0.06,
    emissive: col.clone().multiplyScalar(0.14), emissiveIntensity: 1.0
  });
  const skinMat = new THREE.MeshStandardMaterial({ color: C.skin, roughness: 0.66, metalness: 0.0 });
  const hairMat = new THREE.MeshStandardMaterial({ color: C.hair, roughness: 0.55, metalness: 0.05 });
  const shellMat = new THREE.MeshStandardMaterial({ color: C.shell, roughness: 0.42, metalness: 0.04 });
  const darkMat = new THREE.MeshStandardMaterial({ color: C.dark, roughness: 0.5, metalness: 0.2 });
  const eyeMat = new THREE.MeshStandardMaterial({ color: C.eye, roughness: 0.25, metalness: 0.0 });
  const glossMat = new THREE.MeshBasicMaterial({ color: 0xffffff, toneMapped: false });
  const bulbMat = new THREE.MeshStandardMaterial({ color: 0xffd166, emissive: 0xffc233, emissiveIntensity: 2.2 });

  /* --- 몸통 --- */
  const bodyPivot = new THREE.Group();
  group.add(bodyPivot);

  const torso = new THREE.Mesh(new THREE.SphereGeometry(0.66, 22, 18), suitMat);
  torso.scale.set(1.0, 0.96, 0.86);
  torso.position.y = 1.16;
  torso.castShadow = true;
  bodyPivot.add(torso);

  const collar = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.46, 0.18, 18), shellMat);
  collar.position.y = 1.66;
  collar.castShadow = true;
  bodyPivot.add(collar);

  const badge = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 0.06, 18), shellMat);
  badge.rotation.x = Math.PI / 2;
  badge.position.set(0, 1.22, 0.56);
  bodyPivot.add(badge);
  const badgeCore = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.11, 0.08, 14), bulbMat);
  badgeCore.rotation.x = Math.PI / 2;
  badgeCore.position.set(0, 1.22, 0.59);
  bodyPivot.add(badgeCore);

  /* --- 머리 (전부 3D 지오메트리, 텍스처 없음) --- */
  const headPivot = new THREE.Group();
  headPivot.position.y = C.headY;
  group.add(headPivot);

  const head = new THREE.Mesh(new THREE.SphereGeometry(C.headR, 28, 22), skinMat);
  head.scale.set(1.0, 0.98, 0.96);
  head.castShadow = true;
  headPivot.add(head);

  // 머리카락: 윗머리 캡 + 뒷머리 + 앞머리 세 덩어리
  const hairTop = new THREE.Mesh(
    new THREE.SphereGeometry(C.headR * 1.05, 28, 20, 0, Math.PI * 2, 0, 0.95), hairMat);
  hairTop.scale.copy(head.scale);
  hairTop.castShadow = true;
  headPivot.add(hairTop);

  const hairBack = new THREE.Mesh(
    new THREE.SphereGeometry(C.headR * 1.04, 24, 16,
      Math.PI / 2 + 0.80, Math.PI * 2 - 1.60, 0.70, 0.95), hairMat);
  hairBack.scale.copy(head.scale);
  headPivot.add(hairBack);

  for (const [bx, bsz, brot] of [[-0.40, 0.24, -0.30], [0.02, 0.27, 0.06], [0.42, 0.22, 0.32]]) {
    const bang = new THREE.Mesh(new THREE.SphereGeometry(bsz, 12, 10), hairMat);
    bang.position.set(bx, C.headR * 0.62, C.headR * 0.66);
    bang.scale.set(1.25, 0.62, 0.62);
    bang.rotation.z = brot;
    bang.castShadow = true;
    headPivot.add(bang);
  }

  // 눈: 반구 + 하이라이트 (평면 데칼이 아니라 실제 볼륨)
  const eyes = [];
  for (const sx of [-1, 1]) {
    const eye = new THREE.Mesh(new THREE.SphereGeometry(0.145, 16, 14), eyeMat);
    eye.position.set(sx * 0.33, 0.02, C.headR * 0.80);
    eye.scale.set(0.85, 1.0, 0.55);
    headPivot.add(eye);
    eyes.push(eye);

    const gloss = new THREE.Mesh(new THREE.SphereGeometry(0.052, 10, 8), glossMat);
    gloss.position.set(sx * 0.30, 0.07, C.headR * 0.86);
    headPivot.add(gloss);

    // 눈썹
    const brow = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.05, 0.06), hairMat);
    brow.position.set(sx * 0.33, 0.24, C.headR * 0.80);
    brow.rotation.z = sx * -0.12;
    headPivot.add(brow);
  }

  // 코 + 입 (작은 볼륨)
  const nose = new THREE.Mesh(new THREE.SphereGeometry(0.06, 10, 8), skinMat);
  nose.position.set(0, -0.12, C.headR * 0.96);
  headPivot.add(nose);

  const mouth = new THREE.Mesh(new THREE.TorusGeometry(0.10, 0.026, 8, 18, Math.PI), eyeMat);
  mouth.position.set(0, -0.30, C.headR * 0.84);
  mouth.rotation.x = -0.25;
  mouth.rotation.z = Math.PI;
  headPivot.add(mouth);

  // 귀
  for (const sx of [-1, 1]) {
    const ear = new THREE.Mesh(new THREE.SphereGeometry(0.15, 12, 10), skinMat);
    ear.position.set(sx * C.headR * 0.96, -0.06, 0);
    ear.scale.set(0.45, 1.0, 0.80);
    headPivot.add(ear);
  }

  // 특허 전구 안테나
  const antenna = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.42, 8), darkMat);
  antenna.position.set(0.20, C.headR * 0.92, 0);
  antenna.rotation.z = -0.24;
  headPivot.add(antenna);
  const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.14, 14, 12), bulbMat);
  bulb.position.set(0.29, C.headR * 0.92 + 0.24, 0);
  headPivot.add(bulb);

  /* --- 팔다리 --- */
  const armL = makeLimb(0.56, 0.155, suitMat, shellMat, [1.05, 0.9, 1.05]);
  const armR = makeLimb(0.56, 0.155, suitMat, shellMat, [1.05, 0.9, 1.05]);
  armL.position.set(-0.64, 1.44, 0);
  armR.position.set(0.64, 1.44, 0);
  armL.rotation.z = 0.20;
  armR.rotation.z = -0.20;

  const legL = makeLimb(0.50, 0.185, darkMat, shellMat, [1.0, 0.85, 1.25]);
  const legR = makeLimb(0.50, 0.185, darkMat, shellMat, [1.0, 0.85, 1.25]);
  legL.position.set(-0.27, 0.72, 0);
  legR.position.set(0.27, 0.72, 0);

  group.add(armL, armR, legL, legR);

  const ring = makeColorRing(col);
  group.add(ring);
  const blob = makeShadowBlob();
  group.add(blob);
  const plate = makeNameplate(name, colorHex);
  plate.position.y = C.height + 0.85;
  group.add(plate);

  return {
    isModel: false,
    group, bodyPivot, torso, headPivot, eyes, mouth,
    armL, armR, legL, legR, ring, blob, plate,
    skinMats: [suitMat, shellMat],
    height: C.height,
    phase: Math.random() * 6.28,
    clock: 0,
    landSquash: 0,
    baseArmZ: 0.20
  };
}

/* ---------------------------------------------------------------------------
 * 애니메이션 — GLB 는 클립 크로스페이드, 절차적은 진자 + 스쿼시
 * ------------------------------------------------------------------------- */
function animateAvatar(av, dt, speed01, state) {
  if (!av) return;
  av.clock += dt;

  /* --- A) GLB 모델 --- */
  if (av.isModel) {
    let key = av.actions[state] ? state : 'idle';
    crossFadeTo(av, key, state === 'dead' ? 0.12 : 0.18);
    if (av.actions.run) av.actions.run.setEffectiveTimeScale(0.7 + speed01 * 0.9);
    av.mixer.update(dt);
    av.plate.visible = state !== 'dead';
    if (av.ring) av.ring.visible = state !== 'dead';
    return;
  }

  /* --- B) 절차적 캐릭터 --- */
  const L = (a, b, k) => THREE.MathUtils.lerp(a, b, Math.min(1, k));

  if (state === 'dead') {
    av.group.rotation.x = Math.min(av.group.rotation.x + dt * 3.6, Math.PI / 2.15);
    av.group.rotation.z = Math.sin(av.clock * 5.5) * 0.10;
    av.headPivot.rotation.z = Math.sin(av.clock * 9) * 0.20;
    av.armL.rotation.x = L(av.armL.rotation.x, -0.6, dt * 6);
    av.armR.rotation.x = L(av.armR.rotation.x, -0.6, dt * 6);
    av.legL.rotation.x = L(av.legL.rotation.x, 0.5, dt * 6);
    av.legR.rotation.x = L(av.legR.rotation.x, 0.5, dt * 6);
    av.eyes.forEach((e) => e.scale.set(0.85, 0.22, 0.55));
    av.plate.visible = false;
    if (av.ring) av.ring.visible = false;
    return;
  }
  av.plate.visible = true;
  if (av.ring) av.ring.visible = true;
  av.group.rotation.x *= 0.82;
  av.group.rotation.z *= 0.82;
  av.eyes.forEach((e) => e.scale.set(0.85, 1.0, 0.55));

  /* 스쿼시 & 스트레치 */
  let sx = 1, sy = 1;
  if (state === 'jump') { sy = 1.16; sx = 0.90; av.landSquash = 1; }
  else if (state === 'fall') { sy = 1.08; sx = 0.95; av.landSquash = 1; }
  else if (av.landSquash > 0) {
    av.landSquash = Math.max(0, av.landSquash - dt * 5.0);
    sy = 1 - av.landSquash * 0.28;
    sx = 1 + av.landSquash * 0.22;
  }
  const sm = Math.min(1, dt * 20);
  av.group.scale.set(L(av.group.scale.x, sx, sm), L(av.group.scale.y, sy, sm), L(av.group.scale.z, sx, sm));

  /* 공중 포즈 */
  if (state === 'jump' || state === 'fall') {
    const up = state === 'jump';
    av.armL.rotation.x = L(av.armL.rotation.x, up ? -2.4 : -1.5, dt * 11);
    av.armR.rotation.x = L(av.armR.rotation.x, up ? -2.4 : -1.5, dt * 11);
    av.armL.rotation.z = L(av.armL.rotation.z, av.baseArmZ + 0.32, dt * 11);
    av.armR.rotation.z = L(av.armR.rotation.z, -av.baseArmZ - 0.32, dt * 11);
    av.legL.rotation.x = L(av.legL.rotation.x, up ? -0.72 : -0.28, dt * 11);
    av.legR.rotation.x = L(av.legR.rotation.x, up ? -0.34 : 0.28, dt * 11);
    av.bodyPivot.rotation.x = L(av.bodyPivot.rotation.x, up ? -0.14 : 0.16, dt * 9);
    av.headPivot.rotation.x = L(av.headPivot.rotation.x, up ? -0.18 : 0.14, dt * 9);
    av.headPivot.position.y = L(av.headPivot.position.y, CHIBI.headY, dt * 9);
    return;
  }

  /* 지상: 진자 러닝 + 머리 관성 */
  av.phase += dt * (4.2 + speed01 * 11.0);
  const s = Math.sin(av.phase);
  const amp = 0.16 + speed01 * 1.0;

  av.legL.rotation.x = s * amp;
  av.legR.rotation.x = -s * amp;
  av.armL.rotation.x = -s * amp * 0.9;
  av.armR.rotation.x = s * amp * 0.9;
  av.armL.rotation.z = L(av.armL.rotation.z, av.baseArmZ + speed01 * 0.16, dt * 10);
  av.armR.rotation.z = L(av.armR.rotation.z, -av.baseArmZ - speed01 * 0.16, dt * 10);

  const bounce = Math.abs(Math.sin(av.phase)) * (0.03 + speed01 * 0.10);
  av.bodyPivot.position.y = L(av.bodyPivot.position.y, bounce, dt * 18);
  av.headPivot.position.y = L(av.headPivot.position.y, CHIBI.headY + bounce * 1.30, dt * 11);
  av.bodyPivot.rotation.x = L(av.bodyPivot.rotation.x, speed01 * 0.17, dt * 8);
  av.headPivot.rotation.x = L(av.headPivot.rotation.x, -speed01 * 0.10 + Math.sin(av.phase) * 0.03, dt * 7);
  av.headPivot.rotation.z = Math.sin(av.phase * 0.5) * (0.02 + speed01 * 0.05);

  if (speed01 < 0.05) {
    const breathe = Math.sin(av.clock * 1.9) * 0.016;
    av.torso.scale.set(1.0, 0.96 + breathe, 0.86);
  } else {
    av.torso.scale.set(1.0, 0.96, 0.86);
  }
}

