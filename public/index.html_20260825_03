/* --- 텍스처 슬롯 --------------------------------------------------------- *
 * public/assets/ 에 파일을 넣으면 자동 적용됩니다.
 *   character.glb     3D 캐릭터 모델 (애니메이션 포함)  ← 캐릭터 핵심
 *   road_texture.png  1024x1024, 타일 상판 (선택, 그레이스케일)
 * 파일이 없으면 절차적 3D 캐릭터가 쓰이므로 게임은 항상 동작합니다.        */
const texLoader = new THREE.TextureLoader();
const TEX = { road: null };

function loadOptionalTexture(url, key, repeat) {
  texLoader.load(
    url,
    (t) => {
      t.wrapS = t.wrapT = THREE.RepeatWrapping;
      if (repeat) t.repeat.set(repeat, repeat);
      t.encoding = THREE.sRGBEncoding;
      t.anisotropy = renderer.capabilities.getMaxAnisotropy();
      TEX[key] = t;
      if (key === 'road') {
        for (const rec of G.tiles.values()) {
          rec.mesh.material.map = t;
          rec.mesh.material.needsUpdate = true;
        }
      }
    },
    undefined,
    () => { /* 파일 없음 — 폴백 유지 */ }
  );
}
loadOptionalTexture('assets/road_texture.png', 'road', 1);

/* --- 배경 스카이돔 (3개 맵) --------------------------------------------- *
 * 업로드한 배경은 파노라마가 아니라 일반 16:9 그림입니다. 그래서
 * scene.background 에 그냥 넣으면 회전할 때 크게 왜곡되고 이음매가 보입니다.
 *
 * 해결:
 *   · 큰 구(BackSide)에 매핑하고 가로는 MirroredRepeatWrapping 으로 2회 반복.
 *     미러 반복이라 360도를 돌아도 이음매가 생기지 않습니다.
 *   · 세로는 ClampToEdgeWrapping. 이미지가 덮지 않는 아래쪽은 가장자리
 *     픽셀 색이 그대로 이어져 끊기지 않습니다.
 *   · MeshBasicMaterial + fog:false + toneMapped:false → 조명/안개 영향 0.
 *   · 매 프레임 카메라 위치를 따라가므로 어디로 이동해도 잘리지 않습니다.
 * ---------------------------------------------------------------------- */
const SKY_RADIUS = 600;
const SKY_THETA  = 1.86;   // 이미지가 덮는 세로 각도(rad). 약 107도
const SKY_TURNS  = 2;      // 가로 반복 횟수. 미러 반복이라 짝수여야 이음매가 없습니다

const THEMES = [
  {
    key: 'candy',
    name: '캔디 스카이',
    bg: 'assets/bg/map1_candy.jpg',
    fog: 0x8fcdf0, fogDensity: 0.0035,
    hemiSky: 0xbfe6ff, hemiGround: 0x6f8fb8, hemiInt: 0.95,
    keyColor: 0xffffff, keyInt: 1.05,
    rimColor: 0x66ffe0, rimInt: 0.35
  },
  {
    key: 'neon',
    name: '네온 아레나',
    bg: 'assets/bg/map2_neon.jpg',
    fog: 0x7fb6cf, fogDensity: 0.0040,
    hemiSky: 0xa8e8ff, hemiGround: 0x2d4a63, hemiInt: 0.85,
    keyColor: 0xf2fbff, keyInt: 1.15,
    rimColor: 0x00ffcc, rimInt: 0.55
  },
  {
    key: 'dawn',
    name: '새벽 구름',
    bg: 'assets/bg/map3_dawn.jpg',
    fog: 0xb9a2dd, fogDensity: 0.0032,
    hemiSky: 0xffd9ec, hemiGround: 0x6a5a94, hemiInt: 0.9,
    keyColor: 0xffe3c4, keyInt: 1.0,
    rimColor: 0xb98cff, rimInt: 0.45
  }
];

let skyMesh = null;
let skyTex = {};          // 경로별 캐시 (맵이 바뀌어도 재다운로드하지 않음)
let currentTheme = -1;

function buildSkyDome() {
  const geo = new THREE.SphereGeometry(SKY_RADIUS, 64, 40);
  const mat = new THREE.MeshBasicMaterial({
    color: 0xffffff,
    side: THREE.BackSide,
    depthWrite: false,      // 항상 뒤에 그려지도록
    fog: false,             // 안개 영향 없음
    toneMapped: false       // 톤매핑/노출 영향 없음
  });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.renderOrder = -1;
  mesh.frustumCulled = false;
  mesh.matrixAutoUpdate = true;
  scene.add(mesh);
  return mesh;
}

/* 이미지가 세로로 SKY_THETA 만큼만 덮도록 UV 를 보정합니다.
 * theta=0(천정) → 이미지 위쪽, theta=SKY_THETA → 이미지 아래쪽,
 * 그보다 아래는 ClampToEdge 로 아래쪽 가장자리 색이 계속 이어집니다.   */
function fitSkyTexture(tex) {
  tex.wrapS = THREE.MirroredRepeatWrapping;
  tex.wrapT = THREE.ClampToEdgeWrapping;
  tex.encoding = THREE.sRGBEncoding;
  tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.generateMipmaps = true;

  const a = 1 - SKY_THETA / Math.PI;      // theta=SKY_THETA 지점의 기본 v
  const ry = 1 / (1 - a);
  tex.repeat.set(SKY_TURNS, ry);
  tex.offset.set(0, -a * ry);
  tex.needsUpdate = true;
  return tex;
}

function applyTheme(index) {
  const t = THEMES[(index | 0) % THEMES.length] || THEMES[0];
  if (currentTheme === index && skyMesh && skyMesh.material.map) return;
  currentTheme = index;

  if (!skyMesh) skyMesh = buildSkyDome();

  /* 조명·안개를 배경 톤에 맞춰 갈아끼웁니다.
   * 배경만 바꾸면 캐릭터와 타일이 배경에서 붕 떠 보입니다.              */
  scene.fog.color.setHex(t.fog);
  scene.fog.density = t.fogDensity;
  scene.background = new THREE.Color(t.fog);
  hemiLight.color.setHex(t.hemiSky);
  hemiLight.groundColor.setHex(t.hemiGround);
  hemiLight.intensity = t.hemiInt;
  keyLight.color.setHex(t.keyColor);
  keyLight.intensity = t.keyInt;
  rimLight.color.setHex(t.rimColor);
  rimLight.intensity = t.rimInt;

  const el = document.getElementById('vMap');
  if (el) el.textContent = t.name;

  if (skyTex[t.bg]) {
    skyMesh.material.map = skyTex[t.bg];
    skyMesh.material.needsUpdate = true;
    return;
  }

  texLoader.load(
    t.bg,
    (tex) => {
      skyTex[t.bg] = fitSkyTexture(tex);
      if (currentTheme === index) {
        skyMesh.material.map = skyTex[t.bg];
        skyMesh.material.needsUpdate = true;
      }
    },
    undefined,
    () => {
      // 배경 이미지가 없으면 단색 하늘로 대체합니다 (게임은 그대로 진행)
      console.warn('[IPG] 배경 이미지를 불러오지 못했습니다: ' + t.bg);
      skyMesh.material.map = null;
      skyMesh.material.color.setHex(t.fog);
      skyMesh.material.needsUpdate = true;
    }
  );
}

