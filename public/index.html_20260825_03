  diagBody.innerHTML =
    row('socket.io', typeof io !== 'undefined', typeof io !== 'undefined' ? '로드됨' : '없음') +
    row('연결', !!conn, conn ? '연결됨 / ' + tr : '끊김') +
    row('init 수신', G.started, G.started ? '완료' : '대기중') +
    row('룸', !!G.roomId && G.roomId !== '—', G.roomId) +
    row('내 역할', null, G.role) +
