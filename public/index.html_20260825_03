function updateLayerStack(layer) {
  for (const d of dom.docs) {
    d.classList.toggle('on', parseInt(d.dataset.l, 10) === layer);
  }
}

function updateRoster() {
  const rows = [];
  const entries = [...G.players.values()].sort((a, b) => (b.alive - a.alive));
  for (const r of entries) {
    const isSelf = r.id === G.selfId;
    rows.push(
      '<div class="rrow' + (r.alive ? '' : ' dead') + '" style="border-left-color:' + (r.color || '#888') + '">' +
      '<span>' + escapeHtml(safeName(r.name)) + '</span>' +
      (isSelf ? '<span class="you">YOU</span>' : '') +
      '<span class="lay">' + (r.alive ? 'L' + (r.layer || 3) : 'OUT') + '</span>' +
      '</div>'
    );
  }
  if (!rows.length) rows.push('<div class="rrow" style="border-left-color:#333;opacity:.5">대기 중…</div>');
  dom.rosterList.innerHTML = rows.join('');
}

/* 어떤 경로로 들어오든 화면에 undefined 가 찍히지 않게 하는 안전망 */
function safeName(v, fallback) {
  if (typeof v === 'string' && v.trim()) return v.trim();
  return fallback || '익명 출원인';
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function updateSpectatorUI() {
  const isSpec = G.role === 'spectator';
  dom.spec.classList.toggle('show', isSpec);
  dom.hint.classList.toggle('hide', isSpec);

  /* 관전 중에는 내 캐릭터가 화면에 없는 것이 정상입니다.
   * 이걸 알려주지 않으면 "캐릭터가 안 나온다" 로 오해하게 됩니다.        */
  const banner = document.getElementById('specBanner');
  banner.classList.toggle('show', isSpec);
  if (isSpec) {
    banner.innerHTML = (G.phase === 'playing')
      ? '<b>관전 중</b>진행 중인 회차라 관전으로 참가했습니다 · 다음 회차에 자동으로 주자가 됩니다'
      : '<b>관전 중</b>내 캐릭터는 표시되지 않습니다 · 주자로 뛰려면 새로고침 후 "주자로 참가" 선택';
  }
  if (!isSpec) return;

  const alive = [...G.players.values()].filter((p) => p.alive);
  if (!G.specTarget || !alive.find((p) => p.id === G.specTarget)) {
    G.specTarget = alive.length ? alive[0].id : null;
  }
  dom.specTargets.innerHTML = alive.length
    ? alive.map((p) =>
        '<button class="tgt' + (p.id === G.specTarget ? ' sel' : '') + '" data-id="' + p.id + '">' +
        escapeHtml(safeName(p.name)) + '</button>').join('')
    : '<span style="font-size:11px;opacity:.5">주자가 없습니다</span>';
}

dom.specTargets.addEventListener('click', (e) => {
  const b = e.target.closest('.tgt');
  if (!b) return;
  G.specTarget = b.dataset.id;
  updateSpectatorUI();
