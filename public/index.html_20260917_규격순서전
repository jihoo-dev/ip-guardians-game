/* ══════════════════════════════════════════════════════════════════════
 * 나가기 — 대기 화면으로 돌아가기
 * ────────────────────────────────────────────────────────────────────
 * ★ 부분 초기화가 아니라 페이지를 다시 엽니다.
 *   소켓·씬·물리·타일 1,600여 장·오디오·적응형 품질이 서로 얽혀 있어서,
 *   되돌려야 할 곳을 한 군데라도 빠뜨리면 그 자리가 아니라 다음 판
 *   중간에 터집니다. 재현도 어렵습니다.
 *   에셋은 전부 immutable 캐시라 다시 받지 않으므로 체감은 한 호흡이고,
 *   무엇보다 다음 사람이 깨끗한 상태에서 시작하게 됩니다 — 한 대를
 *   번갈아 쓰는 자리에서는 이게 장점입니다.
 *
 * ★ 먼저 끊고 나서 다시 엽니다.
 *   reload 만 하면 서버가 이탈을 알아차릴 때까지(20Hz 틱의 끊긴 소켓
 *   정리) 내 자리가 남아 있어, 정원이 찬 방이라면 새로 뜬 내 탭이
 *   자기 자리에 못 들어가고 관전자로 밀립니다.
 * ══════════════════════════════════════════════════════════════════ */
function leaveToLobby() {
  try { if (G.socket) G.socket.disconnect(); } catch (e) {}
  location.reload();
}

/* 메뉴를 열 수 있는 상태인가 — 대기 화면이나 결과 화면이 떠 있으면
 * 그쪽에 이미 나가는 길이 있으므로 겹쳐 열지 않습니다.              */
function canOpenLeaveMenu() {
  if (!dom.leaveMenu) return false;
  if (dom.joinScreen.classList.contains('show')) return false;
  if (dom.result.classList.contains('show')) return false;
  return true;
}

function toggleLeaveMenu(on) {
  if (!dom.leaveMenu) return;
  const has = dom.leaveMenu.classList.contains('show');
  const want = on === undefined ? !has : !!on;
  if (want && !canOpenLeaveMenu()) return;
  dom.leaveMenu.classList.toggle('show', want);
  /* 창을 여는 순간 눌려 있던 키가 그대로 남으면, 닫은 뒤에도 그 방향으로
   * 계속 달립니다. 이동 입력을 여기서 한 번 털어 줍니다.            */
  if (want) Input.releaseAll();
}

window.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape' || e.repeat) return;
  const el = document.activeElement;
  if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA')) { el.blur(); return; }
  if (dom.leaveMenu && dom.leaveMenu.classList.contains('show')) { toggleLeaveMenu(false); return; }
  toggleLeaveMenu(true);
});

$('btnMenu').addEventListener('click', () => { Sound.sfx('click'); toggleLeaveMenu(); });
$('btnStay').addEventListener('click', () => { Sound.sfx('click'); toggleLeaveMenu(false); });
$('btnLeaveNow').addEventListener('click', () => { Sound.sfx('click'); leaveToLobby(); });
$('btnLeaveResult').addEventListener('click', () => { Sound.sfx('click'); leaveToLobby(); });
/* 대기실 버튼 하나가 두 가지 일을 합니다 — 방장이면 시작, 아니면 준비.
 * updateReadyUI 가 dataset.act 로 어느 쪽인지 적어 둡니다.          */
function pressReady() {
  if (!G.socket || !G.socket.connected) return;
  if (dom.btnReady.disabled) return;
  Sound.sfx('click');
  if (dom.btnReady.dataset.act === 'start') {
    G.socket.emit('start_round');
  } else {
    const me = G.players.get(G.selfId);
    G.socket.emit('toggle_ready', { ready: !(me && me.ready) });
  }
}

dom.btnReady.addEventListener('click', pressReady);

/* ★ Enter 로도 됩니다.
   *   혼자 들어온 사람은 화면에 자기 이름 하나뿐이라 버튼을 찾기 전에
   *   키부터 눌러 봅니다. 실제로 "아무 키를 눌러도 시작이 안 된다" 는
   *   보고가 있었습니다.
   * ★ Space 는 쓰지 않습니다 — 점프라서, 발판 위에서 뛰다가 라운드가
   *   시작되는 일이 생깁니다.                                       */
window.addEventListener('keydown', (e) => {
  if (e.key !== 'Enter' || e.repeat) return;
  const el = document.activeElement;
  if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA')) return;
  if (!dom.ready || !dom.ready.classList.contains('show')) return;
  e.preventDefault();
  pressReady();
});

$('btnStayNext').addEventListener('click', () => {
  Sound.sfx('click');
  /* 다음 회차는 어차피 서버가 시작합니다. 여기서는 결과 카드만 걷어
   * 아레나를 볼 수 있게 합니다 — 남은 시간을 빈 화면으로 보내지
   * 않게 하는 것이 전부입니다.                                    */
  dom.result.classList.remove('show');
});

document.addEventListener('click', (e) => {
  if (mixer.classList.contains('show') && !mixer.contains(e.target) && e.target !== btnAudio) {
    mixer.classList.remove('show');
  }
});

refreshAudioUI();

/* ============================ 16. boot ================================ */

let joinMode = 'player';
/* 심사 규격 접기/펼치기. 규격 문구 자체는 buildRulesText 가 이미 채워 두었고
 * 여기서는 보이기만 토글합니다 — 내용을 여기서 만들면 config 파생이 깨집니다. */
const btnRules = document.getElementById('btnRules');
if (btnRules) {
  btnRules.addEventListener('click', () => {
    const p = document.getElementById('joinRules');
    const open = p.hasAttribute('hidden');
    if (open) p.removeAttribute('hidden'); else p.setAttribute('hidden', '');
    btnRules.setAttribute('aria-expanded', open ? 'true' : 'false');
    btnRules.textContent = open ? '심사 규격 접기 −' : '심사 규격 보기 +';
  });
}

document.querySelectorAll('.mode').forEach((b) => {
  b.addEventListener('click', () => {
    document.querySelectorAll('.mode').forEach((x) => x.classList.remove('sel'));
    b.classList.add('sel');
    joinMode = b.dataset.mode;
  });
});

/* ★ 심사를 '받는' 쪽이 플레이어입니다. 발밑을 무너뜨리는 것이 심사관이고
 *   그 위에서 버티는 것이 출원인이라, 기본 이름이 심사관이면 역할이
 *   거꾸로 읽힙니다. 명단·입력칸 라벨은 이미 '출원인'이었습니다.    */
dom.nameInput.value = '출원인' + Math.floor(Math.random() * 900 + 100);

/* assets/character.glb 가 있으면 절차적 캐릭터를 대체합니다 */
loadCharacterModel();

/* 균열 텍스처 5종을 미리 구워 둡니다. 첫 균열이 생기는 순간에 만들면
 * 512×512 캔버스 5장을 한꺼번에 그리느라 프레임이 한 번 튑니다 —
 * 하필 라운드 한복판이라 제일 눈에 띄는 타이밍입니다.                */
getCrackTexture('warmup');

/* ══════════════════════════════════════════════════════════════════════
 * 살아 있는 대기 화면 — 페이지를 열자마자 관전으로 붙습니다
 * ────────────────────────────────────────────────────────────────────
 * ★ 왜 이걸 하는가
 *   종전에는 참가 버튼을 눌러야 소켓이 붙고, 그때서야 맵이 만들어졌습니다.
 *   그 전까지 화면에는 3D 가 단 하나도 없었고, 참가 화면은 화면 전체를
 *   덮는 불투명 2D 오버레이였습니다. '게임 화면 같지 않다'는 의견의
 *   원인이 이것입니다 — 실제로 게임 화면이 아니었습니다.
 *
 *   지금은 열자마자 관전으로 붙어 <b>뒤에서 진짜 게임이 돌아갑니다.</b>
 *   이름을 적는 동안 동료가 뛰고 타일이 무너지는 것이 보입니다.
 *
 * ★ preview 플래그를 서버로 보냅니다.
 *   그냥 관전으로 붙이면 wantsPlay 가 켜져 다음 회차에 <b>참가를 누르지도
 *   않은 사람이 주자가 됩니다.</b> preview 는 '구경만 하는 중' 이라는
 *   표시이고, 서버는 이 경우 좌석 경쟁에 넣지 않습니다.
 *
 * ★ 비용은 관전자 한 명 분입니다.
 *   실측으로 40개 방 160명이 코어 1개의 21% 였으므로, 대기 화면을 열어
 *   둔 사람 몇 명이 더 붙는 것은 문제가 되지 않습니다.
 *
 * ★ 실패해도 게임은 그대로 동작합니다.
 *   socket.io 를 못 불러오는 환경이면 조용히 넘어가고, 참가 화면은
 *   종전처럼 불투명한 상태로 남습니다.
 * ══════════════════════════════════════════════════════════════════════ */
function startPreview() {
  if (typeof io === 'undefined') return;      // 정적 파일로 연 경우
  if (G.socket) return;
  if (!joinScreenVisible()) return;
  connect('관전', 'spectator', { preview: true });
}

/* config 를 먼저 받아야 층 수·타일 규격이 채워집니다. 그 뒤에 붙습니다 —
 * 순서가 반대면 참가 화면이 잠깐 빈 골격으로 보입니다. */
setTimeout(startPreview, 400);


/* 방 선택. 같은 방을 다시 누르면 선택 해제 = 빠른 참가로 돌아갑니다. */
if (dom.lbList) {
  dom.lbList.addEventListener('click', (e) => {
    const row = e.target.closest ? e.target.closest('.lbRow') : null;
    if (!row) return;
    if (row.dataset.dis === '1') {
      toast('그 심사실은 지금 들어갈 수 없습니다 — 진행 중이거나 정원입니다', 'kill');
      return;
    }
    lobbyPick = (lobbyPick === row.dataset.room) ? null : row.dataset.room;
    for (const el of dom.lbList.querySelectorAll('.lbRow')) {
      el.classList.toggle('sel', el.dataset.room === lobbyPick);
    }
    syncJoinCta();
    refreshAvPreview();
  });
}

/* 이름을 치는 즉시 명찰이 바뀌는 게 이 미리보기의 핵심입니다 */
if (dom.nameInput) dom.nameInput.addEventListener('input', () => refreshAvPreview());

/* ══════════════════════════════════════════════════════════════════════
 * 대기 화면 배경음
 * ────────────────────────────────────────────────────────────────────
 * ★ 왜 '첫 클릭'에 거는가 — 브라우저 자동재생 정책 때문입니다.
 *   사용자 제스처 없이는 오디오 컨텍스트를 열 수 없습니다. 종전에는 그
 *   제스처를 <b>참가 버튼</b>에서만 받았기 때문에, 대기 화면은 이름을 적고
 *   방을 고르는 내내 완전히 조용했습니다. 화면이 살아 있는데 소리가 없으면
 *   '아직 안 켜진 페이지' 처럼 느껴집니다.
 *
 *   이름 입력창을 누르든 방을 고르든 그것도 똑같은 제스처입니다. 참가
 *   화면 어디를 처음 누르든(또는 키를 치든) 그 순간 열면 됩니다.
 *
 * ★ 음소거 상태는 localStorage 에 남아 있습니다(Sound.save).
 *   꺼 둔 사람에게 소리를 다시 틀지 않도록 muted 를 먼저 봅니다.
 *
 * ★ 참가 화면에서도 끌 수 있어야 합니다.
 *   상단 HUD 의 소리 버튼은 참가 화면에 가려 누를 수 없습니다. 그래서
 *   조작 안내 줄에 같은 기능의 버튼을 하나 둡니다. 두 버튼은 같은
 *   Sound.muted 를 보므로 상태가 갈라지지 않습니다.
 * ══════════════════════════════════════════════════════════════════════ */
function syncJoinSnd() {
  if (!dom.btnJoinSnd) return;
  const off = Sound.muted;
  dom.btnJoinSnd.classList.toggle('off', off);
  dom.btnJoinSnd.setAttribute('aria-pressed', off ? 'true' : 'false');
  dom.joinSndIcon.textContent = off ? '✕' : '♪';
  dom.joinSndTxt.textContent = off ? '소리 꺼짐' : (lobbyAudioArmed ? '소리 켜짐' : '소리 켜기');
}

function armLobbyAudio() {
  if (lobbyAudioArmed) return;
  lobbyAudioArmed = true;
  Sound.unlock();
  if (!Sound.muted) Sound.playBgm('lobby');
  syncJoinSnd();
  if (typeof refreshAudioUI === 'function') { try { refreshAudioUI(); } catch (e) {} }
}

if (dom.joinScreen) {
  /* 네 가지를 모두 받습니다 — 마우스·터치·키보드 어느 쪽으로 처음
   * 조작하든 그 순간 열려야 합니다.
   *
   * ★ pointerdown 하나로는 부족합니다. 자동화 도구나 일부 입력기에서
   *   마우스 이벤트가 pointer 이벤트를 동반하지 않는 경우가 있어,
   *   실제로 클릭했는데도 소리가 안 열리는 상황을 만들었습니다.
   *   armLobbyAudio 는 한 번만 동작하므로(lobbyAudioArmed) 중복으로
   *   걸어 두는 비용이 없습니다. */
  for (const ev of ['pointerdown', 'mousedown', 'touchstart', 'click', 'keydown']) {
    dom.joinScreen.addEventListener(ev, armLobbyAudio);
  }
}

if (dom.btnJoinSnd) {
  dom.btnJoinSnd.addEventListener('click', (e) => {
    /* 이 클릭도 제스처라 위 pointerdown 이 먼저 돕니다(열림).
     * 그 다음 여기서 껐다 켜므로 결과는 사용자가 누른 대로입니다. */
    e.preventDefault();
    Sound.unlock();
    lobbyAudioArmed = true;
    const muted = Sound.toggleMute();
    if (!muted) Sound.playBgm('lobby');
    syncJoinSnd();
    if (typeof refreshAudioUI === 'function') { try { refreshAudioUI(); } catch (e) {} }
    toast(muted ? '소리 꺼짐' : '소리 켜짐');
  });
}
syncJoinSnd();

dom.btnJoin.addEventListener('click', () => {
  if (typeof io === 'undefined') {
    alert('socket.io 클라이언트를 불러오지 못했습니다.\n\n' +
          '이 페이지는 반드시 게임 서버(기본 http://localhost:3000)를 통해 열어야 합니다.\n' +
          'index.html 파일을 직접 열거나 다른 포트의 정적 서버로 열면 동작하지 않습니다.');
    return;
  }
  const name = (dom.nameInput.value || '').trim() || '익명출원인';
  // 브라우저 자동재생 정책상 여기(첫 클릭)에서 오디오를 열어야 합니다
  Sound.unlock();
  /* ★ 전체화면도 '사용자 제스처 안에서만' 허용되므로 같은 자리입니다.
   *   주소창이 세로 폭의 15% 를 먹고, 스크롤에 따라 사라졌다 나타나며
   *   캔버스 크기가 계속 바뀝니다 — 가로 폰에서는 그 15% 가 곧 시야
   *   한 줄입니다. 거절되더라도(iOS 사파리는 문서 전체화면을 막습니다)
   *   게임은 그대로 동작하므로 실패를 삼킵니다.                    */
  if (IS_TOUCH) {
    const el = document.documentElement;
    const rq = el.requestFullscreen || el.webkitRequestFullscreen;
    if (rq) { try { const p = rq.call(el); if (p && p.catch) p.catch(() => {}); } catch (e) {} }
    try {
      if (screen.orientation && screen.orientation.lock) {
        const p = screen.orientation.lock('landscape');
        if (p && p.catch) p.catch(() => {});
      }
    } catch (e) {}
  }
  Sound.playBgm('lobby');
  /* 대기 화면 연출은 여기서 끝냅니다 — 라운드가 도는 동안 setInterval 두 개가
   * 계속 살아 있으면 매 2.5초 fetch 와 매 0.9초 DOM 조작이 프레임에 끼어듭니다. */
  stopStackLoop();
  stopQueuePoll();
  stopJoinBg();
  disposeAvPreview();
  /* 패널을 즉시 지우지 않고 접습니다. 접히는 동안 뒤의 3D 가 드러나고,
   * init 이 도착하면 카메라가 내 발판으로 날아갑니다.
   * show 는 접힘이 끝난 뒤에 뗍니다 — 먼저 떼면 애니메이션이 안 보입니다. */
  dom.joinScreen.classList.add('folding');
  pendingCamFlight = true;
  setTimeout(() => {
    dom.joinScreen.classList.remove('show', 'folding', 'live');
  }, 520);
  G.role = joinMode;
  G.name = name;
  G.joinMode = joinMode;
  /* 방 만들기면 고른 방을 무시합니다 — 둘 다 보내면 서버가 roomId 를
   * 먼저 보므로 새 방이 안 열립니다.                               */
  G.joinRoomId = G.joinCreate ? undefined : (lobbyPick || undefined);

  /* ★ 이미 미리보기로 붙어 있으면 소켓을 새로 만들지 않고 다시 join 합니다.
   *   새로 연결하면 (1) 붙는 동안 화면이 한 번 끊기고 (2) 방금까지 보던
   *   방과 다른 방에 배정될 수 있습니다. 서버가 재참가를 받아 주므로
   *   같은 소켓으로 자격만 바꾸는 편이 자연스럽습니다. */
  if (G.socket && G.socket.connected) {
    previewing = false;
    G.socket.emit('join', {
      name: name, mode: joinMode,
      roomId: G.joinRoomId,
      create: G.joinCreate || undefined
    });
  } else {
    connect(name, joinMode);
  }
  updateSpectatorUI();

  // 5초 안에 init 이 안 오면 진단 패널을 자동으로 펼칩니다.
  setTimeout(() => {
    if (!G.started && !diagAuto) {
      diagAuto = true;
      diagEl.classList.add('show');
      renderDiag();
      toast('서버 응답이 없습니다 — 좌하단 진단 패널을 확인하세요', 'kill');
    }
  }, 5000);
});

/* ── 방 만들기 ────────────────────────────────────────────────────────
 * 참가 흐름은 btnJoin 하나뿐이라, 여기서는 <b>깃발만 세우고</b> 같은
 * 흐름을 탑니다. 참가 절차(오디오 해제·전체화면·대기 화면 접기·
 * 미리보기 소켓 재사용)가 전부 그 핸들러에 있어서, 두 번째 경로를
 * 따로 만들면 그 절차를 통째로 베껴야 합니다.
 *
 * ★ 관전 모드였으면 주자로 되돌립니다. 아무도 없는 새 방을 관전하겠다는
 *   것은 뜻이 안 되고, 그 방은 빈 채로 목록만 채웁니다.           */
$('btnCreate').addEventListener('click', () => {
  G.joinCreate = true;
  lobbyPick = null;
  const pm = document.querySelector('.mode[data-mode="player"]');
  if (pm && !pm.classList.contains('sel')) pm.click();
  dom.btnJoin.click();
});

dom.nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') dom.btnJoin.click(); });

/* ══════════════════════════════════════════════════════════════════════
 * 클릭 소리
 * ────────────────────────────────────────────────────────────────────
 * ★ 대기 화면은 위임 한 줄로 끝납니다 — 버튼이 여럿이고(참가 방식·
 *   규격 접기·소리·심사실 목록·참가) 앞으로도 늘어날 자리라,
 *   각각에 리스너를 다는 대신 화면 하나에 걸어 둡니다.
 *
 * ★ 게임 화면의 층 안내(좌)·출원인 명단(우)에는 pointer-events 를
 *   주지 않습니다. 두 패널은 폭 208·212px 에 세로로 길어서, 클릭을
 *   받게 하면 그 위에서 시작한 드래그가 캔버스로 내려가지 않아
 *   시점 회전이 막힙니다. 그래서 '좌표가 패널 안인가'만 보고 소리를
 *   냅니다 — 패널은 그대로 투명하고 시점 회전도 그대로입니다.
 *
 * ★ 드래그와 구분합니다. 누른 자리에서 6px 이상 움직였으면 시점을
 *   돌린 것이지 누른 것이 아닙니다.
 * ------------------------------------------------------------------ */
const CLICK_SLOP_PX = 6;

if (dom.joinScreen) {
  dom.joinScreen.addEventListener('click', (e) => {
    const hit = e.target.closest && e.target.closest('button, .lbRow, .mode');
    if (hit) Sound.sfx('click');
  });
}

let clickDownAt = null;
window.addEventListener('pointerdown', (e) => {
  clickDownAt = { x: e.clientX, y: e.clientY };
});
window.addEventListener('pointerup', (e) => {
  const d0 = clickDownAt;
  clickDownAt = null;
  if (!d0) return;
  if (Math.hypot(e.clientX - d0.x, e.clientY - d0.y) > CLICK_SLOP_PX) return;   // 드래그
  if (dom.joinScreen && dom.joinScreen.classList.contains('show')) return;      // 위에서 처리
  const inside = (el) => {
    if (!el || !el.offsetParent) return false;
    const b = el.getBoundingClientRect();
    return e.clientX >= b.left && e.clientX <= b.right &&
           e.clientY >= b.top && e.clientY <= b.bottom;
  };
  if (inside(document.getElementById('layerStack')) ||
      inside(document.getElementById('roster'))) {
    Sound.sfx('click');
  }
});

frame();
</script>
</body>
</html>
