function refreshAudioUI() {
  vAudio.textContent = Sound.muted ? 'OFF' : 'ON';
  btnAudio.classList.toggle('off', Sound.muted);
  /* 참가 화면의 소리 버튼도 같은 Sound.muted 를 봅니다.
   * 소리를 바꾸는 경로가 상단 버튼·M 단축키·믹서로 여러 개라,
   * 호출처마다 따로 걸면 반드시 하나를 빠뜨립니다(실제로 상단 버튼에서
   * 껐을 때 참가 화면 버튼만 '켜짐'으로 남는 버그가 났습니다).
