const MODEL_CLIPS = {
  /* 'loose/lose/defeat' 는 게임용으로 리깅된 모델(Meshy 등)이 쓰는 이름입니다.
   * 지금 모델에는 패배 클립이 아예 없어서 이 줄이 걸리지 않지만, 모델을
   * 갈아끼울 때 'Loose 01' 같은 이름을 놓치지 않으려고 남겨 둡니다.      */
  dead: ['death', 'dying', 'die', 'knocked out', 'falling back death', 'dead',
         'loose', 'lose', 'defeat', 'fallen'],
  run:  ['running', 'run', 'jog', 'sprint', 'fast run'],
  jump: ['jumping', 'jump up', 'jump'],
  fall: ['falling idle', 'falling', 'fall'],
  idle: ['breathing idle', 'idle', 'standing', 'stand', 'tpose', 't-pose']
};
const MODEL_CLIP_ORDER = ['dead', 'run', 'jump', 'fall', 'idle'];

/* ══════════════════════════════════════════════════════════════════════
 * 루트 모션 제거 (제자리 애니메이션으로 만들기)
 * ────────────────────────────────────────────────────────────────────
 * ★ 이 게임은 캐릭터 위치를 코드가 정합니다(물리 → local.render). 그런데
 *   Mixamo 달리기 클립에는 '앞으로 나아가는' 이동이 애니메이션 자체에
 *   들어 있습니다(루트 모션). 그대로 재생하면 아바타 그룹은 코드가 정한
 *   자리에 있는데 그 '안에서' 모델이 앞으로 밀려 나갔다가, 클립이 루프할
 *   때 시작 위치로 뚝 되돌아옵니다.
 *
 *   실측: run 클립이 한 주기(0.733초)에 월드 기준 2.21유닛을 전진시킵니다.
 *   타일 간격이 3.69유닛이니 타일 절반 이상을 갔다가 되돌아오는 셈입니다 —
 *   '분명히 타일을 지나갔는데 다시 시작점으로 오는' 증상의 정체입니다.
 *
 * ★ 왜 옆으로 달릴 때 더 잘 보이는가: 되돌아오는 방향이 캐릭터의 정면
 *   축입니다. 화면 안쪽으로 달리면 그 축이 시선과 나란해 단축되어 보이고,
 *   화면을 가로질러 달리면 그대로 옆으로 튀는 것이 보입니다.
 *
 * ★ 어느 채널이 전진인지는 모델마다 다릅니다(리그 방향·축 회전).
 *   이 모델은 Hips.position 의 Y 채널이 전진이고 폭이 31.7 로, 나머지
 *   (X 0.25 · Z 0.78)보다 40배 이상 큽니다. 그래서 '가장 큰 채널이 나머지
 *   최대의 3배를 넘을 때만' 그 채널을 평탄화합니다 — 축을 박아 두면 모델을
 *   바꿀 때 엉뚱한 축(위아래 들썩임)을 지워 버립니다.
 *   나머지 채널은 남겨 둡니다. 위아래 들썩임과 좌우 흔들림은 살아 있어야
 *   달리는 맛이 납니다.
 * ══════════════════════════════════════════════════════════════════════ */
function stripRootMotion(clip) {
  if (!clip || !clip.tracks) return null;
  /* 루트 본 이름은 리그마다 다릅니다. Hips 가 가장 흔하고, 없으면
   * 키가 3개 이상인 첫 position 트랙을 루트로 봅니다(고정 본은 키가 2개). */
  let track = clip.tracks.find((t) => /hips\.position$/i.test(t.name));
  if (!track) {
    track = clip.tracks.find((t) => /\.position$/.test(t.name) && t.values.length / 3 > 2);
  }
  if (!track) return null;

  const v = track.values;
  const n = v.length / 3;
  if (n < 2) return null;
  const span = [0, 1, 2].map((c) => {
    let mn = Infinity, mx = -Infinity;
    for (let i = 0; i < n; i++) { const x = v[i * 3 + c]; if (x < mn) mn = x; if (x > mx) mx = x; }
    return mx - mn;
  });
  let dom = 0;
  for (let c = 1; c < 3; c++) if (span[c] > span[dom]) dom = c;
  const others = span.filter((_, i) => i !== dom);
  const rest = Math.max(others[0], others[1]);
  /* 뚜렷하게 지배적이지 않으면 건드리지 않습니다. 제자리 클립을 잘못
   * 평탄화해 들썩임을 없애는 것이 루트 모션을 남기는 것보다 나쁩니다.
   *
   * ★ 경계값 8 은 이 모델의 실측에서 나왔습니다 (Hips.translation 채널 폭):
   *     running  X0.25  Y31.74  Z0.78  → 지배 Y, 비율 40.8   ← 루트 모션
   *     jumping  X0.90  Y53.55  Z5.69  → 지배 Y, 비율  9.4   ← 루트 모션
   *     idle     X2.15  Y 0.42  Z0.17  → 지배 X, 비율  5.1   ← 좌우 흔들림
   *     fall     X0.82  Y 0.81  Z0.19  → 지배 X, 비율  1.0   ← 없음
   *   처음에 3 으로 잡았더니 idle 의 좌우 흔들림(비율 5.1)까지 지워
   *   가만히 서 있을 때 뻣뻣해졌습니다. 9.4 와 5.1 사이를 가르는 8 이
   *   양쪽에 여유가 있습니다.
   *   다른 모델로 바꿨을 때 의도치 않게 지워지면 로드 로그의 CHAR.rootMotion
   *   목록에 그 클립이 뜨므로 바로 알 수 있습니다. */
  if (!(span[dom] > rest * 8) || span[dom] <= 1e-6) return null;

  const base = v[dom];
  for (let i = 0; i < n; i++) v[i * 3 + dom] = base;
  return { axis: 'XYZ'[dom], span: span[dom], track: track.name };
}

function pickClip(animations, candidates) {
  const lower = animations.map(a => ({ a, n: a.name.toLowerCase() }));
  for (const c of candidates) {
    const hit = lower.find(x => x.n === c);
    if (hit) return hit.a;
  }
  for (const c of candidates) {
    const hit = lower.find(x => x.n.includes(c));
    if (hit) return hit.a;
  }
  return null;
}

/* ---------------------------------------------------------------------------
 * 모델 실측 — 스킨드 메시는 지오메트리 바운딩박스가 실제 렌더 크기와 다릅니다.
 * (bindMatrix / bindMatrixInverse 때문에 노드 스케일이 상쇄되기도 하고,
 *  Blender 익스포트가 정점에 스케일을 구워 넣기도 합니다)
 * 그래서 boneTransform 으로 실제 스키닝된 정점 위치를 계산해 측정합니다.
 * 이 값이 화면에 그려지는 크기와 정확히 일치합니다.
 * ------------------------------------------------------------------------- */
function fmtDim(v) {
  const f = (n) => (Math.abs(n) >= 0.01 || n === 0) ? n.toFixed(2) : n.toExponential(2);
  return f(v.x) + ' x ' + f(v.y) + ' x ' + f(v.z);
}

function measureObject(obj) {
  obj.updateMatrixWorld(true);
  const box = new THREE.Box3();
  const v = new THREE.Vector3();
  let sampled = 0;

  obj.traverse((o) => {
    if (o.isSkinnedMesh && o.geometry && o.skeleton && typeof o.boneTransform === 'function') {
      if (o.skeleton.update) o.skeleton.update();
      const pos = o.geometry.attributes.position;
      if (!pos) return;
      const step = Math.max(1, Math.floor(pos.count / 600));   // 메시당 최대 600점 샘플
      for (let i = 0; i < pos.count; i += step) {
        o.boneTransform(i, v);
        v.applyMatrix4(o.matrixWorld);
        box.expandByPoint(v);
        sampled++;
      }
    } else if (o.isMesh && o.geometry) {
      if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
      if (o.geometry.boundingBox) {
        box.union(o.geometry.boundingBox.clone().applyMatrix4(o.matrixWorld));
        sampled++;
      }
    }
  });

  const size = box.isEmpty() ? new THREE.Vector3() : box.getSize(new THREE.Vector3());
  return { box, size, sampled, valid: sampled > 0 && isFinite(size.y) && size.y > 1e-9 };
}

function loadCharacterModel() {
  if (typeof THREE.GLTFLoader !== 'function') {
    console.warn('[IPG] GLTFLoader 미로드 — 절차적 캐릭터를 사용합니다');
    return;
  }
  const loader = new THREE.GLTFLoader();

  /* Sketchfab 다운로드는 Draco 압축인 경우가 많습니다.
   * DRACOLoader 가 있으면 붙여 줍니다 (없어도 비압축 모델은 정상 동작).
   *
   * ★ 디코더 본체(1.05MB)는 저장소에 없습니다 — 지금 쓰는 모델 둘 다
   *   extensionsRequired 가 비어 있어(Draco 아님) 한 번도 내려받히지
   *   않기 때문입니다. Draco 모델을 쓰게 되면
   *   `node tools/fetch_vendor.js --draco` 로 받으세요.                */
  if (typeof THREE.DRACOLoader === 'function') {
    const draco = new THREE.DRACOLoader();
    draco.setDecoderPath('vendor/draco/');
    loader.setDRACOLoader(draco);
  }

  CHAR.loading = true;
  const t0 = performance.now();
  loader.load(
    assetUrl(MODEL_PATH),
    (gltf) => {
      CHAR.loading = false; CHAR.progress = 1;
      try {
        applyLoadedModel(gltf);
        console.log('[IPG] 캐릭터 내려받기 ' + Math.round(performance.now() - t0) + 'ms' +
          (CHAR.total ? ' · ' + (CHAR.total / 1048576).toFixed(2) + 'MB' : ''));
      } catch (err) {
        console.error('[IPG] 모델 적용 실패:', err);
        CHAR.ready = false;
      }
    },
    (ev) => {
      /* lengthComputable 이 false 인 경우(프록시가 Content-Length 를 떼는
       * 사내망에서 실제로 있습니다)에는 진행률을 못 냅니다. 그때는 막대를
       * 흐르는 모양으로 두는 쪽이 0% 에 멈춘 것보다 정직합니다.        */
      if (ev && ev.lengthComputable && ev.total > 0) {
        CHAR.loaded = ev.loaded; CHAR.total = ev.total;
        CHAR.progress = ev.loaded / ev.total;
      } else if (ev) {
        CHAR.loaded = ev.loaded || 0; CHAR.total = 0; CHAR.progress = 0;
      }
    },
    (err) => {
      CHAR.loading = false;
      // 조용히 넘기지 않습니다. 파일이 있는데 실패한 것인지 구분되어야 합니다.
      console.warn('[IPG] character.glb 를 불러오지 못했습니다 — 절차적 캐릭터를 사용합니다.',
        (err && (err.message || err.type)) || err);
      CHAR.error = String((err && (err.message || err.type)) || 'not found');
    }
  );
}

function applyLoadedModel(gltf) {
  const root = gltf.scene || (gltf.scenes && gltf.scenes[0]);
  if (!root) { console.warn('[IPG] GLB 에 scene 이 없습니다'); return; }

  /* 모델 자신의 트랜스폼(스케일/회전/위치)은 절대 건드리지 않습니다.
   * Sketchfab 모델은 루트에 0.01 같은 스케일을 갖고 있는 경우가 많아서,
   * 여기를 덮어쓰면 모델이 수백 배로 커지거나 화면 밖으로 나갑니다.
   * 대신 바깥에 컨테이너를 하나 씌우고 거기에만 보정을 겁니다.          */
  if (MODEL_ROTATION_X) root.rotation.x += MODEL_ROTATION_X;
  root.updateMatrixWorld(true);

  /* 여기서 재는 값은 참고용입니다. 최종 배율은 아바타를 조립한 뒤
   * 실제 월드 크기를 다시 재서 보정하므로(fitAvatarScale), 이 단계에서
   * 조금 틀려도 결과는 정확합니다.                                       */
  const m = measureObject(root);
  CHAR.measure = m;
  CHAR.scale = (m.valid && m.size.y > 1e-9) ? (MODEL_HEIGHT / m.size.y) : 1;
  CHAR.yOffset = 0;
  CHAR.xOffset = 0;
  CHAR.zOffset = 0;

  let meshCount = 0, skinned = 0;
  root.traverse((o) => {
    if (!o.isMesh && !o.isSkinnedMesh) return;
    meshCount++;
    if (o.isSkinnedMesh) skinned++;
    o.castShadow = true;
    o.receiveShadow = false;
    o.frustumCulled = false;
    o.visible = true;
    const mats = Array.isArray(o.material) ? o.material : [o.material];
    mats.forEach((m) => {
      if (!m) return;
      if (m.map) m.map.encoding = THREE.sRGBEncoding;
      // 완전 투명하게 저장된 머티리얼을 되살립니다 (간혹 이런 모델이 있습니다)
      if (m.transparent && m.opacity === 0) { m.opacity = 1; m.transparent = false; }
      m.side = THREE.FrontSide;
      m.depthWrite = true;
    });
  });

  const allAnims = (gltf.animations || []).slice();
  let pool = allAnims.slice();
  let matchedByName = 0;
  for (const key of MODEL_CLIP_ORDER) {
    const clip = pickClip(pool, MODEL_CLIPS[key]);
    if (!clip) continue;
    CHAR.clips[key] = clip;
    pool = pool.filter((c) => c !== clip);
    matchedByName++;
  }

  /* Blender 로 합치면 클립 이름이 전부 'mixamo.com' / 'mixamo.com.001' 처럼
   * 나오는 경우가 많습니다. 이러면 이름으로는 구분이 불가능하므로
   * 순서(인덱스) 기준으로 배정합니다. MODEL_CLIP_INDEX 로 직접 지정할 수도
   * 있습니다.                                                             */
  const namesUseless = allAnims.length >= 2 &&
    (matchedByName <= 1 || allAnims.every((a) => /^mixamo\.com/i.test(a.name)));

  if (MODEL_CLIP_INDEX) {
    CHAR.clips = {};
    for (const key of Object.keys(MODEL_CLIP_INDEX)) {
      const idx = MODEL_CLIP_INDEX[key];
      if (allAnims[idx]) CHAR.clips[key] = allAnims[idx];
    }
    CHAR.clipMode = '수동 지정 (MODEL_CLIP_INDEX)';
  } else if (namesUseless) {
    CHAR.clips = {};
    const order = ['idle', 'run', 'jump', 'dead'];
    allAnims.forEach((clip, i) => { if (order[i]) CHAR.clips[order[i]] = clip; });
    CHAR.clipMode = '순서 기준 (이름으로 구분 불가)';
    console.warn(
      '[IPG] 애니메이션 이름이 전부 비슷해서(' + allAnims.map((a) => a.name).join(', ') + ') ' +
      '순서대로 배정했습니다: ' +
      Object.keys(CHAR.clips).map((k, i) => k + '=' + i + '번').join(', ') + '\n' +
      '  순서가 다르면 index.html 에서 이렇게 지정하세요:\n' +
      '  const MODEL_CLIP_INDEX = { idle: 0, run: 1, jump: 2, dead: 3 };'
    );
  } else {
    CHAR.clipMode = '이름 기준';
  }

  /* ★ 클립 배정이 전부 끝난 뒤에 한 번만 적용합니다.
   * 위 분기들이 CHAR.clips 를 통째로 갈아치우므로 중간에 하면 날아갑니다.
   * 아바타는 이 뒤 rebuildAllAvatars() 에서 만들어지므로 순서도 맞습니다. */
  CHAR.rootMotion = [];
  for (const key of Object.keys(CHAR.clips)) {
    const r = stripRootMotion(CHAR.clips[key]);
    if (r) CHAR.rootMotion.push(key + ' ' + r.axis + '축 ' + r.span.toFixed(1));
  }
  /* 남은 구멍 메우기.
   * 애니메이션이 하나도 없는 모델(Sketchfab 다수)에서 undefined 가
   * 클립 맵에 들어가면 이후 전부 터지므로, 값이 있을 때만 채웁니다.     */
  const anims = gltf.animations || [];
  if (!CHAR.clips.idle && anims.length) CHAR.clips.idle = anims[0];
  const fill = (key, src) => { if (!CHAR.clips[key] && src) CHAR.clips[key] = src; };
  fill('fall', CHAR.clips.jump || CHAR.clips.idle);
  fill('jump', CHAR.clips.fall || CHAR.clips.idle);
  fill('run',  CHAR.clips.idle);
  for (const k of Object.keys(CHAR.clips)) {
    if (!CHAR.clips[k]) delete CHAR.clips[k];
  }

  if (meshCount === 0) {
    console.warn('[IPG] GLB 에 메시가 없습니다 — 절차적 캐릭터를 유지합니다');
    return;
  }

  CHAR.scene = root;
  CHAR.size = m.size;
  CHAR.meshCount = meshCount;
  CHAR.skinned = skinned;
  CHAR.animNames = anims.map((a) => a.name);
  CHAR.ready = true;
  /* 대기 화면이 떠 있으면 절차적 캐릭터로 세워 둔 미리보기를 진짜 모델로
   * 교체합니다. key 에 'm'/'p' 가 들어 있어 자동으로 갈립니다. */
  if (typeof refreshAvPreview === 'function') { try { refreshAvPreview(); } catch (e) {} }

  console.log(
    '[IPG] 3D 캐릭터 로드 완료\n' +
    '  원본 크기 : ' + fmtDim(m.size) + (m.valid ? '' : '  (측정 실패)') + '\n' +
    '  적용 배율 : ' + CHAR.scale.toFixed(4) + '  (목표 키 ' + MODEL_HEIGHT + ')\n' +
    '  메시      : ' + meshCount + '개 (스킨드 ' + skinned + '개)\n' +
    '  애니메이션: ' + (anims.length ? anims.map((a) => a.name).join(', ') : '없음 (정지 자세로 표시됩니다)') + '\n' +
    '  배정 방식 : ' + (CHAR.clipMode || '이름 기준') + '\n' +
    '  매칭 결과 : ' + (Object.keys(CHAR.clips).length
      ? Object.keys(CHAR.clips).map((k) => k + '=' + CHAR.clips[k].name).join(' / ')
      : '없음')
  );

  if (m.valid && m.size.y > 1e-6 && m.size.z > m.size.y * 1.6) {
    console.warn('[IPG] 모델이 누워 있는 것 같습니다 (깊이 > 높이). ' +
      'index.html 의 MODEL_ROTATION_X 를 -Math.PI/2 로 바꿔 보세요.');
  }

  rebuildAllAvatars();
}

/* 모델이 늦게 도착해도 이미 만들어진 캐릭터를 그 자리에서 교체합니다 */
function rebuildAllAvatars() {
  for (const rec of G.players.values()) {
    if (!rec || !rec.avatar || !rec.avatar.group) continue;
    actorGroup.remove(rec.avatar.group);
    rec.avatar = buildAvatar(rec.color, rec.name, rec.seat);
    actorGroup.add(rec.avatar.group);
  }
  if (typeof local !== 'undefined' && local && local.avatar) {
    actorGroup.remove(local.avatar.group);
    local.avatar = buildAvatar(local.color, G.name || '나', local.seat);
    actorGroup.add(local.avatar.group);
  }
}

/* seat 은 '몇 번 좌석인가'입니다 (0-based). 색과 별개로 링 모양과 이름표
 * 번호 칩을 정합니다 — 색각이상에서도 구분되게 하려는 것이라, 색을 넘기는
 * 곳에는 반드시 seat 도 같이 넘겨야 합니다. 관전자처럼 좌석이 없으면
 * undefined 를 넘기면 되고, 그때는 기본 모양(실선)에 번호 칩이 빠집니다. */
function buildAvatar(colorHex, name, seat) {
  return CHAR.ready ? buildModelAvatar(colorHex, name, seat)
                    : buildProceduralAvatar(colorHex, name, seat);
}

function buildModelAvatar(colorHex, name, seat) {
  const group = new THREE.Group();
  const col = new THREE.Color(colorHex);

  const model = (THREE.SkeletonUtils && THREE.SkeletonUtils.clone)
    ? THREE.SkeletonUtils.clone(CHAR.scene)
    : CHAR.scene.clone(true);

  /* 컨테이너에 담아 보정합니다. 모델 자신의 스케일/회전/위치는 그대로 둡니다.
   * (Sketchfab 모델은 루트에 0.01 같은 스케일을 갖고 있는 경우가 많습니다) */
  const holder = new THREE.Group();
  holder.add(model);
  group.add(holder);
  fitAvatarScale(holder);

  /* 머티리얼을 인스턴스마다 복제해 좌석 색을 입힙니다.
   * 분류는 tintKindOf 규칙이고, 상의는 100%, 하의·신발은 옅게 칠합니다. */
  const skinMats = [];
  let strongHits = 0, weakHits = 0;
  const tintable = [];        // 폴백용 — 피부/얼굴/눈/머리가 아닌 것들
  model.traverse((o) => {
    if (!o.isMesh && !o.isSkinnedMesh) return;
    const src = Array.isArray(o.material) ? o.material : [o.material];
    const cloned = src.map((m) => {
      if (!m) return m;
      const c = m.clone();
      const kind = tintKindOf(c.name);
      if (c.color) {
        if (kind === 'strong') { c.color.copy(col); strongHits++; }
        else if (kind === 'weak') { c.color.copy(col).lerp(WHITE_C, 0.55); weakHits++; }
        if (kind !== 'never') tintable.push(c);
      }
      if (c.emissive) {
        c.emissive.copy(col).multiplyScalar(0.16);
        c.emissiveIntensity = 1.0;
      }
      skinMats.push(c);
      return c;
    });
    o.material = Array.isArray(o.material) ? cloned : cloned[0];
  });

  /* ★ 폴백 — 이게 이 블록의 존재 이유입니다.
   * 종전 규칙은 'accent'|'suit' 였는데 character.glb 의 머티리얼 이름은
   * VRoid 규칙(N00_007_01_Tops_01_CLOTH …)이라 13개 중 0개가 맞았습니다.
   * 즉 좌석 색이 몸에 전혀 안 칠해지는데 아무 데도 티가 안 났습니다.
   * 모델을 갈아끼울 때 같은 일이 반복되므로, 아무것도 못 맞히면 경고를
   * 찍고 피부/얼굴/눈/머리를 뺀 나머지를 옅게라도 칠해 둡니다.        */
  if (strongHits === 0 && weakHits === 0) {
    /* ★ 전신을 칠하게 되는 경우의 혼합비.
     *   0.5 는 옷 머티리얼만 따로 칠할 때의 값이라, 전신에 쓰면 네 좌석이
     *   탁한 베이지로 수렴해 노랑과 초록이 구분되지 않습니다. 단일 아틀라스
     *   모델(머티리얼 이름으로 부위를 못 가르는 모델)로 갈아끼운다면
     *   네 색을 나란히 렌더해 보고 0.22 + 발광 0.28 쯤으로 내리세요.      */
    for (const c of tintable) c.color.copy(col).lerp(WHITE_C, 0.5);
    if (!tintWarned) {
      tintWarned = true;
      console.warn('[IPG] 좌석 색을 칠할 옷 머티리얼을 못 찾았습니다 — ' +
        '모델 머티리얼 이름: ' + skinMats.map((m) => m.name || '(무명)').join(', ') +
        ' · index.html 의 TINT_STRONG / TINT_WEAK 규칙을 이 이름에 맞추세요.');
    }
  }

  const ring = makeColorRing(col, seat);
  group.add(ring);

  const blob = makeShadowBlob();
  group.add(blob);

  const plate = makeNameplate(name, colorHex, seat);
  plate.position.y = MODEL_HEIGHT + 0.85;
  group.add(plate);

  const mixer = new THREE.AnimationMixer(model);
  const actions = {};
  for (const key of Object.keys(CHAR.clips)) {
    const act = mixer.clipAction(CHAR.clips[key]);
    if (key === 'dead') { act.setLoop(THREE.LoopOnce, 1); act.clampWhenFinished = true; }
    actions[key] = act;
  }
  const startKey = actions.idle ? 'idle' : Object.keys(actions)[0];
  if (startKey) actions[startKey].play();

  return {
    isModel: true,
    group, holder, model, mixer, actions, ring, blob, plate, skinMats,
    height: MODEL_HEIGHT,
    current: startKey || null,
    clock: 0
  };
}

/* ---------------------------------------------------------------------------
 * 조립된 아바타의 실제 월드 크기를 재서 배율을 확정합니다.
 *
 * 모델 하나만 따로 재는 것보다 이 방식이 확실합니다. 부모 계층의 스케일,
 * bindMatrix 상쇄, Blender 가 정점에 구워 넣은 스케일 등 무슨 사정이 있든
 * "화면에 그려지는 크기" 를 직접 재서 맞추기 때문입니다.
 * 한 번 보정한 뒤 다시 재서 오차가 남으면 한 번 더 잡습니다.
 * ------------------------------------------------------------------------- */
function fitAvatarScale(holder) {
  if (MODEL_SCALE > 0) {
    holder.scale.setScalar(MODEL_SCALE);
    const m0 = measureObject(holder);
    if (m0.valid) holder.position.set(-((m0.box.min.x + m0.box.max.x) / 2), -m0.box.min.y,
                                      -((m0.box.min.z + m0.box.max.z) / 2));
    return;
  }

  holder.scale.setScalar(1);
  holder.position.set(0, 0, 0);

  for (let pass = 0; pass < 2; pass++) {
    const m = measureObject(holder);
    if (!m.valid || m.size.y <= 1e-9) {
      console.warn('[IPG] 모델 크기를 잴 수 없습니다. index.html 의 MODEL_SCALE 에 ' +
                   '배율을 직접 넣어 주세요 (예: const MODEL_SCALE = 0.01;)');
      holder.scale.setScalar(1);
      return;
    }
    const k = MODEL_HEIGHT / m.size.y;
    if (Math.abs(k - 1) < 0.002) break;              // 이미 목표 크기
    holder.scale.multiplyScalar(k);
    holder.updateMatrixWorld(true);
  }

  // 발끝을 y=0 에, 가로 중심을 원점에 맞춥니다
  const f = measureObject(holder);
  if (f.valid) {
    holder.position.set(
      -((f.box.min.x + f.box.max.x) / 2),
      -f.box.min.y,
      -((f.box.min.z + f.box.max.z) / 2)
    );
    CHAR.scale = holder.scale.x;
    CHAR.fitted = { h: f.size.y, scale: holder.scale.x };
  }
}

function crossFadeTo(av, key, dur) {
  if (!av.actions || !av.actions[key] || av.current === key) return;
  const next = av.actions[key];
  const prev = av.current ? av.actions[av.current] : null;
  next.reset();
  next.setEffectiveWeight(1);
  next.enabled = true;
  next.play();
  if (prev && prev !== next) prev.crossFadeTo(next, dur === undefined ? 0.18 : dur, false);
  av.current = key;
}

/* ---------------------------------------------------------------------------
 * 공통 부속: 플레이어 색 링 + 접지 그림자
 * ------------------------------------------------------------------------- */
/* ── 좌석 색을 어느 머티리얼에 칠할지 ────────────────────────────────
 * 이름 규칙으로 고릅니다. 모델러가 붙인 이름을 그대로 읽으므로 모델을
 * 바꾸면 여기를 손봐야 합니다 — 못 맞히면 buildModelAvatar 가 콘솔에
 * 경고를 찍습니다(조용히 죽지 않게 하는 것이 요점입니다).
 *
 *   never  : 절대 칠하지 않음. 피부·얼굴·눈·머리를 물들이면 사람이
 *            아니라 색덩어리가 됩니다. 가장 먼저 걸러야 합니다.
 *   strong : 상의. 100% 좌석 색 — 원거리에서 이걸로 구분합니다.
 *   weak   : 하의·신발. 옅게만 — 전신을 같은 색으로 칠하면 촌스럽고,
 *            상의의 '유니폼' 느낌이 죽습니다.
 *
 * ★ 순서가 중요합니다. VRoid 이름 N00_007_01_Tops_01_CLOTH 는 tops 와
 *   _cloth 를 둘 다 갖고 있어서, weak 를 먼저 보면 상의가 옅어집니다.
 * ------------------------------------------------------------------ */
const TINT_NEVER  = /(_skin|_face|_eye|hair|brow|eyeline|mouth|iris|highlight)/;
const TINT_STRONG = /(tops|shirt|jacket|jersey|torso|accent|suit)/;
const TINT_WEAK   = /(bottoms|pants|skirt|shoes|boots|_cloth)/;
let tintWarned = false;      // 경고는 방 전체에서 한 번만

function tintKindOf(name) {
  const nm = (name || '').toLowerCase();
  if (TINT_NEVER.test(nm)) return 'never';
  if (TINT_STRONG.test(nm)) return 'strong';
  if (TINT_WEAK.test(nm)) return 'weak';
  return 'none';
}

/* ── 발밑 좌석 링 ─────────────────────────────────────────────────────
 * ★ 색이 아니라 '모양'으로도 갈립니다.
 *   좌석 색만으로 구분하면 적록색약(남성 약 8%)에서 노랑(#ffcc00)과
 *   연두(#66ff66)가 거의 붙습니다. 모양은 색각과 무관하게 읽히므로
 *   이름표의 좌석 번호 칩과 함께 '색에 의존하지 않는' 두 번째 단서입니다.
 *
 * ★ 왜 하필 발밑인가 — 이 게임은 내려다보는 시점이라 링이 항상 타일
 *   위에 평평하게 깔려 보입니다. 캐릭터 뒷모습·역광·어둠 층에서도
 *   가려지지 않는 거의 유일한 자리입니다.
 *
 * 좌석이 늘어도(MAX_PLAYERS 변경) seat % 4 로 순환하므로 터지지 않습니다.
 * 이때 모양이 겹치는 두 사람은 색으로 갈립니다.
 * ------------------------------------------------------------------ */

/* 좌석별 링 지오메트리는 아바타마다 새로 만들지 않고 공유합니다
 * (아바타는 라운드마다 재생성되는데 지오메트리는 그대로 써도 됩니다) */
const ringGeoCache = new Map();

function ringGeosFor(shape) {
  let arr = ringGeoCache.get(shape);
  if (arr) return arr;
  const R = THREE.RingGeometry;
  const TAU = Math.PI * 2;
  if (shape === 1) {
    arr = [new R(0.58, 0.70, 32), new R(0.86, 1.00, 32)];              // 이중선
  } else if (shape === 2) {
    arr = [];                                                          // 점선 8토막
    for (let i = 0; i < 8; i++) arr.push(new R(0.72, 1.00, 6, 1, (i / 8) * TAU, TAU / 16));
  } else if (shape === 3) {
    arr = [new R(0.72, 0.96, 32)];                                     // 실선 + 삼각 마커
    for (let i = 0; i < 3; i++) arr.push(new R(1.02, 1.34, 3, 1, (i / 3) * TAU, TAU / 14));
  } else {
    arr = [new R(0.72, 1.00, 32)];                                     // 실선 (종전과 동일)
  }
  ringGeoCache.set(shape, arr);
  return arr;
}

function makeColorRing(col, seat) {
  const shape = ((seat === undefined || seat === null) ? 0 : seat) % 4;
  /* 머티리얼은 아바타마다 하나만 만들어 조각들이 공유합니다 —
   * 조각 수만큼 만들면 dispose 대상이 흩어져 새는 지점이 됩니다. */
  const mat = new THREE.MeshBasicMaterial({
    color: col, transparent: true, opacity: 0.85,
    side: THREE.DoubleSide, depthWrite: false, toneMapped: false
  });
  /* Group 으로 돌려줍니다. 호출부(animateAvatar)는 position.y / scale /
   * visible 만 건드리므로 Mesh 든 Group 이든 동일하게 동작합니다.     */
  const ring = new THREE.Group();
  for (const g of ringGeosFor(shape)) {
    const m = new THREE.Mesh(g, mat);
    m.rotation.x = -Math.PI / 2;
    ring.add(m);
  }
  ring.position.y = 0.07;
  return ring;
}

function makeShadowBlob() {
  const blob = new THREE.Mesh(
    new THREE.CircleGeometry(0.98, 24),
    new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.34, depthWrite: false })
  );
  blob.rotation.x = -Math.PI / 2;
  blob.position.y = 0.05;
  return blob;
}

/* 공중에 뜨면 그림자를 작고 옅게 — 3층에서 낙하할 때 착지 지점을 읽는 단서 */
function updateGroundShadow(av, feetY, groundY, grounded) {
  if (!av || !av.blob) return;
  const gap = Math.max(0, feetY - groundY);
  const t = THREE.MathUtils.clamp(1 - gap / 16, 0.18, 1);
  av.blob.scale.setScalar(t);
  av.blob.material.opacity = 0.34 * t;
  av.blob.position.y = (groundY - feetY) + 0.05;
  av.blob.visible = gap < 34;
  if (av.ring) {
    av.ring.position.y = grounded ? 0.07 : (groundY - feetY) + 0.07;
    av.ring.scale.setScalar(grounded ? 1 : t);
  }
}

/* ---------------------------------------------------------------------------
 * B) 절차적 3D 치비 캐릭터 — character.glb 가 없을 때 쓰이는 폴백.
 *    이미지 에셋을 전혀 쓰지 않고 지오메트리만으로 조립하므로,
 *    씬 조명에 제대로 반응하는 "진짜" 3D 입니다.
 * ------------------------------------------------------------------------- */
const CHIBI = {
  height:  3.30,
  headR:   0.86,   // 머리 반지름. 키우면 더 귀엽고 줄이면 동작이 또렷해집니다
  headY:   2.30,
  skin:    0xffd9be,
  hair:    0x3b2a22,
  shell:   0xf5f0e4,
  dark:    0x1c2030,
  eye:     0x2a1d16
};

function makeLimb(len, rad, limbMat, capMat, capScale) {
  const pivot = new THREE.Group();
  const seg = new THREE.Mesh(new THREE.CapsuleLikeGeometry(rad, len), limbMat);
  seg.position.y = -len / 2;
  seg.castShadow = true;
  pivot.add(seg);
  const cap = new THREE.Mesh(new THREE.SphereGeometry(rad * 1.32, 14, 12), capMat);
  cap.position.y = -len;
  if (capScale) cap.scale.set(capScale[0], capScale[1], capScale[2]);
  cap.castShadow = true;
  pivot.add(cap);
  return pivot;
}

/* three r128 에는 CapsuleGeometry 가 없어서 원기둥으로 대체합니다 */
THREE.CapsuleLikeGeometry = function (rad, len) {
  return new THREE.CylinderGeometry(rad, rad * 0.94, len, 12);
};

function buildProceduralAvatar(colorHex, name, seat) {
  const group = new THREE.Group();
  const col = new THREE.Color(colorHex);
  const C = CHIBI;

  const suitMat = new THREE.MeshStandardMaterial({
    color: col, roughness: 0.45, metalness: 0.06,
    emissive: col.clone().multiplyScalar(0.14), emissiveIntensity: 1.0
  });
  const skinMat = new THREE.MeshStandardMaterial({ color: C.skin, roughness: 0.66, metalness: 0.0 });
  const hairMat = new THREE.MeshStandardMaterial({ color: C.hair, roughness: 0.55, metalness: 0.05 });
  const shellMat = new THREE.MeshStandardMaterial({ color: C.shell, roughness: 0.42, metalness: 0.04 });
  const darkMat = new THREE.MeshStandardMaterial({ color: C.dark, roughness: 0.5, metalness: 0.2 });
  const eyeMat = new THREE.MeshStandardMaterial({ color: C.eye, roughness: 0.25, metalness: 0.0 });
  const glossMat = new THREE.MeshBasicMaterial({ color: 0xffffff, toneMapped: false });
  const bulbMat = new THREE.MeshStandardMaterial({ color: 0xffd166, emissive: 0xffc233, emissiveIntensity: 2.2 });

  /* --- 몸통 --- */
  const bodyPivot = new THREE.Group();
  group.add(bodyPivot);

  const torso = new THREE.Mesh(new THREE.SphereGeometry(0.66, 22, 18), suitMat);
  torso.scale.set(1.0, 0.96, 0.86);
  torso.position.y = 1.16;
  torso.castShadow = true;
  bodyPivot.add(torso);

  const collar = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.46, 0.18, 18), shellMat);
  collar.position.y = 1.66;
  collar.castShadow = true;
  bodyPivot.add(collar);

  const badge = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 0.06, 18), shellMat);
  badge.rotation.x = Math.PI / 2;
  badge.position.set(0, 1.22, 0.56);
  bodyPivot.add(badge);
  const badgeCore = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.11, 0.08, 14), bulbMat);
  badgeCore.rotation.x = Math.PI / 2;
  badgeCore.position.set(0, 1.22, 0.59);
  bodyPivot.add(badgeCore);

  /* --- 머리 (전부 3D 지오메트리, 텍스처 없음) --- */
  const headPivot = new THREE.Group();
  headPivot.position.y = C.headY;
  group.add(headPivot);

  const head = new THREE.Mesh(new THREE.SphereGeometry(C.headR, 28, 22), skinMat);
  head.scale.set(1.0, 0.98, 0.96);
  head.castShadow = true;
  headPivot.add(head);

  // 머리카락: 윗머리 캡 + 뒷머리 + 앞머리 세 덩어리
  const hairTop = new THREE.Mesh(
    new THREE.SphereGeometry(C.headR * 1.05, 28, 20, 0, Math.PI * 2, 0, 0.95), hairMat);
  hairTop.scale.copy(head.scale);
  hairTop.castShadow = true;
  headPivot.add(hairTop);

  const hairBack = new THREE.Mesh(
    new THREE.SphereGeometry(C.headR * 1.04, 24, 16,
      Math.PI / 2 + 0.80, Math.PI * 2 - 1.60, 0.70, 0.95), hairMat);
  hairBack.scale.copy(head.scale);
  headPivot.add(hairBack);

  for (const [bx, bsz, brot] of [[-0.40, 0.24, -0.30], [0.02, 0.27, 0.06], [0.42, 0.22, 0.32]]) {
    const bang = new THREE.Mesh(new THREE.SphereGeometry(bsz, 12, 10), hairMat);
    bang.position.set(bx, C.headR * 0.62, C.headR * 0.66);
    bang.scale.set(1.25, 0.62, 0.62);
    bang.rotation.z = brot;
    bang.castShadow = true;
    headPivot.add(bang);
  }

  // 눈: 반구 + 하이라이트 (평면 데칼이 아니라 실제 볼륨)
  const eyes = [];
  for (const sx of [-1, 1]) {
    const eye = new THREE.Mesh(new THREE.SphereGeometry(0.145, 16, 14), eyeMat);
    eye.position.set(sx * 0.33, 0.02, C.headR * 0.80);
    eye.scale.set(0.85, 1.0, 0.55);
    headPivot.add(eye);
    eyes.push(eye);

    const gloss = new THREE.Mesh(new THREE.SphereGeometry(0.052, 10, 8), glossMat);
    gloss.position.set(sx * 0.30, 0.07, C.headR * 0.86);
    headPivot.add(gloss);

    // 눈썹
    const brow = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.05, 0.06), hairMat);
    brow.position.set(sx * 0.33, 0.24, C.headR * 0.80);
    brow.rotation.z = sx * -0.12;
    headPivot.add(brow);
  }

  // 코 + 입 (작은 볼륨)
  const nose = new THREE.Mesh(new THREE.SphereGeometry(0.06, 10, 8), skinMat);
  nose.position.set(0, -0.12, C.headR * 0.96);
  headPivot.add(nose);

  const mouth = new THREE.Mesh(new THREE.TorusGeometry(0.10, 0.026, 8, 18, Math.PI), eyeMat);
  mouth.position.set(0, -0.30, C.headR * 0.84);
  mouth.rotation.x = -0.25;
  mouth.rotation.z = Math.PI;
  headPivot.add(mouth);

  // 귀
  for (const sx of [-1, 1]) {
    const ear = new THREE.Mesh(new THREE.SphereGeometry(0.15, 12, 10), skinMat);
    ear.position.set(sx * C.headR * 0.96, -0.06, 0);
    ear.scale.set(0.45, 1.0, 0.80);
    headPivot.add(ear);
  }

  // 특허 전구 안테나
  const antenna = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.42, 8), darkMat);
  antenna.position.set(0.20, C.headR * 0.92, 0);
  antenna.rotation.z = -0.24;
  headPivot.add(antenna);
  const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.14, 14, 12), bulbMat);
  bulb.position.set(0.29, C.headR * 0.92 + 0.24, 0);
  headPivot.add(bulb);

  /* --- 팔다리 --- */
  const armL = makeLimb(0.56, 0.155, suitMat, shellMat, [1.05, 0.9, 1.05]);
  const armR = makeLimb(0.56, 0.155, suitMat, shellMat, [1.05, 0.9, 1.05]);
  armL.position.set(-0.64, 1.44, 0);
  armR.position.set(0.64, 1.44, 0);
  armL.rotation.z = 0.20;
  armR.rotation.z = -0.20;

  const legL = makeLimb(0.50, 0.185, darkMat, shellMat, [1.0, 0.85, 1.25]);
  const legR = makeLimb(0.50, 0.185, darkMat, shellMat, [1.0, 0.85, 1.25]);
  legL.position.set(-0.27, 0.72, 0);
  legR.position.set(0.27, 0.72, 0);

  group.add(armL, armR, legL, legR);

  const ring = makeColorRing(col, seat);
  group.add(ring);
  const blob = makeShadowBlob();
  group.add(blob);
  const plate = makeNameplate(name, colorHex, seat);
  plate.position.y = C.height + 0.85;
  group.add(plate);

  return {
    isModel: false,
    group, bodyPivot, torso, headPivot, eyes, mouth,
    armL, armR, legL, legR, ring, blob, plate,
    skinMats: [suitMat, shellMat],
    height: C.height,
    phase: Math.random() * 6.28,
    clock: 0,
    landSquash: 0,
    baseArmZ: 0.20
  };
}

/* ---------------------------------------------------------------------------
 * 애니메이션 — GLB 는 클립 크로스페이드, 절차적은 진자 + 스쿼시
 * ------------------------------------------------------------------------- */
/* ── 달리기 클립 재생속도 ─────────────────────────────────────────────
 * ★ 발이 땅에 붙어 있으려면 재생속도가 이동속도에 "비례"해야 합니다.
 *   한 걸음에 나아가는 거리는 클립이 정한 고정값이므로,
 *       초당 걸음수 × 걸음거리 = 이동속도
 *   여야 발이 제자리에 심어집니다. 비례가 깨지면 심은 발이 땅 위를
 *   미끄러지고, 그게 '앞으로 갔는데 발이 뒤로 밀리는' 느낌이 됩니다.
 *
 * ★ 종전 공식 0.7 + speed01*0.9 는 비례가 아니라 '오프셋 + 비례' 였습니다.
 *   속도당 재생값이 걷기 0.0885 / 질주 0.0744 로 19% 어긋나고,
 *   저속에서는 상수항 0.7 이 지배해 속도 2 에서 5배까지 벌어집니다
 *   (제자리걸음에 가까운데 다리는 거의 전속으로 젓습니다).
 *
 * ★ STRIDE_REF 는 '클립이 원래 상정한 이동속도'입니다. 이 값에서 재생속도
 *   1.0 이 되고, 나머지는 전부 여기서 비례로 나옵니다. 질주(21.5)에서
 *   종전과 같은 1.6 이 나오도록 21.5/1.6 = 13.44 로 잡았습니다 —
 *   가장 오래 보는 속도의 그림을 바꾸지 않으면서 비례만 되돌립니다.
 *   발이 여전히 미끄러지면 이 숫자 하나만 올리거나 내리면 됩니다
 *   (크게 잡을수록 다리를 천천히 젓습니다).
 */
const STRIDE_REF = 13.44;
const RUN_TS_MIN = 0.35;   // 크로스페이드 도중 0 이 되어 클립이 얼어붙지 않게

function runTimeScale(speed01) {
  const speed = speed01 * PHYS.SPRINT;
  return Math.max(RUN_TS_MIN, speed / STRIDE_REF);
}

function animateAvatar(av, dt, speed01, state) {
  if (!av) return;
  av.clock += dt;

  /* --- A) GLB 모델 --- */
  if (av.isModel) {
    let key = av.actions[state] ? state : 'idle';
    crossFadeTo(av, key, state === 'dead' ? 0.12 : 0.18);
    if (av.actions.run) av.actions.run.setEffectiveTimeScale(runTimeScale(speed01));
    av.mixer.update(dt);
    av.plate.visible = state !== 'dead';
    if (av.ring) av.ring.visible = state !== 'dead';
    return;
  }

  /* --- B) 절차적 캐릭터 --- */
  const L = (a, b, k) => THREE.MathUtils.lerp(a, b, Math.min(1, k));

  if (state === 'dead') {
    av.group.rotation.x = Math.min(av.group.rotation.x + dt * 3.6, Math.PI / 2.15);
    av.group.rotation.z = Math.sin(av.clock * 5.5) * 0.10;
    av.headPivot.rotation.z = Math.sin(av.clock * 9) * 0.20;
    av.armL.rotation.x = L(av.armL.rotation.x, -0.6, dt * 6);
    av.armR.rotation.x = L(av.armR.rotation.x, -0.6, dt * 6);
    av.legL.rotation.x = L(av.legL.rotation.x, 0.5, dt * 6);
    av.legR.rotation.x = L(av.legR.rotation.x, 0.5, dt * 6);
    av.eyes.forEach((e) => e.scale.set(0.85, 0.22, 0.55));
    av.plate.visible = false;
    if (av.ring) av.ring.visible = false;
    return;
  }
  av.plate.visible = true;
  if (av.ring) av.ring.visible = true;
  av.group.rotation.x *= 0.82;
  av.group.rotation.z *= 0.82;
  av.eyes.forEach((e) => e.scale.set(0.85, 1.0, 0.55));

  /* 스쿼시 & 스트레치 */
  let sx = 1, sy = 1;
  if (state === 'jump') { sy = 1.16; sx = 0.90; av.landSquash = 1; }
  else if (state === 'fall') { sy = 1.08; sx = 0.95; av.landSquash = 1; }
  else if (av.landSquash > 0) {
    av.landSquash = Math.max(0, av.landSquash - dt * 5.0);
    sy = 1 - av.landSquash * 0.28;
    sx = 1 + av.landSquash * 0.22;
  }
  const sm = smoothK(20, dt);
  av.group.scale.set(L(av.group.scale.x, sx, sm), L(av.group.scale.y, sy, sm), L(av.group.scale.z, sx, sm));

  /* 공중 포즈 */
  if (state === 'jump' || state === 'fall') {
    const up = state === 'jump';
    av.armL.rotation.x = L(av.armL.rotation.x, up ? -2.4 : -1.5, dt * 11);
    av.armR.rotation.x = L(av.armR.rotation.x, up ? -2.4 : -1.5, dt * 11);
    av.armL.rotation.z = L(av.armL.rotation.z, av.baseArmZ + 0.32, dt * 11);
    av.armR.rotation.z = L(av.armR.rotation.z, -av.baseArmZ - 0.32, dt * 11);
    av.legL.rotation.x = L(av.legL.rotation.x, up ? -0.72 : -0.28, dt * 11);
    av.legR.rotation.x = L(av.legR.rotation.x, up ? -0.34 : 0.28, dt * 11);
    av.bodyPivot.rotation.x = L(av.bodyPivot.rotation.x, up ? -0.14 : 0.16, dt * 9);
    av.headPivot.rotation.x = L(av.headPivot.rotation.x, up ? -0.18 : 0.14, dt * 9);
    av.headPivot.position.y = L(av.headPivot.position.y, CHIBI.headY, dt * 9);
    return;
  }

  /* 지상: 진자 러닝 + 머리 관성 */
  av.phase += dt * (4.2 + speed01 * 11.0);
  const s = Math.sin(av.phase);
  const amp = 0.16 + speed01 * 1.0;

  av.legL.rotation.x = s * amp;
  av.legR.rotation.x = -s * amp;
  av.armL.rotation.x = -s * amp * 0.9;
  av.armR.rotation.x = s * amp * 0.9;
  av.armL.rotation.z = L(av.armL.rotation.z, av.baseArmZ + speed01 * 0.16, dt * 10);
  av.armR.rotation.z = L(av.armR.rotation.z, -av.baseArmZ - speed01 * 0.16, dt * 10);

  const bounce = Math.abs(Math.sin(av.phase)) * (0.03 + speed01 * 0.10);
  av.bodyPivot.position.y = L(av.bodyPivot.position.y, bounce, dt * 18);
  av.headPivot.position.y = L(av.headPivot.position.y, CHIBI.headY + bounce * 1.30, dt * 11);
  av.bodyPivot.rotation.x = L(av.bodyPivot.rotation.x, speed01 * 0.17, dt * 8);
  av.headPivot.rotation.x = L(av.headPivot.rotation.x, -speed01 * 0.10 + Math.sin(av.phase) * 0.03, dt * 7);
  av.headPivot.rotation.z = Math.sin(av.phase * 0.5) * (0.02 + speed01 * 0.05);

  if (speed01 < 0.05) {
    const breathe = Math.sin(av.clock * 1.9) * 0.016;
    av.torso.scale.set(1.0, 0.96 + breathe, 0.86);
  } else {
    av.torso.scale.set(1.0, 0.96, 0.86);
  }
}

/* ============================ 6. local runner =========================== */

const local = {
  /* 아래 위치·층 값은 init 이 서버 스폰으로 곧바로 덮어씁니다.
   * 층 높이를 여기 박아 두면 층 구성이 바뀔 때마다 같이 고쳐야 합니다. */
  pos: new THREE.Vector3(0, 0, 0),
  vel: new THREE.Vector3(0, 0, 0),
  /* ── 렌더 보간용 ──────────────────────────────────────────────────
   * pos 는 '마지막 물리 스텝이 끝난 위치'라 60Hz 격자 위에서만 움직입니다.
   * 화면 주사율은 그 격자와 정확히 맞지 않으므로, pos 를 그대로 그리면
   * 어떤 프레임은 스텝이 0번(제자리), 어떤 프레임은 2번(두 배로 튐) 돌아
   * 미세한 덜컹임이 생깁니다. prev(직전 스텝 위치)와 alpha(남은 누산기
   * 비율)로 그 사이를 메워 그립니다.
   *
   * ★ 물리·네트워크는 계속 pos 만 씁니다. render 는 오직 그리기 전용입니다 —
   *   물리에까지 보간값을 쓰면 판정이 프레임률에 따라 달라집니다.       */
  prev: new THREE.Vector3(0, 0, 0),
  render: new THREE.Vector3(0, 0, 0),
  alpha: 1,
  ry: 0,
  grounded: false,
  groundTile: null,
  lastGroundY: 0,      // 마지막으로 서 있던 바닥 높이
  jumped: false,       // 점프로 떠올랐는지 (발을 헛디딘 것과 구분)
  layer: 0,
  anim: 'idle',
  avatar: null,
  coyote: 0,
  jumpBuffer: 0,
  alive: true,
  seat: null,        // 내 좌석 번호 (대기 발판 매칭용)
  dying: 0,          // >0 이면 구름바다로 잠기는 연출 진행 중
  color: '#ffcc00',
  /* 낙하가 시작된 시점에 확정하는 사인. 밀려서 떨어졌으면 민 사람의 id 입니다.
   * 탈락 시점이 아니라 낙하 시작 시점에 잡아야 정확합니다 — 떨어지는 데
   * 1초, 잠기는 연출에 0.75초가 더 걸려서 그때 판단하면 엉뚱한 사람이 걸립니다. */
  deathBy: null,
  deathByName: '',

  /* ── 대시(신속심사 타일) ──────────────────────────────────────────
   * 서버 player_impulse 를 받으면 채워집니다. null 이면 대시 중이 아닙니다.
   *   { dirX, dirZ, speed, remain, untilMs }
   *   remain : 남은 이동 거리(유닛). 0 이 되면 대시가 끝납니다.
   * 대시 중에는 stepPhysics 가 수평 속도 상한과 마찰을 풀어 줍니다.  */
  dash: null
};

/* ============================ 7. input ================================= */

const keys = Object.create(null);

/* ── 입력원 통합 (Input) ────────────────────────────────────────────
 *
 * ★ 왜 불리언 4개를 걷어냈나
 *   종전에는 이동이 keys['KeyW'] 같은 불리언 4개였고, 이를 더한 뒤
 *   normalize 했습니다. 키보드만 있을 때는 맞는 코드입니다. 그런데
 *   가상 스틱을 붙이면 '얼마나 기울였나'가 그 normalize 에서 통째로
 *   날아갑니다 — 살짝 민 것과 끝까지 민 것이 똑같은 전력 질주가
 *   됩니다. 그래서 입력원을 하나로 모으고 방향(fx, rx)과 세기(mag)를
 *   나눠 내보냅니다. 키보드는 mag 가 늘 1 이라 종전과 완전히 같습니다.
 *
 * ★ 왜 모바일에 '질주 버튼'을 따로 두지 않았나
 *   이 게임은 '타일이 무너지기 전에 지나가나'가 전부라 속도를 손가락에
 *   쥐고 있어야 합니다. 버튼을 따로 두면 엄지 하나로 방향과 속도를
 *   동시에 잡을 수 없습니다. 스틱 기울기가 곧 속도입니다.
 * ------------------------------------------------------------------ */
const Input = {
  /* 마지막으로 실제 입력이 들어온 곳. 속도 곡선이 이것으로 갈립니다. */
  src: 'key',
  stick: { active: false, fx: 0, rx: 0, mag: 0 },

  /* 이번 스텝의 이동 의도. fx = 앞뒤(+앞), rx = 좌우(+오른쪽).       */
  move() {
    const kf = (keys['KeyW'] || keys['ArrowUp'] ? 1 : 0) -
               (keys['KeyS'] || keys['ArrowDown'] ? 1 : 0);
    const kr = (keys['KeyD'] || keys['ArrowRight'] ? 1 : 0) -
               (keys['KeyA'] || keys['ArrowLeft'] ? 1 : 0);
    if (kf || kr) { this.src = 'key'; return { fx: kf, rx: kr, mag: 1 }; }
    if (this.stick.active && this.stick.mag > 0) {
      this.src = 'stick';
      return { fx: this.stick.fx, rx: this.stick.rx, mag: this.stick.mag };
    }
    return { fx: 0, rx: 0, mag: 0 };
  },

  /* 세기 → 최고 속도.
   *   키보드: 종전 그대로 두 단계(Shift).
   *   스틱  : 기울기에 따라 연속. 0.6 까지가 걷기, 그 위가 질주
   *           구간입니다. 살금살금 다가가 타일 가장자리에 서는
   *           조작이 폰에서도 됩니다 — 이게 안 되면 붕괴 직전 타일
   *           앞에서 멈출 방법이 없어 게임이 달리기만 남습니다.    */
  speedFor(mag) {
    if (this.src === 'key') {
      return (keys['ShiftLeft'] || keys['ShiftRight']) ? PHYS.SPRINT : PHYS.MOVE;
    }
    const walk = PHYS.MOVE * 0.45;
    if (mag <= 0.6) return walk + (PHYS.MOVE - walk) * (mag / 0.6);
    return PHYS.MOVE + (PHYS.SPRINT - PHYS.MOVE) * ((mag - 0.6) / 0.4);
  },

  jump() { local.jumpBuffer = 0.16; },

  /* 눌려 있는 것을 전부 뗀 것으로 칩니다.
   * ★ 화면을 덮는 창(ESC 메뉴)을 열 때 필요합니다. 창이 뜨는 순간
   *   keyup 은 오지 않는데 keys[] 는 true 로 남아 있어서, 창을 닫으면
   *   그동안 눌려 있던 방향으로 그대로 달려 나갑니다 — 나가려다 만
   *   사람이 그 자리에서 떨어지는 결과가 됩니다.                  */
  releaseAll() {
    for (const k in keys) keys[k] = false;
    this.stick.active = false;
    this.stick.fx = this.stick.rx = this.stick.mag = 0;
  }
};

window.addEventListener('keydown', (e) => {
  if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) e.preventDefault();
  keys[e.code] = true;
  if (e.code === 'Space') { Input.src = 'key'; Input.jump(); }
});
window.addEventListener('keyup', (e) => { keys[e.code] = false; });
window.addEventListener('blur', () => { for (const k in keys) keys[k] = false; });

/* minDist/maxDist/height 는 타일 크기에 따라 applyWorldScale 이 다시 채웁니다.
 * userZoomed 는 사용자가 휠을 돌린 적이 있는지 — 있으면 맵이 새로 깔려도
 * 사용자가 맞춰 둔 줌을 존중해 강제로 되돌리지 않습니다.               */
const cam = {
  /* 초기 피치는 지상 자동 피치(0.5)와 같아야 합니다. 종전 0.62 는 라운드가
   * 시작되면 0.5 로 천천히 수렴하는데, 시정수가 1.1초라 첫 2~3초 동안
   * 카메라가 계속 기울어집니다 — 진단에서 잡힌 '피치폭 0.099' 가 이것입니다.
   * 끊김은 아니지만 라운드 시작마다 화면이 미세하게 흘러내립니다. */
  yaw: 0, pitch: 0.5, dist: CAM.DIST, targetDist: CAM.DIST, height: CAM.HEIGHT,
  minDist: CAM.MIN, maxDist: CAM.MAX, scale: 1, userZoomed: false,
  dragging: false, lx: 0, ly: 0
};

/* ── 시점 조작 ──────────────────────────────────────────────────────
 *
 * ★ 왜 mouse* 를 pointer* 로 바꿨나
 *   모바일 브라우저는 터치를 마우스 이벤트로 합성해 주기는 하지만
 *   '탭 한 번'에 대해서만입니다. 드래그는 스크롤 제스처로 가로채이고,
 *   핀치는 wheel 로 오지 않습니다 — 그래서 폰에서는 시점을 돌릴 수도,
 *   줌을 바꿀 수도 없었습니다. pointer 는 마우스·터치·펜을 한 경로로
 *   받으므로 데스크톱 동작은 그대로 두고 터치만 더할 수 있습니다.
 *
 * ★ 이동 영역(#tMove)과 점프 버튼은 별도 DOM 요소라 여기로 내려오지
 *   않습니다. 즉 '왼쪽은 이동, 나머지는 시점' 이 좌표 비교 없이
 *   DOM 만으로 갈라집니다.                                        */
const camPts = new Map();        // pointerId → {x, y} · 핀치 판정용
let pinchSpan0 = 0, pinchDist0 = 0;
const pinchSpan = () => {
  const a = [...camPts.values()];
  return a.length < 2 ? 0 : Math.hypot(a[0].x - a[1].x, a[0].y - a[1].y);
};

renderer.domElement.addEventListener('pointerdown', (e) => {
  camPts.set(e.pointerId, { x: e.clientX, y: e.clientY });
  if (camPts.size === 1) {
    cam.dragging = true; cam.lx = e.clientX; cam.ly = e.clientY;
  } else if (camPts.size === 2) {
    /* 두 손가락은 회전이 아니라 줌입니다. 여기서 회전을 끊지 않으면
     * 핀치하는 동안 화면이 같이 빙빙 돕니다.                       */
    cam.dragging = false;
    pinchSpan0 = pinchSpan();
    pinchDist0 = cam.targetDist;
  }
  if (e.pointerType === 'touch') e.preventDefault();
}, { passive: false });

window.addEventListener('pointermove', (e) => {
  if (camPts.has(e.pointerId)) camPts.set(e.pointerId, { x: e.clientX, y: e.clientY });
  if (camPts.size === 2 && pinchSpan0 > 0) {
    /* 비율로 다뤄야 화면 크기와 무관하게 같은 느낌이 납니다.
     * 손가락 사이가 벌어지면(k>1) 가까이 당깁니다.                */
    const k = Math.max(0.2, pinchSpan() / pinchSpan0);
    cam.userZoomed = true;
    cam.targetDist = THREE.MathUtils.clamp(pinchDist0 / k, cam.minDist, cam.maxDist);
    return;
  }
  if (!cam.dragging) return;
  /* 엄지 이동 거리는 마우스보다 짧습니다. 같은 감도로는 시점을 한 바퀴
   * 돌리는 데 여러 번 쓸어야 해서, 터치만 1.6배로 둡니다.          */
  const k = e.pointerType === 'touch' ? 1.6 : 1;
  cam.yaw -= (e.clientX - cam.lx) * 0.0055 * k;
  cam.pitch = THREE.MathUtils.clamp(cam.pitch + (e.clientY - cam.ly) * 0.0042 * k, 0.08, 1.36);
  cam.lx = e.clientX; cam.ly = e.clientY;
});

const camPointerUp = (e) => {
  camPts.delete(e.pointerId);
  if (camPts.size < 2) pinchSpan0 = 0;
  if (camPts.size === 0) { cam.dragging = false; return; }
  /* 핀치에서 한 손가락을 떼면 남은 손가락으로 회전을 이어갑니다.
   * 기준점을 남은 손가락 자리로 다시 잡지 않으면, 두 손가락의 중간
   * 어딘가에서 지금 위치까지의 차이가 한 프레임에 적용되어 화면이
   * 훽 돌아갑니다.                                                 */
  const rest = camPts.values().next().value;
  cam.lx = rest.x; cam.ly = rest.y; cam.dragging = true;
};
window.addEventListener('pointerup', camPointerUp);
window.addEventListener('pointercancel', camPointerUp);

renderer.domElement.addEventListener('wheel', (e) => {
  e.preventDefault();
  cam.userZoomed = true;
  // 줌 감도와 한계도 월드 스케일을 따릅니다 (타일이 크면 같은 휠에 더 멀리)
  cam.targetDist = THREE.MathUtils.clamp(
    cam.targetDist + e.deltaY * 0.02 * cam.scale, cam.minDist, cam.maxDist);
}, { passive: false });

/* ── 가상 스틱 · 점프 버튼 ──────────────────────────────────────────
 *
 * ★ 스틱을 '엄지를 댄 자리에' 만드는 이유
 *   가로로 든 폰의 세로 폭은 390~430px 뿐입니다. 스틱을 고정 위치에
 *   두면 손 크기와 쥐는 방식에 따라 닿지 않는 사람이 생기고, 그러면
 *   화면을 보지 않고 손가락 위치부터 찾아야 합니다.
 *
 * ★ pointerId 를 붙들어야 하는 이유
 *   '스틱을 쥔 채 점프' 가 되려면 두 손가락이 동시에 살아 있어야
 *   합니다. id 없이 마지막 좌표만 보면 점프하는 순간 스틱이 그쪽으로
 *   끌려가 주자가 오른쪽으로 꺾입니다.                            */
const Touch = {
  R: 58,                       // 최대 기울기 반경(px). 스틱 그림의 절반.
  DEAD: 0.16,                  // 이보다 작으면 0 — 엄지를 얹어만 둔 상태
  id: null, cx: 0, cy: 0,
  move: null, stick: null, knob: null, jumpBtn: null,

  init() {
    if (!IS_TOUCH) return;
    document.body.classList.add('touch');
    this.move = $('tMove'); this.stick = $('tStick');
    this.knob = $('tKnob'); this.jumpBtn = $('tJump');
    if (!this.move) return;

    this.move.addEventListener('pointerdown', (e) => {
      if (this.id !== null) return;          // 이미 한 손가락이 쥐고 있음
      this.id = e.pointerId;
      this.cx = e.clientX; this.cy = e.clientY;
      this.stick.style.left = e.clientX + 'px';
      this.stick.style.top = e.clientY + 'px';
      this.stick.classList.add('on');
      /* 포인터를 이 요소에 묶어 둡니다. 안 묶으면 엄지가 이동 영역
       * 밖(오른쪽 시점 영역)으로 나가는 순간 입력이 끊겨 주자가
       * 제자리에 섭니다 — 대각선으로 크게 밀 때 반드시 일어납니다. */
      try { this.move.setPointerCapture(e.pointerId); } catch (err) {}
      this.apply(e.clientX, e.clientY);
      e.preventDefault();
    }, { passive: false });

    this.move.addEventListener('pointermove', (e) => {
      if (e.pointerId !== this.id) return;
      this.apply(e.clientX, e.clientY);
      e.preventDefault();
    }, { passive: false });

    const end = (e) => { if (e.pointerId === this.id) this.reset(); };
    this.move.addEventListener('pointerup', end);
    this.move.addEventListener('pointercancel', end);

    this.jumpBtn.addEventListener('pointerdown', (e) => {
      Input.src = 'stick';
      Input.jump();
      this.jumpBtn.classList.add('press');
      e.preventDefault();
    }, { passive: false });
    const unpress = () => this.jumpBtn.classList.remove('press');
    this.jumpBtn.addEventListener('pointerup', unpress);
    this.jumpBtn.addEventListener('pointercancel', unpress);

    /* 안내 문구도 조작에 맞춰야 합니다 — 키보드가 없는 기기에
     * 'WASD 이동 · SPACE 점프' 가 떠 있으면 조작법을 알 길이
     * 화면 어디에도 없습니다.                                     */
    const hk = $('hintKeys');
    if (hk) hk.textContent = '왼쪽을 밀어 이동 · 많이 밀수록 빠르게 · 오른쪽 드래그로 시점 · 두 손가락으로 줌';

    /* 참가 화면 아래 줄도 같이 바꿉니다. 여기만 두면 폰 사용자는 참가를
     * 누르기 전에 이미 '키보드가 필요한 게임'으로 읽습니다.          */
    const keyRow = document.querySelector('.keys');
    if (keyRow) {
      const old = keyRow.querySelectorAll('.kbd');
      if (old.length) {
        const anchor = old[0];
        for (const [k, v] of [['왼쪽', '이동'], ['기울기', '속도'], ['오른쪽', '시점'],
                              ['두 손가락', '줌'], ['버튼', '점프']]) {
          const sp = document.createElement('span');
          const b = document.createElement('b');
          b.textContent = k;
          sp.append(b, document.createTextNode(' ' + v));
          keyRow.insertBefore(sp, anchor);
        }
        old.forEach((e) => e.remove());
      }
    }
  },

  apply(x, y) {
    let dx = x - this.cx, dy = y - this.cy;
    const len = Math.hypot(dx, dy);
    if (len > this.R) { dx *= this.R / len; dy *= this.R / len; }
    this.knob.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
    const mag = Math.min(1, len / this.R);
    const st = Input.stick;
    if (mag < this.DEAD) { st.active = true; st.fx = st.rx = st.mag = 0; return; }
    /* 화면 위쪽이 전진입니다 — 화면 y 는 아래로 커지므로 부호를 뒤집습니다. */
    const n = Math.hypot(dx, dy) || 1;
    st.active = true; st.fx = -dy / n; st.rx = dx / n; st.mag = mag;
  },

  reset() {
    this.id = null;
    const st = Input.stick;
    st.active = false; st.fx = st.rx = st.mag = 0;
    if (this.stick) this.stick.classList.remove('on');
    if (this.knob) this.knob.style.transform = '';
  },

  /* 주자일 때만 보입니다. 관전자에게는 이동이 없고, 대기 화면에서는
   * 참가 패널이 화면을 덮고 있어 버튼만 둥둥 떠 보입니다.         */
  sync() {
    if (!IS_TOUCH) return;
    const runner = G.role === 'player' && !previewing;
    document.body.classList.toggle('touch-run', runner);
    if (!runner) this.reset();
  }
};
Touch.init();

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

/* 화면을 돌리면 크기가 바뀌는데, 브라우저에 따라 resize 가 회전
 * '직전' 크기로 한 번 먼저 옵니다. 다음 프레임에 한 번 더 맞춥니다. */
window.addEventListener('orientationchange', () => {
  setTimeout(() => window.dispatchEvent(new Event('resize')), 120);
});

/* ============================ 8. physics =============================== */

/** AABB overlap test between the runner box and a tile box (XZ plane). */
function aabbOverlapXZ(px, pz, rec) {
  return (px + PLAYER.HALF_X > rec.minX) && (px - PLAYER.HALF_X < rec.maxX) &&
         (pz + PLAYER.HALF_Z > rec.minZ) && (pz - PLAYER.HALF_Z < rec.maxZ);
}

/**
 * 정확한 flat-top 육각형 판정 — 이 점을 이 타일이 '소유'하는가.
 *
 * 예전에는 AABB(min/max 사각형)로 판정했는데, 육각형의 바운딩 박스는 실제
 * 모양보다 네 모서리의 삼각형만큼 큽니다. 그래서 이웃 영역까지 자기 것이라
 * 주장했고, 밟지도 않은 타일이 무너지거나 이미 무너진 타일 위에 서 있는
 * 것처럼 보이는 문제가 났습니다.
 *
 * flat-top 육각형은 세 구간으로 나눠 보면 간단합니다.
 *   · |dx| > S            → 무조건 바깥
 *   · |dz| > √3/2·S       → 무조건 바깥
 *   · |dx| <= S/2         → 가운데 직사각형 구간이라 무조건 안
 *   · 그 바깥             → 좌우 빗변 아래인지 검사: |dz| <= √3·(S - |dx|)
 *
 * EPS 가 필요한 이유:
 * 공유 변 위의 점은 수학적으로 두 타일 모두에 속하지만, 부동소수점으로
 * 계산하면 양쪽에서 아슬아슬하게 탈락해 '주인 없는 점'이 생깁니다.
 * (두 중심의 정확한 중점에서 dz 가 우변보다 1e-16 만큼 커지는 식)
 * 그러면 그 자리에 선 주자가 한 프레임 발밑을 잃고 떨어집니다.
 * 경계를 아주 살짝 넉넉하게 잡아 양쪽이 모두 소유를 주장하게 두고,
 * 최종 확정은 findLanding 의 '가장 가까운 중심' 타이브레이크에 맡깁니다.
 *
 * ★ 1e-9 → 1e-4 로 올렸습니다. 부동소수점 오차만 막으면 되는 줄 알았는데,
 *   실제 틈은 그보다 네 자릿수 큽니다.
 *
 *   서버가 타일 좌표를 toFixed(4) 로 반올림해 보냅니다(server.js buildMap).
 *   그래서 이웃 타일의 중심 간격이 이론값에서 최대 1e-4 만큼 어긋나고,
 *   세 타일이 만나는 꼭짓점 부근에 '어느 타일에도 속하지 않는' 실틈이
 *   생깁니다. 실측한 틈은 3.3e-5 였습니다.
 *
 *   맵 중앙에서 60·120·240·300도 방향으로 곧장 달리면 그 꼭짓점 선을
 *   그대로 타게 되는데(육각 격자가 그 방향으로 정렬돼 있습니다), 이때
 *   한 프레임 발밑을 잃고 그대로 추락했습니다. 72방향 중 정확히 그 4개만
 *   재현됐습니다.
 *
 *   eps 를 S×1e-4(≈0.0002)로 두면 좌표 반올림 오차를 여섯 배 여유로
 *   덮습니다. 타일 크기의 0.01% 라 서 있는 자리나 그림에는 영향이 없습니다.
 */
const HEX_EPS = 1e-4;

function pointInXZ(px, pz, rec) {
  const S = rec.hexR || G.hexSize;
  const eps = S * HEX_EPS;
  const dx = Math.abs(px - rec.x);
  if (dx > S + eps) return false;
  const dz = Math.abs(pz - rec.z);
  if (dz > S * SQRT3_2 + eps) return false;
  if (dx <= S * 0.5) return true;
  return dz <= SQRT3 * (S - dx) + eps;
}

/**
 * Sweep the runner's feet from prevY to nextY and return the highest solid
 * surface crossed. Supports tiles (per layer) and spectator boosters.
 */
function findLanding(px, pz, prevY, nextY) {
  let best = null;

  for (const L of G.layerOrder) {
    const surf = G.layerY[L] + G.hexThick / 2;
    if (prevY < surf - 0.02) continue;      // already below this floor
    if (nextY > surf) continue;             // haven't reached it yet
    /* 회전층이면 질의점을 그 층의 로컬 프레임으로 옮겨 놓고 봅니다.
     * (toLayerFrame 주석 참고 — 타일이 아니라 점을 돌립니다) */
    const q = toLayerFrame(px, pz, L);
    const qx = q.x, qz = q.z;
    let owner = null, ownerD = Infinity;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      // 위상 타일이 꺼져 있으면 없는 것으로 봅니다 (착지 판정 1/3)
      if (rec.phaseTile && !G.phaseOn) continue;
      if (!pointInXZ(qx, qz, rec)) continue;
      const d = (qx - rec.x) * (qx - rec.x) + (qz - rec.z) * (qz - rec.z);
      if (d < ownerD) { ownerD = d; owner = rec; }
    }
    if (owner && (!best || surf > best.surf)) best = { surf, tile: owner, layer: L };
  }

  for (const b of G.boosters.values()) {
    const surf = b.y + 0.5;
    if (prevY < surf - 0.02 || nextY > surf) continue;
    const dx = px - b.x, dz = pz - b.z;
    if (dx * dx + dz * dz > boosterR2()) continue;
    if (!best || surf > best.surf) best = { surf, tile: null, layer: b.layer || currentLayerOf(surf), booster: b };
  }

  // 대기 발판. 밟아도 무너지지 않으므로 tile 은 넘기지 않습니다.
  if (G.pedestalsActive) {
    for (const rec of G.pedestals.values()) {
      if (rec.state !== 'idle') continue;
      const surf = rec.top;
      // 발판이 위아래로 떠 있으므로 여유를 크게 둡니다
      if (prevY < surf - 0.5 || nextY > surf) continue;
      if (!pointInXZ(px, pz, rec)) continue;
      if (!best || surf > best.surf) best = { surf, tile: null, layer: topLayerIndex(), pedestal: rec };
    }
  }

  return best;
}

/** Is the runner still supported at its current feet height? */
function supportAt(px, pz, feetY) {
  for (const L of G.layerOrder) {
    const surf = G.layerY[L] + G.hexThick / 2;
    if (Math.abs(feetY - surf) > 0.12) continue;
    // 회전층이면 질의점을 로컬 프레임으로 (착지 판정 3곳 모두 같은 처리)
    const q = toLayerFrame(px, pz, L);
    const qx = q.x, qz = q.z;
    let owner = null, ownerD = Infinity;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      // 위상 타일이 꺼져 있으면 없는 것으로 봅니다 (착지 판정 2/3)
      // 여기가 빠지면 OFF 가 되어도 그 위에 계속 서 있게 됩니다.
      if (rec.phaseTile && !G.phaseOn) continue;
      if (!pointInXZ(qx, qz, rec)) continue;
      const d = (qx - rec.x) * (qx - rec.x) + (qz - rec.z) * (qz - rec.z);
      if (d < ownerD) { ownerD = d; owner = rec; }
    }
    if (owner) return { tile: owner, layer: L, surf };
  }
  for (const b of G.boosters.values()) {
    const surf = b.y + 0.5;
    if (Math.abs(feetY - surf) > 0.12) continue;
    const dx = px - b.x, dz = pz - b.z;
    if (dx * dx + dz * dz <= boosterR2()) return { tile: null, layer: currentLayerOf(surf), surf, booster: b };
  }
  if (G.pedestalsActive) {
    for (const rec of G.pedestals.values()) {
      if (rec.state !== 'idle') continue;
      if (Math.abs(feetY - rec.top) > 0.9) continue;    // 발판이 떠다니므로 여유를 둡니다
      if (pointInXZ(px, pz, rec)) return { tile: null, layer: topLayerIndex(), surf: rec.top, pedestal: rec };
    }
  }
  return null;
}

/* 주어진 위치 아래에 있는 가장 가까운 바닥의 y.
 * 2.5D 는 원근 단서가 약해서, 그림자로 높이를 읽게 하는 것이 매우 중요합니다. */
function groundYUnder(px, pz, fromY) {
  let best = G.seaY;
  // 가장 높은 바닥을 고르므로 순서는 상관없습니다
  for (const L of G.layerOrder) {
    const surf = G.layerY[L] + G.hexThick / 2;
    if (surf > fromY + 0.05) continue;
    // 회전층이면 질의점을 로컬 프레임으로 (착지 판정 3곳 모두 같은 처리)
    const q = toLayerFrame(px, pz, L);
    const qx = q.x, qz = q.z;
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      // 위상 타일이 꺼져 있으면 없는 것으로 봅니다 (착지 판정 3/3)
      // 여기가 빠지면 그림자만 OFF 타일 위에 남아 높이가 어긋나 보입니다.
      if (rec.phaseTile && !G.phaseOn) continue;
      if (!pointInXZ(qx, qz, rec)) continue;
      if (surf > best) best = surf;
      break;
    }
  }
  for (const b of G.boosters.values()) {
    const surf = b.y + 0.5;
    if (surf > fromY + 0.05) continue;
    const dx = px - b.x, dz = pz - b.z;
    if (dx * dx + dz * dz <= boosterR2() && surf > best) best = surf;
  }
  if (G.pedestalsActive) {
    for (const rec of G.pedestals.values()) {
      if (rec.state !== 'idle') continue;
      if (rec.top > fromY + 0.05) continue;
      if (pointInXZ(px, pz, rec) && rec.top > best) best = rec.top;
    }
  }
  return best;
}

/* 이 높이가 '어느 층인가'.
 *
 * 예전에는 y >= layerY[3] - 3 처럼 층 번호와 문턱값이 박혀 있었습니다.
 * 층이 5개가 되면 위 두 층만 판정되고 나머지가 전부 1층으로 뭉갭니다.
 * 층 y 중 가장 가까운 것을 고르는 방식이면 층이 몇 개든, 간격이 얼마든
 * 그대로 맞습니다 (최상층보다 높은 대기 발판도 자연히 최상층으로 읽힙니다). */
function currentLayerOf(y) {
  const order = G.layerOrder;
  if (!order.length) return 1;
  let best = order[0], bestD = Infinity;
  for (const L of order) {
    const d = Math.abs(y - G.layerY[L]);
    if (d < bestD) { bestD = d; best = L; }
  }
  return best;
}

/* 최근에 나를 민 사람. 밀려서 떨어졌을 때 사인을 밝히려고 남깁니다. */
const lastBump = { id: null, name: '', at: -Infinity, sfxAt: -Infinity };

/**
 * 주자끼리 겹치지 않게 밀어냅니다 — 내 속도만 바꿉니다.
 *
 * 상대는 절대 건드리지 않습니다. 상대 클라이언트도 자기 자신에게 같은
 * 규칙을 적용하므로 둘은 결국 떨어지고, 남의 좌표를 아무도 쓰지 않으므로
 * 두 화면은 20Hz 중계만으로 다시 일치합니다 (영구 발산이 없습니다).
 *
 * 위치가 아니라 속도를 건드리는 이유는 BUMP 주석 참고 — 110ms 어긋남이
 * 있는 상태에서 위치를 밀어내면 이미 지나간 자리의 유령에게 순간이동을
 * 당합니다.
 */
function separateFromRunners(dt) {
  if (!local.alive || G.phase !== 'playing') return;

  const now = performance.now();
  if (now < G.bumpReadyAt) return;        // 시작 직후 전원 낙하 구간

  const R = BUMP.RADIUS, R2 = R * R;
  let px = 0, pz = 0;            // 분리 가속 누적
  let cx = 0, cz = 0;            // 관통 방지로 깎아낼 속도 누적
  let hardest = null, hardestK = 0;

  for (const r of G.players.values()) {
    /* G.players 에는 내 메타(RemoteRunner 가 아닌 평범한 객체)도 들어 있습니다.
     * syncPlayers 를 보면 self 는 render 가 local.pos 를 그대로 가리키므로,
     * 걸러내지 않으면 자기 자신과 충돌 판정을 하게 됩니다.              */
    if (!r || r.isSelf || r.id === G.selfId || !r.alive || !r.render) continue;
    if (Math.abs(local.pos.y - r.render.y) > BUMP.Y_GATE) continue;

    const dx = local.pos.x - r.render.x, dz = local.pos.z - r.render.z;
    const d2 = dx * dx + dz * dz;
    if (d2 >= R2) continue;

    const d = Math.sqrt(d2);
    let ux, uz;
    if (d < 1e-3) {
      /* 완전히 겹치면 밀 방향이 없습니다. id 비교로 서로 반대쪽을 고르게 해
       * 양쪽이 같은 방향으로 밀어 붙어버리는 것을 막습니다.             */
      ux = (G.selfId < r.id) ? 1 : -1; uz = 0;
    } else {
      ux = dx / d; uz = dz / d;
    }

    const air = local.grounded ? 1 : BUMP.AIR_SCALE;

    /* (1) 관통 방지 — 상대를 파고드는 속도 성분만 깎아냅니다.
     *
     * 이걸 분리 '가속'만으로 하려고 하면 반드시 통과합니다. 입력 가속이
     * ACCEL_GROUND(120)인데 분리 가속을 그보다 작게 잡으면 힘 싸움에서
     * 입력이 항상 이기고, 크게 잡으면 스치기만 해도 튕겨 날아갑니다.
     * 속도 성분을 직접 없애면 '벽'이 되므로 힘의 크기와 무관해집니다.
     *
     * block 은 겹친 깊이에 비례합니다. 살짝 스칠 때 급정거하면
     * 옆으로 지나가는 것조차 불가능해집니다.                          */
    const block = Math.min(1, (1 - d / R) * BUMP.BLOCK_RAMP) * air;
    const vIn = -((local.vel.x + cx) * ux + (local.vel.z + cz) * uz);
    if (vIn > 0) { cx += ux * vIn * block; cz += uz * vIn * block; }

    /* (2) 분리 — 이미 겹쳐 있는 만큼 밀어냅니다.
     * 미는 쪽은 (1)에서 멈추므로, 실제로 상대를 날리는 힘은 '상대 쪽
     * 클라이언트가 자기에게 적용하는 이 가속'입니다.                 */
    const k = BUMP.ACCEL * (1 - d / R) * air;
    px += ux * k; pz += uz * k;
    if (k > hardestK) { hardestK = k; hardest = r; }
  }
  if (px === 0 && pz === 0 && cx === 0 && cz === 0) return;

  const nvx = local.vel.x + cx + px * dt;
  const nvz = local.vel.z + cz + pz * dt;

  /* PUSH_OFF_EDGE 를 끄면, 밀림 때문에 발판을 잃게 되는 프레임에서는
   * 아예 밀지 않습니다. 지금은 켜져 있어 이 분기를 타지 않습니다.     */
  if (!BUMP.PUSH_OFF_EDGE && local.grounded) {
    if (!supportAt(local.pos.x + nvx * dt, local.pos.z + nvz * dt, local.pos.y)) return;
  }

  local.vel.x = nvx;
  local.vel.z = nvz;

  if (hardest) {
    lastBump.id = hardest.id;
    lastBump.name = hardest.name || '';
    lastBump.at = now;
    const dv = Math.hypot(px, pz) * dt + Math.hypot(cx, cz);
    if (dv > BUMP.SFX_DV && now - lastBump.sfxAt > BUMP.SFX_GAP_MS) {
      lastBump.sfxAt = now;
      Sound.sfx('impact', {
        volume: Math.min(0.5, dv * 0.35),
        rate: 1.22 + Math.random() * 0.16
      });
    }
  }
}

/* ── 대시 (신속심사 타일) ─────────────────────────────────────────────
 * 발동 판정과 도착 지점은 서버가 정합니다(권위). 여기서는 서버가 준
 * 속도를 실제로 적용하고, 그동안 수평 속도 상한을 풀어 줄 뿐입니다.
 *
 * ★ 왜 to 로 순간이동하지 않는가
 *   순간이동시키면 20Hz 스냅샷에서 다른 사람 화면에 뚝 끊겨 보이고,
 *   거기에 서버가 준 속도(38)까지 얹히면 2칸이 아니라 6칸을 갑니다.
 *   대신 to 까지의 거리를 remain 에 넣어 두고 그만큼 '실제로' 달립니다.
 *   38 유닛/초로 2칸(약 7.4유닛)이면 약 194ms — 서버 면제 창 400ms 의
 *   절반이라 대시 전체가 면제 안에서 끝납니다.
 * ------------------------------------------------------------------ */
/* ★ 사출 소리는 여기 하나에만 답니다.
 *   내 것이면 이 함수를 지나고, 남의 것이면 지나지 않습니다
 *   (player_impulse 수신부에서 갈립니다). 남의 사출까지 소리를 내면
 *   4인 게임에서 신속심사 층이 시끄러워집니다.                     */
function applyDashImpulse(d) {
  Sound.sfx('boost');
  if (!d || !Array.isArray(d.vel) || !Array.isArray(d.to)) return;
  const vx = +d.vel[0] || 0, vz = +d.vel[2] || 0;
  const speed = Math.hypot(vx, vz);
  if (speed < 1e-6) return;

  // 서버가 준 도착 지점까지의 남은 거리. 이만큼만 달리고 멈춥니다.
  const remain = Math.hypot(d.to[0] - local.pos.x, d.to[2] - local.pos.z);

  local.dash = {
    dirX: vx / speed, dirZ: vz / speed, speed: speed,
    remain: remain,
    // 시간 상한도 함께 둡니다 — 벽에 막히거나 떨어져도 영원히 안 끝나면 안 됩니다
    untilMs: performance.now() + (d.graceMs || 400)
  };
  local.vel.x = vx;
  local.vel.z = vz;
  // 지면에 붙어 나가야 합니다. 살짝 뜬 상태에서 대시하면 공중 가속이 걸립니다.
  local.ry = Math.atan2(local.dash.dirX, local.dash.dirZ);
  Sound.sfx('jump', { rate: 1.35 });
  spawnDashFx(local.pos.x, local.pos.y, local.pos.z, local.dash.dirX, local.dash.dirZ);
}

/* ── 점프 타일 발사 ───────────────────────────────────────────────────
 * 서버가 정한 수직 속도를 그대로 넣고, 나머지는 평소 물리에 맡깁니다.
 * 수평 속도는 건드리지 않습니다 — 달리던 관성을 유지한 채 솟아올라야
 * 자연스럽고, 목표도 '바로 위 같은 q,r' 이라 수평 보정이 필요 없습니다.
 *
 * 대시(applyDashImpulse)와 달리 속도 상한 해제가 필요 없습니다.
 * 클라이언트 물리는 수평 속도만 maxSpeed 로 자르고 수직은 자르지 않기
 * 때문입니다(아래쪽 MAX_FALL 만 있습니다). 서버 검증은 이미
 * graceMs 동안 면제돼 있습니다 — 그게 없으면 VALIDATE.MAX_UP_SPEED(34)에
 * 걸립니다(한 층 39.5 / 두 층 55.2).
 * ------------------------------------------------------------------ */
function applyJumpImpulse(d) {
  if (!d || !Array.isArray(d.vel)) return;
  const vy = +d.vel[1] || 0;
  if (vy <= 0) return;

  local.vel.y = vy;
  local.grounded = false;
  /* jumped=true 로 둬야 낙하 애니메이션 판정이 '떨어지는 중'이 아니라
   * '뛰어오른 중'이 됩니다. 안 그러면 솟는 동안 fall 자세가 나옵니다. */
  local.jumped = true;
  local.lastGroundY = local.pos.y;
  local.coyote = 0;
  local.groundTile = null;
  contactTile = null;
  local.dash = null;              // 대시 중이었다면 여기서 끝냅니다

  /* ★ 올라가는 층수마다 다른 소리를 씁니다.
   *   1층·2층이 같은 소리면 '몇 층 올라갔는지'를 화면으로만 알 수
   *   있는데, 솟는 동안에는 시선이 착지 지점에 가 있습니다.
   *   파일이 없으면 buffers 에 안 들어오므로 기본 점프 소리로
   *   받칩니다 — 소리가 사라지는 것보다 낫습니다.
   *   관전자의 보정 기회도 level 1 로 여기를 지납니다. 같은 '한 층
   *   올라가는 사건'이라 같은 소리가 맞습니다.                     */
  const lv = (d.level | 0) >= 2 ? 2 : 1;
  const stair = lv >= 2 ? 'stairJump2' : 'stairJump1';
  if (Sound.buffers[stair]) Sound.sfx(stair);
  else Sound.sfx('jump', { rate: lv >= 2 ? 0.8 : 1.0, volume: 0.9 });
  spawnJumpFx(local.pos.x, local.pos.y, local.pos.z, d.level || 1);
}

/* ── 회전층에 실려 돌기 ───────────────────────────────────────────────
 * 물리 스텝 맨 앞에서, 회전층에 '발을 붙이고' 있으면 내 좌표를 중심 기준
 * Δθ 만큼 돌립니다. 그 위에 아래의 입력·중력이 평소대로 더해지므로
 * "이동 입력은 회전과 별개로 더해진다"가 그대로 성립합니다.
 *
 * ★ 공중에서는 싣지 않습니다. 발이 닿아 있을 때만 층이 밀어 줍니다 —
 *   공중에서도 돌리면 점프 한 번에 목적지가 통째로 밀려나 조작이 됩니다.
 *   서버 tickRotateCarry 도 같은 조건(grounded)을 씁니다.
 *
 * ★ 서버와 같은 Δθ 를 씁니다.
 *   양쪽이 같은 타임라인·같은 공식을 쓰므로, 내 보고가 서버 좌표를
 *   덮어써도 어긋나지 않습니다. 이게 '이동은 클라이언트 권위'를 유지한 채
 *   층 회전을 서버가 소유하는 방법입니다.
 * ------------------------------------------------------------------ */
let lastCarryAngle = null;

function applyRotationCarry() {
  const s = G.traits.rotate;
  if (!s || !s.epoch) { lastCarryAngle = null; return; }

  const a = s.angle;
  if (lastCarryAngle === null) { lastCarryAngle = a; return; }
  const dTheta = a - lastCarryAngle;
  lastCarryAngle = a;
  if (!dTheta) return;

  if (!local.grounded || !isRotatingLayer(local.layer)) return;

  const c = Math.cos(dTheta), sn = Math.sin(dTheta);
  const x = local.pos.x * c - local.pos.z * sn;
  const z = local.pos.x * sn + local.pos.z * c;
  /* ★ 이 변위는 vel 을 거치지 않습니다 — 바닥이 주자를 실어 나르는 것이라
   * 속도가 아니라 위치를 직접 돌립니다. 그래서 '속도 × 시간'으로 이동량을
   * 검산하는 쪽에서는 이 몫을 따로 더해 줘야 합니다. 안 그러면 회전층에
   * 서 있다는 이유만으로 물리가 고장난 것처럼 보입니다. */
  local.carryAccum = (local.carryAccum || 0) +
    Math.hypot(x - local.pos.x, z - local.pos.z);
  local.pos.x = x;
  local.pos.z = z;
  // 몸도 같이 돌아야 발밑과 어긋나지 않습니다 (제자리에서 미끄러져 보임)
  local.ry += dTheta;
}

/**
 * 위치가 순간이동했을 때 보간 흔적을 지웁니다.
 *
 * ★ 이걸 빼먹으면 대시·점프·스폰·서버 보정처럼 좌표가 확 바뀌는 순간에
 *   prev 가 옛 위치로 남아, 새 위치까지 한 프레임 동안 '주욱 미끄러지는'
 *   그림이 나옵니다. 순간이동은 보간 대상이 아니라 보간을 끊어야 하는
 *   사건입니다.
 */
function snapRender() {
  local.prev.copy(local.pos);
  local.render.copy(local.pos);
  local.alpha = 1;
}

/* stepPhysics 작업용 벡터. 매 스텝 새로 만들지 않습니다. */
const _phFwd = new THREE.Vector3();
const _phRight = new THREE.Vector3();
const _phWish = new THREE.Vector3();

function stepPhysics(dt) {
  if (!local.alive) return;

  applyRotationCarry();

  const wasGrounded = local.grounded;   // 아래 '발판을 잃는 순간' 판정용

  // ---- horizontal intent (camera-relative) ----
  /* ★ 여기서 매 물리 스텝(60Hz)마다 Vector3 3개를 만들고 있었습니다.
   *   모듈 스코프 작업용 벡터로 돌립니다 — stepPhysics 는 재진입하지
   *   않으므로(한 프레임 안에서 순차 호출) 공유해도 안전합니다.      */
  const fwd = _phFwd.set(-Math.sin(cam.yaw), 0, -Math.cos(cam.yaw));
  const right = _phRight.set(Math.cos(cam.yaw), 0, -Math.sin(cam.yaw));
  const wish = _phWish.set(0, 0, 0);
  /* 키보드든 가상 스틱이든 여기 하나로 들어옵니다(Input 주석 참고).
   * mag 는 '얼마나 세게' — 키보드는 늘 1, 스틱은 기울기입니다.
   * wish 는 방향만 쓰고(아래에서 normalize), 세기는 최고 속도로
   * 반영합니다. 가속도까지 줄이면 폰에서 반응이 굼떠집니다.       */
  const mv = Input.move();
  if (mv.fx) wish.addScaledVector(fwd, mv.fx);
  if (mv.rx) wish.addScaledVector(right, mv.rx);
  const moveMag = mv.mag;
  const accel = local.grounded ? PHYS.ACCEL_GROUND : PHYS.ACCEL_AIR;

  /* ── 대시 진행 ────────────────────────────────────────────────────
   * 남은 거리(remain)를 이번 프레임 이동량만큼 깎습니다. 다 깎이거나
   * 시간 상한을 넘으면 끝냅니다. 대시 중에는 아래 두 가지를 풉니다.
   *   · 수평 속도 상한 — 안 풀면 다음 프레임에 15 로 잘려 대시가 사라집니다
   *   · 마찰          — 안 풀면 키를 안 눌렀을 때 프레임당 20% 씩 죽습니다  */
  let dashing = false;
  if (local.dash) {
    if (performance.now() >= local.dash.untilMs || local.dash.remain <= 0) {
      /* 거리를 다 채워서 끝났으면 수평 속도를 끊습니다.
       * 안 끊으면 38 이 상한(15)으로 잘린 뒤 마찰로 1유닛 넘게 더 미끄러져
       * '2칸'이 2.3칸이 됩니다. 착지 지점이 생사를 가르는 게임이라
       * 여기서는 정확도가 손맛보다 우선입니다. 키를 누르고 있으면 곧바로
       * 다시 가속하므로 벽에 부딪힌 느낌은 나지 않습니다.
       * 시간 초과로 끝난 경우(공중에서 멈춘 경우)는 손대지 않습니다 —
       * 낙하 중 수평 속도를 끊으면 허공에서 뚝 떨어집니다.            */
      if (local.dash.remain <= 0 && local.grounded) { local.vel.x = 0; local.vel.z = 0; }
      local.dash = null;
    } else {
      dashing = true;
      const stepDist = local.dash.speed * dt;
      if (stepDist >= local.dash.remain) {
        /* 마지막 프레임 — 남은 거리만큼만 갑니다.
         * 프레임 단위로 잘라 쓰면 최대 한 프레임(38/60 = 0.63유닛)을
         * 더 가서 도착 지점이 어긋납니다.                             */
        const v = local.dash.remain / dt;
        local.vel.x = local.dash.dirX * v;
        local.vel.z = local.dash.dirZ * v;
        local.dash.remain = 0;
      } else {
        local.dash.remain -= stepDist;
        // 대시 방향 속도를 매 프레임 다시 세워 둡니다 (밀림·마찰로 흐르지 않게)
        local.vel.x = local.dash.dirX * local.dash.speed;
        local.vel.z = local.dash.dirZ * local.dash.speed;
      }
    }
  }

  const maxSpeed = dashing
    ? local.dash.speed                      // 대시 중에는 상한을 대시 속도까지
    : Input.speedFor(moveMag);

  if (wish.lengthSq() > 0) {
    wish.normalize();
    if (!dashing) {                         // 대시 중에는 입력이 방향을 흔들지 않게
      local.vel.x += wish.x * accel * dt;
      local.vel.z += wish.z * accel * dt;
    }
    local.ry = Math.atan2(wish.x, wish.z);
  } else if (local.grounded && !dashing) {
    const f = Math.max(0, 1 - PHYS.FRICTION * dt);
    local.vel.x *= f; local.vel.z *= f;
  }

  /* 주자간 밀림. 최고속도 클램프 '앞'에 두어야 밀림이 SPRINT 를 넘겨
   * 누적되지 않습니다 — 넘기면 서버 이동 검증에 곧바로 걸립니다.     */
  separateFromRunners(dt);

  const hs = Math.hypot(local.vel.x, local.vel.z);
  if (hs > maxSpeed) {
    local.vel.x = local.vel.x / hs * maxSpeed;
    local.vel.z = local.vel.z / hs * maxSpeed;
  }
  /* 대시가 끝난 다음 프레임에는 maxSpeed 가 다시 평소 값이므로, 위 클램프가
   * 알아서 38 → 15 로 내립니다. 따로 감속 코드를 두지 않습니다. */

  // ---- jump (with coyote time + input buffering) ----
  local.coyote = local.grounded ? 0.11 : Math.max(0, local.coyote - dt);
  local.jumpBuffer = Math.max(0, local.jumpBuffer - dt);
  if (local.jumpBuffer > 0 && local.coyote > 0) {
    local.vel.y = PHYS.JUMP_V;
    Sound.sfx('jump', { rate: 0.96 + Math.random() * 0.08 });
    local.grounded = false;
    local.jumped = true;
    local.lastGroundY = local.pos.y;
    local.coyote = 0;
    local.jumpBuffer = 0;
    local.groundTile = null;
  }

  // ---- integrate ----
  const prevY = local.pos.y;
  local.vel.y = Math.max(PHYS.MAX_FALL, local.vel.y + PHYS.GRAVITY * dt);

  local.pos.x += local.vel.x * dt;
  local.pos.z += local.vel.z * dt;
  /* 난간. 착지 판정보다 먼저 해야 합니다 — 밀어낸 자리에서 발밑을 봐야
   * 난간에 막힌 채로 허공 판정이 나지 않습니다. */
  clampToArena();
  const nextY = local.pos.y + local.vel.y * dt;

  // ---- ground resolution ----
  local.grounded = false;
  if (local.vel.y <= 0) {
    const hit = findLanding(local.pos.x, local.pos.z, prevY, nextY);
    if (hit) {
      // 착지 순간에만 (매 프레임이 아니라) 소리를 냅니다
      if (!local.grounded && local.vel.y < -6) {
        Sound.sfx('land', { volume: Math.min(1, -local.vel.y / 40) });
      }
      local.pos.y = hit.surf;
      /* 충격 세기는 vel.y 를 0 으로 만들기 전에 읽어야 합니다.
       * wasGrounded 로 걸러 '공중에서 내려온 착지'만 흔듭니다 — 지면을
       * 스치며 달릴 때도 이 분기를 지나가기 때문입니다. */
      if (!wasGrounded) addCamShake(-local.vel.y);
      local.vel.y = 0;
      local.grounded = true;
      local.layer = hit.layer;
      local.groundTile = hit.tile;
      if (hit.tile) onSteppedOn(hit.tile);
    } else {
      local.pos.y = nextY;
    }
  } else {
    local.pos.y = nextY;
  }

  if (local.grounded) {
    const sup = supportAt(local.pos.x, local.pos.z, local.pos.y);
    if (!sup) { local.grounded = false; }
    else {
      local.layer = sup.layer;
      local.groundTile = sup.tile;
      // 대기 발판은 떠 있으므로 플레이어가 발판에 붙어 함께 오르내립니다
      if (sup.pedestal) { local.pos.y = sup.surf; local.vel.y = 0; }
      if (sup.tile) onSteppedOn(sup.tile);
    }
  }

  /* 타일에서 발이 떨어졌습니다 — 다음에 닿을 때 '다시 밟은 것'으로 셉니다.
   * (부스터·대기 발판 위도 groundTile 이 null 이라 여기서 풀립니다)   */
  if (!local.groundTile) contactTile = null;

  /* 발판을 잃는 순간 사인을 확정합니다.
   * 여기서 잡아야 정확합니다 — 구름바다까지 떨어지는 데 1초, 잠기는
   * 연출에 0.75초가 더 걸리므로, 탈락 시점에 판단하면 그 사이 스친
   * 사람이 엉뚱하게 걸립니다. 스스로 뛴 경우(jumped)는 제외합니다. */
  if (wasGrounded && !local.grounded && !local.jumped) {
    const pushed = performance.now() - lastBump.at < BUMP.CREDIT_MS;
    local.deathBy = pushed ? lastBump.id : null;
    local.deathByName = pushed ? lastBump.name : '';
  }

  // ---- 애니메이션 상태 ----
  if (local.grounded) {
    local.lastGroundY = local.pos.y;
    local.jumped = false;
    local.anim = hs > 1.2 ? 'run' : 'idle';
  } else if (local.vel.y > 1.5) {
    // 위로 솟는 중 = 점프
    local.anim = 'jump';
  } else {
    // 내려오는 중. 아래 두 조건을 모두 만족할 때만 fall 입니다.
    //   1) 출발한 바닥보다 충분히 아래로 내려갔을 것
    //   2) 출발한 "층"의 바닥면보다 아래로 내려갔을 것
    //
    // 2번이 핵심입니다. 부스터 발판처럼 층 바닥보다 높은 곳에서 내려와도,
    // 같은 층 타일에 착지하는 한 낙하가 아니라 점프로 봅니다.
    // 결과적으로 fall 은 아래 세 경우에만 나옵니다.
    //   · 다른(아래) 층으로 떨어질 때
    //   · 장외로 떨어질 때
    //   · 맨 아래 층에서 구름바다로 떨어질 때
    const drop = local.jumped ? FALL_DROP.JUMPED : FALL_DROP.WALKED;
    const launchLayer = currentLayerOf(local.lastGroundY);
    const layerFloor = G.layerY[launchLayer] + G.hexThick / 2;
    const leftLayer = local.pos.y < layerFloor - drop;
    const droppedEnough = local.pos.y < local.lastGroundY - drop;
    local.anim = (leftLayer && droppedEnough) ? 'fall' : 'jump';
  }

  // ---- 대기 중 이탈 방지 ----
  // 게임 시작 전에는 발판에서 떨어져도 탈락시키지 않고 제자리로 돌립니다.
  // 먼저 내려간 사람이 유리해지는 것을 막기 위해서입니다.
  //
  // 단, 개발 모드에서는 이 복귀를 끕니다. 대기 중에 레이어를 클릭해 내려가도
  // 곧바로 발판으로 튕겨 올라와 버려서 층 확인이 불가능하기 때문입니다.
  if (G.phase !== 'playing' && !(DEV.on && DEV.layerJump)) {
    const myPed = pedestalForSeat(local.seat);
    if (myPed && local.pos.y < myPed.top - 3) {
      local.pos.set(myPed.x, myPed.top, myPed.z);
      local.vel.set(0, 0, 0);
      local.grounded = true;
      local.jumped = false;
      snapRender();
      local.lastGroundY = myPed.top;
      local.anim = 'idle';
      Sound.sfx('land', { volume: 0.4 });
    }
    return;   // 대기 중에는 구름바다 판정을 하지 않습니다
  }

  // ---- 구름바다 / 장외 ----
  // 구름 표면에 닿는 순간 바로 탈락시키지 않고, 구름을 뚫고 들어가는
  // 연출을 0.75초 보여준 뒤 처리합니다.
  if (!local.dying && local.pos.y <= G.seaY + 6) beginFallOut();
  if (local.pos.y < G.seaY - 26) local.pos.y = G.seaY - 26;   // 무한 낙하 방지
  if (Math.abs(local.pos.x) > 170 || Math.abs(local.pos.z) > 170) beginFallOut();
}

/* 같은 타일에 연속으로 히트를 주지 않기 위한 최소 간격.
 * onSteppedOn 은 매 물리 프레임(60Hz) 호출되므로 이 쿨다운이 없으면
 * 한두 프레임 사이 발이 떴다 붙는 것만으로 히트가 겹칩니다.            */
const TILE_HIT_COOLDOWN_MS = 400;

/* ★ 지금 발이 닿아 있는 타일.
 *
 * 강화 타일이 "2회째 밟기에 파괴"가 되면서, 계속 서 있는 것을 재밟기로
 * 세면 안 되게 됐습니다. 쿨다운만으로는 가만히 서 있어도 0.4초 뒤
 * 두 번째 히트가 들어가 강화 타일이 일반 타일보다 빨리 꺼집니다.
 * 그래서 '발이 떨어졌다가 다시 닿았을 때'만 한 번 셉니다.
 * 계속 서 있는 경우는 서버의 머무름 시계(STAND_ROT_MS)가 처리합니다 —
 * 2026-09-16 규칙 변경으로 첫 밟기 자동 파괴(autoMs)가 없어졌고, 대신
 * '그 위에 머무르면 무너진다' 가 그 역할을 이어받았습니다.            */
let contactTile = null;

/**
 * 타일을 밟았다고 서버에 보고합니다.
 *
 * 예전에는 "라운드당 타일별 1회"만 보냈지만(steppedTiles Set), 이제는
 * 여러 사람이 나눠 밟아 3회를 채우는 규칙이라 그 가드를 쓸 수 없습니다.
 * 대신 '내가 이 타일을 마지막으로 때린 시각'만 기억해 연타를 막습니다.
 * 다른 사람이 밟는 것, 내가 떠났다 다시 밟는 것은 그대로 허용됩니다.
 *
 * 낙관적 렌더링(예전의 startWarn 즉시 호출)은 하지 않습니다. 3회 규칙에서
 * 첫 밟기에 경고 점멸을 띄우면 곧 무너질 것처럼 보여 거짓 정보가 됩니다.
 * 마모 표현은 서버의 tile_hit / tile_warn 을 받아서 반영합니다.
 */
function onSteppedOn(rec) {
  if (!rec || rec.state === 'gone' || rec.state === 'warn' || rec.state === 'reject') return;
  if (G.phase !== 'playing') return;
  if (contactTile === rec) return;      // 계속 서 있는 중 — 새로 밟은 게 아닙니다
  contactTile = rec;

  /* 이 종류를 처음 밟았으면 한 번만 이름과 효과를 알려 줍니다.
   * 위상 타일은 바로 아래에서 빠져나가므로 그 전에 불러야 합니다. */
  noticeTileTip(rec);

  /* 위상 타일은 밟아도 무너지지 않습니다(서버도 막지만 여기서 먼저 끊어
   * 쓸데없는 패킷을 안 보냅니다). contactTile 기록은 위에서 이미 했으므로
   * 다른 타일로 옮겨갈 때의 판정은 그대로 동작합니다.                */
  if (rec.phaseTile) return;

  const now = performance.now();
  if (now - rec.myLastHitAt < TILE_HIT_COOLDOWN_MS) return;
  rec.myLastHitAt = now;

  G.socket.emit('tile_step', { tileId: rec.id });
}

/* ── 특수 타일 첫 접촉 안내 ──────────────────────────────────────────
 * 그 종류를 처음 밟은 순간에만 한 줄 띄웁니다.
 *
 * ★ 왜 대기 화면에서 미리 설명하지 않는가
 *   설명을 대기 화면에 몰아 두면 아무도 안 읽습니다. 실제로 규칙을 접어
 *   두자마자 '설명이 없어 불친절하다'는 말이 나왔는데, 되돌려 봐야 벽 같은
 *   설명문이 될 뿐입니다. 방금 내 발밑에서 일어난 일에 그 자리에서 이름을
 *   붙여 주는 편이 훨씬 잘 남습니다 — 5층을 내려가는 동안 규칙을 하나씩
 *   배우게 됩니다.
 *
 * ★ 문구는 서버 config.SPECIAL_TIPS 입니다.
 *   specialType 으로 먼저 찾고, 없으면 kind 로 한 번 더 찾습니다
 *   (기본 바닥 타일의 '2회 밟기' 안내가 kind 쪽에 있습니다).
 *   문구가 없는 종류도 한 번 본 것으로 기록해 둡니다 — 그래야 매번
 *   테이블을 다시 뒤지지 않습니다.
 * ------------------------------------------------------------------ */
/* 층 배너가 떠 있는 동안 도착한 타일 안내는 줄을 세웁니다.
 *
 * ★ 자리를 나눈 것(배너 위 · 토스트 아래)만으로는 부족합니다.
 *   착지하자마자 바닥을 밟으므로 두 메시지가 <b>같은 순간에</b> 뜹니다.
 *   겹치지는 않아도 한 번에 네 줄이 쏟아지면 읽히지 않습니다.
 *   장소를 먼저 알려 주고, 그 다음에 사건을 알려 주는 순서가 맞습니다.
 *
 * ★ 큐에 쌓아 두고 순서대로 흘려보냅니다.
 *   한 번에 여러 종류를 처음 밟는 경우(바닥 + 특수 타일)가 있어서,
 *   배너가 끝난 뒤 하나씩 내보냅니다. 한꺼번에 두 개를 띄우면 자리만
 *   바뀌었지 같은 문제가 됩니다.
 *
 * ★ 간격을 0.6 → 2.5초로 늘렸습니다. 한 줄이 '신속심사 타일 — 진행
 *   방향으로 두 칸 튀어나갑니다. 앞이 비어 있으면 그대로 떨어집니다'
 *   처럼 길어서 읽는 데 3초쯤 걸리는데, 그것도 달리면서 읽어야 합니다.
 *   0.6초면 첫 줄을 다 읽기 전에 다음 줄이 오고, 동시 표시가 2개라
 *   세 번째에서 첫 줄이 밀려납니다.
 *   실측: 학습 문구가 38.4초와 39.4초에 연달아 떴습니다.        */
const tipQueue = [];
let tipTimer = 0;
/* 토스트가 3.6초 떠 있으므로, 이보다 짧으면 앞 줄을 읽는 중에 다음 줄이
 * 겹칩니다. 2.5초면 앞 줄이 거의 사라질 즈음 다음 줄이 옵니다.      */
const TIP_GAP_MS = 2500;

function flushTipQueue() {
  if (tipTimer) return;
  const step = () => {
    tipTimer = 0;
    if (!tipQueue.length) return;
    /* 아직 배너가 떠 있으면 더 기다립니다 */
    const el = document.getElementById('layerBanner');
    if (el && el.classList.contains('on')) {
      tipTimer = setTimeout(step, 300);
      return;
    }
    toast(tipQueue.shift(), 'learn');
    if (tipQueue.length) tipTimer = setTimeout(step, TIP_GAP_MS);
  };
  tipTimer = setTimeout(step, 300);
}

function clearTipQueue() {
  tipQueue.length = 0;
  if (tipTimer) { clearTimeout(tipTimer); tipTimer = 0; }
}

function noticeTileTip(rec) {
  if (G.phase !== 'playing' || !local.alive) return;
  const tips = G.cfg && G.cfg.SPECIAL_TIPS;
  if (!tips || !rec) return;
  const key = rec.specialType || rec.kind;
  if (!key || G.seenTips.has(key)) return;
  G.seenTips.add(key);
  if (!tips[key]) return;
  tipQueue.push(tips[key]);
  flushTipQueue();
}

/* DEV.noEliminate: 구름바다까지 떨어졌을 때 탈락시키지 않고 최상층 위로
 * 되돌립니다. player_death 는 보내지 않습니다.
 *
 * devTeleport 를 거치므로 서버 이동 검증 면제(dev_teleport)도 같이 탑니다.
 * layerJump 를 꺼 둔 탭에서도 복귀는 되어야 하므로 여기서만 잠시 허용합니다. */
function reviveForDev() {
  const topLayer = G.cfg && G.cfg.LAYERS ? G.cfg.LAYERS[0].index : 3;
  const hadJump = DEV.layerJump;
  DEV.layerJump = true;
  devTeleport(topLayer);
  DEV.layerJump = hadJump;
  toast('개발 모드 — 최상층으로 되돌렸습니다', 'cheer');
}

/* 구름을 뚫고 들어가는 연출을 시작합니다. 실제 탈락 처리는 끝난 뒤에. */
/* ══════════════════════════════════════════════════════════════════════
 * 최종 처분 도장 (showVerdict)
 * ────────────────────────────────────────────────────────────────────
 * 탈락과 승리가 같은 부품을 씁니다. 두 결말이 '도장이 찍힌다'는 하나의
 * 언어로 묶여야, 시작의 '게이트가 열린다' 와 짝이 됩니다.
 *
 *   reject : 붉은 거절결정 도장만
 *   grant  : 등록증이 먼저 펼쳐지고 그 위에 남색 등록결정 도장
 *
 * ★ 출원번호는 방 시드에서 만듭니다.
 *   매번 난수로 뽑으면 같은 라운드인데 사람마다 다른 번호가 찍혀,
 *   화면을 나란히 놓고 찍은 사진에서 어긋납니다. 방 시드를 쓰면
 *   같은 라운드를 본 모두가 같은 번호를 봅니다.
 * ══════════════════════════════════════════════════════════════════════ */
let verdictT1 = 0, verdictT2 = 0;

function verdictDocNo() {
  const seed = Math.abs((G.map && G.map.seed) || 0) % 10000000;
  return '10-' + String(seed).padStart(7, '0');
}

function showVerdict(kind, opts) {
  const el = dom.verdict;
  if (!el) return;
  const o = opts || {};
  const win = kind === 'grant';

  /* ★ 두 경우의 바탕이 정반대라 값을 따로 잡습니다.
   *   승리 : 도장이 '크림색 등록증 위'에 찍히므로 속을 거의 비워
   *          종이가 비쳐 보이게 두고, 남색 글자가 그대로 읽힙니다.
   *   탈락 : 바탕이 '어두운 게임 화면 + 붉은 비네트'입니다. 속을 비우면
   *          붉은 글자가 붉은 화면에 묻혀 버려서, 어두운 원판을 깔고
   *          그 위에 밝은 주홍으로 찍습니다.                        */
  el.style.setProperty('--sealC', win ? '#1b3f8f' : '#ff4433');
  el.style.setProperty('--sealBg', win ? 'rgba(255,255,255,.05)' : 'rgba(14,8,8,.82)');
  dom.verdictSeal.innerHTML =
    '<div class="sTop">대 한 민 국 특 허 청</div>' +
    '<div class="sMain">' + (win ? '등록결정' : '거절결정') + '</div>' +
    '<div class="sEn">' + (win ? 'REGISTERED' : 'REJECTED') + '</div>' +
    '<div class="sLaw">특허법 제' + (win ? '66' : '62') + '조</div>';

  if (win) {
    dom.verdictCert.innerHTML =
      '<div class="ct">LETTERS PATENT</div>' +
      '<div class="cn">특허등록증</div>' +
      '<div class="cno">제 ' + verdictDocNo() + ' 호</div>' +
      '<hr>' +
      '<div class="crow"><span class="ck">발명의 명칭</span><b>패스트트랙 생존 방법</b></div>' +
      '<div class="crow"><span class="ck">특허권자</span><b>' + escapeHtml(safeName(o.name || '')) + '</b></div>' +
      '<div class="crow"><span class="ck">최종 잔류 층</span><b>' + (o.layerName || '—') + '</b></div>' +
      '<div class="cfoot">위 발명은 특허법에 의하여 특허등록원부에<br>등록되었음을 증명합니다.</div>';
  } else {
    dom.verdictCert.innerHTML = '';
  }

  clearTimeout(verdictT1); clearTimeout(verdictT2);
  el.classList.remove('out', 'win');
  /* 애니메이션을 다시 태우려면 클래스를 뗐다 붙여야 합니다 */
  el.classList.remove('on');
  void el.offsetWidth;
  if (win) el.classList.add('win');
  el.classList.add('on');

  /* 도장이 실제로 박히는 순간에 맞춰 소리와 화면 흔들림을 겁니다.
   * CSS 애니메이션 지연(승리 0.5s)과 숫자를 맞춰야 합니다. */
  const hitMs = win ? 500 : 0;
  setTimeout(() => {
    Sound.sfx(win ? 'win' : 'crack', { rate: win ? 1 : 0.6, volume: 1 });
    addCamShake(win ? 34 : 26);
  }, hitMs + 330);

  const holdMs = o.holdMs === undefined ? (win ? 4200 : 1500) : o.holdMs;
  verdictT1 = setTimeout(() => el.classList.add('out'), hitMs + holdMs);
  verdictT2 = setTimeout(() => {
    el.classList.remove('on', 'win', 'out');
  }, hitMs + holdMs + 500);
}

function hideVerdict() {
  clearTimeout(verdictT1); clearTimeout(verdictT2);
  if (dom.verdict) dom.verdict.classList.remove('on', 'win', 'out');
}

/* ── 탈락 연출 ────────────────────────────────────────────────────────
 *
 * ★ 0.75초 → 1.6초.
 *   종전에는 졌다는 걸 느끼기도 전에 끝났습니다. 시작 연출이 1.2초
 *   낙하에 속도선·카메라 흔들림까지 붙어 있는데 끝은 0.75초 가라앉기
 *   한 번이라 무게가 안 맞았습니다.
 *
 * ★ '슬로우'는 전역 시간을 늦추는 게 아닙니다.
 *   다른 주자들은 계속 뛰고 있으므로 dt 를 건드리면 게임이 망가집니다.
 *   대신 <b>잠기는 속도를 감속 곡선</b>으로 만들어(처음 빠르게 들어갔다가
 *   구름 속에서 느려짐) 시간이 늘어지는 느낌만 만듭니다.
 *
 * ★ 서류 파편 — 구름바다를 '폐기된 출원 서류의 바다'로 읽히게 합니다.
 *   기존 파편 풀(spawnDebris)을 그대로 쓰되 흰 종잇조각 색만 넘깁니다.
 * ------------------------------------------------------------------ */
const FALLOUT_S = 1.6;          // 전체 길이
const FALLOUT_STAMP_AT = 0.62;  // 이 지점(비율)에서 도장이 들어옵니다

function beginFallOut() {
  // DEV.noEliminate: 가라앉는 연출 없이 곧바로 최상층으로 되돌립니다
  if (DEV.on && DEV.noEliminate) { reviveForDev(); return; }
  if (local.dying || !local.alive) return;
  local.dying = FALLOUT_S;
  local.stamped = false;
  local.anim = 'fall';
  const th = THEMES[currentTheme] || THEMES[0];
  spawnSeaSplash(local.pos.x, local.pos.z, th.seaTop);
  spawnPaperBurst(local.pos.x, local.pos.y, local.pos.z);
  Sound.sfx('death');
  dom.deadFlash.classList.add('on');
}

/* 연출 진행 — 캐릭터가 구름 속으로 가라앉고, 끝나면 탈락 처리 */
function updateFallOut(dt) {
  if (!local.dying) return;
  local.dying -= dt;
  const k = THREE.MathUtils.clamp(1 - local.dying / FALLOUT_S, 0, 1);

  /* 감속 곡선: 처음엔 빠르게 들어가고 구름 속에서 느려집니다.
   * 등속으로 내리면 '그냥 사라진다'가 되어 아쉬움이 안 남습니다. */
  const sink = -9 * (1 - k) * (1 - k) - 1.2;
  local.vel.y = Math.max(local.vel.y, sink);
  local.vel.x *= 0.90;
  local.vel.z *= 0.90;
  local.pos.y += local.vel.y * dt;
  local.pos.x += local.vel.x * dt;
  local.pos.z += local.vel.z * dt;

  if (local.avatar) {
    // 잠기면서 서서히 사라집니다
    local.avatar.group.scale.setScalar(Math.max(0.02, 1 - k * 0.55));
    local.avatar.group.rotation.y += dt * 5 * (1 - k * 0.7);
    if (local.avatar.plate) local.avatar.plate.visible = false;
  }

  if (!local.stamped && k >= FALLOUT_STAMP_AT) {
    local.stamped = true;
    showVerdict('reject');
  }

  if (local.dying <= 0) {
    local.dying = 0;
    local.stamped = false;
    eliminateSelf('fall');
  }
}

/* ── 서류 파편 ────────────────────────────────────────────────────────
 * 구름에 닿는 순간 솟구쳤다 나풀나풀 떨어지는 종잇조각입니다.
 * 구름바다를 '그냥 구름'이 아니라 <b>폐기된 출원 서류가 쌓인 바다</b>로
 * 읽히게 하는 장치입니다.
 *
 * ★ 대시 궤적(dashTrails) 풀을 재사용하려다 말았습니다.
 *   그쪽 갱신식이 opacity = life×1.6, scale = 1+(0.45−life)×2.2 라
 *   수명이 0.45 보다 긴 것을 넣으면 스케일이 음수가 되어 뒤집힙니다.
 *   종이는 '위로 솟았다 중력으로 떨어지며 팔랑거린다'가 핵심이라
 *   움직임 자체가 달라서, 작은 전용 풀을 두는 편이 맞습니다.
 * ------------------------------------------------------------------ */
const paperBits = [];
let _paperGeo = null;
function paperGeo() {
  const S = G.hexSize || 2.13;
  if (!_paperGeo) _paperGeo = new THREE.PlaneGeometry(S * 0.30, S * 0.40);
  return _paperGeo;
}

function spawnPaperBurst(x, y, z, count) {
  const S = G.hexSize || 2.13;
  const n = count || 16;
  for (let i = 0; i < n; i++) {
    const mat = new THREE.MeshBasicMaterial({
      color: i % 4 === 0 ? 0xdcd2b4 : 0xfdfaf0, transparent: true, opacity: 0.96,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    });
    const m = new THREE.Mesh(paperGeo(), mat);
    m.position.set(x + (Math.random() - 0.5) * S * 1.4, y + Math.random() * 1.0,
                   z + (Math.random() - 0.5) * S * 1.4);
    m.rotation.set(Math.random() * 6, Math.random() * 6, Math.random() * 6);
    fxGroup.add(m);
    paperBits.push({
      mesh: m, mat,
      vx: (Math.random() - 0.5) * 5, vy: 5 + Math.random() * 7, vz: (Math.random() - 0.5) * 5,
      rx: (Math.random() - 0.5) * 7, ry: (Math.random() - 0.5) * 7,
      life: 1.7 + Math.random() * 0.9, max: 2.6
    });
  }
}

function updatePaperBits(dt) {
  for (let i = paperBits.length - 1; i >= 0; i--) {
    const p = paperBits[i];
    p.life -= dt;
    if (p.life <= 0) {
      fxGroup.remove(p.mesh); p.mat.dispose(); paperBits.splice(i, 1); continue;
    }
    /* 종이는 공기 저항이 커서 금방 느려지고 천천히 내려앉습니다.
     * 타일 파편과 같은 중력을 쓰면 돌멩이처럼 떨어집니다. */
    p.vy -= 11 * dt;
    p.vx *= 0.965; p.vz *= 0.965;
    p.vy = Math.max(p.vy, -4.5);
    p.mesh.position.x += p.vx * dt;
    p.mesh.position.y += p.vy * dt;
    p.mesh.position.z += p.vz * dt;
    p.mesh.rotation.x += p.rx * dt;
    p.mesh.rotation.y += p.ry * dt;
    p.mat.opacity = Math.min(0.96, p.life * 1.4);
  }
}

function eliminateSelf(cause) {
  /* DEV.noEliminate: 떨어져도 탈락시키지 않습니다. 서버도 player_death 를
   * 무시하지만, 여기서 먼저 막아야 화면이 붉게 번쩍이거나 아바타가 사라지지
   * 않습니다. player_death 를 아예 보내지 않는 것도 이 return 이 보장합니다. */
  if (DEV.on && DEV.noEliminate) { reviveForDev(); return; }
  if (!local.alive) return;
  local.alive = false;
  G.selfAlive = false;
  local.anim = 'dead';
  dom.deadFlash.classList.add('on');
  setTimeout(() => dom.deadFlash.classList.remove('on'), 900);
  if (local.avatar) local.avatar.group.visible = false;
  // by 가 있으면 밀려서 떨어진 것입니다 (stepPhysics 에서 발판을 잃는 순간 확정)
  G.socket.emit('player_death', { cause, by: local.deathBy || undefined });
  G.role = 'spectator';
  updateSpectatorUI();
  toast(local.deathByName
    ? safeName(local.deathByName) + ' 님에게 밀려 탈락 — 이제 관전자로 개입할 수 있습니다'
    : '심사 탈락 — 이제 관전자로 개입할 수 있습니다', 'kill');
  local.deathBy = null; local.deathByName = '';
}

/* --- 개발 모드: 레이어 안내문 클릭 → 그 층으로 순간이동 ---------------
 * 층별 기능을 확인할 때 매번 떨어져서 내려갈 필요가 없게 합니다.
 * 서버가 DEV_MODE=false 를 내려주면 클릭해도 아무 일이 없습니다.       */
function devTeleport(layerIndex) {
  if (!DEV.on || !DEV.layerJump) return;
  if (G.role !== 'player') { toast('관전 중에는 이동할 수 없습니다', 'kill', { key: 'nomove', gapMs: 4000 }); return; }

  const y = G.layerY[layerIndex];
  if (y === undefined) return;

  /* 위치를 바꾸기 '전에' 서버에 알립니다. 순간이동은 정의상 이동 검증에
   * 걸리므로, 서버가 잠깐 면제 창을 열어 준 뒤에 옮겨야 곧바로
   * state_correction 으로 되돌려지지 않습니다.
   * 앞으로 만들 순간이동 이벤트도 이 순서를 그대로 쓰세요.            */
  if (G.socket) G.socket.emit('dev_teleport', { layer: layerIndex });

  /* 그 층에서 실제로 살아 있는 타일 위에 내려놓습니다. 맵 한가운데가
   * 이미 무너져 있을 수도 있으니, 중심에서 가장 가까운 성한 타일을 고릅니다.
   * (개발 모드에선 타일이 안 무너지지만, 모드를 끈 채 켜 둔 탭에서도
   *  안전하게 동작하도록 이렇게 둡니다.)                                */
  /* 위상 타일 위에 내려놓으면 OFF 순간 곧바로 떨어져서 관찰이 안 됩니다.
   * 단단한 타일을 우선 고르고, 그런 게 없을 때만 위상 타일로 갑니다.  */
  let best = null, bestD = Infinity;
  let anyBest = null, anyBestD = Infinity;
  for (const rec of (G.layerTiles[layerIndex] || [])) {
    if (rec.state === 'gone') continue;
    const d = rec.x * rec.x + rec.z * rec.z;
    if (d < anyBestD) { anyBestD = d; anyBest = rec; }
    if (rec.phaseTile) continue;
    if (d < bestD) { bestD = d; best = rec; }
  }
  if (!best) best = anyBest;

  const px = best ? best.x : 0;
  const pz = best ? best.z : 0;
  const py = (best ? best.top : y + G.hexThick / 2) + 0.6;

  local.pos.set(px, py, pz);
  local.vel.set(0, 0, 0);
  local.grounded = false;
  local.jumped = false;
  local.dying = 0;
  snapRender();
  local.layer = layerIndex;
  local.lastGroundY = py;

  // 떨어져 있던 상태에서 눌렀다면 되살립니다 (서버도 dev_teleport 에서 같이 살립니다)
  if (!local.alive) {
    local.alive = true;
    G.selfAlive = true;
    G.role = 'player';
    local.anim = 'idle';
    if (local.avatar) {
      local.avatar.group.visible = true;
      local.avatar.group.rotation.set(0, 0, 0);
      local.avatar.group.scale.set(1, 1, 1);
    }
    dom.deadFlash.classList.remove('on');
    updateSpectatorUI();
  }

  applyLayerTransparency(layerIndex);
  markDevLayerButton(layerIndex);
  toast('LAYER ' + String(layerIndex).padStart(2, '0') + ' 로 이동했습니다', 'cheer');
}

/* ============================ 9. tile FX =============================== */

/* ── 타일 마모 표현 ───────────────────────────────────────────────────
 * 일반 타일은 3번 밟아야 무너집니다. 남은 내구도를 한눈에 읽을 수 있어야
 * 하므로 단계마다 다르게 보이게 합니다.
 *   1회차: 색이 옅어지고 살짝 가라앉음
 *   2회차: 더 옅어지고 회색조 + 균열 오버레이 + 미세한 떨림
 *   3회차: 기존 경고 점멸 → 붕괴 (startWarn 이 담당)
 *
 * ── 균열을 왜 "별도 메시"로 얹는가 ────────────────────────────────
 * 예전에는 rec.mat.map 에 균열 텍스처를 끼워 넣었습니다. 그런데 타일은
 * CylinderGeometry(…, 6) 이라 옆면/윗면/아랫면 세 그룹이 단일 머티리얼을
 * 공유합니다. map 을 넣으면 옆면에도 균열이 늘어붙어 "금이 간 표면"이
 * 아니라 "무늬가 감긴 기둥"으로 보였습니다. 머티리얼 배열로 쪼개면
 * rec.mat.color / emissiveIntensity / opacity 를 참조하는 코드가 전부
 * 깨지므로, 타일 위에 얇은 육각 평면을 한 장 얹는 쪽을 택했습니다.
 * (덤: road_texture.png 가 늦게 로드돼 mat.map 을 덮어써도 안전해졌습니다)
 * ------------------------------------------------------------------ */

/* 오버레이 지오메트리 — 균열 타일 전부가 공유합니다.
 * CircleGeometry(R, 6) 을 rotation.x = -π/2 로 눕히면 꼭짓점이 (±R,0,0) 에
 * 오는 flat-top 육각형이 되어 타일 본체와 방향이 정확히 맞습니다.
 * thetaStart 는 넣지 마세요 — 타일 본체(CylinderGeometry)는 π/6 교정이
 * 필요하지만 CircleGeometry 는 기준축이 달라 기본값 0 이 정답입니다.
 * 0.94 는 타일 상판(0.985)보다 살짝 안쪽입니다. 상판과 같은 크기로 두면
 * 안티에일리어싱 때문에 가장자리에서 균열이 잘린 것처럼 보입니다.      */
let crackGeo = null;
let crackGeoSize = 0;            // 이 지오메트리를 만든 시점의 hexSize
function ensureCrackGeo() {
  const s = G.hexSize || HEX_SIZE_BASE;
  if (crackGeo && crackGeoSize === s) return crackGeo;
  // 타일 크기가 바뀌는 건 buildMap 뿐이고, 그때 오버레이는 이미 전부
  // 떼어낸 뒤이므로 여기서 dispose 해도 살아 있는 참조가 남지 않습니다.
  if (crackGeo) crackGeo.dispose();
  crackGeoSize = s;
  crackGeo = new THREE.CircleGeometry(s * 0.94, 6);
  return crackGeo;
}

/* ── 균열 텍스처 ─────────────────────────────────────────────────────
 * 타일마다 새로 그리면 비싸고, 한 장만 돌려 쓰면 아레나 전체가 똑같은
 * 무늬로 도배됩니다. 변형 5종을 한 번 만들어 두고 타일 id 해시로 골라
 * 씁니다 (같은 타일은 언제 봐도 같은 균열 모양).                      */
const CRACK_VARIANTS = 5;
const CRACK_TEX_N = 512;
const CRACK_LIMIT_R = 235;                  // 0.46 × 512. 이 밖으로 나가면 육각형에 잘립니다
const CRACK_GROW_R = CRACK_LIMIT_R - 6;     // 선 두께(최대 반폭 ~2.5px)만큼 여유를 둡니다
const CRACK_GROW_MS = 220;                  // 균열이 퍼지는 시간
const CRACK_SHAKE_S = 0.18;                 // 금 갈 때 타일이 흔들리는 시간(초)
const CRACK_WARN_TINT = 0xffb0b0;           // 3회차(경고)에서 흰 텍스처를 붉게 물들입니다
let crackTextures = null;

/* 시드 난수(mulberry32). Math.random() 을 쓰면 변형 5종이 새로고침마다
 * 달라져 "3번 변형이 이상하다" 같은 지적을 재현할 수가 없습니다.      */
function mulberry32(a) {
  return function () {
    a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/* 균열 경로 계산. 그리기(캔버스)와 일부러 분리했습니다.
 *   1) 같은 경로를 그림자·하이라이트 2패스로 두 번 그려야 하고
 *   2) 캔버스 없이도 "반경 235px 안에 들어오는지"를 검증할 수 있습니다
 *
 * 모양을 잡을 때 실제로 보고 고친 것들:
 *   · 세그먼트마다 각도를 ±22° 흔들었더니 선이 부드럽게 휘어 "나뭇가지"로
 *     보였습니다. 유리·콘크리트 균열은 한동안 직진하다 한 번 꺾입니다.
 *     → 지터를 ±12° 로 줄이고 세그먼트를 길게(반경의 10~16%) 잡았습니다.
 *   · 방사 균열만 있으면 "별표"로 보입니다. 인접한 두 갈래를 잇는 연결
 *     균열(concentric)이 있어야 조각으로 나뉜 판으로 읽힙니다. 이게 가장
 *     결정적이었습니다.
 *   · 3~4갈래는 위에서 내려다보는 카메라 거리에서 너무 성깁니다. 5~6갈래로
 *     늘리고 2단계까지 갈라지게 했습니다.                                */
function crackStrokes(seed) {
  const rnd = mulberry32(seed * 9176 + 1013);
  const c = CRACK_TEX_N / 2;
  const strokes = [];            // { ax, ay, bx, by, w }
  const rFrom = (x, y) => Math.hypot(x - c, y - c);

  /** 한 줄기를 바깥으로 전진시킵니다. 반경 한계에 닿으면 거기서 멈춥니다. */
  function grow(sx, sy, ang, segs, lenLo, lenHi, w0, w1) {
    let x = sx, y = sy, a = ang;
    const path = [[x, y]];
    for (let s = 0; s < segs; s++) {
      a += (rnd() - 0.5) * 0.42;                                  // 매 세그먼트 ±12°
      const len = CRACK_GROW_R * (lenLo + rnd() * (lenHi - lenLo));
      const nx = x + Math.cos(a) * len, ny = y + Math.sin(a) * len;
      if (rFrom(nx, ny) > CRACK_GROW_R) break;                    // 육각형 밖으로는 안 나갑니다
      const t = segs > 1 ? s / (segs - 1) : 1;
      strokes.push({ ax: x, ay: y, bx: nx, by: ny, w: w0 + (w1 - w0) * t });
      x = nx; y = ny;
      path.push([x, y]);
    }
    return path;
  }

  /** 두 점을 지그재그로 잇습니다 (연결 균열 전용 — 바깥으로 뻗지 않습니다) */
  function link(p, q, w) {
    const n = 3;
    let px = p[0], py = p[1];
    // 직선으로 이으면 자로 그은 티가 납니다. 수직 방향으로 조금씩 밀어줍니다.
    const nx = -(q[1] - p[1]), ny = q[0] - p[0];
    const nl = Math.hypot(nx, ny) || 1;
    for (let i = 1; i <= n; i++) {
      const t = i / n;
      const off = (i === n ? 0 : (rnd() - 0.5) * 26);
      const qx = p[0] + (q[0] - p[0]) * t + (nx / nl) * off;
      const qy = p[1] + (q[1] - p[1]) * t + (ny / nl) * off;
      if (rFrom(qx, qy) > CRACK_GROW_R) return;
      strokes.push({ ax: px, ay: py, bx: qx, by: qy, w });
      px = qx; py = qy;
    }
  }

  // 충격점 — 정중앙에 못을 박은 듯 보이지 않게 반경 30px 안에서 흔듭니다
  const sa = rnd() * Math.PI * 2, sr = rnd() * 30;
  const ox = c + Math.cos(sa) * sr, oy = c + Math.sin(sa) * sr;

  // 주 균열 5~6개 — 시작 각도를 균등 분할한 뒤 ±25° 지터
  const armCount = 5 + ((rnd() * 2) | 0);
  const arms = [];
  for (let i = 0; i < armCount; i++) {
    const a0 = (i / armCount) * Math.PI * 2 + (rnd() - 0.5) * 0.87;
    const segs = 6 + ((rnd() * 4) | 0);
    const main = grow(ox, oy, a0, segs, 0.10, 0.16, 4.4, 1.1);
    if (main.length < 3) continue;
    arms.push(main);

    // 부 균열 — 주 균열의 30~65% 지점에서 1~2개 갈라져 나옵니다
    const branches = 1 + ((rnd() * 2) | 0);
    for (let b = 0; b < branches; b++) {
      const bi = Math.max(1, Math.min(main.length - 1,
        Math.round(main.length * (0.30 + rnd() * 0.35))));
      const prev = main[bi - 1], at = main[bi];
      const baseAng = Math.atan2(at[1] - prev[1], at[0] - prev[0]);
      const side = rnd() < 0.5 ? -1 : 1;
      // 길이는 주 균열의 40%, 두께는 60%
      const sub = grow(at[0], at[1], baseAng + side * (0.55 + rnd() * 0.5),
        Math.max(2, Math.round(segs * 0.4)), 0.08, 0.13, 4.4 * 0.6, 1.1 * 0.6);
      // 2단계 — 잔가지에서 한 번 더. 있으면 훨씬 부서진 느낌이 납니다.
      if (sub.length >= 3 && rnd() < 0.6) {
        const si = 1 + ((rnd() * (sub.length - 2)) | 0);
        const sp = sub[si - 1], st = sub[si];
        const sAng = Math.atan2(st[1] - sp[1], st[0] - sp[0]);
        grow(st[0], st[1], sAng + (rnd() < 0.5 ? -1 : 1) * (0.6 + rnd() * 0.5),
          2, 0.07, 0.11, 4.4 * 0.36, 1.1 * 0.36);
      }
    }
  }

  /* 연결 균열 — 이웃한 두 갈래를 이어 판을 조각으로 나눕니다.
   * 이게 없으면 아무리 갈래를 늘려도 "별표"로만 보입니다.            */
  for (let i = 0; i < arms.length; i++) {
    if (rnd() < 0.35) continue;                     // 전부 이으면 거미줄이 됩니다
    const A = arms[i], B = arms[(i + 1) % arms.length];
    if (A.length < 3 || B.length < 3) continue;
    const ai = Math.max(1, Math.round(A.length * (0.45 + rnd() * 0.3)));
    const bi = Math.max(1, Math.round(B.length * (0.45 + rnd() * 0.3)));
    link(A[Math.min(ai, A.length - 1)], B[Math.min(bi, B.length - 1)], 1.6 + rnd() * 0.9);
  }

  /* 파편 자국 — 충격점 주변이 실제로도 가장 잘게 부서집니다 */
  const shards = [];
  const shardCount = 3 + ((rnd() * 3) | 0);
  for (let i = 0; i < shardCount; i++) {
    const a = rnd() * Math.PI * 2, d = 8 + rnd() * 46;
    const jx = ox + Math.cos(a) * d, jy = oy + Math.sin(a) * d;
    const verts = 3 + ((rnd() * 2) | 0);
    const poly = [];
    let ok = true;
    for (let v = 0; v < verts; v++) {
      const va = (v / verts) * Math.PI * 2 + rnd() * 0.8;
      const r = 7 + rnd() * 14;
      const px = jx + Math.cos(va) * r, py = jy + Math.sin(va) * r;
      if (rFrom(px, py) > CRACK_GROW_R) { ok = false; break; }
      poly.push([px, py]);
    }
    if (ok) shards.push(poly);
  }

  return { strokes, shards };
}

function makeCrackTexture(seed) {
  const N = CRACK_TEX_N;
  const cv = document.createElement('canvas');
  cv.width = cv.height = N;
  const g = cv.getContext('2d');
  g.clearRect(0, 0, N, N);              // 배경은 완전 투명 — 균열 자국만 남깁니다
  const paths = crackStrokes(seed);

  // 파편 자국은 균열선 아래에 아주 옅게 깔립니다
  g.fillStyle = 'rgba(0,0,0,0.18)';
  for (const poly of paths.shards) {
    g.beginPath();
    g.moveTo(poly[0][0], poly[0][1]);
    for (let i = 1; i < poly.length; i++) g.lineTo(poly[i][0], poly[i][1]);
    g.closePath();
    g.fill();
  }

  /* 2패스 드로잉이 이 표현의 핵심입니다. 한 겹만 그리면 그냥 낙서로
   * 보입니다. 어두운 홈(1패스) 위에 좌상단으로 살짝 어긋난 밝은 모서리
   * (2패스)를 얹어야 빛을 받아 "패인 균열"로 읽힙니다.               */
  g.lineCap = 'round';
  g.lineJoin = 'round';
  g.strokeStyle = 'rgba(8,10,16,0.88)';
  for (const s of paths.strokes) {
    g.lineWidth = s.w + 1.5;
    g.beginPath(); g.moveTo(s.ax, s.ay); g.lineTo(s.bx, s.by); g.stroke();
  }
  /* 하이라이트는 홈보다 가늘게, 그리고 확실히 어긋나게 그립니다.
   * 홈과 같은 폭으로 겹쳐 그리면 선 한가운데가 하얗게 떠서 "패인 홈"이
   * 아니라 "빛나는 선"이 됩니다. 한쪽 모서리만 물려야 입체로 읽힙니다. */
  g.save();
  g.translate(-1.3, -1.3);
  g.strokeStyle = 'rgba(255,255,255,0.5)';
  for (const s of paths.strokes) {
    g.lineWidth = Math.max(0.6, s.w * 0.6);
    g.beginPath(); g.moveTo(s.ax, s.ay); g.lineTo(s.bx, s.by); g.stroke();
  }
  g.restore();

  const tex = new THREE.CanvasTexture(cv);
  tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
  tex.needsUpdate = true;
  tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
  tex.encoding = THREE.sRGBEncoding;
  return tex;
}

/** 타일 id 해시로 변형을 고릅니다 — 같은 타일은 항상 같은 균열 모양. */
function getCrackTexture(tileId) {
  if (!crackTextures) {
    crackTextures = [];
    for (let i = 0; i < CRACK_VARIANTS; i++) crackTextures.push(makeCrackTexture(i));
  }
  let h = 0;
  for (let i = 0; i < tileId.length; i++) h = (h * 31 + tileId.charCodeAt(i)) | 0;
  return crackTextures[((h % CRACK_VARIANTS) + CRACK_VARIANTS) % CRACK_VARIANTS];
}

/* 동시 균열 수 계측. F2 진단 패널에 뿌립니다 — 오버레이가 드로우콜을
 * 몇 개까지 늘리는지 실제 라운드에서 재보려고 넣었습니다.             */
const crackStats = { live: 0, peak: 0 };

/** 균열 오버레이를 타일 위에 얹습니다. */
function attachCrack(rec) {
  if (rec.crack) return;
  const mat = new THREE.MeshBasicMaterial({
    map: getCrackTexture(rec.id),
    transparent: true,
    opacity: 0,              // updateTiles 의 등장 애니메이션이 올립니다
    depthWrite: false,       // 타일 상판과 0.02 차이라 안 끄면 z-fighting 이 납니다
    toneMapped: false,
    side: THREE.FrontSide
  });
  const mesh = new THREE.Mesh(ensureCrackGeo(), mat);
  mesh.rotation.x = -Math.PI / 2;
  mesh.renderOrder = 2;
  mesh.position.set(rec.x, rec.mesh.position.y + G.hexThick / 2 + 0.02, rec.z);
  mesh.scale.setScalar(rec.mesh.scale.x * 0.55);
  /* 반드시 타일과 같은 그룹에 붙입니다. tileGroup 으로 고정하면 회전층
   * 타일의 균열만 제자리에 남아 층이 그 밑에서 돌아가 버립니다.      */
  groupForLayer(rec.layer).add(mesh);
  rec.crack = { mesh, mat, born: performance.now() };
  crackStats.live++;
  if (crackStats.live > crackStats.peak) crackStats.peak = crackStats.live;
}

/** 오버레이를 떼어냅니다. crackGeo·텍스처는 공유 자원이라 dispose 하지 않습니다. */
function releaseCrack(rec) {
  if (!rec.crack) return;
  detach(rec.crack.mesh);
  rec.crack.mat.dispose();
  rec.crack = null;
  crackStats.live = Math.max(0, crackStats.live - 1);
}

const WEAR_WHITE = new THREE.Color(0xffffff);
const WEAR_GREY = new THREE.Color(0x9aa0aa);

/* ── 금 간 타일 색 ────────────────────────────────────────────────────
 * 밟은 타일을 '회색'이 아니라 '어둡게' 죽입니다.
 *
 * ★ 회색이 왜 틀렸나 — 배경과 같은 명도 대역이었습니다.
 *   배경(지평선 L=0.61~0.75, 구름바다 L=0.65~0.85)과 회색 처리된 타일
 *   (L=0.45~0.54)의 WCAG 대비가 1.11~1.78 밖에 안 나왔습니다. 1.0 이
 *   '명도가 완전히 같다' 이고 그래픽 요소 최소 권장치가 3.0 이니,
 *   사실상 명도로는 구분이 0 이고 색상만으로 버티던 상태였습니다.
 *   눈은 형태를 주로 명도로 분리하므로 '배경과 안 구분된다'가 됩니다.
 *
 *   2회 밟기 규칙으로 바꾸면서 금 간 타일이 화면에 보이는 바닥의
 *   대부분이 됐기 때문에, 이 한 가지가 전체 가독성을 좌우합니다.
 *
 * ★ 왜 채도를 빼지 않고 명도만 내리나
 *   층 색을 그대로 어둡게 하면 '죽은 땅'이면서도 어느 층인지는 계속
 *   읽힙니다. 회색으로 빼면 여섯 층이 전부 같은 회색이 되어 층 정체성이
 *   사라집니다. 다만 완전히 순색으로 두면 너무 쨍해서, 아주 어두운
 *   중성색 쪽으로 22% 만 당겨 '빛이 꺼졌다'는 느낌을 줍니다.
 *
 * ★ 개선 폭 (실측 계산)
 *   금 간 타일 vs 배경   1.11 → 5.00 이상
 *   금 간 타일 vs 멀쩡한 타일  1.04 → 5.33 이상
 *   둘 다 3.0 을 넘겨, 명도만으로도 구분이 됩니다.
 * ------------------------------------------------------------------ */
const WEAR_DARK_K = 0.34;                            // 명도를 이 배율로
const WEAR_DEAD = new THREE.Color(0x141a24);         // 아주 어두운 중성색
/* 심사 가속이 걸린 층을 물들이는 빨강. 붕괴 경고(0xff2d2d)보다 조금 어둡게
 * 잡아, 같은 층에서 '가속 중'과 '지금 무너지는 중'이 구분되게 합니다. */
const ACCEL_RED = new THREE.Color(0xd41f16);
/* 붕괴 경고 색. updateTiles 안에서 매 프레임 쓰이므로 상수로 둡니다. */
const WARN_RED = new THREE.Color(0xff2d2d);

/** 서버가 알려준 hits 를 재질에 반영합니다. */
function applyTileWear(rec) {
  const maxH = rec.maxHits || 1;
  rec.wear = Math.min(1, rec.hits / maxH);

  /* ★ 균열 오버레이는 이제 '강화 타일 전용' 표현입니다.
   * 2회차에 있던 이 연출은 일반 타일이 3회 밟기였을 때의 것인데,
   * 일반 타일이 1회 + 퓨즈로 바뀌면서 중간 상태 자체가 없어졌습니다.
   * 강화 타일만 1회에 금이 가고 2회째에 무너지므로 그대로 이관했습니다. */
  if (rec.kind === 'reinforced' && rec.hits > 0) {
    if (!rec.crack) {
      attachCrack(rec);
      rec.crackShake = CRACK_SHAKE_S;   // 금이 갈 때 짧게 흔들려야 타격감이 납니다
    }
  } else if (rec.crack) {
    releaseCrack(rec);
  }
}

/** 라운드가 새로 시작될 때 모든 타일의 마모를 지웁니다.
 * 안내문 기록과 배너 상태도 여기서 함께 비웁니다 — 라운드 경계가
 * 한 군데여야 '새 회차인데 옛 배너가 떠 있는' 일이 안 생깁니다. */
function resetTileWear() {
  G.seenTips.clear();
  G.lastLayerShown = null;
  clearTipQueue();       // 지난 회차 안내가 새 회차로 흘러나오지 않게
  hideLayerBanner();
  for (const rec of G.tiles.values()) {
    rec.hits = 0;
    rec.wear = 0;
    rec.crackShake = 0;
    rec.myLastHitAt = -Infinity;
    releaseCrack(rec);
  }
}

/* ── 거절이유 타일 색 단계 ────────────────────────────────────────────
 * 노랑 → 주황 → 빨강 을 시간에 따라 이어 붙입니다. 세 색 사이를 선형
 * 보간하므로 단계가 뚝뚝 끊기지 않습니다.
 * 마지막 REJECT_BLINK_MS 구간에는 빠른 점멸로 "곧 터진다"를 알립니다. */
const REJECT_COLORS = [
  new THREE.Color(0xffd400),   // 0%   노랑 — 거절이유 발견
  new THREE.Color(0xff8a00),   // 50%  주황
  new THREE.Color(0xff2020)    // 100% 빨강 — 폭발 직전
];
const REJECT_BLINK_MS = 500;   // 마지막 이만큼은 빠르게 점멸합니다

/**
 * 거절이유 카운트다운을 시작합니다.
 * 서버가 정한 delay 를 그대로 씁니다 — 클라이언트는 그리기만 합니다.
 */
function startReject(rec, delay) {
  if (!rec || rec.state === 'gone' || rec.state === 'reject') return;
  rec.state = 'reject';
  rec.rejectStart = performance.now();
  rec.rejectDelay = Math.max(1, delay || 1500);
}

function startWarn(rec, fuse) {
  if (rec.state === 'gone' || rec.state === 'warn') return;
  rec.state = 'warn';
  rec.warnStart = performance.now();
  rec.fuse = fuse;
}

/**
 * 이미 붉게 점멸 중인 타일의 '남은 시간'만 바꿉니다 (심사 가속 발동).
 *
 * startWarn 을 다시 부르면 안 됩니다 — 그 함수는 이미 warn 인 타일을
 * 그냥 무시하고(중복 방지), 무시하지 않도록 고치면 이번엔 연출이 처음부터
 * 다시 시작돼 거의 빨갛던 타일이 노랗게 되돌아갑니다.
 *
 * 그래서 진행률 p 를 그대로 유지한 채 남은 구간만 압축합니다.
 *   p 는 (now - warnStart) / fuse 이므로,
 *   새 fuse = remain / (1 - p) 로 두고 warnStart 를 그만큼 과거로 밀면
 *   지금 프레임의 p 는 변하지 않고 남은 시간만 remain 이 됩니다.
 */
function retimeWarn(rec, remainMs) {
  if (!rec || rec.state !== 'warn') return;
  const now = performance.now();
  const p = Math.min(0.98, Math.max(0, (now - rec.warnStart) / Math.max(1, rec.fuse)));
  const fuse = Math.max(1, remainMs) / (1 - p);
  rec.fuse = fuse;
  rec.warnStart = now - p * fuse;
}

/* 복구 연출 길이. 아래에서 솟아오르는 데 걸리는 시간(ms). */
const RESTORE_RISE_MS = 300;

/**
 * 부서진 타일을 되살립니다 (서버 tile_restore 수신 시).
 *
 * ★ 여기서 하나라도 빠뜨리면 '유령 타일'이 됩니다.
 *   breakTile 이 남긴 흔적은 한 곳이 아니라 여러 곳에 흩어져 있습니다 —
 *   상태값(state/hits), 메시 변환(위치·회전·크기·visible), 재질(색·발광·
 *   투명도), 얹혀 있던 균열 오버레이, 그리고 재밟기 판정용 캐시까지.
 *   되돌리지 않은 항목은 다음 프레임에 updateTiles 가 덮어쓰지 않는 한
 *   그대로 남습니다 (예: rotation 은 idle 분기에서 손대지 않습니다).
 */
function restoreTile(rec) {
  if (!rec) return;

  // ── 상태 ──
  rec.state = 'idle';
  rec.hits = 0;
  rec.wear = 0;
  rec.warnStart = 0;
  rec.breakStart = 0;
  rec.rejectStart = 0;
  rec.rejectDelay = 0;
  rec.crackShake = 0;
  /* 재밟기 쿨다운을 풀어 줍니다. 안 풀면 방금 밟혀 부서진 타일이
   * 되살아났을 때 400ms 동안 밟아도 서버에 보고가 안 갑니다.      */
  rec.myLastHitAt = -Infinity;

  // ── 균열 오버레이 (강화 타일이 부서지기 전에 얹혀 있었을 수 있습니다) ──
  releaseCrack(rec);

  // ── 메시 변환 (breakTile 의 낙하 연출이 전부 여기에 남습니다) ──
  /* 무너질 때 빼놨던 진짜 메시를 거둬 인스턴스로 되돌립니다. */
  TileInst.demote(rec);
  rec.mesh.visible = true;
  rec.mesh.position.set(rec.x, rec.baseY, rec.z);
  rec.mesh.rotation.set(0, 0, 0);
  rec.mesh.scale.setScalar(1);

  // ── 재질 ──
  rec.mat.color.copy(rec.baseColor);
  rec.mat.emissive.copy(rec.baseEmissive);
  rec.mat.emissiveIntensity = rec.baseGlow;
  // 층 반투명이 걸려 있으면 그 값으로 (1 로 두면 위층에서 혼자 불투명해집니다)
  rec.mat.opacity = tileAlphaFor(rec);

  /* 내가 이 타일 위에 서 있다가 떨어졌다면 접촉 기록이 남아 있을 수 있습니다.
   * 안 지우면 되살아난 타일에 다시 올라서도 '계속 서 있던 것'으로 보여
   * tile_step 이 안 나갑니다.                                        */
  if (contactTile === rec) contactTile = null;

  // ── 솟아오르는 연출 시작 ──
  rec.restoreStart = performance.now();
}

function breakTile(rec, scale) {
  if (!rec || rec.state === 'gone') return;
  rec.state = 'gone';
  rec.breakStart = performance.now();
  /* 낙하 연출은 회전 + 반투명이 함께 걸립니다. 한 InstancedMesh 안의
   * 인스턴스는 깊이 정렬이 안 되므로, 무너지는 동안만 진짜 메시로
   * 빼냅니다. 동시에 무너지는 타일은 많아야 수십 장입니다.        */
  TileInst.promote(rec);
  spawnDebris(rec, scale);
}

/* 점프 타일 발사 이펙트 — 발밑에서 위로 솟는 링.
 * 대시 잔상(dashTrails)과 같은 풀을 씁니다. 수명·감쇠 규칙이 같고,
 * 둘이 동시에 뜰 일이 거의 없어 따로 관리할 이유가 없습니다.        */
function spawnJumpFx(x, y, z, level) {
  const S = G.hexSize || 3.2 / 1.5;
  if (!dashTrailGeo) dashTrailGeo = new THREE.RingGeometry(S * 0.35, S * 0.62, 18);
  const color = level >= 2 ? 0xff00c8 : 0x00e5ff;
  const rings = 4 + level * 2;
  for (let i = 0; i < rings; i++) {
    const mat = new THREE.MeshBasicMaterial({
      color: color, transparent: true, opacity: 0.8,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    });
    const m = new THREE.Mesh(dashTrailGeo, mat);
    // 위로 층층이 쌓아 '솟아오른다'로 읽히게 합니다
    m.position.set(x, y + 0.1 + i * (S * 0.55), z);
    m.rotation.x = -Math.PI / 2;
    fxGroup.add(m);
    dashTrails.push({ mesh: m, mat, life: 0.5 - i * 0.03 });
  }
}

/* ── 선행기술 검색 스캔 ───────────────────────────────────────────────
 * 밟은 자리에서 바깥으로 훑고 지나가는 링입니다. 시야가 넓어지는 것과
 * 같은 속도로 퍼져 나가야 "이 스캔이 주변을 드러냈다"로 읽힙니다.
 *
 * 시야 확장 자체는 밟은 사람만 받지만(search_pulse 의 id 로 가름), 이
 * 연출은 모두에게 보입니다 — 어둠 속에서 누가 조사 중인지 알려 줍니다.
 * ------------------------------------------------------------------ */
const searchRings = [];

function spawnSearchFx(x, y, z, viewTiles, durationMs) {
  const S = G.hexSize || 3.2 / 1.5;
  if (!dashTrailGeo) dashTrailGeo = new THREE.RingGeometry(S * 0.35, S * 0.62, 18);

  // 링 지오메트리의 바깥 반지름(S*0.62)을 목표 반경까지 키웁니다
  const goal = (viewTiles || 8) * tileStepUnit() / (S * 0.62);
  const rings = 3;
  for (let i = 0; i < rings; i++) {
    const mat = new THREE.MeshBasicMaterial({
      color: 0x9d7bff, transparent: true, opacity: 0.9,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    });
    const m = new THREE.Mesh(dashTrailGeo, mat);
    m.position.set(x, y + 0.35, z);
    m.rotation.x = -Math.PI / 2;
    m.scale.setScalar(0.35);
    fxGroup.add(m);
    /* 링마다 조금씩 늦게 출발시켜 한 겹이 아니라 '훑고 지나간다'로 보이게
     * 합니다. 지속은 서버가 준 durationMs 를 따릅니다 — 연출이 시야보다
     * 먼저 끝나거나 늦게까지 남으면 둘이 따로 노는 것처럼 보입니다.  */
    searchRings.push({
      mesh: m, mat, goal,
      delay: i * 0.12,
      life: 0,
      span: Math.max(0.4, (durationMs || 2000) / 1000 * 0.55)
    });
  }
}

function updateSearchFx(dt) {
  for (let i = searchRings.length - 1; i >= 0; i--) {
    const r = searchRings[i];
    r.life += dt;
    const t = (r.life - r.delay) / r.span;
    if (t < 0) { r.mat.opacity = 0; continue; }
    if (t >= 1) {
      fxGroup.remove(r.mesh); r.mat.dispose(); searchRings.splice(i, 1); continue;
    }
    const e = 1 - Math.pow(1 - t, 2);              // 빠르게 퍼졌다 끝에서 감속
    r.mesh.scale.setScalar(0.35 + (r.goal - 0.35) * e);
    r.mat.opacity = 0.9 * (1 - t) * (1 - t);
  }
}

/* 대시할 때 발밑에 남기는 잔상. 파편(debris)과 같은 풀을 쓰지 않고
 * 따로 둔 이유는 수명·중력이 달라서입니다 (잔상은 안 떨어집니다).   */
const dashTrails = [];
let dashTrailGeo = null;
function spawnDashFx(x, y, z, dirX, dirZ) {
  const S = G.hexSize || 3.2 / 1.5;
  if (!dashTrailGeo) dashTrailGeo = new THREE.RingGeometry(S * 0.35, S * 0.62, 18);
  for (let i = 0; i < 5; i++) {
    const mat = new THREE.MeshBasicMaterial({
      color: 0x00ffcc, transparent: true, opacity: 0.7,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    });
    const m = new THREE.Mesh(dashTrailGeo, mat);
    // 진행 방향 뒤쪽으로 늘어놓아 '튀어나간' 궤적으로 읽히게 합니다
    const back = i * S * 0.5;
    m.position.set(x - dirX * back, y + 0.12, z - dirZ * back);
    m.rotation.x = -Math.PI / 2;
    fxGroup.add(m);
    dashTrails.push({ mesh: m, mat, life: 0.45 - i * 0.05 });
  }
}
function updateDashTrails(dt) {
  for (let i = dashTrails.length - 1; i >= 0; i--) {
    const d = dashTrails[i];
    d.life -= dt;
    if (d.life <= 0) {
      fxGroup.remove(d.mesh); d.mat.dispose(); dashTrails.splice(i, 1); continue;
    }
    d.mat.opacity = Math.max(0, d.life * 1.6);
    d.mesh.scale.setScalar(1 + (0.45 - d.life) * 2.2);
  }
}

const debris = [];
const debrisGeo = new THREE.TetrahedronGeometry(0.38);   // 타일 축소에 맞춰 작게
/**
 * 타일 파편.
 * @param scale 1 = 평범한 붕괴. 폭발처럼 크게 보여야 할 때 올립니다
 *              (개수·흩어지는 범위·튀는 속도가 함께 커집니다).
 */
/* 파편 위치 계산용 임시 객체 (프레임당 여러 번 불려 GC 압력을 피합니다) */
const _debrisAt = { x: 0, z: 0 };

function spawnDebris(rec, scale) {
  const k = scale || 1;
  const count = Math.round(6 * k);
  for (let i = 0; i < count; i++) {
    const m = new THREE.Mesh(debrisGeo, new THREE.MeshStandardMaterial({
      color: rec.baseColor, emissive: rec.baseColor, emissiveIntensity: 0.6, transparent: true
    }));
    const spread = (G.hexSize || 3.2 / 1.5) * FX.DEBRIS_SPREAD * k;
    /* 파편은 회전하지 않는 fxGroup 에 들어가므로 회전이 반영된 월드
     * 좌표에서 터뜨려야 합니다. 안 그러면 회전층 타일이 부서질 때
     * 파편만 엉뚱한 자리에서 튑니다.                                 */
    const w = tileWorldXZ(rec, _debrisAt);
    m.position.set(w.x + (Math.random() - 0.5) * spread, rec.y, w.z + (Math.random() - 0.5) * spread);
    fxGroup.add(m);
    debris.push({
      mesh: m,
      vel: new THREE.Vector3((Math.random() - 0.5) * 7 * k, (Math.random() * 5 + 1.5) * k, (Math.random() - 0.5) * 7 * k),
      spin: new THREE.Vector3(Math.random() * 6, Math.random() * 6, Math.random() * 6),
      life: 1.6
    });
  }
  if (debris.length > 220) {
    const old = debris.splice(0, debris.length - 220);
    old.forEach((d) => { fxGroup.remove(d.mesh); d.mesh.material.dispose(); });
  }
}

function updateDebris(dt) {
  for (let i = debris.length - 1; i >= 0; i--) {
    const d = debris[i];
    d.life -= dt;
    if (d.life <= 0) {
      fxGroup.remove(d.mesh); d.mesh.material.dispose(); debris.splice(i, 1); continue;
    }
    d.vel.y += PHYS.GRAVITY * 0.55 * dt;
    d.mesh.position.addScaledVector(d.vel, dt);
    d.mesh.rotation.x += d.spin.x * dt;
    d.mesh.rotation.y += d.spin.y * dt;
    d.mesh.material.opacity = Math.min(1, d.life / 0.8);
  }
}

/* ── 어둠: 무엇이 얼마나 보이는가 ─────────────────────────────────────
 * 서버는 '언제부터 언제까지'만 알려주고, 실제로 가리는 일은 각 클라이언트가
 * 자기 플레이어 위치를 기준으로 합니다 (server.js DARK_EVENT 주석 참고).
 *
 * 매 프레임 타일마다 부르는 함수라 프레임 앞에서 기준점을 한 번만 잡고
 * (beginDarkPass) 타일별로는 거리 계산만 합니다.
 *
 * 관전자는 어둠에서 제외합니다 — 볼 기준이 되는 '내 위치'가 없고,
 * 카메라를 기준으로 삼으면 시점을 돌리는 것만으로 시야가 달라집니다.
 * ------------------------------------------------------------------ */
const darkPass = { on: false, x: 0, z: 0, inner: 0, outer: 0 };

function beginDarkPass() {
  const st = G.traits.dark;
  darkPass.on = false;
  if (!st || !st.active) return;
  // 내 위치가 기준입니다. 주자가 아니거나 죽었으면 가리지 않습니다.
  if (G.role !== 'player' || !local.alive) return;

  const step = tileStepUnit();
  const clear = st.clearTiles !== undefined ? st.clearTiles : 2;
  const view = currentViewTiles();
  darkPass.on = true;
  darkPass.x = local.pos.x;
  darkPass.z = local.pos.z;
  darkPass.inner = clear * step;                       // 여기까지는 그대로 보임
  darkPass.outer = Math.max(clear + 0.5, view) * step; // 여기부터 완전한 검정
}

/** 이 타일을 얼마나 밝게 그릴 것인가 (1 = 그대로, 0 = 완전한 검정). */
function darkFactorFor(rec) {
  if (!darkPass.on || !rec.darkTrait) return 1;
  const d = Math.hypot(rec.x - darkPass.x, rec.z - darkPass.z);
  if (d <= darkPass.inner) return 1;
  if (d >= darkPass.outer) return 0;
  const t = (d - darkPass.inner) / (darkPass.outer - darkPass.inner);
  // 가장자리에서 뚝 끊기지 않도록 부드럽게 떨어뜨립니다
  return (1 - t) * (1 - t);
}

function updateTiles(dt, now) {
  beginDarkPass();
  for (const rec of G.tiles.values()) {
    const mesh = rec.mesh;

    if (rec.state === 'reject') {
      /* 거절이유 카운트다운. 노랑 → 주황 → 빨강 을 부드럽게 잇습니다. */
      const p = Math.min(1, (now - rec.rejectStart) / rec.rejectDelay);
      const seg = p < 0.5 ? 0 : 1;                    // 0: 노랑→주황, 1: 주황→빨강
      const k = p < 0.5 ? p / 0.5 : (p - 0.5) / 0.5;
      rec.mat.color.copy(REJECT_COLORS[seg]).lerp(REJECT_COLORS[seg + 1], k);
      rec.mat.emissive.copy(rec.mat.color);

      /* 마지막 0.5초는 빠른 점멸 — 여기서 벗어나지 못하면 휘말립니다. */
      const leftMs = rec.rejectDelay - (now - rec.rejectStart);
      if (leftMs <= REJECT_BLINK_MS) {
        const blink = Math.sin(now * 0.045) * 0.5 + 0.5;
        rec.mat.emissiveIntensity = 0.6 + blink * 3.4;
        mesh.scale.setScalar(1 + blink * 0.05);
      } else {
        rec.mat.emissiveIntensity = 0.5 + p * 1.6;
        mesh.scale.setScalar(1);
      }
      // 점점 크게 흔들려 임박했음을 몸으로 알립니다
      mesh.position.y = rec.baseY + Math.sin(now * 0.03) * 0.10 * p;
    } else if (rec.state === 'warn') {
      const p = Math.min(1, (now - rec.warnStart) / rec.fuse);
      // 취약 타일은 퓨즈가 0.2초뿐이라 점멸을 훨씬 빠르게 해야 읽힙니다
      const blink = Math.sin(p * Math.PI * (rec.kind === 'fragile' ? 16 : 10)) * 0.5 + 0.5;
      rec.mat.emissiveIntensity = 0.3 + blink * 2.6;
      /* ★ 여기에 new THREE.Color(0xff2d2d) 가 있었습니다.
       *   이 줄은 '경고 중인 타일마다, 매 프레임' 돕니다. 층 하나가 한꺼번에
       *   무너지는 구간에서는 수백 개가 동시에 경고 상태라, 초당 수만 개의
       *   Color 객체가 만들어졌습니다. 상수로 빼면 0 이 됩니다.        */
      rec.mat.color.copy(rec.baseColor).lerp(WARN_RED, 0.35 + p * 0.55);
      mesh.position.y = rec.baseY + Math.sin(now * 0.05) * 0.09 * p;
      mesh.scale.setScalar(1 - p * 0.06);
    } else if (rec.state === 'gone') {
      /* 붕괴 중에는 타일이 회전하며 떨어집니다. 평면 오버레이는 회전을
       * 따라갈 수 없어(따라가면 종잇장이 접힌 것처럼 보입니다) 곧바로
       * 떼어냅니다. 어차피 파편이 튀는 순간이라 눈에 띄지 않습니다.   */
      if (rec.crack) releaseCrack(rec);
      const t = (now - rec.breakStart) / 420;
      if (t < 1) {
        mesh.visible = true;
        mesh.position.y = rec.baseY - t * t * 26;
        mesh.rotation.x = t * 1.1;
        mesh.rotation.z = t * 0.8;
        rec.mat.opacity = Math.max(0, 1 - t);
        mesh.scale.setScalar(Math.max(0.01, 1 - t * 0.5));
      } else if (mesh.visible) {
        mesh.visible = false;
        /* 낙하가 끝났습니다 — 빼놨던 진짜 메시를 거둡니다.
         * 여기서 안 거두면 무너진 타일마다 메시가 하나씩 남아,
         * 한 라운드에 수백 개가 씬에 쌓입니다.                    */
        TileInst.demote(rec);
      }
      /* ★ 아래 continue 가 반복문 끝의 syncLive 를 건너뜁니다.
       *   붕괴 연출은 바로 이 분기에서 만들어지므로 여기서 옮겨야
       *   떨어지는 타일이 실제로 움직입니다.                      */
      if (rec.liveMesh) TileInst.syncLive(rec);
      continue;
    } else {
      /* 점프 타일은 위아래로 살랑살랑 떠 있게 해서 '발판'으로 읽히게 합니다.
       * 두 층짜리가 더 크게·빠르게 움직여 색 말고도 구분이 하나 더 생깁니다.
       * 메시 위치만 건드리므로 드로우콜은 늘지 않습니다.               */
      const glow = rec.accelTile
        ? rec.baseGlow + Math.sin(now * 0.011 + (rec.x + rec.z) * 0.5) * 0.55
        : rec.kind === 'fragile'
        ? rec.baseGlow + Math.sin(now * 0.004 + rec.x) * 0.20
        : rec.kind === 'special'
          ? rec.baseGlow + Math.sin(now * 0.0035 + rec.x * 0.3 + rec.z * 0.3) * 0.25
          : rec.baseGlow + Math.sin(now * 0.0016 + rec.x * 0.2 + rec.z * 0.2) * 0.07;
      rec.mat.color.copy(rec.baseColor);

      /* 마모 표현. 이제 hits 가 쌓인 채 서 있는 타일은 강화 타일뿐입니다
       * (나머지는 1회에 곧바로 warn 으로 넘어갑니다).
       * baseColor 로 되돌린 뒤에 적용해야 합니다 — 순서가 바뀌면
       * 매 프레임 원래 색이 마모 표현을 덮어써서 아무 변화도 안 보입니다. */
      if (rec.hits > 0) {
        /* 금이 간 타일 — 어둡게 죽고 가라앉으며 미세하게 떱니다.
         * 회색조였다가 어둡게 바꾼 이유는 WEAR_DARK_K 주석을 보세요.
         * 발광도 0.22 → 0.10 으로 더 눌렀습니다 — 어둡게 만들어 놓고
         * 발광을 남기면 그만큼 다시 밝아져 효과가 반감됩니다.
         * 가라앉는 것은 겉모습만입니다 — 착지 높이는 층 기준이라 변하지
         * 않습니다(발이 빠져 보이지 않습니다).                       */
        rec.mat.color.multiplyScalar(WEAR_DARK_K).lerp(WEAR_DEAD, 0.22);
        rec.mat.emissiveIntensity = glow * 0.10;
        /* 가라앉는 깊이는 0.18 까지 내렸다가 0.12 로 되돌렸습니다 —
         * 발밑 타일이 내려가면 주자가 그 위에 떠 보이는데, 금 간 타일이
         * 이제 밟은 타일 대부분이라 그 틈이 내내 보입니다. 깊이 대신
         * 회색조와 균열 진하기로 표현을 가져갑니다. */
        mesh.position.y = rec.baseY - 0.12 + Math.sin(now * 0.02 + rec.x) * 0.03;
        mesh.scale.setScalar(0.975);
      } else {
        rec.mat.emissiveIntensity = glow;
        mesh.position.y = rec.baseY;
        mesh.scale.setScalar(1);
      }

      if (rec.jumpLevel > 0) {
        const amp = 0.06 + rec.jumpLevel * 0.05;
        const spd = 0.0025 + rec.jumpLevel * 0.0018;
        mesh.position.y = rec.baseY + Math.sin(now * spd + rec.x * 0.4 + rec.z * 0.4) * amp;
        rec.mat.emissiveIntensity = glow * (1 + rec.jumpLevel * 0.15);
      }

      /* ── 심사 가속이 발동 중인 층 ─────────────────────────────────
       * 화면 가장자리 경보만으로는 '어느 층이' 위험한지 모릅니다.
       * 아직 안 밟힌 타일도 붉게 물들여 층 자체를 위험 지대로 읽히게 합니다.
       * 밟혀서 warn 으로 넘어간 타일은 이 분기에 오지 않으므로(위쪽
       * else-if) 붕괴 경고 연출을 덮어쓸 걱정은 없습니다.
       * 발동 여부는 서버 layer_event 로만 바뀝니다 — 여기서 시간을 세지 않습니다. */
      if (rec.accelTrait && G.traits.accel.active) {
        const beat = Math.sin(now * 0.010) * 0.5 + 0.5;
        rec.mat.color.lerp(ACCEL_RED, 0.28 + beat * 0.24);
        rec.mat.emissiveIntensity = glow * (1.1 + beat * 0.9);
      }

      /* 금이 간 직후 아주 짧게 흔듭니다. 균열이 소리 없이 슬며시 나타나면
       * "밟혔다"가 아니라 "원래 그랬다"로 읽혀서 타격감이 죽습니다.
       * 남은 시간에 비례해 진폭을 줄여야 끝에서 뚝 끊기지 않습니다.    */
      if (rec.crackShake > 0) {
        rec.crackShake = Math.max(0, rec.crackShake - dt);
        mesh.position.y += Math.sin(now * 0.09) * 0.05 * (rec.crackShake / CRACK_SHAKE_S);
      }
    }

    /* ── 위상 타일 겉모습 ─────────────────────────────────────────
     * ON  : 위 분기에서 정해진 특수 타일 색 그대로 (꽉 찬 모습)
     * OFF : 사라지지 않고 반투명 + 윤곽선. 발광을 죽여 '실체가 아님'을
     *       보여주되, 위치와 크기는 그대로 둡니다 — 가라앉히면 무너지는
     *       타일과 헷갈립니다.
     * 실제 투명도는 아래 tileAlphaFor 가 층 반투명과 곱해서 냅니다.  */
    if (rec.phaseTile) {
      const layerAlpha = rec.targetOpacity !== undefined ? rec.targetOpacity : 1;
      if (!G.phaseOn) {
        rec.mat.emissiveIntensity = rec.baseGlow * 0.25;
        rec.mat.color.copy(rec.baseColor).lerp(WHITE_C, 0.18);
      }
      if (rec.phaseRing) {
        rec.phaseRing.visible = !G.phaseOn && rec.state !== 'gone';
        // 윤곽선은 층 반투명만 따릅니다 — OFF 반투명까지 곱하면 안 보입니다
        rec.phaseRing.material.opacity = layerAlpha * 0.95;
      }
    }

    /* ── 복구 연출 ────────────────────────────────────────────────
     * 아래에서 솟아오르며 나타납니다. 그냥 툭 나타나면 "원래 있었나?"
     * 싶어 복구가 일어났다는 걸 못 읽습니다.
     * if/else 체인 뒤에서 위치·크기만 덮어쓰므로 idle 분기가 매 프레임
     * 세워 놓은 baseY/scale 을 그대로 밀어냅니다.                    */
    if (rec.restoreStart) {
      const rt = (now - rec.restoreStart) / RESTORE_RISE_MS;
      if (rt >= 1) {
        rec.restoreStart = 0;
      } else {
        const e = 1 - Math.pow(1 - rt, 3);          // ease-out — 끝에서 부드럽게 멈춤
        mesh.position.y = rec.baseY - (1 - e) * G.hexThick * 6;
        mesh.scale.setScalar(0.55 + e * 0.45);
        // 솟는 동안만 살짝 빛나게 해서 눈이 따라가게 합니다
        rec.mat.emissiveIntensity = rec.baseGlow + (1 - rt) * 1.8;
      }
    }

    /* ── 어둠 ─────────────────────────────────────────────────────
     * 모든 상태 분기가 색을 정한 '뒤에' 곱합니다. 분기마다 넣으면
     * 경고 중인 타일만 어둠을 무시하는 식으로 반드시 어긋납니다.
     *
     * 투명하게 만들지 않고 검게 만드는 이유: 투명하면 뒤의 하늘과
     * 아래층이 비쳐서 오히려 정보가 더 드러납니다. "완전히 검게"가
     * 규칙이므로 색과 발광을 0 으로 눌러야 맞습니다.
     *
     * 붕괴 중(gone)인 타일은 위에서 continue 로 빠져 여기 오지 않습니다.
     * 420ms 짜리 낙하 연출이라 그대로 두는 편이 자연스럽습니다.      */
    /* 어둠(층 특성)과 깊이 감쇠(아래층)를 한 번에 곱합니다.
     * 둘 다 '모든 상태 분기가 색을 정한 뒤'에 적용돼야 하고, 곱하는
     * 자리가 같아야 분기마다 어긋나지 않습니다. 균열 오버레이도 아래에서
     * 이 값을 그대로 쓰므로 함께 따라옵니다. */
    const darkK = darkFactorFor(rec) * (rec.depthDim === undefined ? 1 : rec.depthDim);
    if (darkK < 1) {
      rec.mat.color.multiplyScalar(darkK);
      rec.mat.emissiveIntensity *= darkK;
      if (rec.phaseRing) rec.phaseRing.material.opacity *= darkK;
    }

    /* 층 반투명 × 위상 OFF 반투명. 둘을 곱하는 이유는 tileAlphaFor 참고. */
    const wantAlpha = tileAlphaFor(rec);
    rec.mat.opacity += (wantAlpha - rec.mat.opacity) * smoothK(6, dt);

    /* ── 균열 오버레이 추종 ────────────────────────────────────────
     * 타일은 마모되면 가라앉고, 경고 중엔 진동하고, 스케일도 줄어듭니다.
     * 이걸 전부 따라가지 않으면 균열만 원래 높이에 떠서 남습니다.
     * 회전만은 따라가지 않습니다 (붕괴 회전은 위 gone 분기에서 해제).  */
    if (rec.crack) {
      const c = rec.crack;
      const t = Math.min(1, (now - c.born) / CRACK_GROW_MS);
      // 위층이 반투명해지면 균열도 같이 흐려져야 합니다.
      // 어둠에 잠긴 타일의 균열만 하얗게 떠 있으면 안 되므로 함께 지웁니다.
      /* 0.9 → 1.0. 균열이 이제 주 정보 채널이라 흐릴 이유가 없습니다.
       * (위층 반투명·어둠에는 여전히 함께 따라갑니다)               */
      const baseAlpha = tileAlphaFor(rec) * darkK;
      c.mesh.position.set(rec.x, mesh.position.y + G.hexThick / 2 + 0.02, rec.z);
      c.mesh.scale.setScalar(mesh.scale.x * (0.55 + 0.45 * t));   // 툭 튀어나오지 않게 퍼짐
      c.mesh.rotation.x = -Math.PI / 2;
      if (rec.state === 'warn') {
        // 마지막 단계이므로 가장 진하게, 붉은 틴트로 경고와 맞춥니다
        c.mat.opacity = baseAlpha;
        c.mat.color.setHex(CRACK_WARN_TINT);
      } else {
        c.mat.opacity = baseAlpha * t;
        c.mat.color.setHex(0xffffff);
      }
    }

    /* 무너지는 중이라 진짜 메시가 붙어 있으면 위에서 정한 값을 옮겨 줍니다.
     * 위 코드는 rec.mesh(변형 상자)와 rec.mat(값 상자)만 건드리므로
     * 인스턴스든 개별 메시든 같은 코드로 돌아갑니다.                 */
    if (rec.liveMesh) TileInst.syncLive(rec);
  }

  /* 이 프레임에 정해진 변형·색·발광·투명도를 인스턴스 버퍼로 올립니다.
   * 반복문 안에서 타일마다 올리면 버퍼 업로드가 1,626번 일어나므로
   * 반드시 여기 한 번에 모아서 합니다.                              */
  TileInst.sync();
}

/* ── 신속심사 타일 방향 화살표 ────────────────────────────────────────
 * 대시 방향은 '밟는 사람의 진행 방향'이라 타일에 고정으로 그릴 수 없습니다.
 * 그래서 화살표는 하나만 만들어 두고, 내가 신속심사 타일 위에 올라섰을 때만
 * 그 타일 위에 띄우고 local.ry 로 돌립니다. 드로우콜은 1개 늘어납니다.
 * ------------------------------------------------------------------ */
let dashArrow = null;
function ensureDashArrow() {
  if (dashArrow) return dashArrow;
  const S = G.hexSize || HEX_SIZE_BASE;
  // 납작한 삼각형(원뿔 3각) 하나. 위에서 내려다보므로 이걸로 충분합니다.
  const geo = new THREE.ConeGeometry(S * 0.34, S * 0.78, 3);
  const mat = new THREE.MeshBasicMaterial({
    color: 0xffffff, transparent: true, opacity: 0.9, depthWrite: false, toneMapped: false
  });
  dashArrow = new THREE.Mesh(geo, mat);
  dashArrow.rotation.x = Math.PI / 2;      // 눕혀서 XZ 평면을 향하게
  dashArrow.renderOrder = 4;
  dashArrow.visible = false;
  fxGroup.add(dashArrow);
  return dashArrow;
}

function updateDashArrow() {
  const a = ensureDashArrow();
  const rec = local.groundTile;
  if (!local.alive || G.role !== 'player' || !rec || !rec.accelTile || rec.state === 'gone') {
    a.visible = false;
    return;
  }
  a.visible = true;
  a.position.set(rec.x, rec.top + 0.35, rec.z);
  /* ConeGeometry 는 +Y 를 향하는데 rotation.x=π/2 로 눕히면 +Z 를 봅니다.
   * local.ry 는 atan2(dirX, dirZ) 이므로 그대로 y 회전에 넣으면 맞습니다. */
  a.rotation.y = local.ry;
  a.material.color.setHex(local.dash ? 0x00ffcc : 0xffffff);
  const pulse = 0.55 + (Math.sin(performance.now() * 0.012) * 0.5 + 0.5) * 0.45;
  a.material.opacity = pulse;
  a.scale.setScalar(1 + (1 - pulse) * 0.25);
}

/* ============================ 10. boosters & obstacles ================= */

/* 지오메트리를 모듈 로드 시점에 만들면 G.hexSize 가 아직 없습니다
 * (서버 config 를 받기 전). 그래서 처음 쓸 때 만들고, 타일 크기가 바뀌면
 * 다시 만듭니다.                                                       */
let boosterGeo = null, boosterGeoSize = 0;
function getBoosterGeo() {
  const S = G.hexSize || 3.2 / 1.5;
  if (boosterGeo && boosterGeoSize === S) return boosterGeo;
  if (boosterGeo) boosterGeo.dispose();
  boosterGeoSize = S;
  const r = S * FX.BOOSTER_R;
  boosterGeo = new THREE.CylinderGeometry(r, r * 0.92, 0.6, 24);
  return boosterGeo;
}

function spawnBooster(e) {
  /* 서버 x/z 는 층 로컬 좌표입니다. 지금 층 각도로 월드 좌표를 냅니다.
   * (구 서버는 layer 를 안 보내므로 y 로 층을 추정합니다)            */
  const anchor = syncEntityToLayer({
    lx: e.x, lz: e.z,
    layer: e.layer !== undefined ? e.layer : currentLayerOf(e.y)
  });

  const mat = new THREE.MeshStandardMaterial({
    color: 0xffcc00, emissive: 0xffaa00, emissiveIntensity: 1.5,
    metalness: 0.7, roughness: 0.25, transparent: true, opacity: 0.95
  });
  const mesh = new THREE.Mesh(getBoosterGeo(), mat);
  mesh.position.set(anchor.x, e.y, anchor.z);
  mesh.castShadow = true;
  fxGroup.add(mesh);

  const S = G.hexSize || 3.2 / 1.5;
  const ring = new THREE.Mesh(
    new THREE.RingGeometry(S * FX.BOOSTER_RING_IN, S * FX.BOOSTER_RING_OUT, 32),
    new THREE.MeshBasicMaterial({ color: 0xffcc00, transparent: true, opacity: 0.5, side: THREE.DoubleSide, depthWrite: false })
  );
  ring.rotation.x = -Math.PI / 2;
  ring.position.set(anchor.x, e.y + 0.6, anchor.z);
  fxGroup.add(ring);

  G.boosters.set(e.id, {
    id: e.id,
    /* lx/lz = 층 로컬(회전 전) 좌표 — 이게 원본입니다.
     * x/z  = 그것을 현재 각도로 돌린 월드 좌표 — 매 프레임 갱신됩니다.  */
    lx: e.x, lz: e.z, x: anchor.x, z: anchor.z, y: e.y,
    mesh, ring, mat,
    layer: anchor.layer, born: performance.now(), ttl: e.ttl || 7000
  });
}

function removeBooster(id) {
  const b = G.boosters.get(id);
  if (!b) return;
  fxGroup.remove(b.mesh); fxGroup.remove(b.ring);
  b.mesh.material.dispose(); b.ring.material.dispose();
  G.boosters.delete(id);
}

function updateBoosters(dt, now) {
  for (const b of G.boosters.values()) {
    /* 회전층에 지원된 발판은 층과 함께 돕니다. 착지 판정도 여기서 갱신한
     * b.x/b.z 를 그대로 보므로 발판과 판정이 어긋나지 않습니다.       */
    syncEntityToLayer(b);
    b.mesh.position.x = b.x; b.mesh.position.z = b.z;
    b.ring.position.x = b.x; b.ring.position.z = b.z;

    const age = now - b.born;
    const left = b.ttl - age;
    b.mesh.rotation.y += dt * 1.1;
    b.ring.rotation.z += dt * 0.6;
    const s = 1 + Math.sin(now * 0.006) * 0.04;
    b.ring.scale.setScalar(s);
    if (left < 1600) {
      const blink = Math.sin(now * 0.03) * 0.5 + 0.5;
      b.mat.opacity = 0.35 + blink * 0.6;
      b.ring.material.opacity = 0.15 + blink * 0.4;
    }
    if (left <= 0) removeBooster(b.id);
  }
}

let obsGeo = null, obsGeoSize = 0;
function getObsGeo() {
  const S = G.hexSize || 3.2 / 1.5;
  if (obsGeo && obsGeoSize === S) return obsGeo;
  if (obsGeo) obsGeo.dispose();
  obsGeoSize = S;
  obsGeo = new THREE.BoxGeometry(S * FX.OBS_W, 0.3, S * FX.OBS_D);
  return obsGeo;
}

function spawnObstacle(e) {
  /* 서버가 보내는 x/z 는 목표 타일의 층 로컬 좌표입니다.
   * 낙하에 1.4초가 걸리므로 그 사이 층이 돌면 착탄 지점도 따라가야
   * 합니다 — 그래서 로컬 좌표를 들고 매 프레임 월드로 바꿉니다.      */
  const anchor = syncEntityToLayer({
    lx: e.x, lz: e.z,
    layer: e.layer !== undefined ? e.layer : currentLayerOf(e.y)
  });

  const mat = new THREE.MeshStandardMaterial({
    color: 0xece7d8, emissive: 0xff2d2d, emissiveIntensity: 0.35, roughness: 0.85
  });
  const mesh = new THREE.Mesh(getObsGeo(), mat);
  mesh.position.set(anchor.x, e.fromY, anchor.z);
  mesh.rotation.y = Math.random() * 3.14;
  mesh.castShadow = true;
  fxGroup.add(mesh);

  const S = G.hexSize || 3.2 / 1.5;
  const marker = new THREE.Mesh(
    new THREE.RingGeometry(S * FX.OBS_RING_IN, S * FX.OBS_RING_OUT, 24),
    new THREE.MeshBasicMaterial({ color: 0xff2d2d, transparent: true, opacity: 0.65, side: THREE.DoubleSide, depthWrite: false })
  );
  marker.rotation.x = -Math.PI / 2;
  marker.position.set(anchor.x, e.y + 0.7, anchor.z);
  fxGroup.add(marker);

  G.obstacles.set(e.id, {
    id: e.id, mesh, marker, mat,
    // lx/lz = 층 로컬 원본, x/z = 매 프레임 갱신되는 월드 좌표 (부스터와 동일)
    lx: e.x, lz: e.z, x: anchor.x, z: anchor.z, y: e.y,
    layer: anchor.layer, fromY: e.fromY,
    born: performance.now(), duration: e.durationMs || 1400, impacted: false
  });
}

function updateObstacles(dt, now) {
  for (const o of G.obstacles.values()) {
    /* 낙하 중에도 목표 타일을 따라갑니다 — 회전층이면 착탄 지점이
     * 1.4초 사이에 움직이므로, 안 따라가면 엉뚱한 자리에 떨어집니다. */
    syncEntityToLayer(o);
    o.mesh.position.x = o.x; o.mesh.position.z = o.z;
    o.marker.position.x = o.x; o.marker.position.z = o.z;

    const p = Math.min(1, (now - o.born) / o.duration);
    o.mesh.position.y = o.fromY + (o.y + 1.2 - o.fromY) * (p * p);
    o.mesh.rotation.z = Math.sin(p * 9) * 0.3;
    o.marker.material.opacity = 0.25 + (Math.sin(now * 0.02) * 0.5 + 0.5) * 0.55;
    o.marker.scale.setScalar(1.35 - p * 0.35);

    if (p >= 1 && !o.impacted) {
      o.impacted = true;
      // knockback for the local runner if caught in the blast radius
      /* 반경은 타일 크기를 따라가고, 세기(26)와 높이 판정(5)은 그대로입니다.
       * 세기는 속도라서 주자 속도(PHYS)와 같은 척도인데 주자는 안 커지므로,
       * 같이 키우면 검증 상한(MAX_H_SPEED 30.1)을 넘겨 오히려 튕깁니다. */
      const blastR = (G.hexSize || 3.2 / 1.5) * FX.BLAST_R;
      const dx = local.pos.x - o.x, dz = local.pos.z - o.z;
      const d = Math.hypot(dx, dz);
      if (local.alive && d < blastR && Math.abs(local.pos.y - o.y) < 5) {
        const k = (1 - d / blastR) * 26;
        local.vel.x += (dx / (d || 1)) * k;
        local.vel.z += (dz / (d || 1)) * k;
        local.vel.y = Math.max(local.vel.y, 9);
        local.grounded = false;
        // 맞아서 뜬 것도 점프와 같게 취급합니다.
        // 제자리에 다시 떨어지는 것은 낙하가 아니기 때문입니다.
        local.jumped = true;
        local.lastGroundY = local.pos.y;
      }
      setTimeout(() => removeObstacle(o.id), 520);
    }
  }
}

function removeObstacle(id) {
  const o = G.obstacles.get(id);
  if (!o) return;
  fxGroup.remove(o.mesh); fxGroup.remove(o.marker);
  o.mesh.material.dispose(); o.marker.material.dispose();
  G.obstacles.delete(id);
}

/* ============================ 11. dead reckoning ====================== */

/* 원격 주자 동기화 상태 — F2 진단 패널에 표시합니다.
 * lastErr 이 평상시 0.3 을 넘나들면 SMOOTH_HALFLIFE 를, snaps 가 계속
 * 늘어나면 네트워크나 SNAP_DIST 를 의심하면 됩니다.                     */
const netStats = { snaps: 0, lastErr: 0, corrections: 0, lastCorrectionToast: -Infinity,
  phaseFixes: 0,     // 위상 타일 계산이 서버와 어긋나 서버 값으로 넘어간 횟수
  dashes: 0,         // 신속심사 타일로 대시한 횟수
  jumps: 0,          // 점프 타일로 발사된 횟수
  accels: 0,         // 심사 가속이 발동된 횟수 (서버 layer_event 기준)
  darks: 0,          // 어둠이 발동된 횟수
  searches: 0,       // 내가 선행기술 검색 타일을 밟은 횟수
  rotFlips: 0,       // 회전 방향이 반전된 횟수
  rotFixes: 0 };     // 회전 각도를 서버 값으로 되맞춘 횟수 (평상시 0)

const UP_AXIS = new THREE.Vector3(0, 1, 0);   // slerp 회전축 (공용 상수)

/**
 * Remote runners are rendered INTERP_DELAY_MS in the past and interpolated
 * between the two snapshots that bracket that render time. When the newest
 * snapshot is older than the render time (packet loss / jitter spike) we
 * extrapolate with the last known velocity, capped at EXTRAPOLATE_CAP_MS so
 * a stalled peer never rockets off the map.
 */
class RemoteRunner {
  constructor(meta) {
    this.id = meta.id;
    this.name = meta.name;
    this.color = meta.color;
    this.seat = meta.seat;
    this.alive = meta.alive !== false;
    this.layer = meta.layer || 3;
    this.anim = 'idle';
    this.buffer = [];
    this.render = new THREE.Vector3(meta.pos ? meta.pos.x : 0, meta.pos ? meta.pos.y : 24.35, meta.pos ? meta.pos.z : 0);
    this.renderRy = 0;
    this.speed01 = 0;
    this.snaps = 0;                        // 이 주자에게 걸린 강제 스냅 횟수 (진단용)
    this._qCur = new THREE.Quaternion();    // slerp 작업용 — 프레임마다 새로 만들지 않습니다
    this._qTarget = new THREE.Quaternion();
    /* ★ update() 안에서 쓰던 clone()/new Vector3() 를 대신합니다.
     *   원격 주자 1명당 매 프레임 최대 2개씩 만들어졌습니다.
     *   인스턴스마다 따로 두어 주자끼리 섞일 여지를 없앱니다.        */
    this._tgt = new THREE.Vector3();
    this._vel = new THREE.Vector3();
    this.avatar = buildAvatar(meta.color, meta.name, meta.seat);
    this.avatar.group.position.copy(this.render);
    actorGroup.add(this.avatar.group);
  }

  push(s, localNow) {
    this.buffer.push({
      t: localNow,
      p: new THREE.Vector3(s.p[0], s.p[1], s.p[2]),
      v: new THREE.Vector3(s.v[0], s.v[1], s.v[2]),
      ry: s.ry, anim: s.a, layer: s.l, alive: !!s.al,
      // 서버가 g 를 안 보내면(구버전) 애니메이션으로 접지를 추정합니다
      grounded: s.g === undefined ? (s.a !== 'jump' && s.a !== 'fall') : !!s.g
    });
    if (this.buffer.length > 24) this.buffer.shift();
  }

  /**
   * 추측 항법 — 마지막 스냅샷에서 ahead 초만큼 물리를 전진시킨다.
   *
   * 공중이면 등가속도 운동을 그대로 적분합니다.
   *     p = p0 + v0*t + ½*g*t²
   *     v = v0 + g*t
   * 접지 상태면 중력을 적용하지 않고 수평 등속으로만 밀어야 합니다.
   * (접지한 상대에게 중력을 더하면 바닥을 뚫고 가라앉아 보입니다.)
   *
   * 공중 예측은 바닥을 뚫을 수 있으므로, 예측 지점 아래 지면을 찾아
   * 그 위에서 멈춥니다. 서버 스냅샷이 도착하면 어차피 교정됩니다.
   */
  static predict(snap, ahead, outVel) {
    const t = Math.max(0, ahead);
    const p = snap.p.clone();

    if (snap.grounded) {
      // 접지: 수평만 전진, 높이는 유지
      p.x += snap.v.x * t;
      p.z += snap.v.z * t;
      if (outVel) outVel.set(snap.v.x, 0, snap.v.z);
      return p;
    }

    // 공중: 중력 가속도까지 반영
    p.x += snap.v.x * t;
    p.z += snap.v.z * t;
    p.y += snap.v.y * t + 0.5 * PHYS.GRAVITY * t * t;

    let vy = snap.v.y + PHYS.GRAVITY * t;
    if (vy < PHYS.MAX_FALL) vy = PHYS.MAX_FALL;   // 종단속도는 로컬 물리와 동일하게 제한
    if (outVel) outVel.set(snap.v.x, vy, snap.v.z);

    // 예측이 바닥을 관통하지 않도록 지면에서 멈춥니다
    if (snap.v.y <= 0) {
      const floor = groundYUnder(p.x, p.z, snap.p.y) + NET.GROUND_EPS;
      if (p.y < floor) p.y = floor;
    }
    return p;
  }

  update(dt, localNow) {
    const renderTime = localNow - NET.INTERP_DELAY_MS;
    const buf = this.buffer;
    let target = null, vel = null;

    if (buf.length === 0) {
      target = this._tgt.copy(this.render);
    } else if (buf.length === 1 || renderTime <= buf[0].t) {
      target = this._tgt.copy(buf[0].p);
      this.renderRy = buf[0].ry;
      this.anim = buf[0].anim; this.layer = buf[0].layer; this.alive = buf[0].alive;
    } else {
      let a = null, b = null;
      for (let i = buf.length - 1; i > 0; i--) {
        if (buf[i - 1].t <= renderTime && buf[i].t >= renderTime) { a = buf[i - 1]; b = buf[i]; break; }
      }
      if (a && b) {
        // --- interpolation path ---
        const span = Math.max(1, b.t - a.t);
        const k = THREE.MathUtils.clamp((renderTime - a.t) / span, 0, 1);
        target = this._tgt.copy(a.p).lerp(b.p, k);
        this.renderRy = lerpAngle(a.ry, b.ry, k);
        this.anim = k < 0.5 ? a.anim : b.anim;
        this.layer = b.layer; this.alive = b.alive;
        vel = b.v;
      } else {
        /* --- dead reckoning (extrapolation) path ---
         * 다음 스냅샷이 아직 안 왔습니다. 마지막 상태에서 물리를 굴려
         * 상대가 멈칫하지 않고 계속 움직이게 합니다.                     */
        const last = buf[buf.length - 1];
        const ahead = Math.min(renderTime - last.t, NET.EXTRAPOLATE_CAP_MS) / 1000;
        vel = this._vel.set(0, 0, 0);
        target = RemoteRunner.predict(last, ahead, vel);
        this.renderRy = last.ry;
        this.anim = last.anim; this.layer = last.layer; this.alive = last.alive;
      }
    }

    /* --- 예외 안전: 예측이 크게 빗나가면 강제 스냅 ---
     * 오차가 SNAP_DIST 를 넘으면 보간을 포기합니다. 이 경우 부드럽게
     * 따라가면 상대가 몇 초에 걸쳐 허공을 가로지르며 미끄러집니다.
     * 순간이동이 보기 흉해도, 틀린 위치에 오래 머무는 것보다 낫습니다.  */
    /* 대시 중인 주자는 스냅샷 간 이동량이 평소의 두 배라 평소 기준으로는
     * 강제 스냅이 걸립니다. player_impulse 를 받은 동안만 허용 오차를
     * 넓혀 부드럽게 따라가게 합니다 (기본값은 그대로 둡니다).        */
    const tolerant = this.tolerantUntil !== undefined && localNow < this.tolerantUntil;
    const snapSq = tolerant ? NET.SNAP_DIST_SQ * 9 : NET.SNAP_DIST_SQ;

    const errSq = this.render.distanceToSquared(target);
    if (errSq > snapSq) {
      this.render.copy(target);
      this.snaps = (this.snaps || 0) + 1;
      netStats.snaps++;
    } else {
      /* 지수 감쇠 보간. 프레임레이트가 흔들려도 수렴 속도가 일정하도록
       * halflife 기반으로 계수를 만듭니다 (dt 에 독립적).               */
      const k = 1 - Math.pow(0.5, dt / NET.SMOOTH_HALFLIFE);
      this.render.lerp(target, k);
    }
    netStats.lastErr = Math.sqrt(errSq);

    const av = this.avatar;
    av.group.position.copy(this.render);

    /* --- 회전: 쿼터니언 구면 보간(slerp) ---
     * Y축 yaw 를 쿼터니언으로 올려 slerp 로 돌립니다. 각도 wrap(+π/−π 경계)에서
     * 한 바퀴 되감기는 현상이 생기지 않습니다.
     *
     * 주의: 결과를 quaternion 에 통째로 대입하면 안 됩니다. animateAvatar 가
     * rotation.x(사망 시 쓰러짐)와 rotation.z(흔들림)를 프레임마다 '누적'하는데,
     * 통째로 덮으면 그 값이 매 프레임 0으로 리셋돼 연출이 멈춥니다.
     * 그래서 slerp 결과에서 yaw 만 뽑아 rotation.y 에 넣습니다.          */
    this._qCur.setFromAxisAngle(UP_AXIS, av.group.rotation.y);
    this._qTarget.setFromAxisAngle(UP_AXIS, this.renderRy);
    this._qCur.slerp(this._qTarget, smoothK(14, dt));
    // Y축 회전 쿼터니언 (0, sin(θ/2), 0, cos(θ/2)) 에서 θ 복원
    av.group.rotation.y = 2 * Math.atan2(this._qCur.y, this._qCur.w);
    this.speed01 = vel ? THREE.MathUtils.clamp(Math.hypot(vel.x, vel.z) / PHYS.SPRINT, 0, 1) : 0;
    animateAvatar(av, dt, this.speed01, this.alive ? this.anim : 'dead');
    av.group.visible = true;
    updateGroundShadow(av, this.render.y,
      groundYUnder(this.render.x, this.render.z, this.render.y),
      this.anim !== 'jump' && this.anim !== 'fall');
  }

  dispose() {
    actorGroup.remove(this.avatar.group);
  }
}

function lerpAngle(a, b, k) {
  let d = ((b - a + Math.PI) % (Math.PI * 2)) - Math.PI;
  if (d < -Math.PI) d += Math.PI * 2;
  return a + d * k;
}

/* ============================ 12. camera rig ========================== */

const camTarget = new THREE.Vector3();
const camDesired = new THREE.Vector3();
/* camTarget.lerp 에 넘길 목표점. 매 프레임 new THREE.Vector3 를 만들면
 * 초당 60개가 쓰레기로 쌓입니다. */
const _camGoal = new THREE.Vector3();

/**
 * 프레임률에 영향받지 않는 지수 평활 계수.
 *
 * ★ `dt * k` 는 틀린 근사입니다.
 *   지수 평활의 정확한 계수는 1 − e^(−k·dt) 인데, dt 가 작을 때만 dt·k 와
 *   비슷합니다. 60fps 에서 k=8 이면 정확값 0.1248 vs 근사값 0.1333 — 7%
 *   차이이고, 더 나쁜 것은 그 오차가 dt 에 비례해 '프레임마다 달라진다'는
 *   점입니다. 카메라 추종 지연이 매 프레임 흔들리면, 월드에서 완벽하게
 *   등속으로 달려도 화면 속 캐릭터는 앞뒤로 떱니다.
 *
 *   이 게임은 평활을 두 겹으로 겁니다(플레이어 → camTarget → camera.position).
 *   두 겹이 각자 오차를 내므로 체감은 한 겹일 때의 두 배가 됩니다.
 *
 * ★ 같은 k 값을 그대로 넘겨도 됩니다. 정상 상태의 추종 지연은 거의 같고,
 *   달라지는 것은 '프레임 시간이 흔들려도 결과가 같다'는 성질뿐입니다.
 */
function smoothK(k, dt) {
  return 1 - Math.exp(-k * dt);
}

/* ── 낙하 속도선 ─────────────────────────────────────────────────────
 * 세기는 '지금 낙하 속도 ÷ 한 층 낙하 속도(G.fallNorm)' 로 정합니다.
 * 절대 속도로 잡으면 LAYER_GAP 을 바꿀 때마다 다시 맞춰야 하는데, 이 비율은
 * 층 간격이 얼마든 '한 층 떨어지는 중 = 1.0' 이라는 뜻을 유지합니다.
 *   0.6 부터 비치기 시작 → 1.6 에서 최대
 *   한 층 낙하(1.0)는 옅게 스치고, 라운드 시작 낙하(≈1.55)에서 몰아칩니다.
 */
let speedLinesEl = null;
let speedLinesOn = false;

function updateSpeedLines(rawRatio) {
  if (!speedLinesEl) speedLinesEl = document.getElementById('speedLines');
  if (!speedLinesEl) return;
  const k = THREE.MathUtils.clamp((rawRatio - 0.6) / 1.0, 0, 1);
  const vis = !!local.alive && k > 0.001;
  /* 클래스는 상태가 바뀔 때만 만집니다 — 매 프레임 toggle 하면 애니메이션이
   * 계속 처음부터 다시 시작해 줄기가 떨립니다. */
  if (vis !== speedLinesOn) {
    speedLinesOn = vis;
    speedLinesEl.classList.toggle('on', vis);
  }
  speedLinesEl.style.opacity = (k * 0.62).toFixed(3);
}

/* ── 착지 충격 카메라 흔들림 ─────────────────────────────────────────
 * ★ lookAt 뒤에 위치만 흔듭니다. 시선(camTarget)은 건드리지 않으므로
 *   주자는 화면에 그대로 있고 카메라만 덜컹입니다. 회전을 흔들면 조준점이
 *   같이 튀어 조작이 흔들린 것처럼 느껴집니다.
 *
 * ★ 세기도 속도선과 같은 비율(충격속도 ÷ G.fallNorm)로 잡습니다.
 *   0.45 미만(제자리 점프 착지 등)은 아예 흔들지 않습니다 — 걸어다니는 내내
 *   화면이 덜덜거리면 연출이 아니라 잡음이 됩니다.                    */
const CAM_SHAKE_MS = 300;
const camShake = { t: 0, amp: 0, phase: 0, lat: new THREE.Vector3() };

function addCamShake(impactSpeed) {
  const n = (impactSpeed || 0) / (G.fallNorm || 45);
  if (n < 0.45) return;
  const amp = Math.min(0.95, 0.12 + (n - 0.45) * 0.55);
  // 이미 더 센 흔들림이 돌고 있으면 약한 충격이 덮어쓰지 않게 합니다
  if (amp <= camShake.amp * camShake.t) return;
  camShake.amp = amp;
  camShake.t = 1;
  camShake.phase = 0;
  camShake.lat.set(Math.random() * 2 - 1, 0, Math.random() * 2 - 1).normalize();
}

/* 천장(위층 판) 밑면과 카메라 사이에 남길 여유. 0 이면 카메라가 판에
 * 스치듯 붙어 근평면에 타일이 잘려 들어옵니다.                        */
const CAM_CEIL_CLEARANCE = 1.25;
/* 지금 서 있는 층을 천장으로 잘못 잡지 않기 위한 여유.
 * 발밑 층은 focus.y 보다 아래이므로 이 정도면 충분히 갈립니다.        */
const CAM_CEIL_EPS = 1.0;

/** focus.y 보다 위에 있는 층들 중 가장 낮은 층의 y. 없으면 null(=최상층). */
function ceilingYAbove(y) {
  let best = null;
  for (const Lx of G.layerOrder) {
    const ly = G.layerY[Lx];
    if (ly > y + CAM_CEIL_EPS && (best === null || ly < best)) best = ly;
  }
  return best;
}

/* ══════════════════════════════════════════════════════════════════════
 * 입장 카메라 비행
 * ────────────────────────────────────────────────────────────────────
 * 대기 화면에서 보던 자리(관전 시점)에서 내 대기 발판까지 카메라가
 * 날아갑니다. 대기 화면 뒤에서 이미 게임이 보이고 있었기 때문에,
 * 이 비행이 '구경하던 곳에서 내 자리로 들어간다'로 읽힙니다.
 *
 * ★ 카메라를 직접 몰지 않고 '기존 해답을 블렌딩'합니다.
 *   updateCamera 가 매 프레임 내는 목표(camDesired/camTarget)는 천장
 *   클램프·낙하 피치·거리 평활을 전부 거친 값입니다. 비행 중에만 다른
 *   식으로 몰면 끝나는 순간 그 규칙들로 돌아가면서 툭 튑니다.
 *   시작 자세에서 '그 시점의 정답'으로 이어 주면 끝에서 정확히 맞물립니다.
 *
 * ★ 비행 중에는 위치 평활(lerp)을 끕니다.
 *   블렌딩 위에 평활이 또 걸리면 카메라가 목표를 못 따라가 끝에서
 *   한 번 더 미끄러집니다. 비행 자체가 이미 이징입니다.             */
let camFlight = null;          // { t, dur, from: Vector3, look: Vector3 }
let pendingCamFlight = false;  // 참가를 눌렀고, init 이 오면 날아갈 것

function beginCamFlight(dur) {
  camFlight = {
    t: 0,
    dur: dur || 1.15,
    from: camera.position.clone(),
    look: camTarget.clone()
  };
}

function cancelCamFlight() { camFlight = null; pendingCamFlight = false; }

function updateCamera(dt) {
  // 탈락 연출 중에는 카메라를 캐릭터에 붙여 둡니다.
  // 곧바로 관전 시점으로 튀면 무슨 일이 일어났는지 알 수 없습니다.
  /* 카메라 초점도 보간 위치입니다. pos(60Hz 격자)를 따라가면 카메라가
   * 격자 단위로 끊겨 움직여, 아바타를 보간해 놓고도 화면 전체가 덜컹입니다. */
  /* 피날레 중에는 승자를 봅니다 — 내가 죽었든 살았든 모두가 같은 그림을
   * 봐야 '저 사람이 이겼다'가 전달됩니다. */
  const focus = finale ? finale
    : ((local.alive || local.dying > 0) ? local.render : spectateFocus());

  _camGoal.set(focus.x, focus.y + cam.height, focus.z);
  camTarget.lerp(_camGoal, smoothK(8, dt));

  // Auto pitch: ease the camera up while the runner is plummeting so the
  // landing zone below stays framed, and pull it down on the top layer.
  // 45 였던 정규화 기준은 LAYER_GAP 파생(G.fallNorm)으로 바뀌었습니다.
  const fallRatio = -local.vel.y / (G.fallNorm || 45);
  const falling = THREE.MathUtils.clamp(fallRatio, 0, 1);
  const autoPitch = 0.5 + falling * 0.42;
  /* 속도선은 clamp 하지 않은 비율을 씁니다 — 카메라 피치는 1.0 에서
   * 포화되지만, 속도선은 '한 층 낙하'와 '시작 낙하'를 구분해야 합니다. */
  updateSpeedLines(fallRatio);
  cam.pitch = THREE.MathUtils.lerp(cam.pitch, THREE.MathUtils.clamp(cam.pitch, 0.08, 1.36), 1);
  const usedPitch = cam.dragging ? cam.pitch : THREE.MathUtils.lerp(cam.pitch, autoPitch, smoothK(0.9, dt));
  if (!cam.dragging) cam.pitch = usedPitch;

  cam.dist += (cam.targetDist - cam.dist) * smoothK(5, dt);

  const horiz = Math.cos(cam.pitch) * cam.dist;
  camDesired.set(
    camTarget.x + Math.sin(cam.yaw) * horiz,
    camTarget.y + Math.sin(cam.pitch) * cam.dist,
    camTarget.z + Math.cos(cam.yaw) * horiz
  );

  /* ── 천장 클램프 ──────────────────────────────────────────────────
   * 카메라가 '내 위층 판' 위로 올라가지 못하게 막습니다.
   *
   * ★ 이게 없으면 위층 타일이 화면을 덮습니다. 카메라 높이는
   *     CAM.HEIGHT(3) + CAM.DIST(24)×sin(pitch)
   *   라서 pitch 가 조금만 서도 LAYER_GAP 을 넘어갑니다. 넘는 순간
   *   위층 판을 위에서 내려다보게 되어 시야가 통째로 막힙니다.
   *   실측(가운데 층·시점 9종 평균): 클램프 없음 47.6% → 있음 3.3%.
   *
   * ★ 목표점(camTarget)은 건드리지 않고 카메라 높이만 낮춥니다.
   *   그래서 시선은 그대로 주자를 향하고, 시점이 조금 눕을 뿐입니다.
   *   pitch 자체를 깎으면 사용자의 드래그 입력과 싸우게 됩니다.
   *
   * ★ 최상층에는 천장이 없으므로 제한이 걸리지 않습니다. 낙하 중에는
   *   방금 떠난 층이 천장이 되어, 내려가는 동안 아래가 계속 보입니다.
   * --------------------------------------------------------------- */
  const ceilY = ceilingYAbove(focus.y);
  if (ceilY !== null) {
    const limit = ceilY - G.hexThick / 2 - CAM_CEIL_CLEARANCE;
    // 주자보다 아래로 내려가 버리면 밑에서 올려다보는 이상한 그림이 됩니다
    camDesired.y = Math.max(camTarget.y + 1.0, Math.min(camDesired.y, limit));
  }

  if (camFlight) {
    camFlight.t = Math.min(1, camFlight.t + dt / camFlight.dur);
    /* ease-in-out — 출발과 도착이 부드럽고 가운데가 빠릅니다.
     * 등속으로 날면 '카메라가 끌려간다'로 보입니다. */
    const x = camFlight.t;
    const e = x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
    camDesired.lerpVectors(camFlight.from, camDesired, e);
    camTarget.lerpVectors(camFlight.look, camTarget, e);
    camera.position.copy(camDesired);
    if (camFlight.t >= 1) camFlight = null;
  } else {
    camera.position.lerp(camDesired, smoothK(9, dt));
  }
  camera.lookAt(camTarget);

  /* 착지 충격 — 시선을 잡은 뒤 위치만 덜컹입니다 (addCamShake 주석 참고).
   * t 는 1 → 0 으로 줄고 제곱으로 감쇠시켜, 첫 덜컹이 가장 크고 빠르게 잦아듭니다. */
  if (camShake.t > 0) {
    camShake.t = Math.max(0, camShake.t - dt * (1000 / CAM_SHAKE_MS));
    camShake.phase += dt * 42;
    const k = camShake.amp * camShake.t * camShake.t;
    camera.position.y += Math.sin(camShake.phase) * k;
    camera.position.addScaledVector(camShake.lat, Math.sin(camShake.phase * 0.7) * k * 0.45);
  }

  // 스카이돔은 항상 카메라를 중심에 둡니다. 어디로 이동하든 잘리지 않고,
  // 회전할 때만 배경이 움직여 실제 하늘처럼 보입니다.
  if (skyMesh) skyMesh.position.copy(camera.position);
  // 구름과 소품은 월드에 고정합니다. 카메라가 움직이면 시차가 생겨
  // 배경이 진짜 3D 공간처럼 느껴집니다.

  keyLight.position.set(
    focus.x + keyLightDir.x * 80,
    focus.y + keyLightDir.y * 80,
    focus.z + keyLightDir.z * 80
  );
  keyLight.target.position.set(focus.x, focus.y, focus.z);
  keyLight.target.updateMatrixWorld();

  applyLayerTransparency(local.alive ? local.layer : currentLayerOf(focus.y));
}

/* ══════════════════════════════════════════════════════════════════════
 * 승리 피날레 (updateFinale)
 * ────────────────────────────────────────────────────────────────────
 * 종전에는 마지막 1인이 정해져도 화면에서 아무 일도 일어나지 않았습니다.
 * 정적인 HTML 결과 패널만 떴습니다 — 행사에서 다 같이 보는 순간인데
 * 시작 연출(게이트+균열+낙하)에 대응하는 무게가 전혀 없었습니다.
 *
 * 구성:
 *   0.0s  타일 붕괴가 멎고 카메라가 승자에게 붙어 공전 시작
 *   0.0s  승자 발밑에서 빛기둥이 솟고 서류가 흩날림
 *   0.6s  등록증이 펼쳐짐        (showVerdict 'grant')
 *   1.1s  등록결정 도장이 찍힘   (CSS animation-delay)
 *   3.4s  결과 패널
 *
 * ★ 빛기둥은 시작 연출의 부품을 재사용합니다.
 *   makeGlowTexture() 로 만든 같은 글로우를 원통에 입혀, 시작의 게이트와
 *   끝의 빛기둥이 같은 빛으로 보이게 합니다. 새 텍스처를 만들면 두 연출이
 *   서로 다른 게임처럼 보입니다.
 *
 * ★ 카메라는 updateCamera 를 덮지 않고 '초점'만 바꿉니다.
 *   천장 클램프·거리 평활 같은 기존 규칙을 그대로 타야 카메라가 층을
 *   뚫거나 튀지 않습니다. yaw 만 매 프레임 돌려 공전을 만듭니다.
 * ══════════════════════════════════════════════════════════════════════ */
let finale = null;                 // { x,y,z, t, pillar }
const FINALE_SPIN = 0.42;          // rad/s — 한 바퀴 15초. 어지럽지 않은 속도

function beginFinale(pos, opts) {
  endFinale();
  finale = { x: pos.x, y: pos.y, z: pos.z, t: 0, pillar: null };

  /* 빛기둥 — 위로 갈수록 옅어지는 원통. 바닥에서 하늘까지 이어져
   * '여기 한 사람이 남았다'를 멀리서도 읽히게 합니다. */
  const R = (G.hexSize || 2.13) * 1.15;
  const H = 120;
  const geo = new THREE.CylinderGeometry(R, R * 1.5, H, 24, 1, true);
  const mat = new THREE.MeshBasicMaterial({
    map: makeGlowTexture(), color: 0xfff0b8, transparent: true, opacity: 0,
    blending: THREE.AdditiveBlending, side: THREE.DoubleSide,
    depthWrite: false, toneMapped: false
  });
  const m = new THREE.Mesh(geo, mat);
  m.position.set(pos.x, pos.y + H / 2 - 1, pos.z);
  m.renderOrder = 3;
  fxGroup.add(m);
  finale.pillar = { mesh: m, mat, geo };

  spawnGateFlare(pos.x, pos.y + 0.4, pos.z, 0xffe9a8);
  spawnPaperBurst(pos.x, pos.y + 1.0, pos.z, 22);
  addCamShake(18);

  /* 등록증 → 도장 순서는 showVerdict 가 CSS 로 물고 있습니다. */
  setTimeout(() => {
    if (finale) showVerdict('grant', opts || {});
  }, 600);
}

function endFinale() {
  if (!finale) return;
  if (finale.pillar) {
    fxGroup.remove(finale.pillar.mesh);
    finale.pillar.mat.dispose();
    finale.pillar.geo.dispose();
  }
  finale = null;
}

function updateFinale(dt) {
  if (!finale) return;
  finale.t += dt;
  /* 카메라 공전. updateCamera 가 cam.yaw 를 읽어 위치를 내므로
   * 여기서는 각도만 돌리면 됩니다(드래그 중이면 사용자 우선). */
  if (!cam.dragging) cam.yaw += FINALE_SPIN * dt;
  const p = finale.pillar;
  if (!p) return;
  /* 0.35초에 걸쳐 솟았다가 길게 유지되고 끝에서 사그라듭니다 */
  const up = Math.min(1, finale.t / 0.35);
  const fade = finale.t > 5.0 ? Math.max(0, 1 - (finale.t - 5.0) / 1.2) : 1;
  p.mat.opacity = 0.42 * up * fade;
  p.mesh.rotation.y += dt * 0.5;
  p.mesh.scale.set(1 + Math.sin(finale.t * 2.2) * 0.05, 1, 1 + Math.sin(finale.t * 2.2) * 0.05);
}

function spectateFocus() {
  if (G.specTarget) {
    const r = G.players.get(G.specTarget);
    if (r && r.alive) return r.render;
  }
  for (const r of G.players.values()) if (r.alive) return r.render;
  // 아무도 안 남았으면 가운데 층 높이를 봅니다 (층이 몇 개든)
  const mid = G.layerOrder[Math.floor(G.layerOrder.length / 2)];
  return new THREE.Vector3(0, mid === undefined ? 0 : G.layerY[mid], 0);
}

/* ============================ 13. HUD ================================= */

/* 층 안내문을 서버 config.LAYERS 로 만듭니다.
 *
 * 종전에는 HTML 에 3개가 박혀 있었고 CSS 도 data-l="1|2|3" 만 색을 줬습니다.
 * 층이 5개가 되면 두 곳을 손으로 고쳐야 했고, 순서를 뒤집으면 색이
 * 어긋났습니다. 이제 이름·약칭·색이 전부 서버에서 옵니다.
 *
 * 5개가 세로로 안 들어가는 문제:
 *   1) 4개 이상이면 .compact 로 항목 높이를 줄이고
 *   2) 그래도 넘치면 .scroll 을 붙여 스크롤합니다
 * .scroll 일 때만 pointer-events 를 켭니다 — 항상 켜 두면 안내문 위에서
 * 카메라 드래그가 먹지 않습니다.                                       */
/* 참가 화면의 규칙 설명을 서버 상수로 만듭니다.
 * 종전에는 "3번 밟으면 무너집니다 / 함정 블록" 이 문장으로 박혀 있었는데,
 * 규칙이 4종 체계로 바뀌면서 그대로 두면 거짓 설명이 됩니다.           */
/* ── 대기 화면 시놉시스 ───────────────────────────────────────────────
 * 스토리텔링 기획서(IP_Guardians_Storytelling_Master.html) 1절을 대기
 * 화면 길이에 맞게 줄인 것입니다.
 *
 * ★ 층 수와 층 이름은 문장에 박지 않고 config 에서 꺼냅니다.
 *   LAYER_DEFS 를 고치면 '5층'과 층 이름이 같이 틀어지는데, 세계관 문장은
 *   규격 설명과 달리 틀려도 티가 안 나서 오래 방치됩니다.
 */
function buildSynopsis(layers) {
  const el = document.getElementById('joinSynopsis');
  if (!el) return;
  const top = layers[0];
  const bottom = layers[layers.length - 1];
  const n = layers.length;

  const line = (html) => '<span class="ln">' + html + '</span>';
  const b = (t) => '<b>' + t + '</b>';

  const html = [
    '<span class="q">"권리는 위에서 아래로 깎여 내려간다"</span>',
    line('당신은 방금 특허를 출원했습니다. 지금 서 있는 ' +
         (n ? b(n + '층 ' + (top.name || '')) : b('최상층')) +
         ' 은 가장 높고, 가장 빠르고, 가장 위태로운 자리입니다.'),
    line('발밑이 무너지는 것은 심사관이 당신의 권리를 깎아내는 과정입니다. ' +
         '한 층 떨어질 때마다 특허는 ' + b('더 좁아지고, 더 늦어집니다') + '.'),
    line('맨 아래 ' + ((bottom && bottom.name) ? bottom.name + ' 층' : '바닥') +
         ' 밑 구름바다는 포기와 취하의 영역입니다. 닿는 순간 거절결정이 확정됩니다.'),
    line('마지막까지 발판 위에 남은 ' + b('단 한 사람') + '만이 등록결정서를 받습니다.')
  ].join('');
  el.innerHTML = html;
  /* 한 줄씩 차례로 떨어뜨립니다. 지연을 CSS 에 못 박지 않고 여기서 주는 이유는
   * 줄 수가 층 구성에 따라 달라질 수 있기 때문입니다(:nth-child 로 박으면 어긋납니다). */
  [...el.children].forEach((node, i) => { node.style.animationDelay = (i * 140) + 'ms'; });
}

/* ── 층 스택 미니 다이어그램 ─────────────────────────────────────────
 * cfg.LAYERS 를 그대로 그립니다 — 층이 4개로 줄거나 6개로 늘어도, 순서나
 * 색이 바뀌어도 따라옵니다. 층 번호를 세지 않고 배열 순서대로 그리므로
 * '위에서 아래로'가 항상 맞습니다 (LAYERS 는 0번이 최상층).
 */
let stackTimer = null;

function buildJoinStack(layers) {
  const box = document.getElementById('joinStack');
  if (!box) return;
  box.innerHTML = '';
  for (const Lx of layers) {
    const row = document.createElement('div');
    row.className = 'lsRow';
    /* color 를 CSS 변수가 아니라 요소의 color 로 둡니다 — .lsBar 가
     * currentColor 를 쓰므로 막대·번호·테두리가 한 번에 따라옵니다. */
    row.style.color = Lx.color || '#ece7d8';
    const bar = document.createElement('span'); bar.className = 'lsBar';
    const num = document.createElement('span'); num.className = 'lsNum';
    num.textContent = 'L' + Lx.index;
    const nm = document.createElement('span'); nm.className = 'lsName';
    nm.textContent = Lx.short || Lx.name || '';
    row.append(bar, num, nm);
    box.appendChild(row);
  }
  const sea = document.createElement('div');
  sea.className = 'lsSea';
  sea.textContent = '~ 구름바다 · 탈락 ~';
  box.appendChild(sea);

  startStackLoop();
}

/* 최상층부터 한 칸씩 내려가며 점등 → 구름바다 → 잠깐 쉬고 반복.
 * 시놉시스 첫 줄('위에서 아래로 깎여 내려간다')을 그대로 움직임으로 옮긴 것입니다. */
/* ══════════════════════════════════════════════════════════════════════
 * 대기 화면 배경 — 무너지는 육각 타일
 * ────────────────────────────────────────────────────────────────────
 * 게임 본편과 같은 flat-top 육각 배치를 씁니다(가로 1.5R, 세로 √3R,
 * 홀수 열 반 칸 내림). 같은 규약이라 배경과 실제 맵이 따로 놀지 않습니다.
 *
 * ★ 타일을 지웠다 되살리는 순환입니다. 계속 부수기만 하면 20초쯤 뒤에
 *   화면이 텅 비어 배경이 사라집니다. 그래서 broken 이 된 타일은 일정
 *   시간 뒤 다시 살아나고, 살아 있는 비율이 대체로 일정하게 유지됩니다.
 *
 * ★ 색은 층 팔레트에서 가져오되 아주 옅게 씁니다. 배경이 카드의 글자와
 *   경쟁하면 안 되기 때문입니다 — 여기서 강하게 칠하고 싶어지면 opacity
 *   대신 #joinBg 의 CSS opacity 를 만지세요.
 * ══════════════════════════════════════════════════════════════════════ */
const BG = {
  hexR: 44,            // 육각 외접원 반지름(px)
  breakEveryMs: 240,   // 이 간격마다 살아 있는 타일 하나를 무너뜨립니다
  fuseMs: 620,         // 경고(금 가는 중) 지속
  fallMs: 760,         // 무너지는 연출 길이
  reviveMinMs: 2600,   // 되살아나기까지 최소/최대
  reviveMaxMs: 7000,
  fadeInMs: 900
};

let bgCanvas = null, bgCtx = null, bgTiles = [], bgRaf = 0, bgBreakAcc = 0, bgResizeBound = false;

function bgLayerColors() {
  const Ls = (G.cfg && G.cfg.LAYERS) || [];
  const cols = Ls.map((L) => L.color).filter(Boolean);
  return cols.length ? cols : ['#00ffcc', '#7c5cff', '#0088ff', '#ff8a3d', '#aa00ff'];
}

function bgBuild() {
  if (!bgCanvas) return;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const w = bgCanvas.clientWidth, h = bgCanvas.clientHeight;
  if (!w || !h) return;
  bgCanvas.width = Math.round(w * dpr);
  bgCanvas.height = Math.round(h * dpr);
  bgCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

  const R = BG.hexR;
  const dx = R * 1.5, dy = Math.sqrt(3) * R;
  const cols = bgLayerColors();
  bgTiles = [];
  /* 화면 밖으로 한 칸씩 더 깔아 가장자리가 잘린 티가 안 나게 합니다. */
  for (let q = -1; q * dx <= w + dx; q++) {
    for (let i = -1; i * dy <= h + dy; i++) {
      const cx = q * dx;
      const cy = i * dy + (q % 2 ? dy / 2 : 0);
      bgTiles.push({
        x: cx, y: cy,
        state: 'alive',      // alive | warn | fall | gone | rise
        t: 0,
        col: cols[(q * 3 + i * 5 + cols.length * 10) % cols.length],
        /* 처음부터 몇 개는 비워 둡니다 — 전부 꽉 찬 상태로 시작하면
         * 첫 몇 초 동안 아무 일도 안 일어나는 것처럼 보입니다. */
        seed: (q * 7919 + i * 104729) % 1000 / 1000
      });
    }
  }
  for (const t of bgTiles) if (t.seed < 0.12) { t.state = 'gone'; t.t = t.seed * BG.reviveMaxMs; }
}

function bgHexPath(ctx, x, y, r) {
  ctx.beginPath();
  for (let k = 0; k < 6; k++) {
    const a = k * Math.PI / 3;               // flat-top: 꼭짓점이 좌우를 향합니다
    const px = x + r * Math.cos(a), py = y + r * Math.sin(a);
    if (k === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
  }
  ctx.closePath();
}

function bgStep(dt) {
  /* 살아 있는 것 중 하나를 골라 무너뜨립니다. 인덱스를 무작위로 한 번만
   * 뽑고 그 근처를 훑습니다 — 매번 전체를 필터링하면 타일 수만큼 배열을
   * 새로 만들게 됩니다.
   *
   * ★ 벽시계(performance.now)가 아니라 넘겨받은 dt 를 누적합니다.
   *   타일의 퓨즈·부활은 dt 로 도는데 붕괴 스케줄만 벽시계를 쓰면 둘이
   *   따로 놉니다 — 탭이 백그라운드에 다녀오면 dt 는 64ms 로 잘리는데
   *   벽시계는 몇 초를 건너뛰어, 복귀 순간 한 장만 무너지고 나머지는
   *   전부 되살아나 있는 이상한 상태가 됩니다. */
  bgBreakAcc += dt;
  if (bgBreakAcc >= BG.breakEveryMs && bgTiles.length) {
    bgBreakAcc = 0;
    let i = Math.floor(Math.random() * bgTiles.length);
    for (let n = 0; n < bgTiles.length; n++) {
      const t = bgTiles[(i + n) % bgTiles.length];
      if (t.state === 'alive') { t.state = 'warn'; t.t = 0; break; }
    }
  }
  for (const t of bgTiles) {
    t.t += dt;
    if (t.state === 'warn' && t.t >= BG.fuseMs) { t.state = 'fall'; t.t = 0; }
    else if (t.state === 'fall' && t.t >= BG.fallMs) {
      t.state = 'gone'; t.t = 0;
      t.wait = BG.reviveMinMs + Math.random() * (BG.reviveMaxMs - BG.reviveMinMs);
    }
    else if (t.state === 'gone' && t.t >= (t.wait || BG.reviveMinMs)) { t.state = 'rise'; t.t = 0; }
    else if (t.state === 'rise' && t.t >= BG.fadeInMs) { t.state = 'alive'; t.t = 0; }
  }
}

function bgDraw() {
  const ctx = bgCtx;
  if (!ctx) return;
  ctx.clearRect(0, 0, bgCanvas.clientWidth, bgCanvas.clientHeight);
  const R = BG.hexR;
  for (const t of bgTiles) {
    if (t.state === 'gone') continue;
    let a = 1, scale = 1, dy = 0, warn = 0;
    if (t.state === 'warn') { warn = Math.min(1, t.t / BG.fuseMs); }
    else if (t.state === 'fall') {
      const k = Math.min(1, t.t / BG.fallMs);
      a = 1 - k; scale = 1 - k * 0.35; dy = k * k * 26; warn = 1;
    } else if (t.state === 'rise') {
      a = Math.min(1, t.t / BG.fadeInMs);
    }
    if (a <= 0.01) continue;
    bgHexPath(ctx, t.x, t.y + dy, R * 0.94 * scale);
    /* 평소엔 거의 보이지 않는 종이색, 무너질 때만 층 색이 올라옵니다.
     * '가만히 있으면 배경, 무너질 때만 눈에 띈다'가 의도입니다. */
    ctx.fillStyle = 'rgba(236,231,216,' + (0.030 * a).toFixed(3) + ')';
    ctx.fill();
    if (warn > 0) {
      ctx.fillStyle = bgHexToRgba(t.col, 0.16 * warn * a);
      ctx.fill();
    }
    ctx.lineWidth = 1;
    ctx.strokeStyle = warn > 0
      ? bgHexToRgba(t.col, (0.20 + 0.45 * warn) * a)
      : 'rgba(236,231,216,' + (0.085 * a).toFixed(3) + ')';
    ctx.stroke();
  }
}

function bgHexToRgba(hex, alpha) {
  const n = parseInt(String(hex).slice(1), 16);
  return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + alpha.toFixed(3) + ')';
}

function startJoinBg() {
  stopJoinBg();
  if (!joinScreenVisible()) return;
  bgCanvas = document.getElementById('joinBg');
  if (!bgCanvas || !bgCanvas.getContext) return;
  bgCtx = bgCanvas.getContext('2d');
  bgBuild();
  if (!bgResizeBound) {
    bgResizeBound = true;
    /* 리사이즈마다 격자를 다시 만듭니다. 캔버스 픽셀 크기가 바뀌면 좌표가
     * 어긋나므로 늘리기만 해서는 안 됩니다. */
    window.addEventListener('resize', () => { if (bgRaf) bgBuild(); });
  }
  /* 연출 최소화 설정이면 한 장만 그리고 멈춥니다. */
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    bgDraw();
    return;
  }
  let last = performance.now();
  const frame = (now) => {
    if (!bgRaf) return;
    const dt = Math.min(64, now - last);   // 탭 복귀 시 한 프레임에 몰아 도는 것 방지
    last = now;
    bgStep(dt);
    bgDraw();
    bgRaf = requestAnimationFrame(frame);
  };
  bgRaf = requestAnimationFrame(frame);
}

function stopJoinBg() {
  if (bgRaf) { cancelAnimationFrame(bgRaf); bgRaf = 0; }
  if (bgCtx && bgCanvas) bgCtx.clearRect(0, 0, bgCanvas.clientWidth, bgCanvas.clientHeight);
  bgTiles = [];
}

/**
 * 라운드 시작 낙하 동안 주자끼리 밀지 않게 막는 시간(ms).
 *
 * ★ 종전에는 BUMP.START_GRACE_MS = 700 이 박혀 있었습니다. 그 700 의 근거는
 *   '발판 높이 9 에서 떨어지는 데 0.54초'였는데, 높이를 45 로 올리면 낙하가
 *   1.2초라 창이 먼저 닫힙니다. 그러면 전원이 공중에 뜬 채로 서로 밀어
 *   시작하자마자 난장판이 됩니다 — 바로 그 상황을 막으려고 만든 창인데
 *   높이 하나 바꿨다고 무력해지는 셈입니다.
 *
 *   그래서 서버가 내려준 실제 높이에서 매번 계산합니다.
 *       낙하 시간 = √(2·h/g),  여기에 착지 정리용 여유 260ms
 */
function startFallGraceMs() {
  const rise = (G.cfg && G.cfg.PEDESTAL_RISE) || 9;
  const g = Math.abs(PHYS.GRAVITY) || 62;
  return Math.round(Math.sqrt(2 * rise / g) * 1000) + 260;
}

/** 대기 화면이 아직 떠 있는가.
 *
 * ★ 두 연출 타이머(층 스택 점등·대기열 폴링)의 시작 조건입니다.
 *   입장 핸들러에서 stop 을 부르는 것만으로는 부족했습니다 — 입장은
 *   connect() 를 부르고, 그 뒤에 도착하는 server_hello 가 buildRulesText()
 *   를 다시 실행해 타이머를 되살렸습니다. 호출 순서에 기대지 않도록
 *   '대기 화면이 보일 때만 돈다' 를 시작 지점에서 못박습니다.        */
function joinScreenVisible() {
  const js = document.getElementById('joinScreen');
  return !!js && js.classList.contains('show');
}

function startStackLoop() {
  stopStackLoop();
  if (!joinScreenVisible()) return;
  const box = document.getElementById('joinStack');
  if (!box) return;
  const rows = [...box.querySelectorAll('.lsRow'), box.querySelector('.lsSea')].filter(Boolean);
  if (!rows.length) return;
  let i = 0;
  const step = () => {
    rows.forEach((r) => r.classList.remove('on'));
    /* rows.length 번째는 '전부 꺼진 상태' — 다시 최상층으로 돌아가기 전의 쉼입니다.
     * 이게 없으면 맨 아래에서 맨 위로 점등이 튀어 끊겨 보입니다. */
    if (i < rows.length) rows[i].classList.add('on');
    i = (i + 1) % (rows.length + 1);
  };
  step();
  stackTimer = setInterval(step, 900);
}

function stopStackLoop() {
  if (stackTimer) { clearInterval(stackTimer); stackTimer = null; }
}

/* ── 대기열 현황 ─────────────────────────────────────────────────────
 * 입장 전에는 소켓으로 방 목록을 받을 수 없습니다(join 해야 룸에 들어갑니다).
 * 그래서 서버가 이미 갖고 있는 GET /api/rooms 를 폴링합니다 — 진단용으로
 * 만들어 둔 것이지만 phase 와 players 가 그대로 들어 있어 이 용도에 맞습니다.
 *
 * ★ 왜 필요한가 — 종전에는 '지금 들어가면 바로 시작되는지'를 알 수 없어서,
 *   혼자 들어갔다가 대기만 하다 나가는 흐름이 됐습니다.
 *
 * ★ 실패해도 조용히 넘어갑니다. 대기열 표시가 안 되는 것보다 대기 화면이
 *   깨지는 게 훨씬 나쁩니다.
 */
let queueTimer = null;

/* ── 로비 ─────────────────────────────────────────────────────────────
 * 선택한 방. null 이면 '빠른 참가'(서버가 알아서 몰아 줍니다).
 *
 * ★ 왜 기본이 '아무것도 안 고름' 인가
 *   방을 자유롭게 고르게 두면 인원이 흩어져 <b>어느 방도 정원이 안 차는</b>
 *   상황이 생깁니다 — 12명이 6개 방에 2명씩 들어가면 전부 대기 타임아웃까지
 *   기다립니다. 서버의 findOpenRoom 은 빈 방부터 채워서 이걸 막고 있는데,
 *   방 선택은 그 보장을 깨뜨립니다. 그래서 선택은 '친구랑 같은 방' 용도의
 *   보조 수단으로만 두고, 목록도 채워진 정도를 가장 크게 보여 줍니다.  */
let lobbyPick = null;

/* ★ startsIn 의 뜻이 달라졌습니다.
 *   종전에는 "가만히 둬도 이때 시작" 이었고, 지금은 <b>전원 준비가
 *   끝났을 때만</b> 서버가 채웁니다(evaluateLobby). 그래서 이 값이
 *   있다는 것 자체가 "이 방은 곧 시작한다" 는 뜻입니다.
 *   준비 인원은 따로 보여 줍니다 — 들어갈 방을 고르는 근거가
 *   "몇 명 있나" 에서 "얼마나 준비됐나" 로 바뀌었기 때문입니다.  */
function lobbyRoomLabel(r, seats) {
  if (r.phase === 'playing' || r.phase === 'ended') return ['play', '진행 중'];
  if (r.players >= seats) return ['play', '정원'];
  if (r.phase === 'countdown') return ['soon', '곧 시작'];
  if (r.startsIn > 0) return ['soon', Math.ceil(r.startsIn / 1000) + '초 뒤'];
  if (r.players >= 2 && r.ready >= r.players) return ['soon', '준비 완료'];
  if (r.players >= 2) return ['wait', '준비 ' + (r.ready || 0) + '/' + r.players];
  return ['wait', '대기 중'];
}

function renderLobby(rooms) {
  G.lobbyRooms = rooms || [];     // 좌석 예측(previewSeat)이 참조합니다
  const box = dom.lbList;
  if (!box) return;
  const seats = (G.cfg && G.cfg.MAX_PLAYERS) || G.seats || 4;
  const list = (rooms || []).slice().sort((a, b) => {
    /* 들어갈 수 있는 방을 위로, 그중에서도 많이 찬 방을 위로.
     * 목록 맨 위가 '지금 들어가면 바로 시작하는 방' 이 되게 합니다. */
    const ja = a.joinable ? 1 : 0, jb = b.joinable ? 1 : 0;
    if (ja !== jb) return jb - ja;
    return (b.players || 0) - (a.players || 0);
  });

  if (dom.lbCount) dom.lbCount.textContent = list.length ? list.length + ' 곳' : '—';

  if (!list.length) {
    box.innerHTML = '<div class="lbEmpty">아직 열린 심사실이 없습니다 · 입장하면 새로 열립니다</div>';
    lobbyPick = null;
    syncJoinCta();
    return;
  }

  /* 사라진 방을 고른 채로 두면 입장이 조용히 실패합니다 */
  if (lobbyPick && !list.some((r) => r.id === lobbyPick)) lobbyPick = null;

  box.innerHTML = list.map((r) => {
    const st = lobbyRoomLabel(r, seats);
    const dots = [];
    for (let i = 0; i < seats; i++) dots.push('<i' + (i < r.players ? ' class="on"' : '') + '></i>');
    const dis = !r.joinable;
    return '<div class="lbRow' + (dis ? ' full' : '') + (r.id === lobbyPick ? ' sel' : '') +
      '" data-room="' + r.id + '" data-dis="' + (dis ? 1 : 0) + '">' +
      '<span class="lbId">' + escapeHtml(r.id) + '</span>' +
      '<span class="lbMap">' + escapeHtml(r.themeName || '') +
        (r.spectators ? ' · 관전 ' + r.spectators : '') + '</span>' +
      '<span class="lbFill">' + dots.join('') +
        '<span class="lbNum">' + r.players + '/' + seats + '</span></span>' +
      '<span class="lbState ' + st[0] + '">' + st[1] + '</span>' +
      '</div>';
  }).join('');
  syncJoinCta();
  refreshAvPreview();      // 방이 차면 내 좌석 번호·색도 바뀝니다
}

/* 선택 상태에 따라 버튼 문구가 바뀝니다 — 무엇이 일어날지 버튼이 말해야 합니다 */
function syncJoinCta() {
  if (!dom.btnJoin) return;
  dom.btnJoin.textContent = lobbyPick
    ? lobbyPick + ' 심사실로 입장'
    : (joinMode === 'spectator' ? '관전으로 입장' : '빠른 참가 — 심사 대기열');
}

function renderQueue(rooms) {
  renderLobby(rooms);
  const box = document.getElementById('joinQueue');
  const txt = document.getElementById('joinQueueText');
  if (!box || !txt) return;
  const seats = (G.cfg && G.cfg.MAX_PLAYERS) || G.seats || 4;
  let waiting = 0, playing = 0;
  for (const r of rooms || []) {
    if (r.phase === 'playing' || r.phase === 'countdown') playing++;
    else waiting += (r.players || 0);
  }
  let msg;
  if (waiting > 0) msg = '대기 중인 출원인 ' + waiting + '명 · 전원 준비하면 방장이 시작합니다';
  else if (playing > 0) msg = '진행 중인 심사 ' + playing + '회차 · 지금 들어가면 다음 회차부터';
  else msg = '열린 심사실이 없습니다 · 방을 만들면 첫 방장이 됩니다';
  txt.textContent = msg;
  box.classList.toggle('live', waiting > 0 || playing > 0);
}

/* ══════════════════════════════════════════════════════════════════════
 * 캐릭터 미리보기
 * ────────────────────────────────────────────────────────────────────
 * ★ 왜 전용 렌더러를 두는가
 *   메인 씬에 얹어 카드 옆에 오려 붙이려면 시저 테스트로 화면 일부만
 *   따로 그려야 하는데, 참가 화면이 HTML 오버레이라 그 자리에 '구멍'을
 *   뚫어 두고 좌표를 맞춰야 합니다 — 창 크기가 바뀔 때마다 어긋납니다.
 *   작은 캔버스에 전용 렌더러를 두면 레이아웃이 알아서 자리를 잡습니다.
 *   132×150 짜리라 비용도 무시할 만합니다.
 *
 * ★ 좌석 색은 '내가 실제로 받게 될 색'입니다.
 *   서버는 좌석 번호를 방의 현재 인원수로 줍니다(makePlayer). 그래서
 *   지금 겨냥하고 있는 방의 인원수가 곧 내 좌석 번호입니다. 방을 고르면
 *   색이 따라 바뀝니다. 로비 목록이 1.5초마다 갱신되므로 그때 같이
 *   다시 계산합니다.
 *
 * ★ GLB 가 아직 안 왔으면 절차적 캐릭터로 먼저 세우고, 로드가 끝나면
 *   다시 만듭니다. 이 미리보기 덕분에 참가 시점에는 이미 로드가 끝나
 *   있습니다 — 종전에는 참가 직후 몇 초간 캐릭터가 없었습니다.
 * ══════════════════════════════════════════════════════════════════════ */
let avPrev = null;        // { renderer, scene, camera, av, seat, key, raf, t }

function previewSeat() {
  const seats = (G.cfg && G.cfg.MAX_PLAYERS) || 4;
  /* 겨냥한 방 — 고른 방이 있으면 그 방, 없으면 지금 붙어 있는 방 */
  const want = lobbyPick || G.roomId;
  const r = (G.lobbyRooms || []).find((x) => x.id === want);
  const n = r ? r.players : 0;
  return Math.min(seats - 1, Math.max(0, n));
}

function previewColor(seat) {
  const cols = (G.cfg && G.cfg.seatColors) || [];
  return cols.length ? cols[seat % cols.length] : '#00ffcc';
}

function ensureAvPreview() {
  if (avPrev) return avPrev;
  const cv = document.getElementById('avCanvas');
  if (!cv || typeof THREE === 'undefined') return null;
  let renderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true });
  } catch (e) { return null; }      // 컨텍스트를 못 얻으면 미리보기만 조용히 포기
  renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
  renderer.outputEncoding = THREE.sRGBEncoding;

  const scene = new THREE.Scene();
  /* 조명은 메인 씬과 같은 구성의 축소판입니다 — 여기서만 다른 톤이면
   * 참가 직후 '색이 달라졌다'고 느낍니다. */
  scene.add(new THREE.HemisphereLight(0xcfeaff, 0x40506a, 1.15));
  const key = new THREE.DirectionalLight(0xffffff, 1.25);
  key.position.set(2.4, 4.2, 3.0);
  scene.add(key);
  const rim = new THREE.DirectionalLight(0x8fe8ff, 0.55);
  rim.position.set(-3.0, 1.6, -2.4);
  scene.add(rim);

  const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 60);
  avPrev = { renderer, scene, camera, av: null, seat: -1, key: '', raf: 0, t: 0, last: 0 };
  return avPrev;
}

/* 이름·좌석이 바뀌었을 때만 다시 만듭니다. 매 프레임 새로 만들면
 * GLB 클론 비용이 그대로 프레임에 실립니다. */
function refreshAvPreview() {
  const p = ensureAvPreview();
  if (!p) return;
  const name = (dom.nameInput && dom.nameInput.value.trim()) || '익명출원인';
  const seat = previewSeat();
  const key = name + '|' + seat + '|' + (CHAR.ready ? 'm' : 'p');
  if (key === p.key) return;
  p.key = key;
  p.seat = seat;

  if (p.av) { p.scene.remove(p.av.group); }
  const col = previewColor(seat);
  p.av = buildAvatar(col, name, seat);
  /* 명찰은 머리 위에 크게 떠 있어 작은 상자에서는 얼굴을 가립니다 */
  if (p.av.plate) p.av.plate.visible = false;
  p.scene.add(p.av.group);

  const box = document.getElementById('avBox');
  if (box) box.style.setProperty('--seatC', col);
  updateAvLoading(seat);
}

/* 좌석 줄과 진행 막대. refreshAvPreview 는 이름·좌석이 바뀔 때만 도는데
 * 진행률은 계속 변하므로 따로 떼어 매 프레임 갱신합니다.               */
let avLoadSeat = 0;
function updateAvLoading(seat) {
  if (seat !== undefined) avLoadSeat = seat;
  const tag = document.getElementById('avSeat');
  const bar = document.getElementById('avBar');
  if (!tag) return;
  const seatTxt = '좌석 <b>' + (avLoadSeat + 1) + '</b>번';
  let next;
  if (CHAR.ready) {
    next = seatTxt + ' · 준비됨';
  } else if (CHAR.error) {
    /* GLB 를 못 받았습니다. 절차적 캐릭터로 계속 놀 수 있으므로 오류가
     * 아니라 '이게 지금 쓰는 캐릭터'라고만 알립니다.                 */
    next = seatTxt + '<span class="ld">기본 캐릭터로 진행</span>';
  } else {
    next = seatTxt + '<span class="ld">캐릭터 내려받는 중' +
           (CHAR.total ? ' ' + Math.round(CHAR.progress * 100) + '%' : '') + '</span>';
  }
  if (tag.innerHTML !== next) tag.innerHTML = next;      // 매 프레임 DOM 쓰기 방지
  if (!bar) return;
  const show = !CHAR.ready && !CHAR.error;
  bar.classList.toggle('on', show);
  bar.classList.toggle('idle', show && !CHAR.total);
  if (show && CHAR.total) bar.firstElementChild.style.width = (CHAR.progress * 100).toFixed(1) + '%';
}

function startAvPreview() {
  stopAvPreview();
  if (!joinScreenVisible()) return;
  const p = ensureAvPreview();
  if (!p) return;
  refreshAvPreview();
  p.last = performance.now();
  const loop = () => {
    if (!avPrev || !joinScreenVisible()) { stopAvPreview(); return; }
    avPrev.raf = requestAnimationFrame(loop);
    const now = performance.now();
    const dt = Math.min(0.05, (now - avPrev.last) / 1000);
    avPrev.last = now;
    avPrev.t += dt;

    const cv = avPrev.renderer.domElement;
    const w = cv.clientWidth || 132, h = cv.clientHeight || 150;
    if (cv.width !== w || cv.height !== h) {
      avPrev.renderer.setSize(w, h, false);
      avPrev.camera.aspect = w / h;
      avPrev.camera.updateProjectionMatrix();
    }
    if (avPrev.av) {
      avPrev.av.group.rotation.y = avPrev.t * 0.6;
      if (avPrev.av.mixer) avPrev.av.mixer.update(dt);
      /* 발밑 링은 바닥에 붙는 표시라 허공에 뜬 미리보기에서는 어색합니다 */
      if (avPrev.av.ring) avPrev.av.ring.visible = false;
    }
    /* 진행률 표시와, 모델이 도착했을 때의 교체. refreshAvPreview 의 키에
     * CHAR.ready 가 들어 있어 준비되는 순간 자동으로 다시 만들어집니다. */
    updateAvLoading();
    refreshAvPreview();

    const H = (avPrev.av && avPrev.av.height) || 3.1;
    avPrev.camera.position.set(0, H * 0.58, H * 2.35);
    avPrev.camera.lookAt(0, H * 0.48, 0);
    avPrev.renderer.render(avPrev.scene, avPrev.camera);
  };
  loop();
}

function stopAvPreview() {
  if (avPrev && avPrev.raf) { cancelAnimationFrame(avPrev.raf); avPrev.raf = 0; }
}

/* 참가하면 미리보기는 더 필요 없습니다. 컨텍스트까지 놓아 줍니다 —
 * 게임 중에 WebGL 컨텍스트를 두 개 물고 있을 이유가 없습니다. */
function disposeAvPreview() {
  stopAvPreview();
  if (!avPrev) return;
  if (avPrev.av) avPrev.scene.remove(avPrev.av.group);
  if (avPrev.renderer.forceContextLoss) avPrev.renderer.forceContextLoss();
  avPrev.renderer.dispose();
  avPrev = null;
}

function pollQueue() {
  fetch('/api/rooms', { cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : null))
    .then((rooms) => { if (rooms) renderQueue(rooms); })
    .catch(() => {});
}

function startQueuePoll() {
  stopQueuePoll();
  if (!joinScreenVisible()) return;
  pollQueue();
  /* 2500 → 1500. 로비가 붙으면서 이 폴링이 '방 목록'도 겸합니다.
   * 카운트다운이 5초라 2.5초 주기로는 '곧 시작'을 놓칩니다. */
  queueTimer = setInterval(pollQueue, 1500);
}

function stopQueuePoll() {
  if (queueTimer) { clearInterval(queueTimer); queueTimer = null; }
}

function buildRulesText() {
  const cfg = G.cfg || {};
  const layers = cfg.LAYERS || [];
  const K = cfg.TILE_KINDS || {};

  buildSynopsis(layers);
  buildJoinStack(layers);
  startQueuePoll();
  startJoinBg();
  startAvPreview();
  /* 좌석 수도 config 파생으로. 종전에는 '최대 4인'이 마크업에 박혀 있어
   * MAX_PLAYERS 를 바꾸면 버튼만 거짓말을 했습니다. */
  const pm = document.querySelector('.mode[data-mode="player"]');
  if (pm && cfg.MAX_PLAYERS) pm.textContent = '주자로 참가 (최대 ' + cfg.MAX_PLAYERS + '인)';

  const eb = document.getElementById('joinEyebrow');
  if (eb) eb.textContent = 'KIPO SURVIVAL PROTOCOL · ' + (layers.length || '?') + '-LAYER';

  const el = document.getElementById('joinRules');
  if (!el) return;
  const sec = (ms) => (ms / 1000).toFixed(1).replace(/\.0$/, '') + '초';
  const span = (k) => (K[k].fuseMin === K[k].fuseMax)
    ? sec(K[k].fuseMin)
    : sec(K[k].fuseMin) + '~' + sec(K[k].fuseMax);

  /* ★ TILE_KINDS 에 있다고 다 쓰이는 것은 아닙니다.
   *   타일을 2종으로 줄이면서 normal · fragile 은 표에는 남아 있고
   *   비율만 0 이 됐습니다. 존재 여부로 판단하면 '지금 깔리지도 않는
   *   타일'을 설명하게 되므로 TILE_MIX 를 함께 봅니다.              */
  const MIX = cfg.TILE_MIX || {};
  const used = (k) => !!K[k] && (MIX[k] === undefined || MIX[k] > 0);
  const baseKind = cfg.BASE_TILE_KIND || 'normal';
  /* 마지막 밟기부터 붕괴까지. 2026-09-16 규칙 변경으로 이 값이 0 에서
   * 2.5초가 됐습니다 — 두 번째로 밟는 순간 발밑이 사라지면 피할
   * 방법이 없기 때문입니다.                                        */
  const baseSpan = (K[baseKind] && K[baseKind].fuseMax > 0) ? span(baseKind) : '';

  /* ── 심사 규격 만들기 ──────────────────────────────────────────────
   *
   * ★ 왜 문단을 표로 바꿨나
   *   종전에는 아래 내용 전부가 parts.join(' ') 로 한 문단이었습니다.
   *   층 구성 · 바닥 규칙 · 특수 타일 · 층 특성 · 승패는 성격이 전혀
   *   다른데 한 덩어리로 흘러서, 참가 직전 10초 동안 읽으라고 내놓기에는
   *   찾을 수가 없었습니다. 내용은 그대로 두고 "무엇에 대한 규칙인가"
   *   로 끊습니다.
   *
   * ★ 층 색을 표에 그대로 씁니다. 화면에서 타일을 볼 때 층을 구분하는
   *   단서가 색이므로, 규격에서도 같은 색을 써야 "그 색 층 이야기"가
   *   바로 연결됩니다. 이름으로만 적으면 규격과 화면이 따로 놉니다.
   *
   * ★ 모든 값은 여전히 config 파생입니다 — 하드코딩한 숫자가 없어야
   *   server.js 를 고쳤을 때 규격만 거짓말하는 일이 없습니다.     */
  el.innerHTML = '';
  const mk = (tag, cls, text) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };
  /* 절 제목 + 내용 상자를 한 벌로. */
  const section = (title) => {
    const box = mk('div', 'rgSec');
    box.appendChild(mk('div', 'rgHead', title));
    el.appendChild(box);
    return box;
  };
  /* 표 한 줄. 층을 모르는 규칙(층 특성 등)은 layer 를 null 로 넘깁니다. */
  const row = (host, layer, name, desc, warn) => {
    const r = mk('div', 'rgRow');
    const chip = mk('div', 'rgChip');
    chip.style.color = (layer && layer.color) || 'rgba(236,231,216,.35)';
    chip.appendChild(mk('i'));
    chip.appendChild(mk('b', null, layer ? 'L' + layer.index : '—'));
    const d = mk('div', 'rgDesc');
    d.appendChild(document.createTextNode(desc));
    if (warn) d.appendChild(mk('span', 'rgWarn', warn));
    r.append(chip, mk('div', 'rgName', name), d);
    host.appendChild(r);
    return r;
  };

  /* ── 1. 바닥: 같은 타일이 사라지는 3단계 ── */
  const floorSec = section('바닥 — 밟을수록 사라집니다');
  const flow = mk('div', 'rgFlow');
  const HEX = '2,15 9.5,2 24.5,2 32,15 24.5,28 9.5,28';
  const step = (cls, label, sub, crack) => {
    const st = mk('div', 'rgStep ' + cls);
    st.innerHTML = '<svg class="rgHex" viewBox="0 0 34 30" aria-hidden="true">' +
      '<polygon points="' + HEX + '"/>' +
      (crack ? '<path d="M13 3 L17 13 L12 18 L19 27"/>' : '') + '</svg>';
    st.appendChild(mk('b', null, label));
    st.appendChild(mk('span', null, sub));
    flow.appendChild(st);
    return st;
  };
  const kBase = K[baseKind] || K.reinforced || {};
  step('s1', '온전', '아직 아무도 밟지 않음');
  flow.appendChild(mk('i', 'rgArrow'));
  /* 금 간 상태는 이제 '무기한'입니다 — 다시 밟기 전까지 버팁니다.
   * 이 점이 규칙 변경의 핵심이라 단계 설명에 그대로 적습니다.      */
  step('s2', '금', '1번 밟음 · 다시 밟기 전까지 버팀', true);
  flow.appendChild(mk('i', 'rgArrow'));
  step('s3', '붕괴',
    (kBase.hits ? kBase.hits + '번째로 밟히면' : '다시 밟히면') +
    (baseSpan ? ' ' + baseSpan + ' 뒤' : ''));
  floorSec.appendChild(flow);
  const floorNote = mk('div', 'rgDesc');
  floorNote.style.marginTop = '7px';
  floorNote.textContent = '금은 누가 밟았는지를 가리지 않습니다 — 남이 지나간 자리는 이미 한 번 깎여 있습니다.';
  /* ★ 이 한 줄이 없으면 '왜 가만히 있는데 발밑이 꺼지지' 가 됩니다.
   *   바닥이 두 번 밟아야 무너지게 되면서, 멈춰 서 있는 것을 막는
   *   규칙이 별도로 생겼습니다(서버 STAND_ROT_MS).                 */
  if (cfg.STAND_ROT_MS) {
    floorNote.appendChild(mk('span', 'rgWarn',
      '한자리에 ' + sec(cfg.STAND_ROT_MS) + ' 머무르면 그 자리가 무너집니다 — 멈출 수 없습니다'));
  }
  floorSec.appendChild(floorNote);

  /* 지금 쓰이지 않는 타일 종류는 적지 않습니다(TILE_MIX 로 거릅니다). */
  if (used('normal') || used('fragile')) {
    const other = section('그 밖의 바닥');
    const ot = mk('div', 'rgTable');
    if (used('normal')) row(ot, null, '일반', '한 번 밟으면 ' + span('normal') + ' 뒤에 무너집니다.');
    if (used('fragile')) row(ot, null, '취약', span('fragile') + ' 만에 꺼집니다.');
    other.appendChild(ot);
  }

  /* ── 2. 특수 타일 ── */
  const spSec = section('특수 타일 — 층마다 하나씩');
  const spTable = mk('div', 'rgTable');
  let spCount = 0;

  const accelLayer = layers.find((L) => L.special === 'accel');
  if (accelLayer && cfg.DASH) {
    row(spTable, accelLayer, '신속심사',
      '밟으면 진행 방향으로 ' + cfg.DASH.tiles + '칸 튀어나갑니다.',
      '앞이 비어 있으면 그대로 떨어집니다');
    spCount++;
  }
  const rejectLayer = layers.find((L) => L.special === 'reject');
  if (rejectLayer && cfg.REJECT_TILE) {
    const R = cfg.REJECT_TILE;
    row(spTable, rejectLayer, '거절이유',
      '평소엔 일반 타일처럼 보이다가, 밟으면 ' + sec(R.delayMin) + '~' + sec(R.delayMax) +
      ' 뒤에 자기 자신과 이웃 타일까지 함께 터집니다.',
      '밟기 전에는 구별할 수 없습니다');
    spCount++;
  }
  /* 보정 타일은 OFFICE_SPECIAL_MIX 에서 빠지면 맵에 아예 안 깔립니다.
   * 층만 보고 적으면 없는 타일을 설명하게 됩니다.                  */
  if (rejectLayer && cfg.OFFICE_SPECIAL_MIX && cfg.OFFICE_SPECIAL_MIX.amend > 0) {
    row(spTable, rejectLayer, '보정', '밟으면 주변에서 무너진 타일 하나가 되살아납니다.');
    spCount++;
  }
  const darkLayer = layers.find((L) => L.trait === 'dark');
  if (darkLayer && cfg.SEARCH_TILE) {
    const S = cfg.SEARCH_TILE;
    row(spTable, darkLayer, '선행기술 검색',
      '밟으면 ' + sec(S.durationMs) + ' 동안 시야가 ' + S.viewTiles + '칸까지 넓어집니다.');
    spCount++;
  }
  const phaseLayer = layers.find((L) => L.special === 'phase');
  if (phaseLayer && cfg.PHASE_TILE) {
    row(spTable, phaseLayer, '위상',
      sec(cfg.PHASE_TILE.onMs) + ' 실체 → ' + sec(cfg.PHASE_TILE.offMs) +
      ' 비활성을 반복합니다. 밟아도 무너지지 않습니다.',
      '비활성일 때 위에 있으면 떨어집니다');
    spCount++;
  }
  const jumpLayer = layers.find((L) => L.special === 'jump');
  if (jumpLayer && cfg.JUMP_TILE) {
    row(spTable, jumpLayer, '점프',
      cfg.JUMP_TILE.levels.join('층 · ') + '층 위로 쏘아 올립니다.',
      '위에 발판이 없으면 그대로 떨어집니다');
    spCount++;
  }
  if (spCount) spSec.appendChild(spTable);
  else spSec.remove();

  /* ── 3. 층 특성 — 특수 타일과 다른 축입니다(층 전체에 걸립니다) ── */
  const trSec = section('층 특성 — 그 층 전체에 걸립니다');
  const trTable = mk('div', 'rgTable');
  let trCount = 0;

  const rotLayer = layers.find((L) => L.trait === 'rotate');
  if (rotLayer && cfg.ROTATE_EVENT) {
    const R = cfg.ROTATE_EVENT;
    row(trTable, rotLayer, '회전',
      '층이 중심축을 기준으로 천천히 돕니다. 위에 서 있으면 함께 실려 돌고, ' +
      sec(R.effectiveIntervalMs || R.intervalMs) + '마다 방향이 반대로 바뀝니다.');
    trCount++;
  }
  /* 간격은 dev 에서 줄어든 실제 값(effectiveIntervalMs)을 씁니다. */
  const accelTraitLayer = layers.find((L) => L.trait === 'accel');
  if (accelTraitLayer && cfg.ACCEL_EVENT) {
    const A = cfg.ACCEL_EVENT;
    row(trTable, accelTraitLayer, '심사 가속',
      sec(A.effectiveIntervalMs || A.intervalMs) + '마다 ' + sec(A.durationMs) +
      ' 동안 그 층 타일의 붕괴가 ' + A.speed + '배로 빨라집니다. 발동되면 화면이 붉게 깜빡입니다.');
    trCount++;
  }
  if (darkLayer && cfg.DARK_EVENT) {
    const D = cfg.DARK_EVENT;
    row(trTable, darkLayer, '어둠',
      sec(D.effectiveIntervalMs || D.intervalMs) + '마다 ' + sec(D.durationMs) +
      ' 동안 내 주변 ' + D.clearTiles + '~' + D.viewTiles + '칸 밖이 보이지 않습니다.',
      '타일은 평소처럼 무너집니다 — 보이지 않을 뿐입니다');
    trCount++;
  }
  if (trCount) trSec.appendChild(trTable);
  else trSec.remove();

  /* ── 4. 승패 ── */
  const endSec = section('끝나는 방식');
  const end = mk('div', 'rgEnd');
  const endRow = (kind, tag, text) => {
    const d = mk('div');
    const e = mk('em', kind, tag);
    d.append(e, mk('span', null, text));
    end.appendChild(d);
  };
  endRow('neutral', '시작', '정원이 차면 대기 발판이 사라지며 시작됩니다.');
  if (layers.length) {
    endRow('lose', '탈락', '맨 아래 ' + (layers[layers.length - 1].name || '') +
      ' 층 밑으로 떨어지면 구름바다에 빠집니다.');
  }
  endRow('win', '등록결정', '마지막 한 명이 등록결정을 받습니다.');
  /* 관전자 개입도 규격입니다 — 참가 방식에 '관전 + 개입'이 있는데,
   * 그게 무엇을 할 수 있는 자리인지는 어디에도 적혀 있지 않았습니다. */
  if (cfg.AMEND_LEVEL) {
    endRow('neutral', '관전', '이번 회차에 뛰지 않는 관전자는 한 번, 주자 한 명을 ' +
      cfg.AMEND_LEVEL + '층 위로 올려보낼 수 있습니다.');
  }
  endSec.appendChild(end);

  /* 화면 하단 한 줄 요약. 종전에는 "일반 타일 3회 · 함정 블록 1회" 였습니다.
   * 종류가 늘거나 수치가 바뀌면 여기도 자동으로 따라옵니다.            */
  const hint = document.getElementById('hintRules');
  if (!hint) return;
  /* ★ 이름은 '화면에서 보이는 것'으로 부릅니다.
   *   종전에는 TILE_KINDS 의 내부 이름을 그대로 옮겨 '강화 2회 또는
   *   2.5초'라고 적었는데, '강화'라는 말은 게임 어디에도 안 나옵니다.
   *   플레이어가 보는 것은 '밟으면 금이 가는 바닥'입니다.
   * ★ 그리고 TILE_MIX 로 걸러야 합니다. 조인 화면 문구(위)는 이미
   *   거르는데 여기만 안 걸러서, 0장인 일반·취약까지 설명하고
   *   있었습니다 — 네 항목 중 셋이 존재하지 않는 타일이었습니다.   */
  const label = { normal: '일반 타일', fragile: '금 간 타일',
                  reinforced: '바닥', special: '특수 타일' };
  const bits = [];
  for (const k of Object.keys(K)) {
    if (!used(k)) continue;
    if (K[k].autoMs > 0) bits.push(label[k] + ' ' + K[k].hits + '번 밟으면 붕괴 (안 밟아도 ' + sec(K[k].autoMs) + ')');
    else bits.push(label[k] + ' ' + K[k].hits + '번 밟으면 ' + span(k) + ' 뒤 붕괴');
  }
  /* 각 항목이 '…붕괴'로 끝나므로 꼬리를 또 붙이면 겹칩니다
   * (종전 문구는 항목이 '강화 2회' 처럼 끝나서 꼬리가 필요했습니다). */
  /* 머무름 규칙은 타일 종류가 아니라 '나'에 걸리는 규칙이라 맨 뒤에
   * 따로 답니다 — 종류 설명 사이에 끼면 그 타일만의 성질로 읽힙니다. */
  if (cfg.STAND_ROT_MS) bits.push('한자리에 ' + sec(cfg.STAND_ROT_MS) + ' 머무르면 발밑이 무너짐');
  hint.textContent = bits.join(' · ');
}

function buildLayerStack() {
  const box = document.getElementById('layerStack');
  if (!box) return;

  const layers = (G.cfg && G.cfg.LAYERS) ? G.cfg.LAYERS : [];
  box.innerHTML = '';
  box.classList.remove('scroll');
  box.classList.toggle('compact', layers.length > 3);

  for (const L of layers) {
    const d = document.createElement('div');
    d.className = 'doc';
    d.dataset.l = L.index;
    // 층 색은 CSS 가 아니라 서버 값입니다 (LAYER_DEFS.color)
    d.style.setProperty('--layer-c', L.color || '#00ffcc');

    const no = document.createElement('div');
    no.className = 'no';
    no.textContent = 'LAYER ' + String(L.index).padStart(2, '0');
    const nm = document.createElement('div');
    nm.className = 'nm';
    nm.textContent = L.name || '';
    const alt = document.createElement('div');
    alt.className = 'alt';
    alt.textContent = L.short || '';

    /* 회전 방향 표시 자리. 반복되는 반전 배너를 대신하는 조용한 표시라
     * 평소엔 비어 있고 회전이 걸린 층에서만 ↻/↺ 가 들어갑니다.        */
    const rotm = document.createElement('div');
    rotm.className = 'rotmark';

    /* 이 층의 기믹. 층 배너와 <b>같은 데이터(L.marks)</b>를 씁니다 —
     * 문구를 두 벌로 두면 반드시 한쪽만 낡습니다. 평소엔 접혀 있고
     * 내가 선 층(.doc.on)에서만 펼쳐집니다. */
    const mk = document.createElement('div');
    mk.className = 'marks';
    const marks = (L.marks && L.marks.length)
      ? L.marks
      : (L.tip ? [{ i: '·', t: L.tip }] : []);
    mk.innerHTML = marks.map((m) =>
      '<div class="mk' + (m.i === '—' ? ' none' : '') + '">' +
      '<i>' + escapeHtml(m.i || '·') + '</i>' +
      '<span>' + escapeHtml(m.t || '') + '</span></div>').join('');

    d.appendChild(no); d.appendChild(nm); d.appendChild(alt);
    d.appendChild(mk); d.appendChild(rotm);
    box.appendChild(d);
  }

  dom.docs = Array.from(box.querySelectorAll('.doc'));
  refitLayerStack();
}

/* 목록이 화면을 넘치는지 다시 재어 스크롤을 켭니다.
 * 층 수·펼침 상태·창 크기가 바뀔 때마다 달라지므로 한 함수로 모읍니다. */
function refitLayerStack() {
  const box = document.getElementById('layerStack');
  if (!box) return;
  // 여백까지 다 그려진 뒤에야 넘치는지 알 수 있습니다
  box.classList.toggle('scroll', box.scrollHeight > box.clientHeight + 1);
}

/* ── 층 특성 이벤트 연출 ──────────────────────────────────────────────
 * 서버 layer_event 가 켜라/꺼라를 보내면 그대로 따릅니다.
 * 특성이 여러 개이므로 d.trait 로 갈라서 각자의 상태에 담습니다.
 *
 * ★ 지속 시간을 클라이언트가 세지 않습니다.
 *   endsAt 을 받아 두긴 하지만 그걸로 스스로 끄지 않습니다 — 화면마다
 *   시계가 조금씩 달라 어떤 사람은 이미 꺼졌는데 서버 퓨즈는 아직
 *   빨라져 있는 구간이 생깁니다. 끄는 신호도 서버가 보냅니다.
 *
 * ★ 타일 색은 여기서 칠하지 않습니다.
 *   updateTiles 가 매 프레임 G.traits 를 보고 칠합니다. 여기서 한 번
 *   칠해 봐야 다음 프레임에 idle 분기가 원래 색으로 덮어씁니다.
 * ------------------------------------------------------------------ */
/* ── 경고는 '내가 서 있는 층의 것'만 크게 ─────────────────────────────
 * 층 특성은 그 층에서만 작동하는데, 종전에는 어느 층에 있든 모든 특성의
 * 배너와 문구가 떴습니다. 5층에서 걷고 있는데 3층 어둠 문구가 뜨는 식이라
 * 정보가 아니라 소음이었습니다.
 *
 * 이제 큰 배너와 토스트는 내가 그 층에 있을 때만 나오고, 다른 층 상황은
 * 왼쪽 층 목록의 색 표시로만 읽습니다. 내려서면 그 순간 배너가 뜨므로
 * '필요한 때에 필요한 것만' 알려 주는 형태가 됩니다.
 *
 * 관전자에게는 큰 배너를 띄우지 않습니다 — 기준이 되는 '내 위치'가 없고,
 * 관전 화면은 층 목록과 토스트로 충분히 읽힙니다.
 * ------------------------------------------------------------------ */
function onTraitLayer(trait) {
  const st = G.traits[trait];
  if (!st || G.role !== 'player') return false;
  return st.layers.indexOf(local.layer) >= 0;
}

/* 배너 표시 여부는 이벤트가 올 때가 아니라 '매 프레임' 정합니다.
 * 이벤트 발동 시점에 한 번만 정하면, 어둠이 켜진 뒤 내가 그 층으로
 * 내려가도 배너가 안 뜹니다(반대로 올라가도 안 꺼집니다).            */
function refreshTraitBanners() {
  const a = G.traits.accel, dk = G.traits.dark;
  if (dom.accelAlert) {
    dom.accelAlert.classList.toggle('on', !!(a && a.active) && onTraitLayer('accel'));
  }
  if (dom.darkAlert) {
    dom.darkAlert.classList.toggle('on', !!(dk && dk.active) && onTraitLayer('dark'));
  }
}

/* 왼쪽 층 목록의 회전 방향 표시(↻/↺).
 * 반복되는 반전 배너를 대신하는 '조용한' 표시입니다.                 */
function updateRotMark() {
  const st = G.traits.rotate;
  for (const el of (dom.docs || [])) {
    const mark = el.querySelector('.rotmark');
    if (!mark) continue;
    const on = !!(st && st.active) && st.layers.indexOf(+el.dataset.l) >= 0;
    mark.textContent = on ? (st.dir > 0 ? '↻' : '↺') : '';
  }
}

function applyLayerEvent(d) {
  if (!d) return;
  const trait = d.trait || 'accel';               // 구 서버 호환 (trait 없이 오던 시절)
  const st = G.traits[trait] || (G.traits[trait] = { active: false, layers: [], endsAt: 0 });
  const wasActive = st.active;

  st.active = !!d.active;
  if (Array.isArray(d.layers)) st.layers = d.layers.slice();
  st.endsAt = d.endsAt || 0;
  /* 특성별 값을 그대로 받습니다.
   *   accel  : speed
   *   dark   : viewTiles · clearTiles
   *   rotate : epoch · baseAngle · dir · speed  ← 각도 타임라인 자체
   * 회전은 '각도'가 아니라 '각도를 만드는 값들'을 받는 것이 핵심입니다. */
  for (const k of ['speed', 'viewTiles', 'clearTiles', 'durationMs',
                   'epoch', 'baseAngle', 'dir', 'intervalMs']) {
    if (d[k] !== undefined) st[k] = d[k];
  }
  if (trait === 'rotate') {
    // 타임라인이 새로 왔으니 내 공식으로 다시 계산합니다 (검산 상태도 초기화)
    G.rotTrust = true;
    st.angle = rotationAngleNow();
    /* 실어 돌리기 기준값을 지금 각도로 다시 잡습니다.
     * 안 그러면 반전 순간의 각도 차이가 한 프레임에 몰아서 적용돼
     * 서 있던 주자가 순간이동합니다.                                  */
    lastCarryAngle = st.angle;
  }

  /* 진행 중이던 붕괴를 서버가 앞당겼습니다 (심사 가속).
   * 붕괴 시각의 단일 진실 원천은 서버이므로 '남은 시간'만 받아 씁니다. */
  for (const r of (d.retimed || [])) retimeWarn(G.tiles.get(r.tileId), r.fuse);

  const names = st.layers.map(layerNameOf).filter(Boolean);

  /* 왼쪽 층 목록 — 그 특성이 걸린 층에 표시를 켭니다.
   * 클래스 이름을 trait 이름으로 그대로 쓰므로 특성이 늘면 CSS 한 줄만
   * 추가하면 됩니다 (.doc.accel / .doc.dark).                        */
  for (const el of (dom.docs || [])) {
    el.classList.toggle(trait, st.active && st.layers.indexOf(+el.dataset.l) >= 0);
  }

  /* 배너는 refreshTraitBanners 가 매 프레임 정합니다. 여기서는 부제 문구와
   * '새로 켜진 순간'의 알림만 다룹니다.                                */
  refreshTraitBanners();

  if (trait === 'accel') {
    if (dom.accelSub) {
      dom.accelSub.textContent = names.length
        ? names.join(' · ') + ' 층 붕괴 ' + (st.speed || 2) + '배속'
        : 'EXAMINATION ACCELERATION';
    }
    // 새로 켜진 순간에만, 그리고 내가 그 층에 있을 때만 알립니다
    if (st.active && !wasActive) {
      netStats.accels++;
      if (onTraitLayer('accel')) {
        toast('심사 가속 — 이 층이 ' + (st.speed || 2) + '배로 무너집니다', 'kill');
        Sound.sfx('obstacle', { rate: 1.35, volume: 0.85 });
      }
    }
  } else if (trait === 'dark') {
    if (dom.darkSub) {
      dom.darkSub.textContent = names.length
        ? names.join(' · ') + ' 층 시야 ' + (st.clearTiles || 2) + '~' + (st.viewTiles || 3) + '칸'
        : 'PRIOR ART SEARCH';
    }
    /* ★ 켜질 때와 꺼질 때 모두 소리를 냅니다.
     *   어둠은 <b>화면이 어두워지는 것</b>으로만 알리는데, 시야가
     *   좁아지는 순간에는 오히려 화면을 덜 보게 됩니다. 시작과 끝을
     *   소리로 못 박아 두면 "언제 끝나는지"를 기다릴 수 있습니다.
     * ★ 내가 그 층에 있을 때만입니다 — 다른 층에서 남의 층 사정까지
     *   들리면 무슨 일인지 알 수 없는 소리가 됩니다.               */
    if (st.active && !wasActive) {
      netStats.darks++;
      if (onTraitLayer('dark')) {
        /* ★ 회차당 한 번입니다(gapMs: Infinity).
         *   어둠이 켜져 있는 동안 전면 배너가 계속 떠 있으므로 "지금
         *   어둡다" 는 토스트 없이도 읽힙니다. 토스트가 할 일은
         *   "검색 타일을 찾으라" 는 <b>대처법</b>을 처음 한 번 알려
         *   주는 것뿐이고, 그건 두 번 말할 필요가 없습니다.        */
        toast('어둠 — 주변 ' + (st.viewTiles || 3) + '칸 밖은 보이지 않습니다. 검색 타일을 찾으세요', 'obstacle',
              { key: 'dark', gapMs: Infinity });
        if (Sound.buffers.powerDown) Sound.sfx('powerDown');
        else Sound.sfx('obstacle', { rate: 0.55, volume: 0.7 });
      }
    } else if (!st.active && wasActive) {
      if (onTraitLayer('dark')) Sound.sfx('powerUp');
    }
  } else if (trait === 'rotate') {
    for (const el of (dom.docs || [])) {
      el.classList.toggle('rotate', st.active && st.layers.indexOf(+el.dataset.l) >= 0);
    }
    updateRotMark();
    /* fired 는 '이번 패킷이 방향 반전 순간'이라는 표시입니다.
     * 라운드 시작·중도 참가 때도 같은 이벤트가 오는데, 그때까지 문구를
     * 띄우면 접속하자마자 경고가 뜹니다.
     *
     * 반전은 15초마다 반복되므로 회차당 한 번만, 그것도 그 층에 실제로
     * 서 있는 사람에게만 알립니다. 그 뒤로는 층 목록의 ↻/↺ 로만 읽습니다. */
    if (d.fired) {
      netStats.rotFlips++;
      if (!G.rotFlipTold && onTraitLayer('rotate')) {
        G.rotFlipTold = true;
        toast('⚠️ 거절이유 발생, 심사관 검토 방향 변경', 'kill');
        Sound.sfx('obstacle', { rate: 0.9, volume: 0.85 });
        if (dom.rotAlert) {
          dom.rotAlert.classList.add('on');
          clearTimeout(rotAlertTimer);
          rotAlertTimer = setTimeout(() => dom.rotAlert.classList.remove('on'), 2200);
        }
      }
    }
  }
}

/* 방향 반전 배너를 잠깐 띄웠다 지우는 타이머 (연속 반전 시 겹치지 않게) */
let rotAlertTimer = 0;

/* ── 지금 내 시야 반경(칸) ────────────────────────────────────────────
 * 평소에는 어둠 규격의 기본값(3칸)이고, 선행기술 검색 타일을 밟은 동안만
 * 서버가 정한 값(8칸)으로 넓어집니다.
 *
 * 넓어질 때는 즉시, 돌아올 때는 마지막 SEARCH_FADE_MS 동안 서서히입니다.
 * 뚝 끊기면 8칸이 3칸으로 한 프레임에 무너져 "꺼졌다"가 아니라 "버그"로
 * 읽힙니다.
 * ------------------------------------------------------------------ */
const SEARCH_FADE_MS = 600;

function currentViewTiles() {
  const dark = G.traits.dark || {};
  const base = dark.viewTiles ||
    (G.cfg && G.cfg.DARK_EVENT && G.cfg.DARK_EVENT.viewTiles) || 3;
  const now = performance.now();
  if (now >= G.view.searchUntil) return base;
  const left = G.view.searchUntil - now;
  const k = Math.min(1, left / SEARCH_FADE_MS);      // 남은 시간이 짧아지면 0 으로
  return base + (G.view.searchTiles - base) * k;
}

/* ── "떨어져도 끝이 아니다" 를 화면에 상주시킵니다 ────────────────────
 *
 * 이 게임은 층이 5개라 사실상 목숨이 5개입니다. 한 층 떨어져도 안 죽고,
 * 아이디어 층에는 다시 올라가는 점프 타일까지 있습니다. 구름바다에 닿아야
 * 탈락입니다.
 *
 * 그런데 화면이 그걸 한 번도 말해 주지 않았습니다. 바닥이 꺼지고 추락
 * 연출이 크게 돌아가니 모두가 '죽었다'고 느꼈고, 그래서 구조적으로는
 * 가장 관대한 규칙이 가장 가혹하게 읽혔습니다. '너무 어렵다'는 불만의
 * 상당 부분이 실제 난이도가 아니라 이 오해였다고 봅니다.
 *
 * 그래서 두 군데에 계속 답을 둡니다 —
 *   상시 : 상단 HUD 의 '남은 층' 숫자
 *   순간 : 층이 바뀔 때 뜨는 배너 ('아직 살아 있습니다')
 * ------------------------------------------------------------------ */

/** 이 층 아래로 남은 층 수. 구름바다까지의 여유이자 사실상 남은 목숨입니다. */
function floorsLeft(layerIndex) {
  const ord = G.layerOrder || [];
  const i = ord.indexOf(layerIndex);
  /* 번호를 빼서 계산하지 않습니다 — 층 번호가 연속이라는 보장을 코드가
   * 갖게 되면 층 구성을 바꿀 때 조용히 틀립니다. 순서 배열로 셉니다. */
  return i < 0 ? 0 : (ord.length - 1 - i);
}

let layerBannerT1 = 0, layerBannerT2 = 0;
/* 3400 → 2600. 글자를 키우면 같은 내용을 더 빨리 읽습니다.
 * 오래 떠 있으면 그 자체가 화면을 가리고, 다음 층으로 내려갔을 때
 * 이전 배너가 아직 남아 있는 일이 생깁니다. */
const LAYER_BANNER_MS = 2600;

/**
 * 층 진입 배너.
 * @param dir  -1 내려옴 · +1 올라옴 · 0 라운드 시작(첫 층)
 */
function showLayerBanner(layerIndex, dir) {
  const el = document.getElementById('layerBanner');
  if (!el) return;
  const Ls = (G.cfg && G.cfg.LAYERS) || [];
  const Lx = Ls.find((x) => x.index === layerIndex);
  if (!Lx) return;

  const left = floorsLeft(layerIndex);
  el.style.setProperty('--layer-c', Lx.color || '#00ffcc');
  el.querySelector('.lbNo').textContent = 'LAYER ' + String(Lx.index).padStart(2, '0');
  el.querySelector('.lbName').textContent = Lx.name || '';

  /* 층 기믹은 서버 LAYER_DEFS 가 유일한 출처입니다(marks, 없으면 tip).
   * 클라이언트가 문구를 들고 있으면 기믹을 바꿀 때 설명만 옛날 것으로
   * 남습니다. marks 는 한 문장으로 뭉치지 않고 항목으로 그립니다 —
   * 기믹이 둘인 층에서 한 줄에 두 가지를 넣으면 읽히지 않았습니다. */
  const marks = (Lx.marks && Lx.marks.length)
    ? Lx.marks
    : (Lx.tip ? [{ i: '·', t: Lx.tip }] : []);
  el.querySelector('.lbMarks').innerHTML = marks.map((m) =>
    '<div class="lbMark' + (m.i === '—' ? ' none' : '') + '">' +
    '<i>' + escapeHtml(m.i || '·') + '</i>' +
    '<span>' + escapeHtml(m.t || '') + '</span></div>').join('');

  const safe = el.querySelector('.lbSafe');
  if (left <= 0) {
    safe.innerHTML = '<b>마지막 층</b>입니다 — 여기서 더 떨어지면 탈락입니다';
  } else if (dir < 0) {
    safe.innerHTML = '아직 살아 있습니다 · 구름바다까지 <b>' + left + '층</b> 남았습니다';
  } else if (dir > 0) {
    safe.innerHTML = '한 층 올라왔습니다 · 구름바다까지 <b>' + left + '층</b>';
  } else {
    safe.innerHTML = '한 층 떨어져도 탈락이 아닙니다 · 아래로 <b>' + left + '층</b> 더 있습니다';
  }

  clearTimeout(layerBannerT1); clearTimeout(layerBannerT2);
  el.classList.remove('out');
  /* 애니메이션을 다시 태우려면 클래스를 한 번 떼었다 붙여야 합니다 —
   * 붙어 있는 상태로 다시 붙이면 브라우저가 재생하지 않습니다.     */
  el.classList.remove('on');
  void el.offsetWidth;
  el.classList.add('on');
  layerBannerT1 = setTimeout(() => el.classList.add('out'), LAYER_BANNER_MS);
  layerBannerT2 = setTimeout(() => { el.classList.remove('on'); el.classList.remove('out'); },
    LAYER_BANNER_MS + 520);
}

function hideLayerBanner() {
  const el = document.getElementById('layerBanner');
  clearTimeout(layerBannerT1); clearTimeout(layerBannerT2);
  if (el) { el.classList.remove('on'); el.classList.remove('out'); }
}

function updateLayerStack(layer) {
  let changed = false;
  for (const d of dom.docs) {
    const on = parseInt(d.dataset.l, 10) === layer;
    if (d.classList.contains('on') !== on) changed = true;
    d.classList.toggle('on', on);
  }
  /* 펼쳐진 층이 바뀌면 목록 높이도 바뀝니다. 넘침(.scroll) 판정을 다시
   * 하지 않으면 아래쪽 층이 잘린 채 스크롤도 안 되는 상태가 됩니다.
   * 전환 애니메이션(0.3s)이 끝난 뒤에 재야 실제 높이가 나옵니다. */
  if (changed) setTimeout(refitLayerStack, 340);
  if (DEV.on && DEV.layerJump) markDevLayerButton(layer);

  /* 남은 층은 살아 있는 주자일 때만 뜻이 있습니다. 관전 중에는 지금
   * 보고 있는 층이 내 목숨과 무관하므로 '—' 로 비웁니다.          */
  if (dom.vFloors) {
    dom.vFloors.textContent =
      (local.alive && G.phase === 'playing' && isFinite(layer)) ? String(floorsLeft(layer)) : '—';
  }

  /* 층이 바뀐 순간에만 배너. 매 프레임 불리므로 반드시 값 비교로 끊습니다. */
  if (G.phase !== 'playing' || !local.alive || !isFinite(layer)) return;
  if (G.lastLayerShown === layer) return;
  const prev = G.lastLayerShown;
  G.lastLayerShown = layer;
  showLayerBanner(layer, prev === null ? 0 : (layer < prev ? -1 : 1));
}

function updateRoster() {
  const rows = [];
  const isAlive = (r) => (r.id === G.selfId ? local.alive : r.alive);
  const entries = [...G.players.values()].sort((a, b) => (isAlive(b) - isAlive(a)));
  for (const r of entries) {
    const isSelf = r.id === G.selfId;
    /* ★ 내 층의 진실 원천은 local 입니다.
     *   state 스냅샷에서 내 것은 건너뜁니다(로컬 예측을 덮으면 안 되므로).
     *   그래서 G.players 의 내 항목은 참가 시점의 층(최상층)에 멈춰 있고,
     *   명단에 내 층만 L6 으로 굳어 있었습니다. 이동이 클라이언트 권위이므로
     *   남의 층은 스냅샷에서, 내 층은 local 에서 읽는 것이 맞습니다.   */
    const alive = isSelf ? local.alive : r.alive;
    const layer = isSelf ? local.layer : r.layer;
    /* ★ 대기 중에는 층 번호 대신 준비 상태를 보여 줍니다.
     *   모두 같은 발판 위라 층이 정보가 아니고, 정작 알아야 할 것은
     *   "누구를 기다리고 있는가" 입니다.                            */
    const waiting = G.phase === 'waiting';
    const isHost = r.id === G.hostId;
    /* ★ 방장 줄에는 준비 표시를 넣지 않습니다. 배지가 이미 "이 사람이
     *   시작한다" 를 말하고 있고, 넷이 한 줄에 들어가면 212px 폭에서
     *   이름이 글자 단위로 접힙니다.                              */
    const tail = waiting
      ? (isHost ? ''
         : '<span class="rdy' + (r.ready ? '' : ' no') + '">' +
             (r.ready ? '준비 완료' : '준비 중') + '</span>')
      : '<span class="lay">' + (alive ? 'L' + (layer || '?') : 'OUT') + '</span>';
    rows.push(
      '<div class="rrow' + (alive || waiting ? '' : ' dead') + '" style="border-left-color:' + (r.color || '#888') + '">' +
      '<span>' + escapeHtml(safeName(r.name)) + '</span>' +
      (isSelf ? '<span class="you">YOU</span>' : '') +
      (isHost ? '<span class="host">방장</span>' : '') +
      tail +
      '</div>'
    );
  }
  if (!rows.length) rows.push('<div class="rrow" style="border-left-color:#333;opacity:.5">대기 중…</div>');
  dom.rosterList.innerHTML = rows.join('');
}

/* 어떤 경로로 들어오든 화면에 undefined 가 찍히지 않게 하는 안전망 */
function safeName(v, fallback) {
  if (typeof v === 'string' && v.trim()) return v.trim();
  return fallback || '익명 출원인';
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function updateSpectatorUI() {
  /* ★ 미리보기(대기 화면 뒤에서 구경만 하는 상태)에서는 관전 UI 를
   *   띄우지 않습니다. 아직 참가를 누르지도 않았는데 '관전 중입니다',
   *   '부스터를 지원하세요' 가 뜨면 무슨 상태인지 알 수 없습니다.
   *   참가 화면이 이미 화면을 덮고 있기도 합니다.                    */
  const isSpec = G.role === 'spectator' && !previewing;
  dom.spec.classList.toggle('show', isSpec);
  Touch.sync();   // 스틱·점프는 주자일 때만 (관전자는 이동이 없습니다)
  dom.hint.classList.toggle('hide', isSpec);

  /* 관전 중에는 내 캐릭터가 화면에 없는 것이 정상입니다.
   * 이걸 알려주지 않으면 "캐릭터가 안 나온다" 로 오해하게 됩니다.        */
  const banner = document.getElementById('specBanner');
  banner.classList.toggle('show', isSpec);
  if (isSpec) {
    /* ★ '다음 회차에 주자가 된다'는 말은 승격 대상일 때만 참입니다.
     *   스스로 '관전 + 개입'을 고른 사람은 resetRoom 이 건드리지 않으므로
     *   (wantsPlay 인 사람만 올립니다) 오지 않을 차례를 기다리게 됩니다.
     *   서버가 init 으로 내려주는 값을 그대로 씁니다.               */
    banner.innerHTML = G.wantsPlay
      ? ((G.phase === 'playing')
          ? '<b>관전 중</b>진행 중인 회차라 관전으로 참가했습니다 · 다음 회차에 자동으로 주자가 됩니다'
          : '<b>관전 중</b>내 캐릭터는 표시되지 않습니다 · 다음 회차에 주자로 올라갑니다')
      : '<b>관전 + 개입</b>주자로 뛰지 않습니다 · <b>이번 회차에 한 번</b> 보정 기회를 줄 수 있습니다';
  }
  if (!isSpec) return;

  const alive = [...G.players.values()].filter((p) => p.alive);
  if (!G.specTarget || !alive.find((p) => p.id === G.specTarget)) {
    G.specTarget = alive.length ? alive[0].id : null;
  }
  dom.specTargets.innerHTML = alive.length
    ? alive.map((p) =>
        '<button class="tgt' + (p.id === G.specTarget ? ' sel' : '') + '" data-id="' + p.id + '">' +
        escapeHtml(safeName(p.name)) + '</button>').join('')
    : '<span style="font-size:11px;opacity:.5">주자가 없습니다</span>';
}

dom.specTargets.addEventListener('click', (e) => {
  const b = e.target.closest('.tgt');
  if (!b) return;
  G.specTarget = b.dataset.id;
  updateSpectatorUI();
});

dom.actCheer.addEventListener('click', () => {
  if (G.amendUsed) return;
  G.socket.emit('grant_amend', { targetId: G.specTarget });
});

/* ★ 쿨다운이 아니라 '회차당 1회' 입니다.
 *   쿨다운은 개입을 결정이 아니라 작업으로 만듭니다 — 열렸으니 누르게
 *   되고, 누구를 왜 돕는지가 사라집니다. 한 번뿐이면 누구를 언제가
 *   전부 의미를 갖습니다.
 *
 * ★ 권한은 '이번 회차에 뛰지 않는 사람'입니다.
 *   탈락한 주자는 이 회차 결과에 이해관계가 있어 개입이 곧 편들기가
 *   됩니다. 서버도 room.players.has(id) 로 같은 판정을 합니다.     */
function updateActionCooldowns() {
  const btn = dom.actCheer;
  const bar = btn.querySelector('.cd');
  const canAct = G.phase === 'playing' && !previewing &&
                 G.role === 'spectator' && !G.players.has(G.selfId);
  btn.disabled = !canAct || G.amendUsed;
  btn.classList.toggle('used', !!G.amendUsed);
  bar.style.width = G.amendUsed ? '0%' : '100%';
  const label = btn.querySelector('.t');
  if (label) label.textContent = G.amendUsed ? '이번 회차 사용함' : '보정 기회 제공';
}

let cdVisible = false;
let lastCountdownSec = -1;
/* ══════════════════════════════════════════════════════════════════════
 * 대기실 — 준비 / 시작
 * ────────────────────────────────────────────────────────────────────
 * ★ 방장에게는 준비 버튼을 주지 않습니다.
 *   방장의 준비는 '심사 개시' 를 누르는 것 자체입니다. 둘 다 주면
 *   "준비를 누른 뒤 시작을 또 눌러야" 하는 두 단계가 됩니다.
 *
 * ★ 버튼이 왜 안 눌리는지를 버튼 위에 적습니다.
 *   비활성 버튼만 두면 "고장" 으로 읽힙니다. 누가 아직 준비를 안
 *   했는지까지 적어 두면 방장이 그 사람에게 말을 걸 수 있습니다.
 *
 * ★ 관전자에게는 띄우지 않습니다 — 시작시킬 자격이 없습니다.
 * ══════════════════════════════════════════════════════════════════ */
function updateReadyUI() {
  if (!dom.ready) return;
  const show = G.phase === 'waiting' && G.role === 'player' && !previewing;
  dom.ready.classList.toggle('show', show);
  /* 토스트를 대기실 패널 위로 비키게 하는 신호 (CSS body.lobby) */
  document.body.classList.toggle('lobby', show);
  if (!show) return;

  const isHost = G.hostId === G.selfId;
  const total = G.roster || 1;
  const me = G.players.get(G.selfId);
  const notReady = [...G.players.values()]
    .filter((p) => p.id !== G.hostId && !p.ready)
    .map((p) => safeName(p.name));

  let msg;
  if (total <= 1) {
    msg = '혼자입니다 — 지금 시작하면 <b>연습 모드 · 단독 심사</b> 로 진행됩니다';
  } else if (!notReady.length) {
    msg = '<b>전원 준비 완료</b> · ' + total + '/' + G.seats +
          (isHost ? ' — 시작하세요' : ' — 방장이 시작하기를 기다립니다');
  } else {
    msg = '준비 ' + (G.readyCount || 0) + '/' + total + ' · 아직 <b>' +
          notReady.map(escapeHtml).join(', ') + '</b> 님';
  }
  dom.readyState.innerHTML = msg;

  /* ★ 글자에 ENTER 를 같이 적습니다. 대기 화면은 버튼이 하나뿐이라
   *   "누를 것" 을 못 찾는 사람이 키부터 눌러 보는데, 그때 눌러야 할
   *   키가 화면에 없으면 아무 반응도 얻지 못합니다.                 */
  const b = dom.btnReady;
  if (isHost) {
    b.textContent = (total <= 1 ? '연습 시작' : '심사 개시') + '   ENTER';
    b.classList.remove('on');
    b.disabled = !G.canStart;
    b.dataset.act = 'start';
  } else {
    const on = !!(me && me.ready);
    b.textContent = (on ? '준비 완료 — 취소' : '준비') + '   ENTER';
    b.classList.toggle('on', on);
    b.disabled = false;
    b.dataset.act = 'ready';
  }
}

function updateCountdown() {
  if (G.phase === 'countdown' && G.phaseEndsAt) {
    const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
    const sec = Math.ceil(left / 1000);
    if (sec !== lastCountdownSec && sec > 0 && sec <= 5) {
      /* ★ '2 · 1 · GO' 는 <b>한 파일에 셋이 들어 있는</b> 소리라
       *   2초 지점에서 한 번만 틀고, 그 뒤로는 tick 을 내지 않습니다.
       *   매초 tick 을 겹쳐 내면 두 소리가 어긋나 박자가 깨집니다.
       *   파일이 없으면 종전대로 매초 tick 입니다.                   */
      if (Sound.buffers.countGo && sec <= 2) {
        if (sec === 2) Sound.sfx('countGo');
      } else {
        Sound.sfx('tick');
      }
    }
    lastCountdownSec = sec;
    dom.cdNum.textContent = sec;
    dom.cdLabel.textContent = G.solo ? '단독 심사 착수까지' : '심사 착수까지';
    if (!cdVisible) { dom.countdown.classList.add('show'); cdVisible = true; }
  } else if (G.phase === 'waiting' && G.phaseEndsAt) {
    const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
    dom.cdNum.textContent = Math.ceil(left / 1000);
    /* ★ 이 숫자는 이제 <b>전원 준비가 끝난 뒤</b>에만 돕니다.
     *   종전에는 사람이 있으면 무조건 돌았고, 그래서 "준비를 눌러도
     *   아무것도 안 바뀌는" 화면이 됐을 것입니다. 서버가 전원 준비일
     *   때만 phaseEndsAt 을 실어 보냅니다(evaluateLobby).           */
    dom.cdLabel.textContent = '전원 준비 완료 · 자동 시작까지';
    if (!cdVisible) { dom.countdown.classList.add('show'); cdVisible = true; }
  } else if (cdVisible) {
    dom.countdown.classList.remove('show');
    cdVisible = false;
  }
}

/* ★ 종전에는 winnerId 만 보고 분기했습니다. 그래서 시간이 다 되어
 *   끝났을 때(reason 'survived') 멀쩡히 살아 있는 사람에게도
 *   '전원 탈락 / 남은 주자가 없습니다'가 떴습니다 — 사실과 반대입니다.
 *
 * ★ 그리고 서버가 보내주는 durationMs 를 한 번도 쓰지 않았습니다.
 *   한 판이 30초~2분인 게임에서 '다시 해 볼까'를 만드는 건 내가
 *   얼마나 버텼고 어디까지 내려갔는지입니다.                        */
/* 연습 모드 개인 최고 기록.
 *
 * 기준은 '더 깊이, 같은 깊이면 더 오래'입니다. 이 게임에서 아래로
 * 내려가는 것이 곧 권리가 깎이는 것이므로 깊이가 먼저입니다 —
 * 버틴 시간만 보면 맨 위층에서 얌전히 도는 쪽이 최고 기록이 됩니다.
 *
 * localStorage 는 없을 수도, 던질 수도 있습니다(사생활 보호 창·정책).
 * 기록은 부가 기능이므로 실패하면 조용히 비웁니다.                 */
function updateSoloBest(me, layerName) {
  const KEY = 'ipg.soloBest';
  let prev = null;
  try { prev = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
  const mmss = (ms) => { const t = Math.max(0, Math.round(ms / 1000));
    return Math.floor(t / 60) + '분 ' + String(t % 60).padStart(2, '0') + '초'; };

  const now = { deepest: me.deepest, survivedMs: me.survivedMs };
  const better = !prev || now.deepest < prev.deepest ||
    (now.deepest === prev.deepest && now.survivedMs > prev.survivedMs);
  if (better) { try { localStorage.setItem(KEY, JSON.stringify(now)); } catch (e) {} }

  if (!prev) return '<span>첫 기록 <b>저장했습니다</b></span>';
  if (better) {
    return '<span>이전 최고 <b>' + escapeHtml(layerName(prev.deepest)) + ' · ' +
           mmss(prev.survivedMs) + '</b> — 경신</span>';
  }
  return '<span>최고 기록 <b>' + escapeHtml(layerName(prev.deepest)) + ' · ' +
         mmss(prev.survivedMs) + '</b></span>';
}

function showResult(data) {
  const me = (data.standings || []).find((s) => s.id === G.selfId);
  const survived = data.reason === 'survived';
  const solo = !!data.solo;
  const yielded = data.reason === 'yield';
  const won = data.winnerId === G.selfId || (survived && me && me.alive);

  /* ★ 연습 모드에서는 '전원 탈락'이라고 말하면 안 됩니다 — 그 '전원'이
   *   나 하나입니다. 실패가 아니라 기록이 남는 판이므로 말도 그렇게.
   * ★ yield 는 승패가 아닙니다(사람이 와서 양보한 회차).            */
  dom.resultEyebrow.textContent =
    yielded ? '연습 종료 · PRACTICE'
    : won ? '최종 처분 · REGISTERED'
    : solo ? '연습 종료 · PRACTICE'
    : '최종 처분 · REJECTED';
  dom.resultTitle.innerHTML =
    yielded ? '연습 종료'
    : won ? '등록결정'
    : solo ? '단독 심사 종료'
    : (data.winnerName ? '거절결정' : (survived ? '심사 기간 만료' : '전원 탈락'));

  const mmss = (ms) => { const t = Math.max(0, Math.round(ms / 1000));
    return Math.floor(t / 60) + '분 ' + String(t % 60).padStart(2, '0') + '초'; };
  const layerName = (idx) => { const Ls = (G.cfg && G.cfg.LAYERS) || [];
    const f = Ls.find((L) => L.index === idx); return f ? f.name : idx + '층'; };

  const layerCount = ((G.cfg && G.cfg.LAYERS) || []).length;
  if (yielded) {
    dom.resultSub.textContent = '새 출원인이 도착해 연습을 마쳤습니다. 다음은 정식 심사입니다.';
  } else if (won && solo) {
    dom.resultSub.textContent = '혼자서 심사 기간을 끝까지 버텼습니다. 등록결정서가 발부되었습니다.';
  } else if (won && survived) {
    dom.resultSub.textContent = '심사 기간이 끝날 때까지 바닥을 지켜냈습니다. 패스트트랙 심사를 통과했습니다.';
  } else if (won) {
    dom.resultSub.textContent = '마지막까지 바닥을 지켜냈습니다. 패스트트랙 심사를 통과했습니다.';
  } else if (solo && me) {
    /* 몇 층까지 갔는가를 먼저 말합니다 — 연습에서 남는 것은 등수가
     * 아니라 도달 지점입니다.                                      */
    const gone = layerCount ? (layerCount - me.deepest + 1) : 0;
    dom.resultSub.textContent = layerCount
      ? (layerCount + '개 층 중 ' + gone + '개 층을 내려갔습니다. 다시 해 보세요.')
      : '다시 해 보세요.';
  } else if (data.winnerName) {
    dom.resultSub.textContent = escapeHtml(data.winnerName) + ' 님이 등록결정을 받았습니다.';
  } else if (survived) {
    dom.resultSub.textContent = '시간이 다 되어 남은 주자 전원이 등록결정을 받았습니다.';
  } else {
    dom.resultSub.textContent = '남은 주자가 없습니다.';
  }

  /* 내 기록 한 줄. 살아남았으면 라운드 전체 시간이 곧 내 기록입니다. */
  if (dom.resultMine) {
    if (me) {
      /* ★ 연습 모드에는 등수가 없습니다. 다시 할 이유를 만들려면
       *   비교할 대상이 있어야 하고, 그 대상은 지난번의 나입니다.
       *   서버에 남기지 않는 이유: 이 게임에 계정이 없고, 행사장에서
       *   같은 PC 를 여러 사람이 씁니다 — 브라우저에만 둡니다.      */
      let best = '';
      if (solo && !yielded) best = updateSoloBest(me, layerName);
      dom.resultMine.innerHTML =
        '<span>버틴 시간 <b>' + mmss(me.survivedMs) + '</b></span>' +
        '<span>내려간 곳 <b>' + escapeHtml(layerName(me.deepest)) + '</b></span>' +
        (solo ? best
              : (data.durationMs ? '<span>이번 회차 <b>' + mmss(data.durationMs) + '</b></span>' : ''));
      dom.resultMine.style.display = '';
    } else {
      dom.resultMine.style.display = 'none';      // 관전자
    }
  }

  dom.resultRank.innerHTML = (data.standings || []).map((s) =>
    '<div class="rank" style="border-left-color:' + s.color + '">' +
    '<span class="p">' + (s.placement || '—') + '</span>' +
    '<span>' + escapeHtml(s.name) + '</span>' +
    '<span class="rt">' + mmss(s.survivedMs) + ' · ' + escapeHtml(layerName(s.deepest)) + '</span>' +
    '</div>').join('');
  dom.result.classList.add('show');
}

/* ============================ 14. networking ========================== */

/* 소켓은 참가 버튼을 눌러야 붙습니다. 그런데 참가 화면이야말로 층 구성과
 * 타일 규칙을 설명해야 하는 곳이라, 그때까지 비워 둘 수 없습니다.
 * 그래서 페이지가 뜨자마자 /api/config 로 규격만 먼저 받아 옵니다.
 * (server_hello 가 도착하면 같은 내용으로 다시 덮어씁니다 — 무해합니다)
 * 실패해도 게임에는 지장이 없으므로 조용히 넘어갑니다.                */
function preloadConfig() {
  fetch('/api/config', { cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : null))
    .then((cfg) => {
      if (!cfg || G.started) return;
      G.cfg = cfg;
      buildLayerStack();
      buildRulesText();
    })
    .catch(() => {});
}
preloadConfig();

/* 미리보기 관전으로 붙어 있는 상태인가. 참가를 누르기 전까지 true 입니다. */
let previewing = false;

function connect(name, mode, opts) {
  /* polling 으로 먼저 붙은 뒤 websocket 으로 업그레이드합니다.
   * socket.io-client 4.8 부터 tryAllTransports 기본값이 false 라서,
   * websocket 을 첫 transport 로 지정하면 사내 프록시/방화벽이 ws 업그레이드를
   * 막을 때 polling 으로 넘어가지 못하고 연결 자체가 실패합니다.            */
  const socket = io({
    transports: ['polling', 'websocket'],
    tryAllTransports: true,
    upgrade: true,
    reconnectionAttempts: Infinity,
    reconnectionDelayMax: 4000,
    timeout: 8000
  });
  G.socket = socket;
  G.name = name;
  previewing = !!(opts && opts.preview);
  G.joinMode = mode;

  socket.on('connect', () => {
    /* 재연결 때도 같은 자격으로 다시 들어갑니다. previewing 이 중간에
     * 꺼졌다면(이미 참가함) 그때 값으로 보내야 관전으로 되돌아가지 않습니다. */
    /* ★ create 는 G.joinCreate 가 살아 있을 때만 갑니다. init 에서
     *   내려놓으므로 재연결에서는 빠지고, 방을 또 파지 않습니다.    */
    socket.emit('join', previewing
      ? { name: G.name, mode: 'spectator', preview: true }
      : { name: G.name, mode: G.joinMode || mode, roomId: G.joinRoomId || undefined,
          create: G.joinCreate || undefined });
    // 재연결마다 인터벌이 쌓이지 않도록 기존 것을 먼저 정리
    if (G.pingTimer) clearInterval(G.pingTimer);
    G.pingTimer = setInterval(() => socket.emit('ping_probe', Date.now()), 3000);
    socket.emit('ping_probe', Date.now());
  });

  socket.on('pong_probe', (d) => {
    G.rtt = Date.now() - d.clientSent;
    G.serverOffset = d.serverTime - (d.clientSent + G.rtt / 2);
    dom.vPing.textContent = G.rtt + ' ms';
    dom.vPing.classList.toggle('bad', G.rtt > 160);
  });

  socket.on('server_hello', (d) => {
    G.cfg = d.config;
    // 층 안내문과 규칙 설명은 서버가 규격을 알려준 지금 만들 수 있습니다
    buildLayerStack();
    buildRulesText();
    // 구 서버 호환: DEV 객체가 없으면 예전 불리언(DEV_MODE)을 그대로 씁니다
    applyDevMode(d.config.DEV || { on: !!d.config.DEV_MODE, noEliminate: true, layerJump: true });
  });

  socket.on('init', (d) => {
    G.selfId = d.selfId;
    G.role = d.role;
    /* 관전 배너가 '다음 회차에 주자가 되는가'를 정확히 말하려면 필요합니다. */
    G.wantsPlay = d.wantsPlay !== false;
    G.roomId = d.roomId;
    G.map = d.map;
    G.cfg = G.cfg || {};
    dom.vRoom.textContent = d.roomId;

    applyTheme(d.theme || 0);
    buildMap(d.map, mapCfg());

    /* 참가 직후의 첫 init 에서만 날아갑니다. map_reset 이나 재연결로
     * 다시 오는 init 에서는 날면 안 됩니다 — 라운드 중에 카메라가
     * 제멋대로 움직이는 것으로 보입니다. */
    if (pendingCamFlight) {
      pendingCamFlight = false;
      beginCamFlight(1.15);
    }

    G.pedestalsActive = d.pedestalsActive !== false;
    if (!G.pedestalsActive) {
      for (const rec of G.pedestals.values()) { rec.state = 'gone'; rec.mesh.visible = false; rec.ring.visible = false; }
    }

    /* 라운드 도중 들어온 경우, 이미 진행된 타일 상태를 복원합니다.
     * 붕괴된 것뿐 아니라 '2번 밟혀 금이 간' 중간 단계까지 받아야
     * 나만 멀쩡한 타일을 보고 안심하다 빠지는 일이 없습니다.          */
    for (const b of d.brokenTiles || []) {
      const rec = G.tiles.get(b.id);
      if (!rec) continue;
      if (b.hits !== undefined) {
        rec.hits = b.hits;
        applyTileWear(rec);
      }
      if (b.phase === 'broken') { rec.state = 'gone'; rec.mesh.visible = false; }
      // 서버가 '남은' 퓨즈를 보내줍니다. 여기서 기본값으로 다시 세면
      // 중간 참가자 화면에서만 타일이 더 오래 버팁니다.
      // 폭발 대기 중(explode)이면 붉은 경고가 아니라 거절이유 연출이어야 합니다.
      else if (b.phase === 'warning') {
        if (b.explode) startReject(rec, b.fuse !== undefined ? b.fuse : 1500);
        else startWarn(rec, b.fuse !== undefined ? b.fuse : rec.fuse);
      }
    }

    /* 라운드 중 들어왔는데 마침 층 특성이 걸려 있을 수 있습니다.
     * 타일 복원(brokenTiles) 뒤에 적용해야 이미 복원한 퓨즈에 얹힙니다.
     * (구 서버는 layerEvent 하나만 보냈습니다 — 둘 다 받아 줍니다)     */
    for (const ev of (d.layerEvents || (d.layerEvent ? [d.layerEvent] : []))) {
      applyLayerEvent(ev);
    }

    syncPlayers(d.players);
    applyMeta(d.meta);
    /* ★ 한 번 들어갔으면 내려놓습니다. 안 내려놓으면 재연결할 때마다
     *   빈 방이 새로 열려 로비 목록이 유령 방으로 찹니다.           */
    G.joinCreate = false;

    if (d.role === 'player') {
      const me = d.players.find((p) => p.id === d.selfId);
      if (me) {
        local.pos.set(me.pos.x, me.pos.y, me.pos.z);
        local.color = me.color;
        local.seat = me.seat;
        local.lastGroundY = me.pos.y;
        local.grounded = true;
        snapRender();
      }
      local.alive = true;
      G.selfAlive = true;
      if (!local.avatar) {
        local.avatar = buildAvatar(local.color, d.name, local.seat);
        actorGroup.add(local.avatar.group);
      }
    }
    updateSpectatorUI();
    updateRoster();
    /* 안내문·층 버튼을 여기서 한 번 더 만듭니다. server_hello 시점에는
     * 참가 화면이 덮여 있어 #layerStack 의 높이를 못 재고, 그러면
     * 넘침(.scroll) 판정과 버튼 위치가 둘 다 틀립니다.                 */
    buildLayerStack();
    buildDevLayerButtons();
    G.started = true;

    /* 미리보기로 붙은 것이면 참가 화면을 반투명으로 바꿔 뒤가 보이게 합니다.
     * 2D 육각 루프는 3D 가 대신하므로 끕니다. */
    if (previewing && joinScreenVisible()) {
      dom.joinScreen.classList.add('live');
      stopJoinBg();
    }
  });

  socket.on('phase', (meta) => applyMeta(meta));

  socket.on('round_start', (d) => {
    dom.result.classList.remove('show');
    /* 지난 회차 연출이 새 회차로 넘어오면 카메라가 빈 자리를 공전합니다 */
    endFinale();
    hideVerdict();
    cancelCamFlight();
    resetTileWear();
    contactTile = null;      // 지난 회차의 접촉 기록이 새 회차로 넘어오지 않게
    local.dash = null;       // 지난 회차의 대시가 넘어오지 않게
    // 위상 타일은 라운드 시작 순간 ON 으로 출발합니다
    if (d.phaseEpoch) G.phaseEpoch = d.phaseEpoch;
    G.phaseTrust = true;
    G.phaseOn = true;
    // 회전 반전 안내는 회차당 한 번이므로 새 회차에서 다시 열어 줍니다
    G.rotFlipTold = false;
    // 지난 회차의 밀림 기록이 새 회차 사인으로 넘어오지 않게 지웁니다
    lastBump.id = null; lastBump.name = ''; lastBump.at = -Infinity;
    local.deathBy = null; local.deathByName = '';
    G.bumpReadyAt = performance.now() + startFallGraceMs();
    syncPlayers(d.players);
    const me = d.players.find((p) => p.id === G.selfId);
    if (me && G.role === 'player') {
      local.seat = me.seat;
      local.pos.set(me.pos.x, me.pos.y, me.pos.z);
      local.vel.set(0, 0, 0);
      snapRender();
      local.alive = true;
      local.layer = topLayerIndex();
      local.anim = 'idle';
      local.dying = 0;
      local.jumped = false;
      local.lastGroundY = local.pos.y;
      G.selfAlive = true;
      if (local.avatar) {
        local.avatar.group.rotation.set(0, 0, 0);
        local.avatar.group.scale.set(1, 1, 1);
        local.avatar.group.visible = true;
        local.avatar.landSquash = 0;
        if (local.avatar.plate) local.avatar.plate.visible = true;
      }
    }
    updateSpectatorUI();
    Sound.sfx('start');
    toast('심사 개시 — 바닥이 무너집니다', 'obstacle');
  });

  /* 새 회차 = 기회 하나 복구. 서버도 startRound 에서 같은 일을 합니다. */
  socket.on('round_start', () => {
    G.amendUsed = false;
    updateActionCooldowns();
    /* "회차당 한 번" 짜리 알림(어둠·검색)을 다시 쓸 수 있게 합니다. */
    clearToastKeys();
  });

  socket.on('map_reset', (d) => {
    dom.result.classList.remove('show');
    endFinale();
    hideVerdict();
    for (const id of [...G.boosters.keys()]) removeBooster(id);
    for (const id of [...G.obstacles.keys()]) removeObstacle(id);
    resetTileWear();
    /* 새 맵이므로 이벤트 상태도 초기화합니다. 서버도 resetRoom 에서
     * 같이 끄지만, 발동 중이 아니었으면 신호를 안 보내므로 여기서 한 번
     * 더 지웁니다 (층 목록의 표시가 다음 판까지 남는 것 방지).        */
    for (const trait of Object.keys(G.traits)) {
      applyLayerEvent({ trait, active: false, layers: G.traits[trait].layers });
    }
    G.view.searchUntil = 0;      // 넓어진 시야도 회차를 넘기지 않습니다
    G.map = d.map;
    applyTheme(d.theme || 0);
    buildMap(d.map, mapCfg());
    syncPlayers(d.players);
    applyMeta(d.meta);
    const mine = d.players.find((p) => p.id === G.selfId);
    if (mine) {
      // 관전자였다가 이번 회차에 주자로 승격된 경우도 여기서 처리됩니다.
      G.role = 'player';
      local.alive = true;
      local.dying = 0;
      G.selfAlive = true;
      local.color = mine.color;
      local.seat = mine.seat;
      local.pos.set(mine.pos.x, mine.pos.y, mine.pos.z);
      local.vel.set(0, 0, 0);
      snapRender();
      local.layer = topLayerIndex();
      local.anim = 'idle';
      local.jumped = false;
      local.lastGroundY = local.pos.y;
      if (!local.avatar) {
        local.avatar = buildAvatar(local.color, safeName(mine.name, G.name), local.seat);
        actorGroup.add(local.avatar.group);
      }
      local.avatar.group.rotation.set(0, 0, 0);
      local.avatar.group.scale.set(1, 1, 1);
      local.avatar.group.visible = true;
      local.avatar.landSquash = 0;
      if (local.avatar.plate) local.avatar.plate.visible = true;
    } else {
      G.role = 'spectator';
    }
    updateSpectatorUI();
  });

  socket.on('player_joined', (p) => {
    if (!p || !p.id || p.id === G.selfId) return;
    p.name = safeName(p.name);
    if (!G.players.has(p.id)) G.players.set(p.id, new RemoteRunner(p));
    const rr = G.players.get(p.id); if (rr) rr.ready = !!p.ready;
    updateRoster(); updateSpectatorUI();
    toast(p.name + ' 님이 출원했습니다', '', { level: 'info' });
  });

  /* 누가 준비를 눌렀다/풀었다. 대기실 패널과 명단이 같이 갱신됩니다.
   * ★ 토스트를 내지 않습니다 — 4인이 각자 눌렀다 풀었다 하면 그것만으로
   *   화면이 가득 찹니다. 상태는 명단에 남아 있는 표시로 읽는 것이
   *   맞고, 토스트는 지나가는 사건에 씁니다.                        */
  socket.on('player_ready', (d) => {
    if (!d || !d.id) return;
    const r = G.players.get(d.id);
    if (r) r.ready = !!d.ready;
    updateRoster();
  });

  socket.on('player_left', (p) => {
    const r = G.players.get(p.id);
    if (r) { r.dispose(); G.players.delete(p.id); }
    updateRoster(); updateSpectatorUI();
  });

  socket.on('spectator_joined', (s) => {
    if (!s) return;
    toast(safeName(s.name) + ' 님이 관전을 시작했습니다', '', { level: 'info' });
  });

  socket.on('state', (snap) => {
    /* ── 위상 타일 검산 ──────────────────────────────────────────
     * 서버가 스냅샷에 현재 ON/OFF 를 1바이트(ph)로 실어 보냅니다.
     *
     * 비교 기준은 '지금'이 아니라 '스냅샷을 만든 시각(snap.t)' 입니다 —
     * 패킷은 늘 조금 늦게 오므로 지금과 비교하면 전환 때마다 멀쩡한
     * 계산이 틀린 것으로 나옵니다.
     * 경계 근처(PHASE_EDGE_GUARD_MS)에서는 시계 지터만으로도 갈리므로
     * 아예 판정하지 않습니다.                                       */
    if (snap.ph !== undefined) {
      const serverOn = !!snap.ph;
      const pi = phaseInfoAt(snap.t);
      if (pi.known && pi.marginMs > PHASE_EDGE_GUARD_MS) {
        if (pi.on !== serverOn) {
          if (G.phaseTrust) { G.phaseTrust = false; netStats.phaseFixes++; }
        } else if (!G.phaseTrust) {
          G.phaseTrust = true;      // 다시 맞기 시작했습니다 — 공식으로 복귀
        }
      }
      // 공식을 못 믿는 동안에는 서버 값을 그대로 씁니다
      if (!G.phaseTrust) G.phaseOn = serverOn;
    }

    /* ── 회전 각도 검산 ──────────────────────────────────────────
     * 위상 타일과 같은 구조입니다. 서버가 스냅샷을 만든 시각(snap.t)의
     * 각도를 rt 로 보내므로, 나도 '그 시각'의 각도를 계산해 비교합니다.
     * 지금 시각과 비교하면 패킷 지연만큼 늘 어긋나 보입니다.
     *
     * 각도는 계속 커지는 값이라 절대 비교가 아니라 차이를 봅니다.
     * 임계값 ROT_TRUST_EPS 는 시계 지터(수십 ms) × 각속도보다 넉넉하고,
     * 눈에 띄는 어긋남(약 1.7°)보다는 작게 잡았습니다.               */
    if (snap.rt !== undefined && G.traits.rotate.epoch) {
      const s = G.traits.rotate;
      const mine = s.baseAngle + s.dir * s.speed * (snap.t - s.epoch) / 1000;
      if (Math.abs(mine - snap.rt) > ROT_TRUST_EPS) {
        if (G.rotTrust) { G.rotTrust = false; netStats.rotFixes++; }
      } else if (!G.rotTrust) {
        G.rotTrust = true;        // 다시 맞기 시작했습니다 — 공식으로 복귀
      }
      /* 공식을 못 믿는 동안에는 서버 값을 그대로 씁니다.
       * 스냅샷 시각의 값이므로 지금까지 흐른 만큼만 앞으로 굴려 줍니다. */
      if (!G.rotTrust) {
        s.angle = snap.rt + s.dir * s.speed * (Date.now() + G.serverOffset - snap.t) / 1000;
      }
    }

    const now = performance.now();
    Interp.note(now);       // 도착 간격을 재서 보간 버퍼 크기를 정합니다
    for (const s of snap.players) {
      if (s.id === G.selfId) continue;         // never overwrite local prediction
      let r = G.players.get(s.id);
      if (!r) continue;
      r.push(s, now);
      r.alive = !!s.al;
      r.layer = s.l;
    }
  });

  /* 서버가 정한 강제 이동(지금은 대시 하나, 앞으로 점프 타일도 여기로).
   *
   * 내 것이면 그대로 적용합니다 — 서버가 이미 graceMs 동안 이동 검증을
   * 면제해 뒀으므로 state_correction 이 오지 않습니다.
   * 남의 것이면 그 주자의 보간 허용 오차를 잠깐 넓힙니다. 대시 중에는
   * 스냅샷 간 이동량이 평소의 두 배라 NET.SNAP_DIST(2.0)를 넘겨
   * 강제 스냅(뚝 끊김)이 걸리기 때문입니다.                          */
  socket.on('player_impulse', (d) => {
    if (!d || !d.id) return;
    if (d.id === G.selfId) {
      if (G.role !== 'player' || !local.alive) return;
      if (d.type === 'dash') { applyDashImpulse(d); netStats.dashes++; }
      else if (d.type === 'jump') {
        applyJumpImpulse(d);
        netStats.jumps++;
        if (!d.landed) {
          toast(d.reason === 'phase_off' ? '위상 타일이 꺼져 있습니다 — 착지 실패'
                                         : '위쪽에 발판이 없습니다 — 착지 실패', 'kill',
                { key: 'nojump', gapMs: 3000 });
        }
      }
      return;
    }
    const r = G.players.get(d.id);
    if (r instanceof RemoteRunner) {
      r.tolerantUntil = performance.now() + (d.graceMs || 400) + NET.INTERP_DELAY_MS;
      if (d.type === 'jump') spawnJumpFx(r.render.x, r.render.y, r.render.z, d.level || 1);
      else if (d.to) spawnDashFx(d.to[0], d.to[1], d.to[2],
        Array.isArray(d.vel) ? d.vel[0] : 0, Array.isArray(d.vel) ? d.vel[2] : 0);
    }
  });

  socket.on('pedestals_clear', () => {
    clearPedestals();
    // 전원이 동시에 공중에 뜨는 구간입니다. 여기서 서로 밀면 난장판이 됩니다.
    G.bumpReadyAt = performance.now() + startFallGraceMs();
    toast('접수 게이트 개방 — 최상층으로 낙하합니다', 'obstacle');
  });

  /* 서버 이동 검증에 걸려 위치가 되돌려졌습니다.
   * 퇴장이 아니라 보정입니다 — 렉으로 인한 오탐이 퇴장으로 이어지면 안 됩니다. */
  socket.on('state_correction', (d) => {
    if (!d || !Array.isArray(d.p) || d.p.length !== 3) return;
    local.pos.set(d.p[0], d.p[1], d.p[2]);
    local.vel.set(0, 0, 0);
    snapRender();
    local.grounded = false;
    local.jumped = false;
    local.lastGroundY = d.p[1];
    netStats.corrections++;
    // 매번 토스트를 띄우면 도배가 됩니다. 3초에 한 번만 알립니다.
    const now = performance.now();
    if (now - netStats.lastCorrectionToast > 3000) {
      netStats.lastCorrectionToast = now;
      /* 렉이 이어지는 동안 몇 초에 걸쳐 여러 번 옵니다 — 원인이 하나이므로
       * 줄도 하나면 충분합니다.                                        */
      toast('위치가 서버 기준으로 보정되었습니다', 'kill', { key: 'correct', gapMs: 8000 });
    }
  });

  /* 아직 안 무너진 타격 — 마모 단계만 올라갑니다 (일반 타일 1·2회차). */
  /* 층 특성 이벤트(지금은 '심사 가속' 하나).
   * 언제 켜지고 언제 꺼지는지, 진행 중이던 퓨즈를 얼마나 앞당길지는
   * 전부 서버가 정해서 보냅니다. 우리는 그리기만 합니다.            */
  socket.on('layer_event', (d) => applyLayerEvent(d));

  /* 선행기술 검색 타일을 누군가 밟았습니다.
   * 시야가 넓어지는 것은 밟은 사람 한 명뿐이고(내 것인지 id 로 가름),
   * 스캔 연출은 모두가 봅니다 — 어둠 속에서 누가 조사 중인지 읽혀야 합니다.
   * 얼마나·얼마 동안 넓어지는지는 서버가 정합니다.                    */
  socket.on('search_pulse', (d) => {
    if (!d) return;
    const p = Array.isArray(d.pos) ? d.pos : [0, 0, 0];
    spawnSearchFx(p[0], p[1], p[2], d.viewTiles, d.durationMs);
    Sound.sfx('booster', { pos: { x: p[0], y: p[1], z: p[2] }, rate: 1.45, volume: 0.75 });

    if (d.id === G.selfId) {
      G.view.searchUntil = performance.now() + (d.durationMs || 2000);
      G.view.searchTiles = d.viewTiles || 8;
      netStats.searches++;
      /* ★ 회차당 한 번. 시야가 실제로 넓어지는 것이 그 자체로 피드백이라,
       *   검색 타일을 밟을 때마다 같은 줄을 띄우면 설명이 아니라 소음입니다.
       *   5층 타일의 20% 가 검색 타일이라 한 회차에 여러 번 밟습니다.   */
      toast('선행기술 검색 — ' + (d.viewTiles || 8) + '칸까지 조사했습니다', 'cheer',
            { key: 'search', gapMs: Infinity });
    } else if (d.name && G.traits.dark.active) {
      /* 남의 조사는 레이더 펄스로 화면에 이미 보입니다 (updateSearchFx). */
      toast(safeName(d.name) + ' 님이 선행기술을 조사합니다', 'obstacle', { level: 'info' });
    }
  });

  socket.on('tile_hit', (d) => {
    const rec = G.tiles.get(d.tileId);
    if (!rec) return;
    rec.hits = d.hits;
    rec.maxHits = d.maxHits;
    if (d.kind) rec.kind = d.kind;
    applyTileWear(rec);
    /* ★ tile_hit 은 <b>아직 버티는</b> 밟기입니다(hits < maxHits).
     *   바닥은 두 번 밟아야 무너지므로 여기 오는 것은 첫 밟기 —
     *   '금이 갔다' 소리입니다. 두 번째 밟기는 붕괴가 예약되므로
     *   tile_warn 으로 갑니다(아래).
     *   파일이 없으면 buffers 에 안 들어오니 종전 'step' 으로 받칩니다. */
    const hitKey = Sound.buffers.tile1 ? 'tile1' : 'step';
    Sound.sfx(hitKey, {
      pos: rec, rate: hitKey === 'step' ? 0.9 + d.hits * 0.08 : 1,
      volume: d.by === G.selfId ? 1 : 0.55
    });
  });

  socket.on('tile_warn', (d) => {
    const rec = G.tiles.get(d.tileId);
    if (!rec) return;
    // 마지막 타격이므로 hits 도 확정값으로 맞춰 둡니다
    if (d.hits !== undefined) rec.hits = d.hits;
    if (d.maxHits !== undefined) rec.maxHits = d.maxHits;
    startWarn(rec, d.fuse);
    /* ★ tile_warn 은 <b>붕괴가 예약된</b> 밟기입니다 — 바닥에서는
     *   두 번째 밟기입니다. 첫 밟기(tile_hit)와 소리를 달리해
     *   "이번엔 꺼진다"를 발밑을 보지 않고도 알 수 있게 합니다.
     *   내가 밟은 타일만 또렷하게, 남이 밟은 건 거리에 따라 작게.   */
    const warnKey = Sound.buffers.tile2 ? 'tile2' : 'step';
    Sound.sfx(warnKey, {
      pos: rec, rate: warnKey === 'step' ? 0.94 + Math.random() * 0.12 : 1,
      volume: d.by === G.selfId ? 1 : 0.55
    });
  });

  /* 거절이유 타일을 누군가 밟았습니다. 색 변화는 여기서 시작합니다.
   * 언제 터질지(delay)는 서버가 정하고 우리는 그대로 그립니다.       */
  socket.on('tile_reject', (d) => {
    const rec = G.tiles.get(d.tileId);
    if (!rec) return;
    startReject(rec, d.delay);
    Sound.sfx('crack', { pos: rec, rate: 1.25 });
    if (d.by === G.selfId) {
      /* 이건 목숨이 걸린 경고라 회차당 한 번으로 묶지 않습니다.
       * 다만 연달아 밟았을 때 같은 줄이 쌓이지는 않게 합니다.       */
      toast('거절이유 발견 — 주변까지 무너집니다. 피하세요', 'kill', { key: 'reject' });
    } else if (d.byName) {
      /* 남의 폭발은 타일 색과 폭발음으로 이미 읽힙니다. */
      toast(safeName(d.byName) + ' 님이 거절이유를 건드렸습니다', 'obstacle', { level: 'info' });
    }
  });

  /* 폭발 — 서버가 없앨 타일 목록을 통째로 보냅니다.
   * 이웃 계산도 연쇄 방지도 전부 서버가 이미 끝냈으므로,
   * 여기서는 목록대로 부수고 파편만 크게 냅니다.                     */
  socket.on('tile_explode', (d) => {
    if (!d || !Array.isArray(d.tiles)) return;
    const center = G.tiles.get(d.tileId);
    for (const id of d.tiles) {
      const rec = G.tiles.get(id);
      if (!rec || rec.state === 'gone') continue;      // 이미 사라진 건 건너뜁니다
      // 중앙은 더 크게, 이웃은 조금 작게 터집니다
      breakTile(rec, id === d.tileId ? 2.4 : 1.6);
    }
    if (center) {
      /* 폭탄 소리가 있으면 그것 하나로 갑니다 — 없을 때만 종전처럼
       * 두 소리를 겹쳐 대신합니다.                                  */
      if (Sound.buffers.bomb) {
        Sound.sfx('bomb', { pos: center });
      } else {
        Sound.sfx('crack', { pos: center, rate: 0.72 });
        Sound.sfx('death', { pos: center, volume: 0.5 });
      }
    }
  });

  /* 보정 타일을 밟았습니다. 어느 타일이 되살아나는지는 서버가 정하고
   * 여기로는 결과만 옵니다 (restored 가 null 이면 되살릴 이웃이 없었음). */
  socket.on('tile_amend', (d) => {
    const rec = G.tiles.get(d.tileId);
    if (rec) Sound.sfx('booster', { pos: rec, rate: 1.15, volume: 0.7 });
    if (d.by === G.selfId) {
      toast(d.restored ? '보정 성공 — 무너진 타일 하나를 되살렸습니다'
                       : '보정 성공 — 되살릴 타일이 주변에 없습니다', 'cheer');
    } else if (d.byName && d.restored) {
      /* 남의 보정은 타일이 되살아나는 것으로 이미 보입니다. */
      toast(safeName(d.byName) + ' 님이 보정으로 타일을 되살렸습니다', 'cheer', { level: 'info' });
    }
  });

  /* 타일 되살리기. breakTile 이 남긴 흔적을 restoreTile 이 전부 되돌립니다. */
  socket.on('tile_restore', (d) => {
    const rec = G.tiles.get(d.tileId);
    if (!rec) return;
    restoreTile(rec);
    Sound.sfx('land', { pos: rec, rate: 1.3, volume: 0.8 });
  });

  socket.on('tile_break', (d) => {
    const rec = G.tiles.get(d.tileId);
    breakTile(rec);
    if (rec) Sound.sfx('crack', { pos: rec, rate: 0.9 + Math.random() * 0.2 });
  });

  /* 보정 기회가 발동했습니다. 실제 이동은 player_impulse 가 처리하고
   * (점프 타일과 같은 경로), 여기서는 내 기회 소진만 기록합니다.   */
  socket.on('amend_granted', (e) => {
    if (e.byId === G.selfId) { G.amendUsed = true; updateActionCooldowns(); }
    /* ★ 올라가는 사람의 자리에서 냅니다 — 방 전체가 듣되, 누가
     *   도움을 받았는지가 소리의 방향으로도 읽힙니다.
     *   실제 상승 소리(stairJump1)는 player_impulse 가 따로 냅니다.
     *   이건 '기회가 쓰였다'는 신호라 겹쳐도 역할이 다릅니다.       */
    let at = null;
    if (e.targetId === G.selfId) at = local.pos;
    else { const r = G.players.get(e.targetId); if (r && r.render) at = r.render; }
    Sound.sfx('opportunity', at ? { pos: at } : undefined);
  });

  socket.on('booster_spawn', (e) => {
    spawnBooster(e);
    Sound.sfx('booster', { pos: e });
  });
  socket.on('booster_expire', (e) => removeBooster(e.id));

  /* ★ 투하(디버프)는 서버에서 제거했으므로 이 이벤트는 더 이상 오지
   *   않습니다. 렌더링은 지우지 않고 남겨 둡니다 — 되살릴 때 서버
   *   핸들러만 되돌리면 되도록.                                    */
  socket.on('obstacle_drop', (e) => {
    spawnObstacle(e);
    Sound.sfx('obstacle', { pos: { x: e.x, y: e.y, z: e.z } });
  });
  socket.on('obstacle_impact', (e) => {
    const rec = G.tiles.get(e.tileId);
    Sound.sfx('impact', { pos: rec || camTarget });
  });

  socket.on('eliminated', (d) => {
    const r = G.players.get(d.id);
    if (r) {
      r.alive = false;
      // 관전자에게도 누가 어디로 떨어졌는지 보이게 합니다
      if (d.id !== G.selfId && r.render) {
        spawnSeaSplash(r.render.x, r.render.z, (THEMES[currentTheme] || THEMES[0]).seaTop);
      }
    }
    if (d.id !== G.selfId) {
      // 밀어서 떨어뜨린 사람이 있으면 밝혀 줍니다 (내가 민 경우도 여기로 옵니다)
      const by = d.byName ? safeName(d.byName) + ' 님이 밀어냄 · ' : '';
      toast(by + safeName(d.name) + ' 님 탈락 · ' + d.placement + '위', 'kill');
      Sound.sfx('eliminate');
    } else if (local.alive) {
      /* 서버가 먼저 탈락시킨 경우 — 보고가 끊겨 서버가 대신 처리했습니다
       * (server.js 의 eliminateStale). 예전에는 탈락을 항상 클라이언트가
       * 시작했기 때문에 이 분기가 필요 없었지만, 이제는 서버가 통보할 수
       * 있으므로 여기서 내 상태를 맞춰야 합니다. 안 그러면 내 화면에서만
       * 계속 살아 움직이고 서버는 죽은 것으로 아는 어긋남이 생깁니다.
       * player_death 를 되쏘지는 않습니다 — 이미 서버가 확정한 사실입니다. */
      local.alive = false;
      local.dying = 0;
      G.selfAlive = false;
      local.anim = 'dead';
      if (local.avatar) local.avatar.group.visible = false;
      dom.deadFlash.classList.add('on');
      setTimeout(() => dom.deadFlash.classList.remove('on'), 900);
      G.role = 'spectator';
      Sound.sfx('death');
      toast(d.cause === 'afk'
        ? '연결이 끊긴 것으로 처리되어 탈락했습니다'
        : '통신이 끊겨 탈락 처리되었습니다 — 이제 관전자로 개입할 수 있습니다', 'kill');
    }
    updateRoster(); updateSpectatorUI();
  });

  socket.on('game_over', (d) => {
    updateRoster();
    /* 승자가 있으면 3D 피날레를 먼저 돌리고 결과 패널은 그 뒤에 올립니다.
     * 패널이 먼저 뜨면 화면을 덮어 연출이 하나도 안 보입니다.
     * 승자가 없으면(전멸) 연출할 대상이 없으므로 종전처럼 바로 띄웁니다. */
    const who = d.winnerId ? G.players.get(d.winnerId) : null;
    const spot = (d.winnerId === G.selfId) ? local.render : (who ? who.render : null);
    if (spot) {
      const layer = currentLayerOf(spot.y);
      beginFinale(spot, { name: d.winnerName || '', layerName: layerNameOf(layer) || '—' });
      setTimeout(() => showResult(d), 3400);
    } else {
      showResult(d);
    }
    Sound.sfx(d.winnerId === G.selfId ? 'win' : 'lose');
  });

  /* ★ 페이지를 열면 바로 관전으로 붙는 구조라, 아직 참가 버튼을 누르지도
   *   않은 사람에게 진행 중인 경기의 문구가 그대로 날아옵니다.
   *   이름을 적고 있는 사람에게 '○○ 님이 의견제출통지서를 투하했습니다'
   *   는 맥락 없는 소음입니다. 참가 전에는 걸러냅니다.               */
  socket.on('toast', (d) => { if (previewing) return; toast(d.text, d.kind); });
  socket.on('chat', (d) => { if (previewing) return; });
  socket.on('chat', (d) => { if (previewing) return; toast(safeName(d.name) + ': ' + d.text); });

  socket.on('action_denied', (d) => {
    /* 회차당 1회라 '재사용까지 N초' 는 더 이상 맞지 않습니다.
     * 왜 안 됐는지를 그대로 말해 줘야 합니다.                      */
    /* 대기실 — 시작 거절. 버튼이 비활성인 이유는 패널에 이미 적혀
     * 있지만, 마지막 사람이 준비를 푼 직후에 누르면 화면과 어긋난
     * 순간이 생깁니다. 그때 아무 일도 안 일어나면 고장으로 읽힙니다. */
    if (d.action === 'start') {
      const why = d.reason === 'not_host' ? '방장만 시작할 수 있습니다'
                : d.reason === 'not_ready' ? '아직 준비하지 않은 출원인이 있습니다'
                : '지금은 시작할 수 없습니다';
      toast(why, 'kill', { key: 'startDeny', gapMs: 3000 });
      return;
    }
    if (d.reason === 'used') { toast('보정 기회는 회차당 한 번입니다', 'kill', { key: 'amendDeny' }); return; }
    if (d.reason === 'top') { toast('이미 맨 위층입니다 — 올려보낼 곳이 없습니다', 'kill'); return; }
    if (d.reason === 'no_landing') {
      toast('위층에 착지할 자리가 없습니다 — 잠시 뒤 다시 시도하세요', 'kill', { key: 'amendDeny', gapMs: 4000 });
      return;
    }
    if (d.retryInMs) { toast('재사용까지 ' + Math.ceil(d.retryInMs / 1000) + '초 남았습니다', '', { key: 'amendDeny', gapMs: 3000 }); return; }
    toast('지금은 사용할 수 없습니다', '', { key: 'amendDeny', gapMs: 3000 });
  });

  socket.on('disconnect', (reason) => {
    dom.vRoom.textContent = '연결끊김';
    toast('서버 연결이 끊어졌습니다 — 재연결 중 (' + reason + ')', 'kill', { key: 'netdown', gapMs: 10000 });
  });

  /* 연결 자체가 안 되는 상황을 조용히 넘기지 않고 화면에 알립니다.
   * 예전에는 아무 표시 없이 로스터가 "대기 중…" 으로 멈춰 있어서
   * 서버가 죽은 것인지 매칭 대기인지 구분할 수 없었습니다.                  */
  let connectFails = 0;
  socket.on('connect_error', (err) => {
    connectFails++;
    dom.vRoom.textContent = '연결실패';
    dom.vPing.textContent = '— ms';
    dom.vPing.classList.add('bad');
    /* 재연결 뒤 회선이 달라졌을 수 있습니다. 끊기기 전 통계를 그대로
     * 쓰면 엉뚱한 버퍼로 시작합니다.                                 */
    Interp.gaps.length = 0; Interp.last = 0;
    if (connectFails === 1 || connectFails % 5 === 0) {
      toast('서버에 연결할 수 없습니다 (' + (err && err.message ? err.message : 'unknown') + ') — 재시도 ' + connectFails + '회', 'kill', { key: 'netfail', gapMs: 10000 });
    }
    console.error('[IPG] socket connect_error #' + connectFails + ':', err);
  });

  socket.io.on('reconnect', (n) => toast('서버에 다시 연결되었습니다 (' + n + '회 시도)'));
}

function applyMeta(meta) {
  if (!meta) return;
  const prevPhase = G.phase;
  G.phase = meta.phase;
  if (meta.phase !== prevPhase) {
    if (meta.phase === 'playing') Sound.playBgm('play');
    else if (meta.phase === 'ended') Sound.playBgm('result');
    else Sound.playBgm('lobby');
  }
  G.phaseEndsAt = meta.phaseEndsAt;
  /* 위상 타일 기준 시각. meta 는 init·phase·map_reset 에 다 실려 오므로
   * 중도 참가자도 여기서 받아 곧바로 같은 리듬에 올라탑니다.         */
  if (meta.phaseEpoch !== undefined) G.phaseEpoch = meta.phaseEpoch;
  if (meta.theme !== undefined) applyTheme(meta.theme);
  if (meta.seats) G.seats = meta.seats;
  G.roster = meta.total;
  /* 대기실 상태. 서버가 phase 마다 실어 보냅니다(roomSnapshotMeta). */
  if (meta.hostId !== undefined) G.hostId = meta.hostId;
  if (meta.canStart !== undefined) G.canStart = !!meta.canStart;
  if (meta.ready !== undefined) G.readyCount = meta.ready;
  /* 대기 중에는 '지금 혼자인가', 회차가 시작된 뒤에는 '이 회차가
   * 연습이었나'. 결과 화면 문구가 이 값을 봅니다.                 */
  G.solo = !!meta.solo;
  dom.vAlive.textContent = meta.alive + '/' + meta.total;
  dom.vSpec.textContent = meta.spectators;
  dom.vRoom.textContent = meta.roomId || G.roomId;
}

function syncPlayers(list) {
  const seen = new Set();
  for (const p of list) {
    seen.add(p.id);
    if (p.id === G.selfId) {
      G.players.set(p.id, Object.assign(G.players.get(p.id) || {}, {
        id: p.id, name: p.name, color: p.color, seat: p.seat,
        alive: p.alive, layer: p.layer, isSelf: true,
        ready: !!p.ready,
        render: local.pos
      }));
      continue;
    }
    let r = G.players.get(p.id);
    if (!r || !(r instanceof RemoteRunner)) {
      if (r && r.dispose) r.dispose();
      r = new RemoteRunner(p);
      G.players.set(p.id, r);
    } else {
      r.alive = p.alive;
      r.layer = p.layer;
      r.seat = p.seat;
      r.ready = !!p.ready;
    }
  }
  for (const [id, r] of [...G.players]) {
    if (!seen.has(id)) { if (r.dispose) r.dispose(); G.players.delete(id); }
  }
  updateRoster();
}

/* ============================ 15. main loop =========================== */

let lastTime = performance.now();
let accumulator = 0;
let sendAccum = 0;
let fpsAccum = 0, fpsFrames = 0;

/* ── 왜 시뮬레이션과 렌더를 쪼갰는가 ───────────────────────────────────
 * 브라우저는 비활성 탭의 requestAnimationFrame 을 멈춥니다. 예전에는
 * 물리·전송·렌더가 frame() 한 덩어리였기 때문에, 알트탭한 참가자는 물리도
 * 전송도 같이 멈췄습니다. 서버는 마지막으로 받은 위치를 계속 중계하므로
 * 다른 사람 화면에서 대기 발판 높이에 낙하 자세로 굳어 버렸고, 죽지도
 * 않아 checkRoundEnd 가 성립하지 않고 라운드가 5분 타임아웃까지 갔습니다.
 *
 *   simulate()    — 물리 + 업링크. 백그라운드에서도 워커 타이머로 돕니다.
 *   renderFrame() — 아바타/월드/카메라/HUD/GL 드로우. 보일 때만 돕니다.
 *
 * 렌더를 백그라운드에서 돌리면 GPU 자원만 낭비하고 컨텍스트를 잃을 수도
 * 있어서, 화면에 안 보이면 아예 건너뜁니다.
 *
 * lastTime 갱신은 stepFrameOnce() 한 곳에서만 합니다. frame() 에서 또
 * 갱신하면 dt 가 0 이 되거나 물리가 두 배로 돕니다.                   */
function simulate(dt, now) {
  /* ── 위상 타일 상태를 프레임당 한 번만 정합니다 ──────────────────
   * 착지 판정 3곳(findLanding·supportAt·groundYUnder)과 그리기가 모두
   * 이 값을 봅니다. 각자 계산하게 두면 전환 순간에 한 곳만 먼저 넘어가
   * "발밑은 없는데 그림자는 있다" 같은 어긋남이 생깁니다.
   *
   * phaseTrust 가 false 면 내 공식이 서버와 어긋난 것이므로 계산하지 않고,
   * state 핸들러가 넣어 준 서버 값을 그대로 씁니다.                  */
  if (G.phaseTrust) {
    const on = phaseTilesNow();
    if (on !== G.phaseOn) {
      G.phaseOn = on;
      /* 두 클라이언트의 전환 시각을 맞대 보려면 이 로그를 비교하세요.
       * 서버 시각 기준이라 기기 시계가 달라도 같은 값이 나와야 합니다. */
      if (DEV.on) {
        console.log('[위상] ' + (on ? 'ON ' : 'OFF') +
          ' 서버시각=' + Math.round(Date.now() + G.serverOffset) +
          ' 경과=' + Math.round(Date.now() + G.serverOffset - G.phaseEpoch) + 'ms');
      }
    }
  }

  /* ── 회전 각도도 프레임당 한 번만 정합니다 ──────────────────────
   * 위상 타일과 같은 이유입니다. 착지 판정 3곳과 그리기, 그리고 나를
   * 실어 돌리는 계산이 전부 이 값을 봅니다. 각자 계산하면 프레임 안에서
   * 시각이 미세하게 달라져 발밑이 어긋납니다.
   *
   * rotTrust 가 false 면 내 공식이 서버와 어긋난 것이므로 계산하지 않고,
   * state 핸들러가 넣어 준 서버 각도를 그대로 씁니다.                */
  if (G.traits.rotate.epoch) {
    if (G.rotTrust) G.traits.rotate.angle = rotationAngleNow();
    /* 타일 271장이 아니라 그룹 하나만 돌립니다.
     *
     * ★ 부호에 −가 붙습니다. 빠뜨리면 화면과 물리가 2θ 만큼 어긋납니다.
     *
     *   이 게임의 회전 물리는 전부 수학 규약의 회전행렬로 쓰여 있습니다 —
     *       M(φ) = [[cosφ, −sinφ], [sinφ, cosφ]]
     *   즉 '층이 각도 θ 일 때 월드 = M(θ)·로컬' 을 전제합니다.
     *   toLayerFrame(M(−θ) 로 되돌림) · syncEntityToLayer · tileWorldXZ ·
     *   applyRotationCarry · clampToArena, 그리고 서버의 toLayerLocalXZ ·
     *   tickRotateCarry 까지 일곱 군데가 전부 이 규약으로 서로 맞물려
     *   있습니다.
     *
     *   그런데 three.js 의 Y축 회전은 그 거울상입니다 —
     *       Ry(θ) : x' = x·cosθ + z·sinθ ,  z' = −x·sinθ + z·cosθ
     *   행렬로 보면 Ry(θ) = M(−θ) 입니다. 그래서 rotation.y 에 θ 를 그대로
     *   넣으면 타일만 반대 방향으로 그려집니다. 물리끼리는 서로 맞으므로
     *   '물리가 틀렸다'는 증상이 아니라 '보이는 자리와 밟히는 자리가 다르다'
     *   가 됩니다.
     *
     *   실측(θ=0.7rad, 회전층 271장): 부순 타일 136장 중 58장이 그려진
     *   자리에 그대로 발판이 남았고, 반대로 멀쩡한 타일 135장 중 56장은
     *   보이는데 밟히지 않았습니다. −를 붙이면 양쪽 다 0 이 됩니다.
     *
     * ★ 왜 물리 일곱 군데를 고치지 않고 여기 한 줄을 고치는가
     *   일곱 군데는 서로 이미 일치합니다. 하나라도 놓치면 새 불일치가
     *   생기고, 그 불일치는 회전층에서만·특정 각도에서만 드러나 찾기가
     *   아주 어렵습니다. 어긋난 곳이 한 곳이면 한 곳을 고치는 것이 맞습니다.
     *   방향 표시(HUD '시계/반시계', 층 목록 ↻/↺)도 dir>0 을 시계로 읽는데,
     *   −를 붙인 쪽이 위에서 내려다본 실제 회전 방향과 맞습니다.
     *
     * ★ 이 줄을 건드릴 일이 생기면 검증은 이렇게 합니다.
     *   mesh.getWorldPosition() 으로 타일이 '그려지는' 월드 좌표를 얻고,
     *   그 점에 supportAt() 을 물어 봅니다. 부순 타일이면 발판이 없어야
     *   하고 멀쩡한 타일이면 있어야 합니다. 손으로 적은 회전식끼리
     *   비교하면 같은 실수를 두 번 하게 됩니다 — 기준은 렌더러입니다. */
    rotGroup.rotation.y = -G.traits.rotate.angle;
  }

  /* 층 특성 배너는 '내가 지금 어느 층에 있는지'에 따라 달라지므로
   * 이벤트가 올 때가 아니라 매 프레임 정합니다 (refreshTraitBanners 주석).
   * classList.toggle 두 번이라 값이 그대로면 렌더링 비용이 없습니다.  */
  refreshTraitBanners();

  /* --- fixed-step physics for the local runner --- */
  if (local.dying) {
    updateFallOut(dt);
    accumulator = 0;
    snapRender();
  } else if (G.started && G.role === 'player' && local.alive &&
             (G.phase === 'playing' || G.phase === 'countdown' || G.phase === 'waiting')) {
    accumulator += dt;
    let guard = 0;
    local.stepsThisFrame = 0;
    local.carryAccum = 0;      // 이 프레임에 바닥이 실어 나른 거리
    while (accumulator >= PHYS.STEP && guard++ < 8) {
      local.stepsThisFrame++;
      /* prev 는 '마지막 스텝 직전' 위치여야 합니다. 루프 바깥에서 한 번만
       * 저장하면 두 스텝이 도는 프레임에서 두 칸치를 한 번에 보간하게 되어,
       * 고치려던 덜컹임이 그대로 남습니다. */
      local.prev.copy(local.pos);
      stepPhysics(PHYS.STEP);
      accumulator -= PHYS.STEP;
    }
    /* 남은 누산기가 곧 '다음 스텝까지 얼마나 왔는가' 입니다.
     * 스텝이 0번 돈 프레임에서도 이 값이 커지므로 화면은 계속 앞으로 갑니다. */
    local.alpha = THREE.MathUtils.clamp(accumulator / PHYS.STEP, 0, 1);
  } else {
    accumulator = 0;
    snapRender();
  }

  /* --- 20Hz uplink --- */
  if (G.started && G.socket && G.role === 'player' && local.alive) {
    sendAccum += dt;
    if (sendAccum >= 1 / NET.SEND_HZ) {
      /* 0 으로 밀지 않고 주기만큼 뺍니다. 밀어버리면 나머지가 버려져서
       * 60fps 에서 3프레임(50.01ms)과 4프레임(66.7ms)이 번갈아 나오고
       * 실효 전송률이 20Hz 가 아니라 17.5Hz 로 떨어집니다. 워커 틱(33ms)
       * 에서는 더 심해서 15Hz 까지 내려갑니다.
       * 다만 오래 멈췄다 돌아왔을 때 밀린 만큼 몰아 보내면 안 되므로,
       * 두 주기 이상 밀렸으면 밀린 분은 버립니다.                      */
      sendAccum = sendAccum > 2 / NET.SEND_HZ ? 0 : sendAccum - 1 / NET.SEND_HZ;
      G.socket.emit('player_state', {
        p: [local.pos.x, local.pos.y, local.pos.z],
        v: [local.vel.x, local.vel.y, local.vel.z],
        ry: local.ry,
        layer: local.layer,
        anim: local.anim,
        g: local.grounded ? 1 : 0   // 접지 여부 — 원격 클라이언트의 중력 적분 근거
      });
    }
  }
}

/** 한 스텝 전진. 포그라운드는 frame() 이, 백그라운드는 워커가 부릅니다. */
function stepFrameOnce() {
  const now = performance.now();
  let dt = (now - lastTime) / 1000;
  lastTime = now;
  if (dt > 0.25) dt = 0.25;
  simulate(dt, now);
  return { dt, now };
}

/* ══════════════════════════════════════════════════════════════════════
 * F3 — 주행 끊김 진단
 * ────────────────────────────────────────────────────────────────────
 * '달릴 때 걸리는 느낌'의 원인을 세 갈래로 갈라 줍니다. 눈으로는 셋이
 * 똑같이 보이지만 고치는 방법이 전혀 다릅니다.
 *
 *   (A) 월드 이동이 불균일  → 물리/보간 문제
 *   (B) 월드는 균일한데 화면에서만 불균일 → 카메라 추종 문제
 *   (C) 프레임 시간 자체가 튐 → GC·드로우콜 등 프레임 스파이크
 *
 * ★ 화면 좌표로 재는 것이 핵심입니다. 사람이 실제로 보는 것은 월드 좌표가
 *   아니라 '화면 속 캐릭터'이고, 카메라가 따로 흔들리면 월드가 완벽해도
 *   끊겨 보입니다. 월드만 재면 이 경우를 영영 못 찾습니다.
 * ══════════════════════════════════════════════════════════════════════ */
const runDiag = { on: false, t0: 0, rows: [], lastW: null, lastS: null };
const _diagV = new THREE.Vector3();

function startRunDiag() {
  runDiag.on = true;
  runDiag.t0 = performance.now();
  runDiag.rows.length = 0;
  runDiag.lastW = null;
  runDiag.lastS = null;
  toast('주행 진단 4초 — 직선으로 계속 달리세요', 'cheer');
}

function sampleRunDiag(dt) {
  if (!runDiag.on) return;
  /* 화면 좌표(px). project() 는 카메라 행렬을 그대로 쓰므로 실제로
   * 그려지는 위치와 같습니다. */
  _diagV.copy(local.render).project(camera);
  const sx = (_diagV.x * 0.5 + 0.5) * window.innerWidth;
  const sy = (-_diagV.y * 0.5 + 0.5) * window.innerHeight;
  const w = local.render;
  if (runDiag.lastW) {
    runDiag.rows.push({
      dt: dt * 1000,
      steps: local.stepsThisFrame || 0,
      dw: Math.hypot(w.x - runDiag.lastW.x, w.z - runDiag.lastW.z),
      sp: Math.hypot(local.vel.x, local.vel.z),
      carry: local.carryAccum || 0,
      layer: local.layer,
      rot: isRotatingLayer(local.layer) ? 1 : 0,
      alpha: local.alpha,
      dsx: sx - runDiag.lastS.x,
      dsy: sy - runDiag.lastS.y,
      sx: sx, sy: sy,
      gnd: local.grounded ? 1 : 0,
      pitch: cam.pitch
    });
  }
  runDiag.lastW = { x: w.x, z: w.z };
  runDiag.lastS = { x: sx, y: sy };

  if (performance.now() - runDiag.t0 < 4000) return;
  runDiag.on = false;
  reportRunDiag();
}

function reportRunDiag() {
  /* ★ 프레임 단위로 '안 움직인 프레임' 을 거르면 안 됩니다.
   * 처음에 그렇게 짰다가 판정 A 가 통째로 죽었습니다 — 끊김의 정체가
   * 바로 '한 프레임 멈췄다가 다음 프레임에 두 배로 튀는' 것인데, 멈춘
   * 프레임을 버리면 남는 것은 균일한 튐뿐이라 CV 가 0% 으로 나옵니다.
   * 대신 구간 전체의 평균으로 '달리고 있었는가' 만 판단하고, 표본은
   * 0 인 프레임까지 전부 씁니다. */
  const rows = runDiag.rows;
  const movedMean = rows.length ? rows.reduce((a, r) => a + r.dw, 0) / rows.length : 0;
  if (rows.length < 30 || movedMean < 0.05) {
    toast('표본 부족 — 직선으로 달리면서 다시 F3', 'kill');
    return 'RUNDIAG 표본부족 (달리는 중에 눌러야 합니다)';
  }
  const cv = (arr) => {
    const m = arr.reduce((a, b) => a + b, 0) / arr.length;
    const sd = Math.sqrt(arr.reduce((a, b) => a + (b - m) * (b - m), 0) / arr.length);
    return { m: m, sd: sd, cv: m ? sd / m * 100 : 0 };
  };
  const dts = rows.map((r) => r.dt).sort((a, b) => a - b);
  const med = dts[Math.floor(dts.length / 2)];
  const spikes = rows.filter((r) => r.dt > med * 1.5).length;
  /* ★ 이동거리(dw)의 변동계수를 그대로 쓰면 안 됩니다.
   * 가속·감속·방향 전환이 전부 '불균일'로 잡혀 정상 주행에서도 15% 안팎이
   * 나옵니다. 실제로 앞선 측정의 16.7% 중 9.1% 는 이상치 2프레임만으로도
   * 설명되는 값이었습니다.
   *
   * 물어야 할 것은 '얼마나 움직였나'가 아니라 '흐른 시간에 비례해
   * 움직였나' 입니다. 기대값 = 수평속도 × dt 로 나누면 가속·선회가
   * 약분되고, 타이밍 결함만 남습니다. 정상이면 언제나 1.0 근처입니다. */
  /* 기대 이동량 = 내가 낸 속도 × 시간 + 바닥이 실어 나른 거리.
   * carry 를 빼먹으면 회전층에 서 있는 것만으로 이탈이 잡힙니다. */
  const usable = rows.filter((r) => r.sp > 0.5 && r.dt > 0);
  const withRatio = usable.map((r) => {
    const exp = r.sp * r.dt / 1000 + (r.carry || 0);
    return Object.assign({}, r, { ratio: exp > 0 ? r.dw / exp : 1 });
  });
  const ratios = withRatio.map((r) => r.ratio);
  const world = ratios.length > 20 ? cv(ratios) : cv(rows.map((r) => r.dw));
  const ratioBad = ratios.filter((v) => Math.abs(v - 1) > 0.3).length;
  const ratioWorst = ratios.length ? Math.max(...ratios.map((v) => Math.abs(v - 1))) : 0;
  /* ★ 이탈 프레임을 그냥 세기만 하면 원인을 못 찾습니다. 가장 심한 3개를
   *   통째로 찍어야 '그 프레임에 무슨 일이 있었는지'가 드러납니다. */
  const worst = withRatio.slice().sort((a, b) => Math.abs(b.ratio - 1) - Math.abs(a.ratio - 1)).slice(0, 3);
  const rotFrames = rows.filter((r) => r.rot).length;
  const carrySum = rows.reduce((a, r) => a + (r.carry || 0), 0);
  /* 화면 이동은 부호가 중요합니다 — 전진 중인데 화면에서 뒤로 간 프레임이
   * 바로 '되돌아오는 느낌'의 정체입니다. 주 진행 방향을 먼저 정하고 셉니다. */
  /* ★ 화면 '이동량'의 변동계수는 쓰면 안 됩니다.
   * 카메라가 주자를 따라가므로 정상 상태에서는 화면 속 위치가 거의 고정이고,
   * 따라서 프레임간 이동량의 평균이 0 근처입니다. 0 으로 나눈 변동계수는
   * 늘 수백 %가 나와 '정상'과 '고장'을 구분하지 못합니다. (첫 측정에서
   * 133% 가 나왔던 것이 바로 이 함정이었습니다.)
   * 대신 화면 위치가 평균 자리에서 몇 픽셀이나 떠는지를 절대값으로 봅니다 —
   * 사람이 실제로 느끼는 것이 그 픽셀 흔들림입니다. */
  const sd = (arr) => {
    const m = arr.reduce((a, b) => a + b, 0) / arr.length;
    return Math.sqrt(arr.reduce((a, b) => a + (b - m) * (b - m), 0) / arr.length);
  };
  /* ★ 위치의 표준편차만 보면 '천천히 한 방향으로 흐른 것'과 '매 프레임
   *   떤 것'을 구분하지 못합니다. 앞선 측정에서 Y 5.6px 가 나왔는데 실제로는
   *   4초에 걸친 카메라 피치 수렴이었고, 프레임당으로 치면 0.023px 라
   *   끊김으로 느껴질 수가 없는 값이었습니다.
   *   사람이 끊김으로 느끼는 것은 '프레임간 변화량' 쪽이므로 둘을 나눕니다. */
  const driftX = Math.abs(rows[rows.length - 1].sx - rows[0].sx);
  const driftY = Math.abs(rows[rows.length - 1].sy - rows[0].sy);
  const jitX = sd(rows.map((r) => r.dsx));
  const jitY = sd(rows.map((r) => r.dsy));
  const sumX = rows.reduce((a, r) => a + r.dsx, 0);
  const sign = sumX >= 0 ? 1 : -1;
  const proj = rows.map((r) => r.dsx * sign);
  const back = proj.filter((v) => v < -0.5).length;
  /* 달리는 중 접지가 끊긴 횟수. 타일을 건널 때마다 발이 떨어지면
   * autoPitch 가 흔들려 카메라가 같이 들썩입니다. */
  let gndFlips = 0;
  for (let i = 1; i < rows.length; i++) if (rows[i].gnd !== rows[i - 1].gnd) gndFlips++;
  const pitchSwing = Math.max(...rows.map((r) => r.pitch)) - Math.min(...rows.map((r) => r.pitch));
  const stepHist = {};
  for (const r of rows) stepHist[r.steps] = (stepHist[r.steps] || 0) + 1;

  /* 판정 기준은 '보이는가' 입니다. 화면 지터 2px 미만은 사람이 못 느낍니다. */
  let verdict;
  if (spikes > rows.length * 0.03) verdict = '(C) 프레임 스파이크 — GC/드로우콜 쪽';
  else if (world.cv > 12) verdict = '(A) 월드 이동 불균일 — 물리/보간 쪽';
  /* 판정은 프레임간 지터로만 합니다. 드리프트는 참고용으로 찍기만 합니다 —
   * 천천히 흐르는 것은 끊김으로 느껴지지 않기 때문입니다. */
  else if (jitX > 3 || jitY > 3) verdict = '(B) 카메라 추종 — 프레임간 흔들림이 큼';
  else if (jitX > 1.2 || jitY > 1.2) verdict = '(B약) 카메라 추종 — 흔들림이 조금 남음';
  else verdict = '(위치는 정상) 프레임간 흔들림 1.2px 미만 — 위치가 아니라 애니메이션(발 미끄러짐) 쪽을 보세요';

  const line =
    'RUNDIAG ' + rows.length + '프레임' +
    ' | dt중앙 ' + med.toFixed(2) + 'ms 스파이크 ' + spikes +
    ' | 스텝 ' + Object.keys(stepHist).sort().map((k) => k + ':' + stepHist[k]).join(' ') +
    ' | 시간대비 CV ' + world.cv.toFixed(1) + '% 이탈 ' + ratioBad +
    '(최대 ' + (ratioWorst * 100).toFixed(0) + '%)' +
    ' | 지터 X' + jitX.toFixed(2) + 'px Y' + jitY.toFixed(2) + 'px' +
    ' 드리프트 X' + driftX.toFixed(0) + 'px Y' + driftY.toFixed(0) + 'px 역행 ' + back +
    ' | 접지끊김 ' + gndFlips + ' 피치폭 ' + pitchSwing.toFixed(3) +
    ' | ' + verdict;
  console.log('%c' + line, 'color:#00ffcc');
  /* 층과 회전 실림 정보. '타일을 지나갔는데 되돌아온다'가 회전층 기믹
   * 때문인지 아닌지를 이 두 줄로 가릅니다. */
  const layers = {};
  for (const r of rows) layers[r.layer] = (layers[r.layer] || 0) + 1;
  console.log('  층: ' + Object.keys(layers).map((k) => 'L' + k + ' ' + layers[k] + '프레임').join(', ') +
    ' | 회전층 프레임 ' + rotFrames + ' | 바닥이 실어 나른 거리 합계 ' + carrySum.toFixed(2) + '유닛');
  if (worst.length) {
    console.log('  이탈 최악 3프레임 (기대 대비 실제):');
    for (const w of worst) {
      console.log('   · ' + (w.ratio * 100).toFixed(0) + '%' +
        '  dt ' + w.dt.toFixed(2) + 'ms  스텝 ' + w.steps +
        '  alpha ' + (w.alpha !== undefined ? w.alpha.toFixed(3) : '?') +
        '  속도 ' + w.sp.toFixed(1) + '  carry ' + (w.carry || 0).toFixed(3) +
        '  L' + w.layer + (w.rot ? ' (회전층)' : '') + (w.gnd ? '' : ' 공중'));
    }
  }
  toast(verdict, 'cheer');
  runDiag.last = line;
  return line;
}

window.addEventListener('keydown', (e) => {
  if (e.code === 'F3') { e.preventDefault(); startRunDiag(); }
});

function renderFrame(dt, now) {
  /* --- local avatar --- */
  /* 그릴 위치를 먼저 정합니다. 카메라도 이 값을 보므로 아바타보다 앞서야
   * 합니다 — pos 로 카메라를 잡고 render 로 아바타를 그리면 둘이 프레임마다
   * 어긋나 오히려 더 흔들립니다. */
  local.render.copy(local.prev).lerp(local.pos, local.alpha);
  if (local.avatar) {
    local.avatar.group.position.copy(local.render);
    /* 몸통 방향. 프레임률 의존이면 방향을 틀 때마다 몸이 덜컥거립니다 —
     * 위치가 매끄러워도 '덩어리 전체가 끊긴다'로 느껴지는 지점입니다. */
    local.avatar.group.rotation.y = lerpAngle(local.avatar.group.rotation.y, local.ry, smoothK(16, dt));
    const sp = THREE.MathUtils.clamp(Math.hypot(local.vel.x, local.vel.z) / PHYS.SPRINT, 0, 1);
    animateAvatar(local.avatar, dt, sp, local.alive ? local.anim : 'dead');
    local.avatar.group.visible = true;
    updateGroundShadow(local.avatar, local.render.y,
      groundYUnder(local.render.x, local.render.z, local.render.y), local.grounded);
  }

  /* --- remote runners (dead reckoning) --- */
  for (const r of G.players.values()) if (r instanceof RemoteRunner) r.update(dt, now);

  /* --- world --- */
  updateTiles(dt, now);
  updateDebris(dt);
  updateDashTrails(dt);
  updatePaperBits(dt);
  updateFinale(dt);
  updateSearchFx(dt);
  updateDashArrow();
  updateBoosters(dt, now);
  updateObstacles(dt, now);
  updateCamera(dt);
  /* ★ updateCamera 다음입니다 — 그 안에서 applyLayerTransparency 가
   *   층 배율(layerMul)을 갱신하므로, 먼저 부르면 층을 옮긴 프레임에만
   *   한 프레임 묵은 배율로 칠하게 됩니다.                        */
  updateFenceEdge(dt);
  /* 카메라가 정해진 뒤에 재야 합니다 — 이 순서가 아니면 화면 좌표가
   * 한 프레임 전 카메라로 계산되어 측정 자체가 틀립니다. */
  sampleRunDiag(dt);
  updateSky(dt, now);

  updatePedestals(dt, now);
  updateCloudSea(dt, now);
  updateSplash(dt);

  /* --- HUD --- */
  updateLayerStack(local.alive ? local.layer : currentLayerOf(spectateFocus().y));
  updateCountdown();
  updateReadyUI();
  updateActionCooldowns();

  fpsAccum += dt; fpsFrames++;
  if (fpsAccum >= 0.5) {
    dom.vFps.textContent = Math.round(fpsFrames / fpsAccum);
    fpsAccum = 0; fpsFrames = 0;
    updateRoster();
  }
  Interp.slew(dt);

  renderer.render(scene, camera);
}

let frameParity = 0;
function frame() {
  requestAnimationFrame(frame);
  // 화면에 안 보이면 렌더는 건너뜁니다. 물리·전송은 워커 타이머가 맡습니다.
  if (document.hidden) return;
  const s = stepFrameOnce();

  /* ★ 화질 판단은 '화면이 실제로 몇 번 갱신되는가' 를 재야 하므로
   *   프레임 스킵 판정보다 앞에 있어야 합니다.
   *   종전에는 renderFrame 안에 있었습니다. 최소 단계는 한 프레임
   *   걸러 그리므로 거기서 재는 fps 가 30 에 고정되는데, 승격 조건이
   *   58fps 라서 한 번 최소로 내려간 기기는 여유가 생겨도 영영
   *   올라오지 못했습니다. PC 는 최소까지 내려갈 일이 드물어 드러나지
   *   않았지만, 폰은 대개 최소에서 시작하므로 전부 거기 갇힙니다.  */
  Quality.sample(s.dt, s.now);

  /* 최소 단계에서는 한 프레임 걸러 그립니다. stepFrameOnce() 는 건너뛰지
   * 않으므로 물리·입력·서버 전송은 그대로 60Hz 입니다 — 조작감은
   * 유지한 채 그리는 비용만 절반으로 만듭니다.                       */
  if (QLEVELS[Quality.level].skip && (frameParity ^= 1)) return;
  renderFrame(s.dt, s.now);
}

/* ── 백그라운드 틱 ────────────────────────────────────────────────────
 * 비활성 탭에서는 setInterval/setTimeout 도 최소 1000ms 로 묶입니다
 * (크롬은 5분 뒤 더 강하게 조입니다). 20Hz 전송이 1Hz 가 되면 원격
 * 캐릭터가 뚝뚝 끊깁니다. 워커 타이머는 이 제한을 받지 않으므로,
 * 워커에서 틱을 만들어 메인 스레드로 넘깁니다.
 *
 * 워커 파일을 따로 두면 배포 경로가 꼬이므로 Blob 인라인으로 만듭니다.
 *
 * 탭이 보일 때는 반드시 워커 틱을 멈춰야 합니다 — rAF 와 겹치면 물리가
 * 두 배 속도로 돕니다. (onmessage 안에서도 document.hidden 으로 한 번 더
 * 거릅니다. 정지 메시지가 늦게 도착하는 경우를 막기 위해서입니다.)   */
let bgWorker = null;
let bgFallbackTimer = null;

function startBackgroundTicker() {
  if (bgWorker || bgFallbackTimer) return;
  if (typeof Worker === 'undefined') {
    bgFallbackTimer = setInterval(() => { if (document.hidden) stepFrameOnce(); }, 50);
    return;
  }
  try {
    const src = 'let id=null;onmessage=e=>{' +
      'if(e.data==="start"){if(!id)id=setInterval(()=>postMessage(0),33);}' +
      'else if(e.data==="stop"){clearInterval(id);id=null;}};';
    const url = URL.createObjectURL(new Blob([src], { type: 'application/javascript' }));
    bgWorker = new Worker(url);
    URL.revokeObjectURL(url);
    bgWorker.onmessage = () => { if (document.hidden) stepFrameOnce(); };
  } catch (e) {
    // 사내 CSP 등으로 Blob 워커가 막히는 환경이 있습니다. 그때는 1Hz 라도 도는 편이 낫습니다.
    console.warn('[IPG] 워커 타이머 사용 불가 — setInterval 로 대체', e && e.message);
    bgWorker = null;
    bgFallbackTimer = setInterval(() => { if (document.hidden) stepFrameOnce(); }, 50);
  }
}

function syncBackgroundTicker() {
  if (document.hidden) {
    startBackgroundTicker();
    if (bgWorker) bgWorker.postMessage('start');
  } else {
    if (bgWorker) bgWorker.postMessage('stop');
    /* 복귀 튐 방지. 워커 틱과 rAF 사이에 시간이 비어 있을 수 있고,
     * 누적기에 큰 값이 남아 있으면 돌아오자마자 물리가 몰아서 돕니다. */
    lastTime = performance.now();
    accumulator = 0;
  }
}
document.addEventListener('visibilitychange', syncBackgroundTicker);

/* ★ 로드 시점에 한 번 맞춰 줍니다.
 *   종전에는 시작 지점이 visibilitychange 하나뿐이었습니다. 그러면
 *   '숨은 상태로 열린 페이지'에서는 그 이벤트가 영영 안 나므로 워커가
 *   시작되지 않습니다 — 실측으로 document.hidden=true · rAF 0회 ·
 *   bgWorker=null 이었고, 그 상태로 라운드에 들어가면 서버 안전망
 *   (STALE)에 걸려 '통신이 끊겨 탈락' 처리됩니다.
 *   상태를 보고 맞추는 것이지 전환을 기다리는 것이 아니어야 합니다.  */
syncBackgroundTicker();

