    prop: { kind: 'island', colors: [0xb9a2dd, 0xf0b8c8, 0xc9b0e8], count: 22 },
    fog: 0xc49aa2, fogDensity: 0.0028,
    hemiSky: 0xf5d2e4, hemiGround: 0x6a5a94, hemiInt: 0.95,
    keyColor: 0xffdcb0, keyInt: 1.0, rimColor: 0xb98cff, rimInt: 0.5
  }
];

/* ── 하늘 셰이더 ───────────────────────────────────────────────────────
 * 방향 벡터의 높이(y)로 색을 섞습니다. 텍스처가 없으니 확대 개념이 없고,
 * 화면 해상도가 아무리 높아도 픽셀 단위로 계산되어 항상 매끄럽습니다.  */
const SKY_VERT = `
varying vec3 vDir;
void main() {
  vDir = normalize(position);
  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
}
`;

const SKY_FRAG = `
precision highp float;
uniform vec3  uZenith;
uniform vec3  uMid;
uniform vec3  uHorizon;
uniform vec3  uGround;
uniform vec3  uSunColor;
uniform vec3  uSunDir;
uniform float uSunSharp;
uniform float uSunInt;
uniform float uStars;
uniform float uTime;
varying vec3 vDir;

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.yzx + 33.33);
  return fract((p.x + p.y) * p.z);
}

void main() {
  vec3 d = normalize(vDir);
  float h = d.y;
  vec3 col;

  if (h >= 0.0) {
    float t = pow(clamp(h, 0.0, 1.0), 0.62);
    col = mix(uHorizon, uMid, smoothstep(0.0, 0.42, t));
    col = mix(col, uZenith, smoothstep(0.34, 1.0, t));
  } else {
    col = mix(uHorizon, uGround, smoothstep(0.0, 0.40, -h));
  }

  // 태양 주변 광훈. 원반 없이 부드러운 빛무리만 넣어 자연스럽게 만듭니다.
  float sd = max(dot(d, normalize(uSunDir)), 0.0);
  col += uSunColor * uSunInt * pow(sd, uSunSharp) * 1.2;
  col += uSunColor * uSunInt * pow(sd, 6.0) * 0.16;

  // 별 (새벽 맵 전용). 위쪽 하늘에만, 태양 반대편일수록 진하게.
  if (uStars > 0.001 && h > 0.02) {
    vec3 g = floor(d * 260.0);
    float n = hash13(g);
    float star = smoothstep(0.9975, 1.0, n);
    float tw = 0.65 + 0.35 * sin(uTime * 1.7 + n * 100.0);
    float mask = smoothstep(0.02, 0.5, h) * (1.0 - smoothstep(0.0, 0.55, sd));
    col += vec3(1.0, 0.97, 0.92) * star * tw * mask * uStars;
  }

  // 미세 디더링 — 완만한 그라데이션에서 생기는 띠(밴딩)를 없앱니다
  float dither = (hash13(vec3(gl_FragCoord.xy, 1.0)) - 0.5) / 255.0;
  gl_FragColor = vec4(col + dither, 1.0);
}
`;

let skyMesh = null;
let skyUniforms = null;
let cloudGroup = null;
let propGroup = null;
let currentTheme = -1;

function buildSkyDome() {
  skyUniforms = {
    uZenith:   { value: new THREE.Color(0x1f7fd4) },
    uMid:      { value: new THREE.Color(0x4aa8e8) },
    uHorizon:  { value: new THREE.Color(0xa8dcf5) },
    uGround:   { value: new THREE.Color(0x7fc4e6) },
    uSunColor: { value: new THREE.Color(0xfff3c4) },
    uSunDir:   { value: new THREE.Vector3(0.35, 0.42, -0.84) },
    uSunSharp: { value: 220 },
    uSunInt:   { value: 0.55 },
    uStars:    { value: 0.0 },
    uTime:     { value: 0 }
  };
  const mat = new THREE.ShaderMaterial({
    uniforms: skyUniforms,
    vertexShader: SKY_VERT,
    fragmentShader: SKY_FRAG,
    side: THREE.BackSide,
    depthWrite: false,   // 항상 가장 뒤에 그려집니다
    fog: false,          // 안개 영향 없음
    toneMapped: false    // 노출/톤매핑 영향 없음
  });
  const mesh = new THREE.Mesh(new THREE.SphereGeometry(SKY_RADIUS, 32, 24), mat);
  mesh.renderOrder = -1;
  mesh.frustumCulled = false;
  scene.add(mesh);
  return mesh;
}

/* ── 구름 ──────────────────────────────────────────────────────────────
 * 구 여러 개를 뭉쳐 하나의 덩어리로 만듭니다. 전부 InstancedMesh 한 개로
 * 그리므로 드로우콜은 1회입니다.                                        */
function buildClouds(t) {
  const puffGeo = new THREE.IcosahedronGeometry(1, 2);
  const mat = new THREE.MeshStandardMaterial({
    color: t.cloudBase,
    emissive: new THREE.Color(t.cloudTop).multiplyScalar(t.cloudEmissive),
    emissiveIntensity: 1.0,
    roughness: 1.0,
    metalness: 0.0,
    flatShading: false
  });

  const puffsPer = 7;
  const total = t.cloudCount * puffsPer;
  const inst = new THREE.InstancedMesh(puffGeo, mat, total);
  inst.castShadow = false;
  inst.receiveShadow = false;
  inst.frustumCulled = false;

  const m = new THREE.Matrix4();
  const q = new THREE.Quaternion();
  const pos = new THREE.Vector3();
  const scl = new THREE.Vector3();
  let i = 0;

  for (let c = 0; c < t.cloudCount; c++) {
    const ang = (c / t.cloudCount) * Math.PI * 2 + Math.random() * 0.5;
    const dist = 130 + Math.random() * 250;
    const cy = -18 + Math.random() * 96;
    const cx = Math.cos(ang) * dist;
    const cz = Math.sin(ang) * dist;
    const big = 12 + Math.random() * 22;

    for (let p = 0; p < puffsPer; p++) {
      const s = big * (0.45 + Math.random() * 0.7);
      pos.set(
        cx + (Math.random() - 0.5) * big * 2.6,
        cy + (Math.random() - 0.5) * big * 0.5,
        cz + (Math.random() - 0.5) * big * 2.0
      );
      scl.set(s, s * (0.55 + Math.random() * 0.25), s);
      q.setFromEuler(new THREE.Euler(Math.random() * 3, Math.random() * 3, Math.random() * 3));
      m.compose(pos, q, scl);
      inst.setMatrixAt(i++, m);
    }
  }
  inst.instanceMatrix.needsUpdate = true;

  const group = new THREE.Group();
  group.add(inst);
  scene.add(group);
  return group;
}

/* ── 떠다니는 소품 ─────────────────────────────────────────────────────
 * 맵마다 다른 오브젝트를 멀리 띄웁니다. 카메라를 돌릴 때 이것들이
 * 시차를 만들어 "배경이 진짜 3D 공간"처럼 느껴지게 합니다.             */
function buildProps(t) {
  const group = new THREE.Group();
  const cfg = t.prop;

  let geo;
  if (cfg.kind === 'ring')        geo = new THREE.TorusGeometry(1, 0.30, 10, 28);
  else if (cfg.kind === 'island') geo = new THREE.CylinderGeometry(1, 0.62, 0.42, 7);
  else                            geo = new THREE.BoxGeometry(1.4, 1.4, 1.4);

  for (const hex of cfg.colors) {
    const col = new THREE.Color(hex);
    const mat = new THREE.MeshStandardMaterial({
      color: col,
      emissive: col.clone().multiplyScalar(cfg.kind === 'ring' ? 0.85 : 0.30),
      emissiveIntensity: 1.0,
      roughness: cfg.kind === 'ring' ? 0.25 : 0.65,
      metalness: cfg.kind === 'ring' ? 0.35 : 0.05
    });
    const n = Math.round(cfg.count / cfg.colors.length);
    const inst = new THREE.InstancedMesh(geo, mat, n);
    inst.frustumCulled = false;

    const m = new THREE.Matrix4(), q = new THREE.Quaternion();
    const pos = new THREE.Vector3(), scl = new THREE.Vector3();
    for (let i = 0; i < n; i++) {
      const ang = Math.random() * Math.PI * 2;
      const dist = 100 + Math.random() * 240;
      const s = (cfg.kind === 'island' ? 9 : 3) * (0.6 + Math.random() * 1.5);
      pos.set(Math.cos(ang) * dist, -30 + Math.random() * 120, Math.sin(ang) * dist);
      scl.set(s, s, s);
      q.setFromEuler(new THREE.Euler(Math.random() * 3, Math.random() * 3, Math.random() * 3));
      m.compose(pos, q, scl);
      inst.setMatrixAt(i, m);
    }
    inst.instanceMatrix.needsUpdate = true;
    group.add(inst);
  }
  scene.add(group);
  return group;
}

function disposeGroup(g) {
  if (!g) return;
  g.traverse((o) => {
    if (o.geometry) o.geometry.dispose();
    if (o.material) {
      const ms = Array.isArray(o.material) ? o.material : [o.material];
      ms.forEach((mm) => mm.dispose());
    }
  });
  scene.remove(g);
}

/* ★ 배경이 바뀌면 곡도 바뀌어야 합니다. applyTheme 은 init·map_reset·phase
 *   어디서 와도 거치는 길목이라 여기 한 곳만 붙이면 됩니다.
 *   playBgm 은 지금 곡과 같으면 아무것도 하지 않으므로, 맵이 그대로인
 *   호출에서는 비용이 없습니다.                                     */
function applyTheme(index) {
  const i = ((index | 0) % THEMES.length + THEMES.length) % THEMES.length;
  if (currentTheme === i && skyMesh) return;
  const themeChanged = (currentTheme !== i);
  currentTheme = i;
  const t = THEMES[i];

  if (!skyMesh) skyMesh = buildSkyDome();

  skyUniforms.uZenith.value.setHex(t.zenith);
  skyUniforms.uMid.value.setHex(t.mid);
  skyUniforms.uHorizon.value.setHex(t.horizon);
  skyUniforms.uGround.value.setHex(t.ground);
  skyUniforms.uSunColor.value.setHex(t.sunColor);
  skyUniforms.uSunDir.value.set(t.sunDir[0], t.sunDir[1], t.sunDir[2]).normalize();
  skyUniforms.uSunSharp.value = t.sunSharp;
  skyUniforms.uSunInt.value = t.sunInt;
  skyUniforms.uStars.value = t.stars;

  disposeGroup(cloudGroup);
  disposeGroup(propGroup);
  cloudGroup = buildClouds(t);
  propGroup = buildProps(t);
  buildCloudSea(t);

  // 탈락 화면 섬광도 맵 색에 맞춥니다 (빨간 섬광은 하늘 배경과 안 어울립니다)
  dom.deadFlash.style.background =
    'radial-gradient(circle at 50% 60%, transparent 18%, #' +
    new THREE.Color(t.flash).getHexString() + ')';
  bounceLight.color.setHex(t.seaTop);

  /* 안개와 조명을 하늘 색에 맞춰 함께 바꿉니다.
   * 배경만 바꾸면 타일과 캐릭터가 배경에서 붕 떠 보입니다.              */
  scene.fog.color.setHex(t.fog);
  scene.fog.density = t.fogDensity;
  scene.background = new THREE.Color(t.horizon);
  hemiLight.color.setHex(t.hemiSky);
  hemiLight.groundColor.setHex(t.hemiGround);
  hemiLight.intensity = t.hemiInt;
  keyLight.color.setHex(t.keyColor);
  keyLight.intensity = t.keyInt;
  rimLight.color.setHex(t.rimColor);
  rimLight.intensity = t.rimInt;
  // 주광 방향을 하늘의 해 위치와 맞춰 그림자 방향이 어긋나지 않게 합니다
  keyLightDir.set(t.sunDir[0], Math.max(0.35, t.sunDir[1]), t.sunDir[2]).normalize();

  const el = document.getElementById('vMap');
  if (el) el.textContent = t.name;

  console.log('[IPG] 배경 적용: ' + t.name +
    ' · 구름 ' + t.cloudCount + '덩어리 · 소품 ' + t.prop.count + '개 (이미지 파일 불필요)');

  /* 맵이 바뀌었으면 라운드 곡도 그 맵의 것으로. 대기·결과 곡은 맵과
   * 무관하므로 지금 페이즈가 play 일 때만 바꿉니다 — 대기 화면에서
   * 맵이 바뀔 때마다 로비 음악이 끊기면 안 됩니다.                  */
  if (themeChanged && Sound.unlocked && Sound.phaseKey === 'play') {
    Sound.playBgm('play');
  }
}

/* 하늘의 별 반짝임과 구름/소품의 느린 흐름 */
/* ══════════════════════════════════════════════════════════════════════
 * 하늘 균열 (카운트다운 배경 연출)
 * ────────────────────────────────────────────────────────────────────
 * ★ 스카이돔 셰이더를 건드리지 않고 별도 판 하나로 만듭니다.
 *   배경 테마가 3종이고 각자 셰이더 유니폼을 쓰는데, 거기에 균열을
 *   끼워 넣으면 테마를 추가할 때마다 같이 손봐야 합니다. 판 하나면
 *   테마와 무관하게 얹힙니다.
 *
 * ★ 항상 카메라를 향하게 Y축만 돌립니다(빌보드). 균열은 '하늘에 난 틈'
 *   이라 어느 방향에서 보든 정면으로 보여야 하는데, 완전 빌보드로 하면
 *   위아래로도 돌아 지평선과 어긋납니다.
 *
 * ★ 카운트다운에만 보입니다. 대기 내내 떠 있으면 배경이 아니라 소품이
 *   되어 버리고, '곧 시작한다'는 신호로 안 읽힙니다.
 * ══════════════════════════════════════════════════════════════════════ */
let skyRift = null;

function makeRiftTexture() {
  const W = 512, H = 128;
  const cv = document.createElement('canvas');
  cv.width = W; cv.height = H;
  const g = cv.getContext('2d');
  /* 가운데가 가장 밝고 위아래·좌우로 사그라지는 틈. 가장자리를 완전히
   * 0 으로 떨어뜨려야 판의 네모난 경계가 안 보입니다. */
  const grd = g.createLinearGradient(0, 0, 0, H);
  grd.addColorStop(0.00, 'rgba(255,255,255,0)');
  grd.addColorStop(0.42, 'rgba(255,255,255,0.10)');
  grd.addColorStop(0.50, 'rgba(255,255,255,1)');
  grd.addColorStop(0.58, 'rgba(255,255,255,0.10)');
  grd.addColorStop(1.00, 'rgba(255,255,255,0)');
  g.fillStyle = grd;
  g.fillRect(0, 0, W, H);
  /* 좌우 끝을 지웁니다 — 균열은 끝이 뾰족해야 갈라진 것으로 읽힙니다. */
  const fade = g.createLinearGradient(0, 0, W, 0);
  fade.addColorStop(0.00, 'rgba(0,0,0,1)');
  fade.addColorStop(0.18, 'rgba(0,0,0,0)');
  fade.addColorStop(0.82, 'rgba(0,0,0,0)');
  fade.addColorStop(1.00, 'rgba(0,0,0,1)');
  g.globalCompositeOperation = 'destination-out';
  g.fillStyle = fade;
  g.fillRect(0, 0, W, H);
  g.globalCompositeOperation = 'source-over';
  /* 들쭉날쭉한 가지. 매끈한 띠는 '빛줄기'로 보이고, 가지가 있어야 '균열'이 됩니다. */
  g.strokeStyle = 'rgba(255,255,255,0.55)';
  let seed = 20260911;
  const rnd = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };
  for (let i = 0; i < 26; i++) {
    const x = W * (0.2 + rnd() * 0.6);
    const len = 8 + rnd() * 26;
    const dir = rnd() < 0.5 ? -1 : 1;
    g.lineWidth = 0.8 + rnd() * 1.4;
    g.beginPath();
    g.moveTo(x, H / 2);
    g.lineTo(x + (rnd() - 0.5) * 30, H / 2 + dir * len);
    g.stroke();
  }
  const tex = new THREE.CanvasTexture(cv);
  tex.encoding = THREE.sRGBEncoding;
  return tex;
}

function ensureSkyRift() {
  if (skyRift) return skyRift;
  const mat = new THREE.MeshBasicMaterial({
    map: makeRiftTexture(), color: 0xbfe9ff, transparent: true, opacity: 0,
    blending: THREE.AdditiveBlending, side: THREE.DoubleSide,
    depthWrite: false, depthTest: false, toneMapped: false
  });
  skyRift = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), mat);
  skyRift.renderOrder = 3;
  skyRift.visible = false;
  scene.add(skyRift);
  return skyRift;
}

function updateSkyRift(dt) {
  const rift = ensureSkyRift();
  let heat = 0;
  if (G.phase === 'countdown' && G.phaseEndsAt) {
    const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
    heat = THREE.MathUtils.clamp(1 - left / 5000, 0, 1);
  }
  /* 라운드가 막 시작된 직후 잠깐 더 타오르게 둡니다 — 0 에서 바로 꺼지면
   * '열렸다'가 아니라 '사라졌다'로 보입니다. */
  if (G.phase === 'playing' && riftAfterglow > 0) {
    riftAfterglow = Math.max(0, riftAfterglow - dt / 0.9);
    heat = riftAfterglow;
  }
  if (heat <= 0.001) { rift.visible = false; return; }
  rift.visible = true;

  /* 카메라 쪽을 향하되 Y축만 돌립니다. 위치도 카메라 기준이라 어느
   * 발판에 서 있든 같은 크기로 보입니다. */
  const d = 260;
  rift.position.set(
    camera.position.x + Math.sin(cam.yaw) * -d,
    camera.position.y + 95,
    camera.position.z + Math.cos(cam.yaw) * -d
  );
  rift.rotation.set(0, cam.yaw, 0);
  /* 갈라지듯 가로로 먼저 벌어지고, 뒤늦게 두께가 붙습니다. */
  const wide = 120 + heat * 300;
  const tall = 6 + heat * heat * 46;
  rift.scale.set(wide, tall, 1);
  rift.material.opacity = Math.min(0.72, 0.08 + heat * 0.52);
}

let riftAfterglow = 0;

function updateSky(dt, now) {
  updateSkyRift(dt);
  if (skyUniforms) skyUniforms.uTime.value = now * 0.001;
  if (cloudGroup) cloudGroup.rotation.y += dt * 0.0045;
  if (propGroup) {
    propGroup.rotation.y += dt * 0.0075;
    propGroup.children.forEach((c, i) => { c.rotation.x += dt * 0.05 * (i % 2 ? 1 : -1); });
  }
}

/* --- 구름바다 (탈락 구역) ---------------------------------------------- *
 * 배경이 하늘이므로 바닥도 용암이 아니라 구름바다입니다.
 * 1층 아래로 떨어지면 구름을 뚫고 사라지면서 탈락합니다.
 *
 *   · 표면  : 구를 뭉쳐 만든 두꺼운 구름층 (InstancedMesh 1개)
 *   · 안개막: 그 아래를 덮는 반투명 원판. 끝없이 이어지는 느낌을 줍니다
 *   · 색    : 맵 테마에 맞춰 바뀝니다
 * ---------------------------------------------------------------------- */
let seaGroup = null;
let seaPuffs = null;
let seaHaze = null;
let seaBase = [];       // 각 퍼프의 기준 위치 (물결 애니메이션용)

function buildCloudSea(t) {
  disposeGroup(seaGroup);
  seaBase = [];

  const group = new THREE.Group();
  const y = G.seaY;

  /* 구름 표면 */
  const puffGeo = new THREE.IcosahedronGeometry(1, 2);
  const mat = new THREE.MeshStandardMaterial({
    color: t.seaBase,
    emissive: new THREE.Color(t.seaTop).multiplyScalar(t.seaEmissive),
    emissiveIntensity: 1.0,
    roughness: 1.0,
    metalness: 0.0
  });

  const RINGS = [
    { r: 0,   n: 1  }, { r: 12,  n: 8  }, { r: 24, n: 14 },
    { r: 36,  n: 20 }, { r: 50,  n: 26 }, { r: 66, n: 30 },
    { r: 84,  n: 34 }, { r: 104, n: 36 }
  ];
  let total = 0;
  for (const ring of RINGS) total += ring.n;

  const inst = new THREE.InstancedMesh(puffGeo, mat, total);
  inst.frustumCulled = false;
  inst.receiveShadow = true;

  const m = new THREE.Matrix4(), q = new THREE.Quaternion();
  const pos = new THREE.Vector3(), scl = new THREE.Vector3();
  let i = 0;
  for (const ring of RINGS) {
    for (let k = 0; k < ring.n; k++) {
      const a = (k / ring.n) * Math.PI * 2 + (ring.r * 0.13);
      const rr = ring.r + (Math.random() - 0.5) * 9;
      const px = Math.cos(a) * rr;
      const pz = Math.sin(a) * rr;
      const py = y + (Math.random() - 0.5) * 3.2;
      const s = 9 + Math.random() * 9;
      pos.set(px, py, pz);
      scl.set(s, s * (0.5 + Math.random() * 0.22), s);
      q.setFromEuler(new THREE.Euler(Math.random() * 3, Math.random() * 3, Math.random() * 3));
      m.compose(pos, q, scl);
      inst.setMatrixAt(i, m);
      seaBase.push({ x: px, y: py, z: pz, sx: scl.x, sy: scl.y, sz: scl.z,
                     q: q.clone(), phase: Math.random() * 6.28 });
      i++;
    }
  }
  inst.instanceMatrix.needsUpdate = true;
  group.add(inst);
  seaPuffs = inst;

  /* 아래를 덮는 안개막 — 구름 사이로 바닥이 비치지 않게 합니다 */
  const haze = new THREE.Mesh(
    new THREE.CircleGeometry(300, 48),
    new THREE.MeshBasicMaterial({
      color: t.seaHaze, transparent: true, opacity: 0.92,
      depthWrite: false, toneMapped: false, side: THREE.DoubleSide
    })
  );
  haze.rotation.x = -Math.PI / 2;
  haze.position.y = y - 7;
  group.add(haze);
  seaHaze = haze;

  scene.add(group);
  seaGroup = group;
  return group;
}

/* 구름바다가 아주 천천히 일렁입니다 */
/* 구름바다 갱신 작업용. 매 프레임 새로 만들지 않습니다. */
const _seaM = new THREE.Matrix4();
const _seaP = new THREE.Vector3();
const _seaS = new THREE.Vector3();

function updateCloudSea(dt, now) {
  if (!seaPuffs) return;
  const m = _seaM, p = _seaP, s = _seaS;
  const t = now * 0.00035;
  for (let i = 0; i < seaBase.length; i++) {
    const b = seaBase[i];
    p.set(b.x, b.y + Math.sin(t + b.phase) * 1.15, b.z);
    s.set(b.sx, b.sy, b.sz);
    m.compose(p, b.q, s);
    seaPuffs.setMatrixAt(i, m);
  }
  seaPuffs.instanceMatrix.needsUpdate = true;
  seaGroup.rotation.y += dt * 0.006;
}

/* ── 낙하 연출 ─────────────────────────────────────────────────────────
 * 구름을 뚫고 들어가는 순간 퍼프가 사방으로 터집니다.
 * 탈락한 본인뿐 아니라 다른 사람이 떨어질 때도 보입니다.              */
const splashPuffs = [];
const splashGeo = new THREE.IcosahedronGeometry(1, 1);

function spawnSeaSplash(x, z, colorHex) {
  const col = new THREE.Color(colorHex);
  for (let i = 0; i < 14; i++) {
    const mat = new THREE.MeshBasicMaterial({
      color: col, transparent: true, opacity: 0.95, toneMapped: false, depthWrite: false
    });
    const mesh = new THREE.Mesh(splashGeo, mat);
    const a = Math.random() * Math.PI * 2;
    const r = Math.random() * 3;
    mesh.position.set(x + Math.cos(a) * r, G.seaY + 1 + Math.random() * 2, z + Math.sin(a) * r);
    const s = 1.6 + Math.random() * 2.6;
    mesh.scale.setScalar(s);
    fxGroup.add(mesh);
    splashPuffs.push({
      mesh, mat,
      vel: new THREE.Vector3(Math.cos(a) * (5 + Math.random() * 9),
                             5 + Math.random() * 9,
                             Math.sin(a) * (5 + Math.random() * 9)),
      life: 1.5, max: 1.5, grow: 1 + Math.random() * 1.6
    });
  }
  if (splashPuffs.length > 90) {
    const old = splashPuffs.splice(0, splashPuffs.length - 90);
    old.forEach((d) => { fxGroup.remove(d.mesh); d.mat.dispose(); });
  }
}

function updateSplash(dt) {
  for (let i = splashPuffs.length - 1; i >= 0; i--) {
    const d = splashPuffs[i];
    d.life -= dt;
    if (d.life <= 0) {
      fxGroup.remove(d.mesh); d.mat.dispose(); splashPuffs.splice(i, 1); continue;
    }
    const k = 1 - d.life / d.max;
    d.vel.y -= 14 * dt;
    d.mesh.position.addScaledVector(d.vel, dt);
    d.mesh.scale.setScalar((1.6 + k * d.grow * 3.2));
    d.mat.opacity = 0.95 * (1 - k) * (1 - k);
  }
}

/* ============================ 4. map building ========================== */

/* ── 타일 종류별 겉모습 ───────────────────────────────────────────────
 * 4종이 한눈에 갈려야 하므로 '무엇으로' 구분되는지를 종류마다 다르게 잡았습니다.
 *
 *   normal     층 색을 흰색 쪽으로 많이 섞어 옅게. 바닥의 대부분이라 차분하게.
 *   fragile    짙은 적갈색 고정 — 밟으면 0.2초 만에 꺼지므로 층과 무관한 경고색.
 *   reinforced 황동 금속색 고정 + 두꺼움 — 층과 무관하게 '단단한 것'으로 읽힙니다.
 *   special    층 색 원색 + 강한 발광 — 층마다 색이 달라 층 정체성을 드러냅니다.
 *
 * 결과적으로 같은 층에서 normal(옅음) 과 special(진함) 은 밝기로 갈리고,
 * fragile / reinforced 는 어느 층에 있든 항상 같은 색입니다.
 *
 *   mix           : 층 색을 흰색 쪽으로 섞는 비율 (color 가 있으면 무시)
 *   color         : 층과 무관한 고정 색
 *   emissiveColor : 발광 색 (없으면 본체 색과 같음)
 *   thick         : 타일 두께 배율. 물리 판정은 항상 hexThick 기준이라
 *                   두껍게 해도 착지 높이는 변하지 않습니다(윗면만 살짝 도톰).
 * ------------------------------------------------------------------ */
const TILE_STYLE = {
  normal:     { mix: 0.62,                                    emissive: 0.14, rough: 0.62, metal: 0.18, thick: 1.00 },
  fragile:    { color: 0x6b0d12, emissiveColor: 0x330000,     emissive: 0.50, rough: 0.85, metal: 0.10, thick: 1.15 },
  /* ★ 강화 타일이 '바닥 그 자체'가 되면서 겉모습을 일반 타일과 같게
   *   맞췄습니다 (종전: 황동 고정색 0xc9a227 + 두께 1.28).
   *
   *   종전에는 전체의 10% 라 '층과 무관하게 단단한 것'으로 튀어 보이는
   *   편이 좋았습니다. 그런데 이 타일이 바닥의 80% 가 되면 다섯 층이
   *   전부 황금색 바닥이 되어 층 색(민트/보라/파랑/주황/자주)이 통째로
   *   사라집니다. 층 정체성이 색으로 읽히는 게임이라 치명적입니다.
   *
   *   그래서 '이 타일이 2회 밟기'라는 정보는 색이 아니라 균열이 전담합니다.
   *   밟기 전에는 층 색 그대로, 밟고 나면 회색으로 죽으면서 금이 갑니다 —
   *   상태가 바뀐 것만 눈에 띄면 되고, 밟기 전부터 튈 이유는 없습니다.
   *
   *   TILE_MIX 를 4종으로 되돌린다면 이 줄도 같이 되돌리세요.       */
  reinforced: { mix: 0.62,                                    emissive: 0.14, rough: 0.62, metal: 0.18, thick: 1.00 },
  special:    { mix: 0.00,                                    emissive: 0.85, rough: 0.30, metal: 0.45, thick: 1.08 }
};
/* ── 특수 타일 세부 종류별 색 덮어쓰기 ───────────────────────────────
 * TILE_STYLE 은 '종류(kind)' 단위라 special 안에서 갈리는 것들은 여기서
 * 따로 정합니다. 점프 타일은 한 층/두 층이 한눈에 갈려야 하므로 색상
 * 자체를 멀리 떨어뜨렸습니다 (청록 vs 자홍).
 * 키는 specialType 이므로 층 번호와 무관합니다 — 아이디어 층이 어디로
 * 가든 그대로 따라옵니다.                                            */
const SPECIAL_TYPE_STYLE = {
  jump1: { color: 0x00e5ff, emissiveColor: 0x0090b8, emissive: 0.9 },   // 한 층 위
  jump2: { color: 0xff00c8, emissiveColor: 0xa0007e, emissive: 1.1 }    // 두 층 위
};

const WHITE_C = new THREE.Color(0xffffff);

/* 두께가 종류마다 다르므로 지오메트리도 두께별로 하나씩 만들어 공유합니다.
 * (종전에는 hexGeo / trapGeo 두 개였습니다)                            */
let hexGeos = null;   // '1.00' 같은 두께 키 -> CylinderGeometry
let geoHexSize = 0;   // 공유 지오메트리를 만든 시점의 타일 크기 (달라지면 재생성)

/* ── 타일 테두리 (베벨) ───────────────────────────────────────────────
 *
 * ★ 왜 색이 아니라 테두리로 푸는가
 *   타일과 배경이 안 구분된다는 문제를 색으로 풀려고 하면 막힙니다.
 *   층 색 여섯 개가 명도 대역을 넓게 덮고 있어서, 배경을 어떤 밝기로
 *   잡아도 그중 한 층은 반드시 배경과 같은 밝기가 됩니다. 실제로
 *   지평선 색을 아무리 어둡게 해도 최악 WCAG 대비가 2.6 을 못 넘었습니다
 *   (권장치 3.0). 타일을 어둡게 해도 마찬가지였습니다 — mix 를 0.62 에서
 *   0.28 까지 내려도 최악값이 1.00 → 1.03 이었습니다.
 *
 *   테두리는 명도와 무관하게 작동합니다. 타일과 배경의 밝기가 같아도
 *   경계선 하나가 있으면 형태가 읽힙니다.
 *
 * ★ 정점 색(vertex color)으로 하는 이유
 *   텍스처(map)로 하면 원통의 옆면과 윗면이 UV 를 공유해서, 윗면에 맞춘
 *   그림이 옆면에서는 엉뚱하게 늘어납니다. 재질을 셋으로 쪼개면(옆·위·아래)
 *   해결되지만 드로우콜이 세 배가 됩니다(560 → 1,600대).
 *   정점 색은 지오메트리에 한 번만 칠하면 되고, 타일 1,626장이 지오메트리
 *   하나를 공유하므로 <b>추가 비용이 0</b> 입니다.
 *
 * ★ 윗면은 부드러운 음영, 옆면은 균일하게 어둡게
 *   육각 윗면은 정점이 '중심 하나 + 가장자리 여섯'뿐이라 그 사이가 선형
 *   보간됩니다. 그래서 윗면은 날카로운 테두리선이 아니라 가운데가 밝고
 *   가장자리로 갈수록 어두워지는 음영이 됩니다 — 타일끼리의 이음매가
 *   드러나는 데는 이걸로 충분합니다.
 *   정작 중요한 것은 옆면입니다. 아레나 가장자리와 구멍 둘레에서 하늘과
 *   맞닿는 면이 옆면이라, 여기가 어두워야 실루엣이 생깁니다.
 *
 *   윗면에 또렷한 테두리선이 필요하면 캡에 링 하나를 더 넣은 지오메트리를
 *   직접 만들어야 합니다(CylinderGeometry 로는 불가). 지금은 비용 대비
 *   효과가 낮다고 보고 두었습니다.
 * ------------------------------------------------------------------ */
const EDGE_RIM  = 0.44;   // 윗면 가장자리 밝기 (중앙이 1.0)
const EDGE_SIDE = 0.34;   // 옆면 밝기 — 실루엣을 만드는 값

function paintTileEdges(geo) {
  const pos = geo.attributes.position;
  const nrm = geo.attributes.normal;
  const n = pos.count;
  let maxR = 0;
  for (let i = 0; i < n; i++) maxR = Math.max(maxR, Math.hypot(pos.getX(i), pos.getZ(i)));
  if (!(maxR > 0)) return;
  const col = new Float32Array(n * 3);
  for (let i = 0; i < n; i++) {
    /* 법선이 위아래를 보면 윗면/아랫면, 아니면 옆면입니다.
     * 위치만으로는 가릴 수 없습니다 — 윗면 가장자리와 옆면 위 끝이
     * 같은 반지름이라 한 덩어리로 묶여 버립니다. */
    const cap = Math.abs(nrm.getY(i)) > 0.5;
    const r = Math.hypot(pos.getX(i), pos.getZ(i)) / maxR;
    const k = cap ? (1 - (1 - EDGE_RIM) * r) : EDGE_SIDE;
    col[i * 3] = col[i * 3 + 1] = col[i * 3 + 2] = k;
  }
  geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
}

function tileGeoFor(thick) {
  const key = thick.toFixed(2);
  let g = hexGeos.get(key);
  if (g) return g;
  /* thetaStart = π/6 이 핵심입니다.
   * CylinderGeometry(…, 6) 은 꼭짓점이 ±Z 를 향하는 pointy-top 육각형을
   * 만드는데, 우리 좌표계(axialToWorld)는 flat-top 을 전제합니다.
   * 30도를 돌려주지 않으면 메시가 이웃 간격보다 커져 반드시 겹칩니다.
   * 0.985 는 타일 사이에 머리카락 굵기의 이음선을 남기기 위한 값입니다. */
  g = new THREE.CylinderGeometry(
    G.hexSize * 0.985, G.hexSize * 0.94, G.hexThick * thick, 6, 1, false, HEX_THETA, Math.PI * 2);
  /* 테두리 음영을 정점 색으로 구워 둡니다. 지오메트리는 두께별로 하나씩
   * 공유되므로 여기서 한 번만 칠하면 그 두께의 타일 전부에 적용됩니다. */
  paintTileEdges(g);
  hexGeos.set(key, g);
  return g;
}

/* ══════════════════════════════════════════════════════════════════════
 * 타일 인스턴싱
 * ────────────────────────────────────────────────────────────────────
 * 타일 1,626장을 개별 메시로 그리면 드로우콜이 500개를 넘습니다.
 * 실측: 프레임 6.3ms 중 4.6ms 가 타일이었고, 픽셀비를 2 → 0.65 로
 * 낮춰도(픽셀 9.6배 감소) 4.66 → 4.28ms 로 8%만 줄었습니다.
 * 즉 이 비용은 GPU 가 칠하는 값이 아니라 CPU 가 드로우콜을 밀어 넣는
 * 값입니다. 그래서 적응형 품질(픽셀비)로는 건드릴 수 없고, 사무용 PC
 * 처럼 CPU 가 느린 기기에서 그대로 예산을 넘깁니다.
 *
 * 인스턴싱하면 드로우콜 546 → 42, 프레임 6.3 → 1.7ms 입니다(실측).
 *
 * ★ 이 구조가 성립하는 근거
 *   고유 지오메트리가 2종(두께별)뿐이고, 재질 파라미터도 4종뿐입니다.
 *   나머지 1,626개의 차이는 전부 '색'이라 인스턴스 속성으로 내려갑니다.
 *
 * ★ 타일마다 다른 값 세 가지를 인스턴스 속성으로 내려보냅니다
 *   color    : InstancedMesh 기본 기능(instanceColor)
 *   alpha    : r128 에 없습니다 — iAlpha 속성 + onBeforeCompile 로 주입
 *   emissive : 경고 점멸·거절 카운트다운·점프 타일이 전부 타일마다
 *              발광을 따로 움직이므로 이것도 인스턴스 속성이어야 합니다
 *              (세기를 색에 미리 곱해 vec3 하나로 보냅니다)
 *
 * ★ 무너지는 타일만 진짜 메시로 빼냅니다(promote)
 *   붕괴 연출은 회전 + 반투명이 동시에 걸립니다. 한 InstancedMesh 안의
 *   인스턴스들은 깊이 정렬이 되지 않아 반투명이 겹치면 순서가 틀어질 수
 *   있습니다. 동시에 무너지는 타일은 많아야 수십 장이라 드로우콜 부담이
 *   없고, 기존 붕괴 코드(mesh.rotation/scale/position)를 한 줄도 고치지
 *   않고 그대로 쓸 수 있습니다.
 *
 * ★ rec.mesh 는 Object3D 입니다 (렌더되지 않는 변형 상자)
 *   기존 코드가 rec.mesh.position.y / scale / visible 을 직접 쓰기
 *   때문에, 그 호출부를 전부 고치는 대신 변형을 담는 빈 객체로 둡니다.
 *   씬에는 넣지 않습니다 — 1,626개를 씬 그래프에 매달면 three.js 가
 *   매 프레임 전부 순회하므로 인스턴싱으로 아낀 것을 도로 까먹습니다.
 * ══════════════════════════════════════════════════════════════════ */

/* 타일 재질 대역 객체. THREE.Material 이 아니라 값만 담는 상자입니다.
 * 기존 코드가 rec.mat.color / emissive / emissiveIntensity / opacity 를
 * 그대로 쓰므로 인터페이스를 맞춥니다.                               */
function makeTileMat(color, emissive, glow) {
  return {
    color: color.clone(),
    emissive: emissive.clone(),
    emissiveIntensity: glow,
    opacity: 1,
    needsUpdate: false,          // 호출부 호환용 — 인스턴싱에서는 의미 없음
    dispose() {}                 // 호출부 호환용
  };
}

const TileInst = {
  groups: [],                    // { mesh, recs, alpha, emis, parent }
  byKey: new Map(),
  pending: [],
  ready: false,

  reset() {
    for (const g of this.groups) {
      if (g.mesh.parent) g.mesh.parent.remove(g.mesh);
      g.mesh.geometry.dispose();
      g.mesh.material.dispose();
      g.mesh.dispose();
    }
    this.groups.length = 0;
    this.byKey.clear();
    this.pending.length = 0;
    this.ready = false;
  },

  /* 타일을 만들 때마다 부릅니다. 실제 InstancedMesh 는 전부 모은 뒤
   * build() 에서 한 번에 만듭니다 — 개수를 미리 알아야 하기 때문입니다. */
  register(rec, geo, st, parent) {
    const key = [parent.uuid, geo.uuid, st.rough, st.metal].join('|');
    let b = this.byKey.get(key);
    if (!b) { b = { key, geo, st, parent, recs: [] }; this.byKey.set(key, b); this.pending.push(b); }
    rec.instKey = key;
    rec.instIdx = b.recs.length;
    b.recs.push(rec);
  },

  build() {
    for (const b of this.pending) {
      const n = b.recs.length;
      /* 지오메트리는 두께별로 공유되고 있습니다. 인스턴스 속성을 원본에
       * 붙이면 다른 묶음까지 오염되므로 묶음마다 복제합니다.         */
      const geo = b.geo.clone();
      const alpha = new THREE.InstancedBufferAttribute(new Float32Array(n).fill(1), 1);
      const emis = new THREE.InstancedBufferAttribute(new Float32Array(n * 3), 3);
      /* ★ setUsage 는 첫 업로드 '전에' 불러야 합니다. 나중에 부르면 이미
       *   만들어진 GL 버퍼에 반영되지 않아 매 프레임 버퍼가 재할당됩니다. */
      alpha.setUsage(THREE.DynamicDrawUsage);
      emis.setUsage(THREE.DynamicDrawUsage);
      geo.setAttribute('iAlpha', alpha);
      geo.setAttribute('iEmissive', emis);

      const mat = new THREE.MeshStandardMaterial({
        color: 0xffffff, emissive: 0xffffff, emissiveIntensity: 1,
        roughness: b.st.rough, metalness: b.st.metal,
        transparent: true, opacity: 1, vertexColors: true
      });
      if (TEX.road) mat.map = TEX.road;
      mat.onBeforeCompile = (sh) => {
        sh.vertexShader = 'attribute float iAlpha;\nattribute vec3 iEmissive;\n' +
          'varying float vIAlpha;\nvarying vec3 vIEmissive;\n' +
          sh.vertexShader.replace('void main() {',
            'void main() {\n  vIAlpha = iAlpha;\n  vIEmissive = iEmissive;');
        sh.fragmentShader = 'varying float vIAlpha;\nvarying vec3 vIEmissive;\n' +
          sh.fragmentShader
            .replace('#include <emissivemap_fragment>',
                     '#include <emissivemap_fragment>\n  totalEmissiveRadiance = vIEmissive;')
            .replace('#include <dithering_fragment>',
                     '#include <dithering_fragment>\n  gl_FragColor.a *= vIAlpha;');
      };
      /* 셰이더를 고쳤으므로 캐시 키를 따로 줍니다. 안 주면 three.js 가
       * 같은 파라미터의 보통 재질과 프로그램을 공유해 주입이 사라집니다. */
      mat.customProgramCacheKey = () => 'ipgTile';

      const im = new THREE.InstancedMesh(geo, mat, n);
      im.receiveShadow = true;
      im.castShadow = false;
      im.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
      /* 인스턴스 단위 프러스텀 컬링은 불가능합니다. 묶음 전체가 화면 밖일
       * 때만 걸러지므로, 경계구를 넉넉히 잡아 잘못 잘리지 않게 합니다.  */
      im.frustumCulled = false;
      im.renderOrder = 0;
      b.recs.forEach((r, i) => im.setColorAt(i, r.mat.color));
      im.instanceColor.setUsage(THREE.DynamicDrawUsage);
      b.parent.add(im);
      this.groups.push({ mesh: im, recs: b.recs, alpha, emis, parent: b.parent });
    }
    this.pending.length = 0;
    this.byKey.clear();
    this.ready = true;
    this.sync();
  },

  groupOf(rec) {
    for (const g of this.groups) if (g.recs[rec.instIdx] === rec) return g;
    return null;
  },

  /* 매 프레임 끝에서 한 번. 변형·색·발광·투명도를 버퍼로 올립니다. */
  sync() {
    if (!this.ready) return;
    for (const g of this.groups) {
      const recs = g.recs, im = g.mesh, aArr = g.alpha.array, eArr = g.emis.array;
      for (let i = 0; i < recs.length; i++) {
        const r = recs[i];
        if (r.liveMesh) {                     // 무너지는 중 — 진짜 메시가 그립니다
          _tiZero.makeScale(0, 0, 0);
          im.setMatrixAt(i, _tiZero);
          aArr[i] = 0;
          continue;
        }
        const o = r.mesh;
        if (!o.visible) {
          /* 투명도 0 으로만 두면 래스터라이즈는 그대로 일어납니다.
           * 크기를 0 으로 눌러 아예 화소를 만들지 않게 합니다.       */
          _tiZero.makeScale(0, 0, 0);
          im.setMatrixAt(i, _tiZero);
          aArr[i] = 0;
          continue;
        }
        o.updateMatrix();                     // 씬 그래프 밖이라 직접 갱신
        im.setMatrixAt(i, o.matrix);
        im.setColorAt(i, r.mat.color);
        aArr[i] = r.mat.opacity;
        const e = r.mat.emissive, k = r.mat.emissiveIntensity;
        eArr[i * 3] = e.r * k; eArr[i * 3 + 1] = e.g * k; eArr[i * 3 + 2] = e.b * k;
      }
      im.instanceMatrix.needsUpdate = true;
      im.instanceColor.needsUpdate = true;
      g.alpha.needsUpdate = true;
      g.emis.needsUpdate = true;
    }
  },

  /* 무너지기 시작 — 진짜 메시로 승격시킵니다. */
  promote(rec) {
    if (rec.liveMesh || !this.ready) return;
    const g = this.groupOf(rec);
    if (!g) return;
    const src = g.mesh;
    const mat = new THREE.MeshStandardMaterial({
      color: rec.mat.color.clone(), emissive: rec.mat.emissive.clone(),
      emissiveIntensity: rec.mat.emissiveIntensity,
      roughness: src.material.roughness, metalness: src.material.metalness,
      transparent: true, opacity: rec.mat.opacity, vertexColors: true
    });
    if (TEX.road) mat.map = TEX.road;
    const m = new THREE.Mesh(rec.instGeo, mat);
    m.receiveShadow = true; m.castShadow = false;
    m.position.copy(rec.mesh.position);
    m.rotation.copy(rec.mesh.rotation);
    m.scale.copy(rec.mesh.scale);
    g.parent.add(m);
    rec.liveMesh = m;
  },

  /* 붕괴가 끝났거나 타일이 되살아났습니다 — 진짜 메시를 거둡니다. */
  demote(rec) {
    if (!rec.liveMesh) return;
    const m = rec.liveMesh;
    if (m.parent) m.parent.remove(m);
    m.material.dispose();
    rec.liveMesh = null;
  },

  /* 승격된 타일은 인스턴스가 아니라 이 메시가 그리므로, 매 프레임
   * 변형과 색을 옮겨 줍니다. 기존 붕괴 코드는 rec.mesh/rec.mat 만
   * 건드리면 되고 여기 존재를 몰라도 됩니다.                        */
  syncLive(rec) {
    const m = rec.liveMesh;
    if (!m) return;
    m.visible = rec.mesh.visible;
    m.position.copy(rec.mesh.position);
    m.rotation.copy(rec.mesh.rotation);
    m.scale.copy(rec.mesh.scale);
    m.material.color.copy(rec.mat.color);
    m.material.emissive.copy(rec.mat.emissive);
    m.material.emissiveIntensity = rec.mat.emissiveIntensity;
    m.material.opacity = rec.mat.opacity;
  },

  stats() {
    let live = 0;
    for (const r of G.tiles.values()) if (r.liveMesh) live++;
    return { 묶음: this.groups.length, 인스턴스: this.groups.reduce((a, g) => a + g.recs.length, 0), 개별: live };
  }
};
const _tiZero = new THREE.Matrix4();

/** 층 번호로 층 색을 꺼냅니다. 없는 층이면 흰색. */
function layerColorOf(layerIndex) {
  const c = G.layerColor[layerIndex];
  return c === undefined ? 0xffffff : c;
}

/** 층 번호 → 층 이름. 서버 config.LAYERS 가 유일한 출처입니다. */
function layerNameOf(layerIndex) {
  const L = (G.cfg && G.cfg.LAYERS || []).find((x) => x.index === layerIndex);
  return L ? L.name : '';
}

/** 이 층에 그 특성이 걸려 있는가 (지금 발동 중인지가 아니라 '자격'). */
function isLayerTrait(layerIndex, trait) {
  const L = (G.cfg && G.cfg.LAYERS || []).find((x) => x.index === layerIndex);
  return !!L && L.trait === trait;
}

/** 육각 이웃 중심거리 = 1칸. 시야 반경을 칸에서 월드 단위로 바꿀 때 씁니다. */
function tileStepUnit() {
  return Math.sqrt(3) * (G.hexSize || 3.2 / 1.5);
}

/* ══════════════════════════════════════════════════════════════════════
 * 층 회전 (trait:'rotate')
 * ────────────────────────────────────────────────────────────────────
 * 회전 상태의 유일한 출처는 서버입니다. 서버가 (epoch, baseAngle, dir) 를
 * 주면 우리는 같은 공식으로 매 프레임 각도를 계산합니다 — 각도를 20Hz 로
 * 받아 쓰면 초당 20번만 갱신돼 층이 끊겨 보입니다.
 *
 *     θ(t) = baseAngle + dir × speed × (t − epoch)/1000
 *
 * 시각은 서버 시각 기준이므로 RTT 보정값(G.serverOffset)을 더해 씁니다.
 * 그래도 어긋날 수 있어 20Hz 스냅샷의 rt 로 검산합니다(위상 타일과 동일).
 *
 * 회전 중심은 월드 원점(0,0)입니다 — 맵이 원점 둘레의 육각 링이라 그렇습니다.
 * ══════════════════════════════════════════════════════════════════ */

/* 내 계산과 서버 각도가 이만큼(rad) 넘게 벌어지면 서버 값으로 넘어갑니다.
 * 0.03 rad ≈ 1.7°. 시계 지터 수십 ms × 각속도(0.12)보다는 넉넉하고,
 * 눈에 띄는 어긋남보다는 작습니다.                                    */
const ROT_TRUST_EPS = 0.03;

/** 지금 회전 각도(rad). 회전층이 없거나 라운드 밖이면 0. */
function rotationAngleNow() {
  const s = G.traits.rotate;
  if (!s || !s.epoch) return 0;
  const now = Date.now() + G.serverOffset;
  return s.baseAngle + s.dir * s.speed * (now - s.epoch) / 1000;
}

/* ══════════════════════════════════════════════════════════════════════
 * 아레나 난간 (장외 추락 방지)
 * ────────────────────────────────────────────────────────────────────
 * ★ 경계는 원이 아니라 육각형입니다.
 *   맵은 육각 그리드라 바깥 윤곽도 육각형입니다. 원으로 막으면 둘 중
 *   하나가 됩니다 — 외접원으로 잡으면 육각형의 '평평한 변' 쪽에서 타일
 *   바깥 허공까지 걸어 나갈 수 있고, 내접원으로 잡으면 여섯 모서리의
 *   타일에 아예 못 갑니다. 둘 다 틀립니다.
 *
 * ★ 아레나 육각형은 타일 한 장과 30도 어긋나 있습니다.
 *   타일의 이웃 방향(HEX_DIRS)이 30·90·150… 도인데 아레나는 그 방향으로
 *   뻗으므로, 아레나의 '모서리'가 타일의 '변 중점' 방향에 놓입니다.
 *   그래서 아레나 판정에는 타일용 pointInXZ 를 그대로 쓸 수 없습니다.
 *
 * ★ 판정은 '변 법선 3개'로 합니다.
 *   정육각형은 마주보는 변이 평행하므로 법선이 3개뿐입니다(0·60·120도).
 *   각 법선에 투영한 절댓값이 내접반지름(√3/2·R) 이하이면 안쪽입니다.
 *   변마다 따로 검사하는 것보다 짧고, 되밀어내기도 같은 식으로 됩니다.
 * ══════════════════════════════════════════════════════════════════════ */

/* 아레나 육각형의 변 법선 3개 (x, z). 60도 간격이면 충분합니다.
 *
 * ★ 여기서 SQRT3_2 를 쓰면 안 됩니다. 그 상수는 이 파일 아래쪽(타일 구역)
 *   에서 const 로 선언되는데, 이 배열은 모듈이 평가되는 순간 값을 읽으므로
 *   TDZ 에 걸려 'Cannot access before initialization' 으로 페이지 전체가
 *   죽습니다. 함수 안이었다면 호이스팅 덕에 괜찮았겠지만 여기는 최상위
 *   초기화식이라 순서가 그대로 드러납니다. 그래서 숫자를 직접 씁니다. */
const ARENA_SQ32 = Math.sqrt(3) / 2;          // 0.8660254
const ARENA_N = [
  { x: 1, z: 0 },
  { x: 0.5, z: ARENA_SQ32 },
  { x: -0.5, z: ARENA_SQ32 }
];

/** 이 점이 놓이는 아레나 육각형의 외접원 반지름. 클수록 바깥입니다. */
function arenaHexR(x, z) {
  let m = 0;
  for (const n of ARENA_N) m = Math.max(m, Math.abs(x * n.x + z * n.z));
  return m / ARENA_SQ32;
}

/**
 * 주자를 아레나 안으로 되밀어냅니다. 벽을 따라 미끄러지듯 멈춥니다.
 *
 * ★ 회전층에서는 층 로컬 좌표로 바꿔서 판정합니다.
 *   난간은 층과 함께 도는데 판정만 고정 육각형으로 하면, 층이 30도쯤
 *   돌았을 때 눈에 보이는 난간과 실제로 막히는 선이 어긋납니다.
 *   착지 판정(findLanding)이 toLayerFrame 을 쓰는 것과 같은 이유입니다.
 *
 * ★ 세 법선을 두 번 훑습니다. 모서리 근처에서는 한 법선을 밀어내면 다른
 *   법선을 넘을 수 있어서, 한 번만 돌면 모서리 바깥에 남는 경우가 있습니다.
 */
function clampToArena() {
  const R = G.clampR;
  if (!R) return;
  /* clampR 은 이미 '주자 중심이 설 수 있는' 한계입니다. 착지 판정
   * (findLanding)이 중심 한 점만 보므로 몸 반폭을 또 빼면 안 됩니다 —
   * 빼면 끝 타일에 아예 못 올라섭니다. */
  const lim = R * ARENA_SQ32;                    // 법선 투영 기준(내접반지름)
  const layer = local.grounded ? local.layer : currentLayerOf(local.pos.y);
  const a = layerAngleOf(layer);
  const ca = Math.cos(-a), sa = Math.sin(-a);
  /* 층 로컬로 */
  let px = a ? local.pos.x * ca - local.pos.z * sa : local.pos.x;
  let pz = a ? local.pos.x * sa + local.pos.z * ca : local.pos.z;
  let vx = a ? local.vel.x * ca - local.vel.z * sa : local.vel.x;
  let vz = a ? local.vel.x * sa + local.vel.z * ca : local.vel.z;

  let hit = false;
  for (let pass = 0; pass < 2; pass++) {
    for (const n of ARENA_N) {
      const d = px * n.x + pz * n.z;
      const over = Math.abs(d) - lim;
      if (over <= 0) continue;
      const sgn = d > 0 ? 1 : -1;
      px -= n.x * over * sgn;
      pz -= n.z * over * sgn;
      /* 바깥으로 향하는 속도 성분만 깎습니다. 전부 0 으로 만들면 난간을
       * 따라 옆으로 달리는 것까지 멈춰 벽에 붙어 버립니다. */
      const vn = vx * n.x + vz * n.z;
      if (vn * sgn > 0) { vx -= n.x * vn; vz -= n.z * vn; }
      hit = true;
    }
  }
  if (!hit) return;

  /* 월드로 되돌리기 (+a 회전) */
  const cb = Math.cos(a), sb = Math.sin(a);
  local.pos.x = a ? px * cb - pz * sb : px;
  local.pos.z = a ? px * sb + pz * cb : pz;
  local.vel.x = a ? vx * cb - vz * sb : vx;
  local.vel.z = a ? vx * sb + vz * cb : vz;
}

/**
 * 이 층이 회전하는가. 층 번호가 아니라 trait 로만 판정합니다.
 *
 * ★ 서버 config(LAYERS[].trait)를 봅니다 — 런타임 이벤트 상태가 아닙니다.
 *   종전에는 G.traits.rotate.layers(= layer_event 로 채워지는 배열)를
 *   봤는데, 그 배열은 라운드가 시작되고 예열(25초)이 지나 첫 회전 이벤트가
 *   와야 채워집니다. 그런데 이 함수의 가장 중요한 호출부인 groupForLayer 는
 *   buildMap 안에서, 즉 init 을 받은 '그 순간' 실행됩니다.
 *
 *   결과: 접속 후 첫 라운드에서는 회전층 타일이 전부 tileGroup(고정)으로
 *   들어가 버리고 다시 옮겨지지 않았습니다. rotGroup 은 텅 빈 채로 돌아
 *   타일이 눈에 보이게 돌지 않았습니다. 반면 주자를 실어 돌리는 계산과
 *   착지 판정은 씬 그래프가 아니라 toLayerFrame(질의점을 −θ 회전)으로
 *   하므로 정상 동작했습니다 — 그래서 '타일은 가만히 있는데 나만 미끄러지는'
 *   증상이 됐습니다. 2라운드부터는 map_reset 시점에 직전 라운드 값이 남아
 *   있어 정상이라, 재현이 들쭉날쭉해 찾기 어려운 버그였습니다.
 *
 *   어느 층이 회전하는지는 LAYER_DEFS 로 고정된 정적 정보입니다. 이벤트가
 *   나르는 것은 '지금 몇 도인가'(epoch·baseAngle·dir)뿐이므로, 소속 판정은
 *   config 에서 직접 읽는 것이 맞습니다. 같은 파일의 accelTrait·darkTrait
 *   가 이미 isLayerTrait 로 그렇게 하고 있었고, 회전만 예외였습니다.
 *
 * ★ 이벤트 도착 전에도 true 가 되지만 부작용이 없습니다. 각도의 출처인
 *   rotationAngleNow() 는 epoch 이 0 이면 0 을 돌려주고, rotGroup 을 돌리는
 *   블록과 실어 돌리기(applyRotationCarry)는 둘 다 epoch 을 먼저 확인합니다.
 *   즉 회전이 시작되기 전에는 항등 변환이라 종전과 완전히 동일합니다.
 */
function isRotatingLayer(layerIndex) {
  return isLayerTrait(layerIndex, 'rotate');
}

/** 이 층 타일이 들어갈 씬 그룹. 회전층만 rotGroup 으로 갑니다. */
function groupForLayer(layerIndex) {
  return isRotatingLayer(layerIndex) ? rotGroup : tileGroup;
}

/* 씬에서 떼어낼 때 부모를 직접 찾습니다.
 * tileGroup.remove(x) 로 고정해 두면 회전층 타일(부모가 rotGroup)이
 * 조용히 안 지워져 유령 메시로 남습니다.                              */
function detach(obj) {
  if (obj && obj.parent) obj.parent.remove(obj);
}

/** 이 층의 현재 각도. 회전하지 않는 층은 0 이라 변환이 항등이 됩니다. */
function layerAngleOf(layerIndex) {
  return isRotatingLayer(layerIndex) ? G.traits.rotate.angle : 0;
}

/* 좌표계 변환용 임시 객체. 매 프레임 타일마다 부르는 경로라
 * 새 객체를 만들면 GC 압력이 생깁니다.                                */
const _framePt = { x: 0, z: 0 };

/**
 * 월드 좌표 → 그 층의 로컬(회전 전) 좌표.
 *
 * ★ 이 게임에서 회전 충돌 판정의 핵심입니다.
 *   타일 845장을 매 프레임 회전시키는 대신, '질의점 하나'를 −θ 회전시켜
 *   정적인 타일 좌표와 비교합니다. 강체 회전이라 결과가 수학적으로 같고,
 *   pointInXZ / AABB / 육각 판정 코드는 한 줄도 바뀌지 않습니다.
 *   회전하지 않는 층에서는 항등 변환이라 비용이 사실상 0 입니다.
 */
function toLayerFrame(px, pz, layerIndex) {
  const a = layerAngleOf(layerIndex);
  if (!a) { _framePt.x = px; _framePt.z = pz; return _framePt; }
  const c = Math.cos(-a), s = Math.sin(-a);
  _framePt.x = px * c - pz * s;
  _framePt.z = px * s + pz * c;
  return _framePt;
}

/**
 * 층에 얹힌 개체(관전자 부스터·투하 서류)의 월드 좌표를 층 회전에 맞춥니다.
 *
 * 서버가 보내는 x/z 는 '층 로컬' 좌표이고(server.js toLayerLocalXZ 참고),
 * 월드 좌표는 매 프레임 여기서 만듭니다. 이렇게 두면 착지 판정(findLanding ·
 * supportAt · groundYUnder)과 렌더링이 함께 쓰는 ent.x/ent.z 가 항상 지금
 * 층 위치와 일치합니다 — 개체가 층과 함께 돕니다.
 *
 * 회전하지 않는 층이면 각도가 0 이라 로컬 = 월드 이고 비용도 거의 없습니다.
 */
function syncEntityToLayer(ent) {
  const a = layerAngleOf(ent.layer);
  if (!a) { ent.x = ent.lx; ent.z = ent.lz; return ent; }
  const c = Math.cos(a), s = Math.sin(a);
  ent.x = ent.lx * c - ent.lz * s;
  ent.z = ent.lx * s + ent.lz * c;
  return ent;
}

/** 타일의 현재 월드 좌표 (파편·이펙트를 제자리에 터뜨릴 때 씁니다). */
function tileWorldXZ(rec, out) {
  const a = layerAngleOf(rec.layer);
  out = out || {};
  if (!a) { out.x = rec.x; out.z = rec.z; return out; }
  const c = Math.cos(a), s = Math.sin(a);
  out.x = rec.x * c - rec.z * s;
  out.z = rec.x * s + rec.z * c;
  return out;
}

/* ── 위상 타일 (phase tile) ───────────────────────────────────────────
 * 서버 LAYER_DEFS 에서 special:'phase' 인 층의 특수 타일입니다.
 * 켜졌다 꺼졌다 하며, 꺼진 동안에는 지지력이 없어 밟으면 빠집니다.
 *
 * ★ ON/OFF 는 서버가 매 틱 보내주지 않습니다. 서버가 라운드 시작 시각
 *   (phaseEpoch)만 주고 양쪽이 같은 공식으로 계산합니다. 내 시계를
 *   G.serverOffset(RTT 보정값)으로 서버 시각에 맞춘 뒤 넣기 때문에
 *   어느 클라이언트에서 보든 같은 순간에 같은 상태가 됩니다.
 * ------------------------------------------------------------------ */
const PHASE_OFF_ALPHA = 0.22;        // OFF 일 때 타일 불투명도 (층 반투명과 곱해집니다)
/* 전환 경계 근처에서는 서버와 검산하지 않습니다 — 시계가 몇 ms만 어긋나도
 * 멀쩡한 계산이 틀린 것으로 나오기 때문입니다.                        */
const PHASE_EDGE_GUARD_MS = 60;

/**
 * 주어진 '서버 시각'에서의 위상 상태.
 *   known    : 계산할 수 있는가 (config·epoch 가 있는가)
 *   on       : 켜져 있는가
 *   marginMs : 가장 가까운 전환 경계까지 남은 시간
 */
function phaseInfoAt(serverNow) {
  const c = G.cfg && G.cfg.PHASE_TILE;
  if (!c || !G.phaseEpoch) return { known: false, on: true, marginMs: Infinity };
  const period = c.onMs + c.offMs;
  let elapsed = serverNow - G.phaseEpoch;
  if (elapsed < 0) elapsed = 0;
  const t = elapsed % period;
  const on = t < c.onMs;
  const marginMs = on ? Math.min(t, c.onMs - t) : Math.min(t - c.onMs, period - t);
  return { known: true, on, marginMs };
}

/** 지금 이 순간 위상 타일이 켜져 있는가 (내 시계를 서버 시각으로 환산해서). */
function phaseTilesNow() {
  return phaseInfoAt(Date.now() + G.serverOffset).on;
}

/* OFF 일 때 얹는 육각 윤곽선. "여기 타일이 있긴 한데 지금은 못 밟는다"를
 * 한눈에 보여줍니다. 지오메트리는 모든 위상 타일이 공유합니다.        */
let phaseRingGeo = null, phaseRingGeoSize = 0;
function ensurePhaseRingGeo() {
  const S = G.hexSize || HEX_SIZE_BASE;
  if (phaseRingGeo && phaseRingGeoSize === S) return phaseRingGeo;
  if (phaseRingGeo) phaseRingGeo.dispose();
  phaseRingGeoSize = S;
  /* flat-top 육각형의 6꼭짓점. 0도에서 시작해 60도씩 — 꼭짓점이 ±X 에
   * 오므로 타일 본체(CylinderGeometry + HEX_THETA 교정)와 방향이 맞습니다. */
  const pts = [];
  const R = S * 0.985;
  for (let i = 0; i < 6; i++) {
    const a = (i / 6) * Math.PI * 2;
    pts.push(new THREE.Vector3(Math.cos(a) * R, 0, Math.sin(a) * R));
  }
  phaseRingGeo = new THREE.BufferGeometry().setFromPoints(pts);
  return phaseRingGeo;
}

/**
 * 타일의 최종 불투명도.
 *
 * ★ 층 반투명(applyLayerTransparency)과 위상 OFF 반투명은 서로 다른 이유로
 *   생깁니다. 한쪽이 다른 쪽을 덮어쓰면, 아래층에서 올려다볼 때 OFF 타일이
 *   도로 진해지거나 그 반대가 됩니다. 그래서 '곱해서' 씁니다.
 */
function tileAlphaFor(rec) {
  const layerAlpha = rec.targetOpacity !== undefined ? rec.targetOpacity : 1;
  const phaseAlpha = (rec.phaseTile && !G.phaseOn) ? PHASE_OFF_ALPHA : 1;
  return layerAlpha * phaseAlpha;
}

/** 맨 위 층 번호. 층이 몇 개든, 번호가 무엇이든 여기서만 답합니다. */
function topLayerIndex() {
  if (G.layerOrder.length) return G.layerOrder[0];
  const Ls = (G.cfg && G.cfg.LAYERS) || [];
  return Ls.length ? Ls[0].index : 1;
}

/* pointy-top → flat-top 교정각. 타일·대기 발판 모두 이 값을 써서 방향을 맞춥니다.
 * 이 값을 빼면 육각형이 30도 돌아간 채로 놓여 이웃과 반드시 겹칩니다.   */
const HEX_THETA = Math.PI / 6;

/* 육각형 판정에 쓰는 상수 (매 프레임 호출되므로 미리 계산해 둡니다) */
const SQRT3 = Math.sqrt(3);          // 1.7320508
const SQRT3_2 = SQRT3 / 2;           // 0.8660254

/* ── 타일 크기에 연동되는 이펙트 치수 ─────────────────────────────────
 * 예전에는 3.6 / 4.6 / 0.55 처럼 옛 타일 크기(3.2)를 전제한 숫자가 여기저기
 * 박혀 있었습니다. 타일이 작아지면 부스터가 타일 두 칸을 덮어버리는 식으로
 * 어긋나므로, 전부 G.hexSize 기준 배율로 바꿉니다.                    */
const FX = {
  BOOSTER_R: 1.15,     // 부스터 반경 = hexSize × 1.15
  BOOSTER_RING_IN: 1.18, BOOSTER_RING_OUT: 1.62,
  OBS_W: 1.5, OBS_D: 1.1,          // 장애물 가로/세로
  OBS_RING_IN: 0.9, OBS_RING_OUT: 1.4,
  DEBRIS_SPREAD: 1.1,              // 파편이 흩어지는 반경
  /* 의견제출통지서 낙하 폭발이 주자를 밀어내는 반경.
   * 여기만 6.5 라는 숫자가 그대로 박혀 있어 타일 크기를 따라오지 않았습니다.
   * 폭발은 자기 타일 + 이웃 6칸을 부수므로(REJECT_TILE.radius=1) 밀어내는
   * 범위도 그 바깥 경계(한 칸 = √3·S)를 덮어야 합니다. 6.5 ÷ 종전 S(2.1333)
   * = 3.05 로 옮겨 적었습니다 — 종전 크기에서는 값이 그대로입니다.      */
  BLAST_R: 3.05
};

/** 부스터 충돌 반경의 제곱. 매 프레임 3곳에서 쓰이므로 함수로 뽑았습니다. */
function boosterR2() {
  const r = (G.hexSize || 3.2 / 1.5) * FX.BOOSTER_R;
  return r * r;
}

/* 서버 config 를 그대로 쓰는 얇은 래퍼입니다.
 * 폴백은 '서버가 아직 말을 안 걸었을 때 터지지 않게' 하는 용도일 뿐,
 * 실제 렌더는 init 이후에만 일어나므로 값이 쓰이지는 않습니다.
 * 그래서 폴백에도 층 배열을 박지 않고 최소 1층만 만들어 둡니다.        */
function mapCfg() {
  const c = G.cfg || {};
  const gap = c.LAYER_GAP || 12;
  const base = c.LAYER_BASE_Y || 0;
  return {
    HEX_SIZE: c.HEX_SIZE || (3.2 / 1.5),
    HEX_THICKNESS: c.HEX_THICKNESS || 0.7,
    SEA_Y: (c.SEA_Y !== undefined ? c.SEA_Y : base - 16),
    LAYER_GAP: gap,
    LAYERS: (c.LAYERS && c.LAYERS.length)
      ? c.LAYERS
      : [{ index: 1, y: base, color: '#00ffcc', name: '—', short: '—' }]
  };
}

/* ═══════════════════════════════════════════════════════════════════════
 * 개발용 테스트 모드 (클라이언트 측)
 * ───────────────────────────────────────────────────────────────────────
 * 최종 설정 = 서버가 내려준 값  +  이 탭의 URL 옵션
 *
 *   ?dev=1                  이 탭에서 개발 UI 를 켭니다
 *   ?dev=1&noElim=0         떨어지면 그냥 탈락시킵니다 (탈락 흐름 시험용)
 *   ?dev=1&jump=0           층 이동 버튼을 숨깁니다
 *   ?dev=0                  서버가 dev 여도 이 탭만 평소처럼 씁니다
 *
 * ?dev 를 아예 안 붙이면 서버 설정을 그대로 따릅니다(종전과 동일).
 * 창을 4개 띄워 한 개만 dev 로 두는 식의 테스트를 하려고 이렇게 나눴습니다.
 *
 * noFuse / fastEvents 는 여기서 못 바꿉니다 — 타일 상태를 바꾸는 항목이라
 * 사람마다 다르면 같은 방에서 서로 다른 맵을 보게 됩니다. 서버 전역입니다.
 * ═══════════════════════════════════════════════════════════════════════ */
const DEV = {
  on: false,           // 이 탭에서 개발 모드 UI/동작을 쓰는가
  serverOn: false,     // 서버가 DEV 로 떠 있는가 (아래 항목들의 전제)
  noEliminate: false,  // 개인 — 떨어져도 탈락하지 않고 최상층 복귀
  layerJump: false,    // 개인 — 층 이동 버튼
  noFuse: false,       // 서버 전역 (읽기 전용, 표시용)
  fastEvents: false,   // 서버 전역 (읽기 전용, 표시용)
  eventSpeedup: 1
};

/** URL 옵션 읽기. 없으면 undefined 를 돌려 '서버 값을 따른다'는 뜻이 됩니다. */
function devUrlFlag(name) {
  const v = new URLSearchParams(location.search).get(name);
  if (v === null) return undefined;
  return !(v === '0' || v === 'false');
}

/**
 * server_hello 의 config.DEV 를 받아 이 탭의 최종 설정을 확정합니다.
 * 서버가 dev 가 아니면 무엇을 붙여도 켜지지 않습니다 — 위치를 옮기는
 * 동작은 전부 서버의 이동 검증 면제가 필요하기 때문입니다.
 */
function applyDevMode(cfg) {
  const sv = cfg || {};
  DEV.serverOn = !!sv.on;
  DEV.noFuse = !!sv.noFuse;
  DEV.fastEvents = !!sv.fastEvents;
  DEV.eventSpeedup = sv.eventSpeedup || 1;

  const want = devUrlFlag('dev');
  if (!DEV.serverOn) {
    DEV.on = false;
    document.body.classList.remove('dev');
    if (want === true) {
      toast('이 서버는 개발 모드가 아닙니다 — DEV_MODE=1 npm start 로 켜세요', 'kill');
    }
    return;
  }

  DEV.on = want === undefined ? true : want;    // dev 서버 기본은 켜짐 (종전과 동일)
  const elim = devUrlFlag('noElim'), jump = devUrlFlag('jump');
  DEV.noEliminate = DEV.on && (elim === undefined ? !!sv.noEliminate : elim);
  DEV.layerJump = DEV.on && (jump === undefined ? !!sv.layerJump : jump);

  document.body.classList.toggle('dev', DEV.on);
  renderDevBadge();
  buildDevLayerButtons();

  if (DEV.on) {
    toast('개발 모드 — ' + devFlagSummary(), 'cheer');
    if (DEV.layerJump) toast('왼쪽 "층 이동" 버튼으로 각 층을 오갈 수 있습니다', 'cheer');
  }
}

function devFlagSummary() {
  const on = [];
  if (DEV.noFuse) on.push('noFuse');
  if (DEV.fastEvents) on.push('fastEvents×' + DEV.eventSpeedup);
  if (DEV.noEliminate) on.push('noEliminate');
  if (DEV.layerJump) on.push('layerJump');
  return on.length ? on.join(' · ') : '켜진 항목 없음';
}

/** 상단 배지에 어떤 항목이 켜져 있는지 표시합니다 (꺼진 건 취소선). */
function renderDevBadge() {
  const el = document.getElementById('devFlags');
  if (!el) return;
  const item = (name, on, scope) =>
    (on ? '<b>' + name + '</b>' : '<s>' + name + '</s>') +
    '<span style="opacity:.4">' + scope + '</span>';
  el.innerHTML = [
    item('noFuse', DEV.noFuse, '전역'),
    item('fastEvents', DEV.fastEvents, '전역'),
    item('noEliminate', DEV.noEliminate, '개인'),
    item('layerJump', DEV.layerJump, '개인')
  ].join('');
}

/* 층 이동 버튼을 서버 config 의 LAYERS 로 만듭니다.
 * HTML 에 박아 두지 않는 이유: 왼쪽 안내문(#layerStack)은 3층이 하드코딩돼
 * 있어서 층이 늘면 손으로 고쳐야 합니다. 이 버튼은 층이 5개가 되면 자동으로
 * 5개가 됩니다.                                                        */
function buildDevLayerButtons() {
  const box = document.getElementById('devLayers');
  if (!box) return;
  box.querySelectorAll('button').forEach((b) => b.remove());
  box.style.display = (DEV.on && DEV.layerJump) ? 'flex' : 'none';
  if (!DEV.on || !DEV.layerJump) return;

  const layers = (G.cfg && G.cfg.LAYERS) ? G.cfg.LAYERS : [];
  for (const L of layers) {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.l = L.index;
    b.innerHTML = '<span>LAYER ' + String(L.index).padStart(2, '0') + '</span>' +
                  '<span class="y">y ' + L.y + '</span>';
    b.addEventListener('click', () => devTeleport(L.index));
    box.appendChild(b);
  }
  // 안내문 아래로 내려 겹치지 않게 합니다 (안내문 높이는 층 수에 따라 달라집니다)
  const stack = document.getElementById('layerStack');
  box.style.top = (stack ? stack.offsetTop + stack.offsetHeight + 12 : 300) + 'px';
  markDevLayerButton(local.layer);
}

/** 지금 있는 층 버튼을 강조합니다. */
function markDevLayerButton(layerIndex) {
  const box = document.getElementById('devLayers');
  if (!box) return;
  box.querySelectorAll('button').forEach((b) => {
    b.classList.toggle('cur', parseInt(b.dataset.l, 10) === layerIndex);
  });
}

/* 타일이 커지면 카메라도 그만큼 물러나야 시야가 종전과 비슷해집니다.
 * HEX_SIZE 기준값(3.2) 대비 비율로 계산하므로, 나중에 타일 크기를 또 바꿔도
 * 카메라가 알아서 따라옵니다. 곱셈 누적을 피하려고 항상 기준값에서 새로
 * 계산합니다 (buildMap 은 맵이 새로 깔릴 때마다 다시 호출됩니다).      */
/* 카메라 기준값. 타일이 작아지고 아레나가 넓어진 만큼 조금 물러서고,
 * 줌 범위도 넓혔습니다 (종전 20 / 10~46 / 높이 3.2).
 * 캐릭터 크기는 그대로이므로 높이는 오히려 살짝 낮춥니다.              */
const CAM = { DIST: 24, MIN: 12, MAX: 58, HEIGHT: 3.0 };
/* 이 기준값이 어떤 타일 크기를 전제로 잡힌 값인지. 서버가 다른 크기를
 * 내려주면 그 비율만큼 카메라가 따라 움직입니다 (지금은 1.0).          */
const HEX_SIZE_BASE = 3.2 / 1.5;
const CAM_BASE = { dist: CAM.DIST, min: CAM.MIN, max: CAM.MAX, height: CAM.HEIGHT };

function applyWorldScale(hexSize) {
  const s = (hexSize || HEX_SIZE_BASE) / HEX_SIZE_BASE;
  cam.scale = s;
  cam.minDist = CAM_BASE.min * s;
  cam.maxDist = CAM_BASE.max * s;
  cam.height = CAM_BASE.height * s;
  cam.targetDist = THREE.MathUtils.clamp(CAM_BASE.dist * s, cam.minDist, cam.maxDist);
  if (!cam.userZoomed) cam.dist = cam.targetDist;
}

function buildMap(map, cfg) {
  lastTransparencyLayer = -1;
  // clear previous map
  for (const rec of G.tiles.values()) {
    releaseCrack(rec);            // 균열 오버레이도 같이 떼어냅니다 (안 하면 tileGroup 에 그대로 남습니다)
    if (rec.phaseRing) {          // 위상 타일 윤곽선도 함께 (지오메트리는 공유라 두고 재질만 버립니다)
      detach(rec.phaseRing);
      rec.phaseRing.material.dispose();
      rec.phaseRing = null;
    }
    /* rec.mesh 는 렌더되지 않는 Object3D 라 버릴 것이 없습니다.
     * 무너지는 중이라 진짜 메시가 붙어 있으면 그것만 거둡니다.     */
    TileInst.demote(rec);
  }
  TileInst.reset();
  G.tiles.clear();

  G.hexSize = cfg.HEX_SIZE;
  G.hexThick = cfg.HEX_THICKNESS;
  G.seaY = cfg.SEA_Y;
  /* 낙하 연출(updateCamera 의 auto pitch)을 정규화할 기준 속도.
   * '한 층 떨어졌을 때의 착지 직전 속도' = √(2·g·LAYER_GAP) 입니다.
   * 종전에는 45 가 박혀 있었는데 그 숫자의 근거가 바로 이 식이었고,
   * LAYER_GAP 을 바꾸면 어긋납니다 — gap 12 면 38.6 이라 카메라가 끝까지
   * 안 젖혀지고, gap 18 이면 47.2 라 낙하 초반에 이미 최대로 젖혀져
   * 높이 차가 연출로 안 읽힙니다. 그래서 서버 값에서 직접 뽑습니다. */
  G.fallNorm = Math.sqrt(2 * Math.abs(PHYS.GRAVITY) * (cfg.LAYER_GAP || 15));
  bounceLight.position.y = cfg.SEA_Y + 6;
  if (currentTheme >= 0) buildCloudSea(THEMES[currentTheme]);

  /* 층 색인을 통째로 새로 만듭니다.
   * 덮어쓰기가 아니라 '새로 만들기'여야 합니다 — 층이 5개에서 4개로 줄면
   * 예전 키가 남아 사라진 층의 빈 배열을 계속 훑게 됩니다.            */
  /* 난간은 층 그룹에 붙으므로 맵을 새로 만들 때 직접 떼어내야 합니다.
   * 타일처럼 G.tiles 로 관리되지 않아 잊기 쉬운 지점입니다. */
  for (const f of G.fences) { detach(f); f.material.dispose(); }
  G.fences = [];

  G.layerY = {};
  G.layerTiles = {};
  G.layerColor = {};
  G.layerOrder = [];
  for (const L of cfg.LAYERS) {
    G.layerY[L.index] = L.y;
    G.layerTiles[L.index] = [];
    G.layerColor[L.index] = new THREE.Color(L.color || '#ffffff').getHex();
    G.layerOrder.push(L.index);
  }
  // 위 → 아래 순. findLanding 등이 이 순서를 그대로 씁니다.
  G.layerOrder.sort((a, b) => G.layerY[b] - G.layerY[a]);

  // 타일 크기가 바뀌면(DEV_MODE 전환 등) 카메라 거리도 같이 맞춥니다
  applyWorldScale(G.hexSize);
  // 균열 오버레이 지오메트리도 새 타일 크기에 맞춰 둡니다.
  // 위에서 오버레이를 전부 떼어낸 뒤라 여기가 재생성하기 안전한 유일한 지점입니다.
  ensureCrackGeo();

  /* 지오메트리는 한 번 만들어 모든 타일이 공유합니다. 다만 타일 크기가
   * 달라졌다면 (서버 DEV_MODE 를 켜고 재접속한 경우) 반드시 다시 만들어야
   * 합니다 — 안 그러면 옛 크기 그대로 남아 물리 AABB 와 어긋납니다.    */
  if (hexGeos && geoHexSize !== G.hexSize) {
    for (const g of hexGeos.values()) g.dispose();
    hexGeos = null;
    if (pedDoorA) {
      pedDoorA.dispose(); pedDoorB.dispose(); pedRingGeo.dispose();
      pedDoorA = pedDoorB = pedRingGeo = null;
    }
  }
  if (!hexGeos) {
    geoHexSize = G.hexSize;
    hexGeos = new Map();   // 두께별 지오메트리는 tileGeoFor 가 필요할 때 만듭니다
  }

  // AABB half-extents of a flat-top hexagon: adjacent boxes overlap in X and
  // touch exactly in Z, so the plane is fully covered — no fall-through gaps.
  const halfX = G.hexSize;
  const halfZ = G.hexSize * Math.sqrt(3) / 2;

  measureArena(map);

  G.kindCount = {};
  for (const t of map.tiles) {
    const kind = t.kind || 'normal';
    /* ★ 거절이유 타일만은 '특수 타일 겉모습'을 쓰지 않고 일반 타일로 위장합니다.
     * 특수 색(층 원색 + 강한 발광)으로 두면 멀리서도 눈에 띄어 그냥 피해
     * 가면 그만이라 함정이 성립하지 않습니다. 밟혀서 서버가 tile_reject 를
     * 보낸 뒤에야 노랑→주황→빨강으로 정체를 드러냅니다.
     * 로직상으로는 여전히 kind='special' 입니다 — 겉모습만 바꿉니다.   */
    const disguised = kind === 'special' && t.specialType === 'reject';
    const baseStyle = disguised ? TILE_STYLE.normal : (TILE_STYLE[kind] || TILE_STYLE.normal);
    /* 세부 종류 색이 정의돼 있으면 그것으로 덮어씁니다 (점프 타일 A/B) */
    const sub = (!disguised && t.specialType) ? SPECIAL_TYPE_STYLE[t.specialType] : null;
    const st = sub ? Object.assign({}, baseStyle, sub) : baseStyle;
    G.kindCount[kind] = (G.kindCount[kind] || 0) + 1;

    // 고정색 종류는 층과 무관, 그 외에는 층 색을 흰색 쪽으로 섞습니다
    const base = (st.color !== undefined)
      ? new THREE.Color(st.color)
      : new THREE.Color(layerColorOf(t.layer)).lerp(WHITE_C, st.mix);
    const emis = (st.emissiveColor !== undefined)
      ? new THREE.Color(st.emissiveColor)
      : base.clone();

    /* 재질은 값만 담는 대역 객체입니다 — 실제 그리기는 InstancedMesh 가
     * 합니다. 테두리 음영(paintTileEdges)은 지오메트리의 정점 색이라
     * 인스턴싱과 무관하게 그대로 따라옵니다.                        */
    const mat = makeTileMat(base, emis, st.emissive);

    /* ★ Mesh 가 아니라 Object3D 입니다. 기존 코드가 mesh.position.y /
     *   scale / visible 을 직접 쓰기 때문에 변형 상자로만 남깁니다.
     *   씬에는 넣지 않습니다 — 1,626개를 매달면 three.js 가 매 프레임
     *   전부 순회해서 인스턴싱으로 아낀 것을 도로 까먹습니다.        */
    const mesh = new THREE.Object3D();
    mesh.position.set(t.x, t.y, t.z);
    const tileGeo = tileGeoFor(st.thick);
    // 회전층 타일은 회전 그룹으로 들어갑니다 (groupForLayer 참고)
    const tileParent = groupForLayer(t.layer);

    const rec = {
      id: t.id, layer: t.layer,
      /* kind : 'normal' | 'fragile' | 'reinforced' | 'special'  (서버가 정함)
       * specialType : 특수 타일이면 그 층의 태그 (예: 'phase'). 지금은
       *   표시용이고 동작은 일반 타일과 같습니다 — 다음 작업에서 씁니다. */
      kind: kind, specialType: t.specialType || null,
      /* 위상 타일인가. 착지 판정 3곳에서 매 프레임 타일마다 보는 값이라
       * 문자열 비교 대신 불리언으로 미리 접어 둡니다.                 */
      phaseTile: kind === 'special' && t.specialType === 'phase',
      phaseRing: null,
      /* 신속심사 타일. 방향은 밟는 사람의 진행 방향이라 타일마다 다르지
       * 않으므로, 타일에는 '여기서 튀어나간다'는 강조만 두고 실제 방향
       * 화살표는 내가 올라선 타일 위에 하나만 띄웁니다(dashArrow).   */
      accelTile: kind === 'special' && t.specialType === 'accel',
      /* 층 특성 '심사 가속'이 걸린 층의 타일인가.
       * 위 accelTile(특수 타일 한 칸)과는 다른 축입니다 — 이건 그 층
       * 전체가 대상입니다. 매 프레임 층을 되찾지 않도록 여기서 접어 둡니다. */
      accelTrait: isLayerTrait(t.layer, 'accel'),
      /* 층 특성 '어둠'이 걸린 층의 타일인가.
       * 어둠은 이 층 타일만 가립니다 — 층 특성이므로 다른 층까지 덮으면
       * 위층에 서 있는 사람의 발밑까지 캄캄해져 규칙이 뒤집힙니다.    */
      darkTrait: isLayerTrait(t.layer, 'dark'),
      /* 거절이유 타일. 평소엔 일반 타일과 똑같이 보이고, 밟혀서 서버가
       * tile_reject 를 보내야 비로소 색이 변하기 시작합니다.
       * (미리 티가 나면 밟지 않고 피할 수 있어 함정이 성립하지 않습니다) */
      rejectTile: kind === 'special' && t.specialType === 'reject',
      /* 보정 타일. 밟으면 부서진 이웃 하나가 되살아납니다.
       * 어느 타일을 되살릴지는 서버가 정해 tile_restore 로 알려줍니다. */
      amendTile: kind === 'special' && t.specialType === 'amend',
      /* 점프 타일이면 '몇 층 위로' 보내는지 (아니면 0).
       * 서버가 정한 specialType 'jumpN' 을 그대로 읽습니다 — 색과 진동
       * 세기만 여기서 쓰고, 실제 발사는 서버 player_impulse 가 시킵니다. */
      jumpLevel: (function () {
        const m = kind === 'special' && /^jump(\d+)$/.exec(t.specialType || '');
        return m ? parseInt(m[1], 10) : 0;
      })(),
      x: t.x, y: t.y, z: t.z,
      // 두께가 종류마다 달라도 착지면은 항상 hexThick 기준입니다.
      // 여기를 종류별로 바꾸면 같은 층인데 층마다 발 높이가 달라집니다.
      top: t.y + G.hexThick / 2,
      hexR: G.hexSize,   // 육각형 판정용 외접원 반지름
      // AABB 는 빠른 배제용으로 남겨 둡니다 (findLanding 등에서 먼저 걸러냄)
      minX: t.x - halfX, maxX: t.x + halfX,
      minZ: t.z - halfZ, maxZ: t.z + halfZ,
      state: 'idle', warnStart: 0, fuse: t.fuse || 800, breakStart: 0,
      /* 밟기 누적. 종전 '3회 규칙' 구조를 강화 타일이 그대로 물려받았습니다.
       *   hits        : 서버가 확정한 히트 수 (낙관적으로 올리지 않습니다)
       *   maxHits     : 이 타일이 버티는 횟수 (강화 2, 나머지 1)
       *   autoMs      : 첫 밟기 뒤 자동 파괴까지. 2026-09-16 규칙 변경으로
       *                 바닥은 0 이 됐습니다(다시 밟기 전까지 안 무너짐).
       *                 값을 쓰는 타일이 다시 생길 수 있어 필드는 남깁니다.
       *   wear        : hits/maxHits 를 0~1 로 정규화한 마모도
       *   myLastHitAt : 내가 마지막으로 이 타일을 때린 시각 (연타 방지)  */
      hits: 0, maxHits: t.maxHits || 1, autoMs: t.autoMs || 0,
      wear: 0, myLastHitAt: -Infinity,
      /* 내 층에서 몇 층 아래인가에 따른 밝기 배율 (applyLayerTransparency).
       * 1 이면 그대로. 맵을 만든 직후에는 아직 안 정해졌으므로 1 로 둡니다. */
      depthDim: 1,
      /* crack : 강화 타일이 금 간 뒤 얹는 오버레이 { mesh, mat, born }
       * crackShake : 금이 간 직후 타일이 흔들리는 남은 시간(초)          */
      crack: null, crackShake: 0,
      mesh, mat, baseColor: base.clone(), baseGlow: st.emissive, baseY: t.y,
      /* ★ 발광 '색'의 원본. 거절이유 카운트다운이 mat.emissive 를 노랑~빨강
       * 으로 덮어쓰기 때문에, 이걸 안 들고 있으면 복구(tile_restore)해도
       * 타일이 벌겋게 남습니다. baseGlow(세기)와는 다른 값입니다.      */
      baseEmissive: emis.clone(),
      /* 복구 연출이 시작된 시각. 0 이면 연출 중이 아닙니다. */
      restoreStart: 0
    };
    /* 위상 타일에는 OFF 용 윤곽선을 미리 달아 둡니다 (평소엔 visible=false).
     * 재질을 타일마다 따로 두는 이유: 층 반투명이 층마다 다르므로 공유하면
     * 두 층에 위상 타일이 생겼을 때 한쪽 투명도가 다른 쪽을 덮어씁니다.
     * 개수가 한 층의 20% 정도라 재질을 따로 둬도 부담이 없습니다.     */
    if (rec.phaseTile) {
      const ringMat = new THREE.LineBasicMaterial({
        color: base.clone(), transparent: true, opacity: 0, depthWrite: false, toneMapped: false
      });
      const ring = new THREE.LineLoop(ensurePhaseRingGeo(), ringMat);
      ring.position.set(t.x, t.y + G.hexThick / 2 + 0.03, t.z);
      ring.renderOrder = 3;
      ring.visible = false;
      groupForLayer(t.layer).add(ring);
      rec.phaseRing = ring;
    }

    /* 승격(promote)할 때 쓸 지오메트리와, 무너지는 중 붙는 진짜 메시. */
    rec.instGeo = tileGeo;
    rec.liveMesh = null;
    TileInst.register(rec, tileGeo, st, tileParent);

    G.tiles.set(t.id, rec);
    if (G.layerTiles[t.layer]) G.layerTiles[t.layer].push(rec);
  }
  /* 타일을 다 모은 뒤에 InstancedMesh 를 만듭니다 — 개수를 알아야 합니다. */
  TileInst.build();
  buildPedestals(map, cfg);
  buildFences(cfg);
  applyLayerTransparency(topLayerIndex());
}

/* ── 층 난간 ─────────────────────────────────────────────────────────
 * 층마다 육각 난간을 세웁니다.
 *
 * ★ 회전층 난간은 회전 그룹에 넣습니다(groupForLayer).
 *   층이 돌면 타일 윤곽도 같이 도는데 난간만 고정이면, 30도쯤 돌았을 때
 *   타일이 난간 밖으로 삐져나옵니다. 물리 판정도 같은 이유로 층 로컬
 *   좌표에서 합니다(clampToArena 주석 참고).
 *
 * ★ CylinderGeometry 의 thetaStart 는 0 입니다.
 *   three.js 는 각도 θ 를 (x = R·sinθ, z = R·cosθ) 로 쓰므로 θ=0 이 +Z
 *   꼭짓점입니다. 아레나 육각형의 꼭짓점이 마침 +Z 방향에 있어서 교정이
 *   필요 없습니다 — 타일(HEX_THETA=π/6)과 다른 점입니다.
 * ------------------------------------------------------------------ */
/* ── 아레나 경계 측정 ─────────────────────────────────────────────────
 * 두 반지름을 따로 잡습니다.
 *
 *   clampR : 주자 중심이 넘어갈 수 없는 선. '발밑에 타일이 있는' 최대
 *            반지름의 방향별 최솟값입니다.
 *   arenaR : 난간을 세울 반지름. clampR 보다 몸 반폭만큼 바깥이라,
 *            주자가 멈춘 자리에서 난간에 닿아 보입니다.
 *
 * ★ 왜 계산하지 않고 재는가.
 *   처음에는 '바깥 타일 중심 + hexSize×1.25' 로 잡았습니다. 그런데 육각
 *   그리드의 바깥선은 직선이 아니라 톱니입니다 — 타일이 한 칸씩 들쭉날쭉
 *   물려 있어서, 방향에 따라 밟을 수 있는 한계가 34.49 ~ 35.65 로 1.2 나
 *   차이납니다. 계산으로 낸 35.14 는 그 최솟값보다 바깥이라, 난간까지는
 *   갔는데 발밑이 없어 그대로 떨어졌습니다(전 방향 추락).
 *   톱니의 최솟값은 식으로 깔끔히 안 나오므로 실제 타일에 대고 잽니다.
 *
 * ★ 탐색은 맵 중심에서 바깥으로 이분합니다.
 *   육각 타일이 육각형으로 빈틈없이 깔리므로 덮인 영역은 볼록합니다 —
 *   중심에서 뻗은 반직선 위에서 '타일 있음'은 [0, d] 한 구간이라 이분
 *   탐색이 성립합니다.
 *   처음에는 바깥 타일만 후보로 두고 lo 를 maxR/2 에서 시작했는데,
 *   그 지점은 바깥 밴드 밖이라 첫 판정부터 false 가 나서 탐색이 그대로
 *   주저앉았습니다(clampR 이 절반값 16.6 으로 나옴). 시작점은 반드시
 *   '타일이 확실히 있는' 곳이어야 하고, 중심이 그 조건을 늘 만족합니다.
 * ------------------------------------------------------------------ */
function measureArena(map) {
  const S = G.hexSize;
  let maxR = 0;
  for (const t of map.tiles) maxR = Math.max(maxR, arenaHexR(t.x, t.z));

  /* 층은 전부 같은 윤곽이므로 한 층치(q,r 조합)만 봅니다. */
  const cells = [];
  const seen = new Set();
  for (const t of map.tiles) {
    const key = t.q + ',' + t.r;
    if (seen.has(key)) continue;
    seen.add(key);
    cells.push(t);
  }

  /* 타일 한 장 안인가 — 바닥 판정과 '같은 식'이 아니라 '같은 함수'를 씁니다.
   *
   * ★ 처음에는 pointInXZ 의 식을 그대로 옮겨 적었는데, eps 를 빼먹었습니다.
   *   그 차이가 타일 크기를 2배로 올리자 바로 터졌습니다. +X 축(0도) 위에는
   *   짝수 q 타일이 3S 간격으로 놓이고 그 사이를 홀수 q 타일이 '정확히'
   *   맞물려 메웁니다 — 겹침이 0 인 이음매입니다. 서버가 좌표를 toFixed(4)
   *   로 반올림하므로 이 이음매는 실제로 1e-4 만큼 벌어지는데, eps 가 없으면
   *   그 틈이 '타일 없음'으로 잡힙니다. 이분 탐색이 거기서 멈춰 0도 방향만
   *   34.8 이 나왔습니다(옆 방향은 전부 49~50).
   *   S=2.1333 에서는 반올림이 우연히 안쪽으로 떨어져 안 드러났습니다 —
   *   크기를 바꾸기 전에는 재현되지 않는 종류의 버그였습니다.
   *
   *   식을 베끼면 이런 식으로 언젠가 어긋납니다. 측정이 바닥 판정보다
   *   조금이라도 인색하면 '난간 앞인데 발밑이 없는' 자리가 생기고, 후하면
   *   그 반대가 됩니다. 둘이 절대 갈라지지 않게 같은 함수를 부릅니다.
   *   (서버 타일 레코드에는 hexR 이 없어 pointInXZ 가 G.hexSize 로 폴백합니다
   *    — 모든 타일이 같은 크기이므로 그게 맞는 값입니다.)               */
  const inTile = (px, pz) => {
    for (const t of cells) if (pointInXZ(px, pz, t)) return true;
    return false;
  };

  /* 방향마다 바깥으로 훑어 '발밑이 있는' 마지막 지점을 찾습니다.
   * 육각형은 60도 주기지만 톱니 위상까지 달라서 한 바퀴 다 봅니다. */
  let minR = Infinity;
  for (let deg = 0; deg < 360; deg += 3) {
    const a = deg * Math.PI / 180;
    const cx = Math.cos(a), cz = Math.sin(a);
    let lo = 0, hi = maxR + S * 2;      // 중심은 언제나 타일 안입니다
    for (let it = 0; it < 22; it++) {
      const mid = (lo + hi) / 2;
      if (inTile(cx * mid, cz * mid)) lo = mid; else hi = mid;
    }
    minR = Math.min(minR, arenaHexR(cx * lo, cz * lo));
  }

  /* 측정 실패(타일이 없는 맵 등)에 대비한 보수적 폴백. */
  if (!isFinite(minR) || minR <= 0) minR = maxR;
  G.clampR = minR;
  G.arenaR = minR + PLAYER.HALF_X;
}

/* ── 2026-09-17 — 외곽을 세 겹으로 만들었습니다 ──────────────────────
 * 테스터 의견: "장외 추락을 막고 있는 층의 외곽이 너무 흐리다."
 * 맞는 지적이었고, 원인은 셋이었습니다.
 *
 *   ① 벽의 실효 알파가 0.07 까지 떨어져 있었습니다 (makeFenceTexture 주석)
 *   ② 발밑에는 아무 표시도 없었습니다. 벽은 바닥에서 2.6 을 <b>올라가는</b>
 *      물건이라 카메라가 뒤통수 위에 있는 이 게임에서는 시야 위쪽에
 *      걸립니다. 정작 판단은 발끝에서 내리는데 발끝에는 선이 없었습니다.
 *   ③ 레일이 벽 꼭대기, 즉 그라디언트가 0 으로 끝나는 자리에 있어
 *      허공에 뜬 가는 선 하나로 보였습니다.
 *
 * 그래서 한 겹을 더 깝니다 — <b>바닥 경계선</b>(floor). 타일 윗면 높이에
 * 누운 육각 띠라 달리는 중에 발끝으로 바로 읽힙니다. 벽은 "저 너머는
 * 못 간다", 바닥선은 "여기가 끝이다" 로 역할이 갈립니다.
 *
 * ★ RingGeometry 를 눕힐 때 thetaStart 는 HEX_THETA 입니다.
 *   난간 원통은 (x=R·sinθ, z=R·cosθ) 에 thetaStart 0 이고, RingGeometry
 *   는 (x=R·cosθ, y=R·sinθ) 입니다. rotation.x=+π/2 로 눕히면 y→z 가
 *   되므로 두 각도는 φ = 90° − θ 관계이고, 원통의 꼭짓점 φ=0·60·120…
 *   에 맞추려면 θ 가 30° 간격으로 시작해야 합니다. 안 맞추면 바닥선의
 *   꼭짓점이 벽의 변 한가운데에 놓여 육각형 두 개가 어긋나 보입니다.
 * ------------------------------------------------------------------ */
function buildFences(cfg) {
  const R = G.arenaR;
  if (!R) return;
  const H = 2.6;
  if (fenceGeo) { fenceGeo.dispose(); fenceRailGeo.dispose(); fenceFloorGeo.dispose(); }
  fenceGeo = new THREE.CylinderGeometry(R, R, H, 6, 1, true, 0, Math.PI * 2);
  /* 윗변 레일. 얇은 육각 테두리 하나가 있으면 난간의 높이가 읽힙니다.
   * 0.16 은 멀리서 사라져 버려 0.26 으로 올렸습니다.                 */
  fenceRailGeo = new THREE.CylinderGeometry(R * 1.004, R * 1.004, 0.26, 6, 1, true, 0, Math.PI * 2);
  /* 바닥 경계선. 폭은 R 의 4% 로, 카메라 거리가 변해도 비율이 유지됩니다. */
  fenceFloorGeo = new THREE.RingGeometry(R * 0.975, R * 1.015, 6, 1, HEX_THETA, Math.PI * 2);

  for (const Lx of (cfg.LAYERS || [])) {
    const col = new THREE.Color(Lx.color || '#ffffff');
    const wall = new THREE.Mesh(fenceGeo, new THREE.MeshBasicMaterial({
      map: makeFenceTexture(),
      color: col.clone().lerp(WHITE_C, 0.35),
      transparent: true, opacity: 0.78,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    }));
    wall.position.set(0, Lx.y + G.hexThick / 2 + H / 2, 0);
    /* 층 반투명·깊이 감쇠가 나중에 찾아 쓰도록 표시해 둡니다. */
    wall.userData.layerIndex = Lx.index;
    wall.userData.baseOpacity = wall.material.opacity;
    groupForLayer(Lx.index).add(wall);

    const rail = new THREE.Mesh(fenceRailGeo, new THREE.MeshBasicMaterial({
      color: col.clone().lerp(WHITE_C, 0.72),
      transparent: true, opacity: 1,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    }));
    rail.position.set(0, Lx.y + G.hexThick / 2 + H, 0);
    rail.userData.layerIndex = Lx.index;
    rail.userData.baseOpacity = rail.material.opacity;
    groupForLayer(Lx.index).add(rail);

    /* ★ 바닥선은 타일 윗면보다 아주 조금만 띄웁니다.
     *   같은 높이에 두면 z-파이팅으로 달릴 때 지직거립니다. 0.02 는
     *   위에서 내려다봐도 떠 보이지 않으면서 깊이 버퍼가 갈라지는 값.
     *   depthWrite:false 라 타일보다 뒤에 있어도 가려지지 않습니다 —
     *   바깥쪽 절반이 허공 위에 걸리는 톱니 구간이 있기 때문입니다. */
    const floor = new THREE.Mesh(fenceFloorGeo, new THREE.MeshBasicMaterial({
      color: col.clone().lerp(WHITE_C, 0.66),
      transparent: true, opacity: 0.92,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    }));
    floor.rotation.x = Math.PI / 2;
    floor.position.set(0, Lx.y + G.hexThick / 2 + 0.02, 0);
    floor.renderOrder = 1;
    floor.userData.layerIndex = Lx.index;
    floor.userData.baseOpacity = floor.material.opacity;
    groupForLayer(Lx.index).add(floor);

    G.fences.push(wall, rail, floor);
  }
  /* 새 맵의 난간은 배율이 아직 안 정해졌으므로 여기서 한 번 맞춥니다. */
  for (const m of G.fences) m.userData.layerMul = 1;
  fenceNear = 0;
}

/* ── 가장자리 근접 강조 ───────────────────────────────────────────────
 * 내가 외곽에 다가가면 내 층의 난간만 더 밝아집니다.
 *
 * ★ 세기를 항상 최대로 두지 않는 이유.
 *   난간은 층마다 하나씩, 여섯 겹이 화면에 겹쳐 보입니다. 전부 진하게
 *   두면 아레나가 유리병 속처럼 보이고 아래층 지형이 그 선들에 묻힙니다.
 *   평소에는 형태만 읽히게 두고, <b>판단이 필요한 순간</b>(가장자리에
 *   다가갔을 때)에만 올립니다.
 *
 * ★ 기준은 clampR 입니다 — 난간이 서 있는 arenaR 이 아니라, 내 중심이
 *   실제로 못 넘는 선입니다. 둘은 몸 반폭만큼 다르고, 사람이 부딪히는
 *   것은 앞쪽입니다.
 * ------------------------------------------------------------------ */
let fenceNear = 0;                 // 0~1. 프레임마다 목표값으로 따라갑니다.

function updateFenceEdge(dt) {
  if (!G.fences.length) return;
  let want = 0;
  if (G.role === 'player' && local.alive && G.clampR) {
    /* 회전층에서는 층 로컬 좌표로 봐야 눈에 보이는 난간과 일치합니다
     * (clampToArena 와 같은 이유).                                  */
    const p = toLayerFrame(local.pos.x, local.pos.z, local.layer);
    const t = arenaHexR(p.x, p.z) / G.clampR;
    /* 0.78 부터 반응합니다. 더 이르면 아레나 절반이 늘 켜져 있고,
     * 더 늦으면 이미 난간에 붙은 뒤라 알려 줄 것이 없습니다.       */
    want = THREE.MathUtils.clamp((t - 0.78) / 0.18, 0, 1);
  }
  /* 뚝 켜지면 깜빡임으로 읽힙니다. 켤 때는 빠르게, 끌 때는 천천히. */
  const k = want > fenceNear ? 1 - Math.pow(0.001, dt) : 1 - Math.pow(0.25, dt);
  fenceNear += (want - fenceNear) * k;
  if (Math.abs(want - fenceNear) < 0.002) fenceNear = want;
  const here = local.layer;
  for (const m of G.fences) {
    const mul = m.userData.layerMul === undefined ? 1 : m.userData.layerMul;
    const near = m.userData.layerIndex === here ? fenceNear : 0;
    m.material.opacity = Math.min(1, m.userData.baseOpacity * mul * (1 + near * 0.9));
  }
}


/* --- 대기 발판 ---------------------------------------------------------- *
 * 게임 시작 전, 각 플레이어가 최상층 위 공중에 뜬 자기 발판에서 대기합니다.
 * 정원이 차면 발판이 사라지고 다 같이 최상층으로 떨어지며 시작됩니다.
 * ---------------------------------------------------------------------- */
/* 발판은 '한 장'이 아니라 좌우로 갈라지는 두 짝입니다 (접수 게이트).
 * 반쪽은 CylinderGeometry 의 thetaLength 를 π 로 주면 그대로 나옵니다 —
 * radialSegments 를 3 으로 두면 60도씩 끊겨 육각형 절반과 정확히 맞습니다. */
/* ── 난간 재질 ───────────────────────────────────────────────────────
 * 아래가 진하고 위로 갈수록 사라지는 세로 그라디언트입니다. 위쪽을 딱
 * 끊으면 판때기로 보이고, 사라지게 두면 '빛의 경계'로 읽힙니다.
 * 가산 블렌딩은 쓰지 않습니다 — 밝은 하늘 배경에서 포화되어 육각 윤곽이
 * 뭉개집니다(대기 화면 관문에서 겪은 것과 같은 이유).
 * ------------------------------------------------------------------ */
let fenceTex = null;

function makeFenceTexture() {
  if (fenceTex) return fenceTex;
  const W = 8, H = 64;
  const cv = document.createElement('canvas');
  cv.width = W; cv.height = H;
  const g = cv.getContext('2d');
  const grd = g.createLinearGradient(0, H, 0, 0);   // 아래 → 위
  /* ★ 2026-09-17 — 감쇠를 위로 끌어올렸습니다.
   *   종전 값은 높이의 18% 에서 이미 0.42 로, 55% 에서 0.12 로
   *   떨어졌습니다. 재질 투명도 0.55 가 여기 다시 곱해지므로 벽의
   *   윗절반은 실효 알파가 0.07 — 사실상 안 그려지는 상태였습니다.
   *   그래서 화면에는 바닥에 깔린 옅은 빛과, 2.6 위에 떠 있는 가는 선
   *   하나만 보였습니다. "층 외곽이 흐리다" 는 의견의 실체입니다.
   *   윗부분은 여전히 0 으로 끝납니다 — 딱 끊으면 판때기로 보입니다. */
  grd.addColorStop(0.00, 'rgba(255,255,255,1)');
  grd.addColorStop(0.34, 'rgba(255,255,255,0.66)');
  grd.addColorStop(0.68, 'rgba(255,255,255,0.30)');
  grd.addColorStop(1.00, 'rgba(255,255,255,0)');
  g.fillStyle = grd;
  g.fillRect(0, 0, W, H);
  fenceTex = new THREE.CanvasTexture(cv);
  fenceTex.wrapS = THREE.RepeatWrapping;
  fenceTex.encoding = THREE.sRGBEncoding;
  return fenceTex;
}

let fenceGeo = null, fenceRailGeo = null, fenceFloorGeo = null;
let pedDoorA = null;   // +z 쪽 반쪽
let pedDoorB = null;   // -z 쪽 반쪽
let pedRingGeo = null;

function buildPedestals(map, cfg) {
  for (const rec of G.pedestals.values()) {
    if (rec.gate) { detach(rec.gate.group); }
    tileGroup.remove(rec.mesh);
    rec.mat.dispose();
    if (rec.ring) { tileGroup.remove(rec.ring); rec.ring.material.dispose(); }
  }
  G.pedestals.clear();
  if (!map.pedestals) return;

  const scale = map.pedestalScale || 1.45;
  const R = G.hexSize * scale;
  if (!pedDoorA) {
    /* 육각형을 X 축으로 반 갈라 두 짝을 만듭니다.
     * three.js 는 각도 θ 를 (x = r·sinθ, z = r·cosθ) 로 씁니다. 그래서
     *   1.5π 에서 π 만큼  → (-r,0) → z>0 → (r,0)  : +z 쪽 반쪽
     *   0.5π 에서 π 만큼  → (r,0) → z<0 → (-r,0)  : -z 쪽 반쪽
     * 이 됩니다. 이음선이 X 축과 나란하므로 경첩도 그냥 rotation.x 입니다 —
     * 다른 각도로 자르면 축을 맞추려고 그룹을 한 겹 더 씌워야 합니다. */
    const th = G.hexThick * 1.3;
    pedDoorA = new THREE.CylinderGeometry(R * 0.97, R * 0.86, th, 3, 1, false, Math.PI * 1.5, Math.PI);
    pedDoorB = new THREE.CylinderGeometry(R * 0.97, R * 0.86, th, 3, 1, false, Math.PI * 0.5, Math.PI);
    // RingGeometry 는 thetaStart 가 7번째 인자입니다 (phiSegments 다음)
    pedRingGeo = new THREE.RingGeometry(R * 1.02, R * 1.16, 6, 1, HEX_THETA, Math.PI * 2);
  }

  // AABB. 일반 타일과 같은 방식이라 물리 코드를 그대로 씁니다.
  const halfX = R;
  const halfZ = R * Math.sqrt(3) / 2;

  for (const p of map.pedestals) {
    const col = new THREE.Color(0xffffff);
    const mat = new THREE.MeshStandardMaterial({
      color: 0xf2f7ff,
      emissive: 0x88ccff,
      emissiveIntensity: 0.35,
      roughness: 0.45,
      metalness: 0.15,
      transparent: true,
      opacity: 1
    });
    /* mesh 는 이제 Group 입니다. 바깥 코드는 position.y / visible 만 만지므로
     * Mesh 였을 때와 똑같이 동작합니다(위아래 부유, 착지면 계산 전부 그대로). */
    const mesh = new THREE.Group();
    mesh.position.set(p.x, p.y, p.z);

    /* 경첩은 각 문짝의 바깥 모서리에 둡니다. 문짝 메시를 그만큼 반대로
     * 밀어 두었으므로 닫힌 상태의 위치는 종전 한 장짜리와 동일합니다. */
    const hz = halfZ * 0.97;
    const doorA = new THREE.Mesh(pedDoorA, mat);
    doorA.position.z = -hz;
    doorA.receiveShadow = true; doorA.castShadow = true;
    const hingeA = new THREE.Group();
    hingeA.position.z = hz;
    hingeA.add(doorA);

    const doorB = new THREE.Mesh(pedDoorB, mat);
    doorB.position.z = hz;
    doorB.receiveShadow = true; doorB.castShadow = true;
    const hingeB = new THREE.Group();
    hingeB.position.z = -hz;
    hingeB.add(doorB);

    mesh.add(hingeA, hingeB);
    tileGroup.add(mesh);

    /* 관문은 tileGroup 이 아니라 fxGroup 에 둡니다 — 층 반투명 처리
     * (applyLayerTransparency)가 타일 재질을 훑는데, 거기 섞이면 관문까지
     * 같이 흐려집니다. */
    const gate = makeGate(R, 0x88ccff);
    gate.group.position.set(p.x, p.y, p.z);
    fxGroup.add(gate.group);

    const ring = new THREE.Mesh(pedRingGeo, new THREE.MeshBasicMaterial({
      color: 0x88ccff, transparent: true, opacity: 0.55,
      side: THREE.DoubleSide, depthWrite: false, toneMapped: false
    }));
    ring.rotation.x = -Math.PI / 2;
    ring.position.set(p.x, p.y + G.hexThick * 0.68, p.z);
    tileGroup.add(ring);

    G.pedestals.set(p.id, {
      id: p.id, seat: p.seat,
      x: p.x, y: p.y, z: p.z,
      top: p.y + G.hexThick * 1.3 / 2,
      hexR: R,           // 발판은 자기 반지름으로 판정 (타일보다 큼)
      minX: p.x - halfX, maxX: p.x + halfX,
      minZ: p.z - halfZ, maxZ: p.z + halfZ,
      mesh, mat, ring, hingeA, hingeB, gate, baseY: p.y,
      /* 카운트다운 맥동이 되돌아갈 기준 불투명도. 좌석 색이 정해지면
       * 아래 좌석 색 갱신 루프가 이 값을 다시 씁니다. */
      ringBase: 0.55,
      state: 'idle', clearAt: 0, phase: Math.random() * 6.28
    });
  }
  G.pedestalsActive = true;
}

function pedestalForSeat(seat) {
  if (seat === undefined || seat === null) return null;
  for (const rec of G.pedestals.values()) {
    if (rec.seat === seat && rec.state === 'idle') return rec;
  }
  return null;
}

/* 좌석 주인이 정해지면 발판을 그 사람 색으로 물들입니다 */
function tintPedestals() {
  const bySeat = new Map();
  for (const p of G.players.values()) {
    if (p && p.seat !== undefined) bySeat.set(p.seat, p.color);
  }
  for (const rec of G.pedestals.values()) {
    const c = bySeat.get(rec.seat);
    if (c) {
      rec.mat.color.set(c).lerp(new THREE.Color(0xffffff), 0.45);
      rec.mat.emissive.set(c);
      rec.mat.emissiveIntensity = 0.5;
      rec.emiBase = 0.5;
      rec.ring.material.color.set(c);
      rec.ring.material.opacity = 0.75;
      rec.ringBase = 0.75;
    } else {
      rec.mat.color.setHex(0xf2f7ff);
      rec.mat.emissive.setHex(0x88ccff);
      rec.mat.emissiveIntensity = 0.28;
      rec.emiBase = 0.28;
      rec.ring.material.color.setHex(0x88ccff);
      rec.ring.material.opacity = 0.35;
      rec.ringBase = 0.35;
    }
    rec.mat.needsUpdate = true;
  }
}

/* 접수 게이트가 열리는 데 걸리는 시간과 젖혀지는 각도.
 * 1.9 rad ≈ 109도 — 수직(90도)을 넘겨야 문짝이 아래로 늘어져 보입니다. */
const PED_OPEN_MS = 360;
const PED_OPEN_RAD = 1.9;

/* ══════════════════════════════════════════════════════════════════════
 * 빛의 관문 (대기 발판 연출)
 * ────────────────────────────────────────────────────────────────────
 * ★ 이 게임에는 블룸(후처리)이 없습니다. 그래서 '빛남'은 가산 블렌딩으로
 *   만듭니다 — 겹칠수록 밝아지므로 링을 두세 겹 포개면 중심이 하얗게
 *   타오르는 것처럼 보입니다. depthWrite 를 끄는 것도 필수입니다.
 *   켜두면 투명한 링끼리 서로를 가려 겹침이 사라집니다.
 *
 * ★ 텍스처는 파일이 아니라 캔버스로 그립니다. 이 저장소 규칙대로 에셋이
 *   없어도 게임이 돌아야 하기 때문입니다.
 * ══════════════════════════════════════════════════════════════════════ */
let glowTex = null;

function makeGlowTexture() {
  if (glowTex) return glowTex;
  const N = 128;
  const cv = document.createElement('canvas');
  cv.width = cv.height = N;
  const g = cv.getContext('2d');
  const grd = g.createRadialGradient(N / 2, N / 2, 0, N / 2, N / 2, N / 2);
  grd.addColorStop(0.00, 'rgba(255,255,255,1)');
  grd.addColorStop(0.25, 'rgba(255,255,255,0.55)');
  grd.addColorStop(0.60, 'rgba(255,255,255,0.12)');
  grd.addColorStop(1.00, 'rgba(255,255,255,0)');
  g.fillStyle = grd;
  g.fillRect(0, 0, N, N);
  glowTex = new THREE.CanvasTexture(cv);
  glowTex.encoding = THREE.sRGBEncoding;
  return glowTex;
}

/* 관문 = 발판 테두리를 감싸는 두 겹의 링 + 가운데 빛무리.
 * 캐릭터는 이 링 한가운데의 해치를 통해 떨어지므로, 문이 열리며 빛을
 * 뚫고 내려가는 그림이 됩니다. */
let gateRingGeo = null, gateRingGeo2 = null;

function makeGate(R, color) {
  if (!gateRingGeo) {
    gateRingGeo = new THREE.RingGeometry(R * 1.22, R * 1.46, 48);
    gateRingGeo2 = new THREE.RingGeometry(R * 1.02, R * 1.12, 40);
  }
  const gate = new THREE.Group();
  const mk = (geo, y) => {
    const m = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
      color: color, transparent: true, opacity: 0,
      blending: THREE.AdditiveBlending, side: THREE.DoubleSide,
      depthWrite: false, toneMapped: false
    }));
    m.rotation.x = -Math.PI / 2;
    m.position.y = y;
    gate.add(m);
    return m;
  };
  const outer = mk(gateRingGeo, 0.10);
  const inner = mk(gateRingGeo2, 2.30);

  const halo = new THREE.Sprite(new THREE.SpriteMaterial({
    map: makeGlowTexture(), color: color, transparent: true, opacity: 0,
    blending: THREE.AdditiveBlending, depthWrite: false, toneMapped: false
  }));
  /* 빛무리 크기. 가산 블렌딩은 밝은 배경(캔디 스카이 등)에서 금방 포화되어,
   * 크게 잡으면 발판과 캐릭터가 흰 덩어리에 묻힙니다. 발판 지름 정도가 한계입니다. */
  halo.scale.setScalar(R * 1.9);
  halo.position.y = 1.2;
  gate.add(halo);

  return { group: gate, outer, inner, halo };
}

/* 관문이 터지는 순간 — 링이 바깥으로 퍼져 나갑니다.
 * 기존 dashTrails 풀을 그대로 씁니다(수명이 다하면 알아서 정리됩니다). */
function spawnGateFlare(x, y, z, color) {
  const S = G.hexSize || 3.2 / 1.5;
  if (!dashTrailGeo) dashTrailGeo = new THREE.RingGeometry(S * 0.35, S * 0.62, 18);
  for (let i = 0; i < 5; i++) {
    const mat = new THREE.MeshBasicMaterial({
      color: i < 2 ? 0xffffff : color, transparent: true, opacity: 0.95,
      blending: THREE.AdditiveBlending, side: THREE.DoubleSide,
      depthWrite: false, toneMapped: false
    });
    const m = new THREE.Mesh(dashTrailGeo, mat);
    m.position.set(x, y + 0.2 + i * 0.45, z);
    m.rotation.x = -Math.PI / 2;
    m.scale.setScalar(1.6 + i * 0.5);
    fxGroup.add(m);
    dashTrails.push({ mesh: m, mat, life: 0.55 - i * 0.05 });
  }
}

/* 게임 시작 — 발판이 접수 게이트처럼 좌우로 갈라지며 열립니다 */
function clearPedestals() {
  if (!G.pedestalsActive) return;
  G.pedestalsActive = false;
  const now = performance.now();
  /* ★ 시차를 두지 않습니다.
   * state 가 'clearing' 이 되는 순간 findLanding 이 이 발판을 건너뛰므로
   * 지지면은 전원이 동시에 사라집니다. 예전처럼 문 여는 시각만 40ms 씩
   * 늦추면, 아직 닫혀 있는 문을 통과해 떨어지는 사람이 생깁니다. */
  for (const rec of G.pedestals.values()) {
    rec.state = 'clearing';
    rec.clearAt = now;
    if (rec.gate) spawnGateFlare(rec.x, rec.baseY, rec.z, 0x9fe4ff);
  }
  riftAfterglow = 1;     // 하늘 균열이 한 번 확 타올랐다 사그라듭니다
  Sound.sfx('start');
}

function updatePedestals(dt, now) {
  for (const rec of G.pedestals.values()) {
    if (rec.state === 'idle') {
      // 대기 중에는 아주 천천히 위아래로 떠 있습니다
      const bob = Math.sin(now * 0.0011 + rec.phase) * 0.16;
      rec.mesh.position.y = rec.baseY + bob;
      rec.ring.position.y = rec.baseY + bob + G.hexThick * 0.68;
      rec.ring.rotation.z += dt * 0.35;
      rec.top = rec.mesh.position.y + G.hexThick * 1.3 / 2;

      /* ── 카운트다운 맥동 ──────────────────────────────────────────
       * 종전 카운트다운은 화면 한가운데 숫자뿐이라, 내가 서 있는 발판과
       * 아무 관계가 없어 보였습니다. 초가 바뀔 때마다 발밑 링이 같이
       * 번쩍이면 숫자와 발판이 한 사건이 됩니다.
       * 서버 시계(G.serverOffset 보정)를 쓰므로 모든 화면이 같은 박자입니다. */
      if (G.phase === 'countdown' && G.phaseEndsAt) {
        const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
        const frac = (left % 1000) / 1000;      // 초가 바뀌는 순간 1 → 0 으로 감쇠
        const pulse = Math.pow(frac, 2.4);
        rec.ring.material.opacity = Math.min(1, rec.ringBase + 0.55 * pulse);
        rec.ring.scale.setScalar(1 + 0.12 * pulse);
        rec.mat.emissiveIntensity = 0.35 + 1.0 * pulse;
      } else {
        /* 카운트다운이 아니면 항상 기준값으로 되돌립니다.
         * ★ 처음에는 '변형됐을 때만' 되돌리려고 scale !== 1 로 걸렀는데,
         *   맥동 끝자락 값이 1.0000019 처럼 1 에 아주 가깝게 남아 판정이
         *   어긋났습니다. 되돌릴 목적지가 ringBase(좌석 색 갱신이 써 주는
         *   값)라서 매 프레임 덮어써도 싸울 상대가 없습니다 — 조건을 두는
         *   것보다 무조건 맞추는 쪽이 단순하고 정확합니다. */
        rec.ring.scale.setScalar(1);
        rec.ring.material.opacity = rec.ringBase;
        rec.mat.emissiveIntensity = rec.emiBase !== undefined ? rec.emiBase : 0.35;
      }

      /* ── 빛의 관문 ────────────────────────────────────────────────
       * 대기 중에는 은은하게 돌기만 하고, 카운트다운에 들어가면 회전이
       * 빨라지며 밝아집니다. '곧 열린다'가 숫자를 안 봐도 읽혀야 합니다. */
      if (rec.gate) {
        const g = rec.gate;
        let heat = 0;              // 0 = 대기, 1 = 개방 직전
        if (G.phase === 'countdown' && G.phaseEndsAt) {
          const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
          heat = THREE.MathUtils.clamp(1 - left / 5000, 0, 1);
        }
        const spin = 0.35 + heat * 3.2;
        g.outer.rotation.z += dt * spin;
        g.inner.rotation.z -= dt * spin * 1.4;
        /* 초가 바뀔 때마다 한 번 더 번쩍이게 해서 발밑 링 맥동과 박자를 맞춥니다 */
        let beat = 0;
        if (G.phase === 'countdown' && G.phaseEndsAt) {
          const left = Math.max(0, G.phaseEndsAt - (Date.now() + G.serverOffset));
          beat = Math.pow((left % 1000) / 1000, 2.4);
        }
        /* ★ 상한을 1 로 두면 안 됩니다. 가산 블렌딩에서 1 은 이미 '하얗게
         *   탄' 상태라, 배경이 밝은 테마에서는 링 모양 자체가 사라집니다.
         *   링이 보이려면 배경과의 차이가 남아 있어야 합니다. */
        const base = 0.10 + heat * 0.30;
        g.outer.material.opacity = Math.min(0.62, base + beat * 0.26);
        g.inner.material.opacity = Math.min(0.52, base * 0.8 + beat * 0.20);
        g.halo.material.opacity = Math.min(0.30, 0.03 + heat * 0.14 + beat * 0.12);
        g.group.position.y = rec.mesh.position.y;
        g.group.visible = true;
      }
    } else if (rec.state === 'clearing') {
      if (now < rec.clearAt) continue;
      /* ── 접수 게이트 열림 ────────────────────────────────────────
       * 0 ~ 1 : 두 짝이 바깥 모서리를 축으로 아래로 젖혀집니다.
       * 1 ~ 1.6 : 다 열린 뒤 옅어지며 사라집니다.
       * 지지면은 이미 없어졌으므로(state !== 'idle') 주자는 문이 열리는
       * 동안 그 틈으로 떨어집니다 — 그림과 물리가 같은 시각에 일어납니다. */
      const t = (now - rec.clearAt) / PED_OPEN_MS;
      const k = Math.min(1, t);
      const e = 1 - Math.pow(1 - k, 3);        // ease-out: 처음에 확 열립니다
      /* 경첩이 +z 인 문짝은 몸통이 -z 쪽에 있으므로 rotation.x 가 음수일 때
       * 아래로 내려갑니다(y' = -z·sinθ). 반대쪽은 부호만 뒤집습니다. */
      rec.hingeA.rotation.x = -e * PED_OPEN_RAD;
      rec.hingeB.rotation.x = e * PED_OPEN_RAD;
      rec.ring.material.opacity = Math.max(0, rec.ringBase * (1 - k));
      /* 관문은 문이 열리는 동안 빠르게 사그라듭니다 — 빛이 남아 있으면
       * 주자가 그 안으로 떨어지는 그림이 가려집니다. */
      if (rec.gate) {
        const f = Math.max(0, 1 - k * 1.8);
        rec.gate.outer.material.opacity *= f;
        rec.gate.inner.material.opacity *= f;
        rec.gate.halo.material.opacity *= f;
        rec.gate.outer.scale.setScalar(1 + k * 0.5);
        rec.gate.inner.scale.setScalar(1 + k * 0.8);
      }
      if (t >= 1.6) {
        rec.state = 'gone';
        rec.mesh.visible = false;
        rec.ring.visible = false;
        if (rec.gate) rec.gate.group.visible = false;
        continue;
      }
      if (t > 1) rec.mat.opacity = Math.max(0, 1 - (t - 1) / 0.6);
    }
  }
}

/* Upper floors turn translucent once the runner drops below them, so the
 * camera never has an opaque ceiling between it and the player.            */
let lastTransparencyLayer = -1;
/* 내 층에서 몇 층 아래인가에 따른 밝기 배율.
 * 0칸(내 층) · 1칸 · 2칸 · 3칸 이상 순서이고, 마지막 값이 하한입니다. */
const DEPTH_DIM = [1.0, 0.55, 0.42, 0.35];

/* ── 층 반투명 + 아래층 어둡게 ────────────────────────────────────────
 *
 * ★ 위층은 흐리게, 아래층은 어둡게 — 이유가 다릅니다.
 *   위층(0.16)은 '내 시야를 가리니까' 투명하게 만드는 것이고,
 *   아래층은 가릴 일이 없습니다. 아래층 문제는 정반대입니다 —
 *   <b>구멍이 구멍으로 안 보인다</b> 는 것입니다.
 *
 *   종전에는 아래층을 1.0 그대로 뒀습니다. 그래서 발밑에 뚫린 구멍으로
 *   내려다보면 18 아래 층이 '같은 파스텔 팔레트로 또렷하게' 보였고,
 *   바닥인지 구멍인지 구분이 안 됐습니다. 타일과 배경이 안 구분된다는
 *   의견의 상당 부분이 실은 이것이라고 봅니다.
 *
 * ★ 투명도가 아니라 밝기를 낮추는 이유
 *   아래층은 '어디로 떨어질지 고르는' 정보라 반드시 보여야 합니다.
 *   투명하게 하면 더 안 보이게 되고, 뒤의 하늘까지 비쳐 오히려 복잡해집니다.
 *   어둡게만 하면 형태는 남으면서 '저건 아래층'이라는 깊이가 생깁니다.
 *
 * ★ 거리에 비례해 단계적으로 어둡게 하는 이유
 *   한 단계만 어둡게 하면 두 층 아래와 세 층 아래가 같아 보여 깊이가
 *   안 읽힙니다. 실제 대기 원근(멀수록 어둡고 흐림)과 같은 방향입니다.
 * ------------------------------------------------------------------ */
function applyLayerTransparency(currentLayer) {
  if (currentLayer === lastTransparencyLayer) return;
  lastTransparencyLayer = currentLayer;
  // 층 번호가 클수록 위입니다(서버 파생 규칙). 층이 몇 개든 그대로 성립합니다.
  const order = G.layerOrder;
  const here = order.indexOf(currentLayer);
  for (let i = 0; i < order.length; i++) {
    const L = order[i];
    const above = L > currentLayer;
    const target = above ? 0.16 : 1.0;
    /* 내 층보다 아래로 몇 칸인가. 위층·내 층은 0 이라 배율이 1 입니다.
     * 층 번호를 빼서 세지 않습니다 — 번호가 연속이라는 보장을 코드가
     * 갖게 되면 층 구성을 바꿀 때 조용히 틀립니다. */
    const below = (here < 0 || above) ? 0 : Math.max(0, i - here);
    const dim = DEPTH_DIM[Math.min(below, DEPTH_DIM.length - 1)];
    for (const rec of G.layerTiles[L]) {
      if (rec.state === 'gone') continue;
      rec.targetOpacity = target;
      rec.depthDim = dim;
    }
    /* 난간도 같이 어둡게. 안 하면 어두워진 바닥 위에 난간만 밝게 떠서
     * '저 아래 층'이 아니라 '가까운 무언가'로 읽힙니다.
     * ★ 여기서는 배율만 적어 둡니다. 실제 opacity 는 updateFenceEdge 가
     *   매 프레임 정합니다 — 근접 강조와 여기가 같은 값을 서로 덮어쓰면
     *   층을 옮길 때마다 강조가 한 번씩 꺼집니다.                   */
    for (const m of G.fences) {
      if (m.userData.layerIndex !== L) continue;
      m.userData.layerMul = above ? 0.16 : dim;
    }
  }
}


/* ============================ 4.5 오디오 =============================== *
 * 배경음 + 효과음 관리자.
 *
 *  · 브라우저 자동재생 정책 때문에 첫 사용자 클릭(참가 버튼) 전에는 소리를
 *    낼 수 없습니다. 그래서 join 시점에 unlock() 을 호출합니다.
 *  · 배경음은 HTMLAudioElement 로 스트리밍(mp3 전체를 받지 않아도 시작),
 *    효과음은 Web Audio 버퍼로 재생(지연 없음 + 동시에 여러 개 겹침).
 *  · 파일이 없으면 조용히 넘어갑니다. 오디오 때문에 게임이 멈추지 않습니다.
 *  · 배경음 교체: 아래 BGM 경로만 바꾸면 됩니다.
 *  · 효과음 추가: SFX 에 한 줄 추가하고 Sound.sfx('이름') 을 호출하면 됩니다.
 * ======================================================================= */

/* 게임 상황별 배경음. 지금은 한 파일을 공유합니다.
 * 상황별로 다른 곡을 쓰려면 경로만 나눠 주세요.
 * (같은 경로면 상황이 바뀌어도 끊기지 않고 계속 재생됩니다)             */
/* 대기 화면에서 첫 조작을 받아 오디오를 열었는가.
 *
 * ★ 선언이 여기 있는 이유 — TDZ.
 *   이 값을 읽는 것은 syncJoinSnd 이고, syncJoinSnd 는 refreshAudioUI 가
 *   부릅니다. refreshAudioUI 는 초기화 구간에서 한 번 불리는데, 그 시점은
 *   파일 아래쪽의 로비 오디오 블록보다 앞입니다. 거기에 let 으로 선언해
 *   두면 '초기화 전 접근' 으로 터지고, 그 예외가 초기화를 통째로 끊습니다
 *   (실제로 그렇게 났습니다 — 참가 화면 소리 버튼이 아무 반응도 안 했습니다).
 *   const 는 호이스팅돼도 초기화 전에는 못 읽으므로, 읽는 쪽보다 먼저
 *   실행되는 자리에 두어야 합니다.                                    */
let lobbyAudioArmed = false;

/* ══════════════════════════════════════════════════════════════════════
 * 배경음 파일 이름 규칙
 * ────────────────────────────────────────────────────────────────────
 * 전부 public/assets/audio/ 에 둡니다. **모두 선택 사항**입니다 —
 * 없으면 공통 곡(bgm_main.mp3)으로 자동으로 내려앉고, 그것도 없으면
 * 조용히 무음으로 갑니다. 게임은 어느 경우에도 그대로 돌아갑니다.
 *
 *   bgm_main.mp3     공통 폴백. 아래 파일이 하나도 없어도 이것만 있으면
 *                    종전과 똑같이 동작합니다.
 *   bgm_lobby.mp3    대기 화면 · 카운트다운
 *   bgm_result.mp3   결과 화면
 *   bgm_map1.mp3     1번 맵 — 캔디 스카이
 *   bgm_map2.mp3     2번 맵 — 네온 아레나
 *   bgm_map3.mp3     3번 맵 — 새벽 구름
 *
 * ★ 왜 맵 이름이 아니라 번호인가
 *   THEMES 의 이름(캔디 스카이…)은 언제든 바뀔 수 있는 표시용 문구이고,
 *   파일 이름이 거기 묶이면 이름을 고치는 순간 음악이 조용히 사라집니다.
 *   번호는 THEMES 배열의 순서 그 자체라 흔들리지 않습니다.
 *   맵을 4개로 늘리면 bgm_map4.mp3 가 자동으로 후보가 됩니다.
 *
 * ★ 왜 라운드 중(play)만 맵별인가
 *   대기 화면은 아직 어느 맵을 달릴지 모르는 시간이고, 결과 화면은
 *   8초입니다. 맵마다 세 곡씩 아홉 곡을 만들 일이 아닙니다 —
 *   '이 맵의 노래'는 실제로 그 맵을 달리는 동안에만 의미가 있습니다.
 *
 * ★ 형식: mp3 권장(모든 브라우저 공통). 반복 재생되므로 앞뒤가 자연스럽게
 *   이어지는 루프가 좋습니다. 파일은 압축하지 않고 그대로 나갑니다
 *   (server.js PRECOMPRESSED) — 용량을 직접 줄여 두세요.
 * ------------------------------------------------------------------ */
const BGM_DIR = 'assets/audio/';
const BGM_FALLBACK = BGM_DIR + 'bgm_main.mp3';

/* 페이즈별 후보. 앞에서부터 '없는 파일'을 건너뛰며 고릅니다.
 * themeIndex 는 0부터입니다 — 파일 이름은 사람이 세는 1부터입니다.   */
function bgmCandidates(phaseKey, themeIndex) {
  const list = [];
  if (phaseKey === 'play' && themeIndex >= 0) {
    list.push(BGM_DIR + 'bgm_map' + (themeIndex + 1) + '.mp3');
  } else if (phaseKey === 'lobby') {
    list.push(BGM_DIR + 'bgm_lobby.mp3');
  } else if (phaseKey === 'result') {
    list.push(BGM_DIR + 'bgm_result.mp3');
  }
  list.push(BGM_FALLBACK);
  return list;
}

/* 효과음. { 경로, 볼륨 } — 파일이 없으면 그냥 무시됩니다. */
const SFX = {
  start:     { src: 'assets/audio/sfx_start.mp3',     volume: 0.9 },
  tick:      { src: 'assets/audio/sfx_tick.mp3',      volume: 0.6 },
  step:      { src: 'assets/audio/sfx_step.mp3',      volume: 0.5 },
  crack:     { src: 'assets/audio/sfx_crack.mp3',     volume: 0.7 },
  jump:      { src: 'assets/audio/sfx_jump.mp3',      volume: 0.6 },
  land:      { src: 'assets/audio/sfx_land.mp3',      volume: 0.5 },
  death:     { src: 'assets/audio/sfx_death.mp3',     volume: 0.9 },
  eliminate: { src: 'assets/audio/sfx_eliminate.mp3', volume: 0.7 },
  booster:   { src: 'assets/audio/sfx_booster.mp3',   volume: 0.8 },
  obstacle:  { src: 'assets/audio/sfx_obstacle.mp3',  volume: 0.7 },
  impact:    { src: 'assets/audio/sfx_impact.mp3',    volume: 0.8 },
  win:       { src: 'assets/audio/sfx_win.mp3',       volume: 1.0 },
  lose:      { src: 'assets/audio/sfx_lose.mp3',      volume: 0.9 },
  /* 점프 타일 — 올라가는 층수마다 다릅니다(JUMP_TILE.levels). 파일이
   * 없으면 버퍼가 안 생기므로 applyJumpImpulse 가 기본 점프 소리로
   * 받쳐 줍니다.                                                    */
  stairJump1: { src: 'assets/audio/sfx_stair_jump_1.mp3', volume: 0.95 },
  stairJump2: { src: 'assets/audio/sfx_stair_jump_2.mp3', volume: 0.95 },
  /* UI 클릭. 화면 조작이라 게임 소리보다 작게 둡니다 — 같은 크기면
   * 대기 화면에서 버튼을 누를 때마다 배경음을 뚫고 튀어나옵니다.    */
  click:      { src: 'assets/audio/sfx_click.mp3',        volume: 0.5 },

  /* ── 2026-09-17 추가 ────────────────────────────────────────────
   * 바닥을 밟는 소리를 <b>첫 번째와 두 번째로 나눴습니다.</b>
   * 바닥은 두 번 밟아야 무너지는데, 소리가 같으면 지금 밟은 것이
   * 몇 번째인지 <b>화면을 봐야만</b> 알 수 있습니다. 발밑은 달리는
   * 동안 시선이 가장 덜 가는 곳이라, 두 번째를 소리로 알려 줍니다.
   * ------------------------------------------------------------ */
  tile1:      { src: 'assets/audio/sfx_tile1.mp3',        volume: 0.55 },  // 첫 밟기 — 금이 감
  tile2:      { src: 'assets/audio/sfx_tile2.mp3',        volume: 0.75 },  // 두 번째 — 곧 무너짐
  bomb:       { src: 'assets/audio/sfx_bomb.mp3',         volume: 1.0 },   // 거절이유 타일 폭발
  boost:      { src: 'assets/audio/sfx_boost.mp3',        volume: 0.9 },   // 신속심사 사출
  powerDown:  { src: 'assets/audio/sfx_power_down.mp3',   volume: 0.85 },  // 암전 시작
  powerUp:    { src: 'assets/audio/sfx_power_up.mp3',     volume: 0.8 },   // 암전 끝
  countGo:    { src: 'assets/audio/sfx_2_1_go.mp3',       volume: 1.0 },   // 2 · 1 · GO
  /* 관전자가 보정 기회를 쓴 순간. 종전에는 이 사건에 소리가 아예
   * 없었습니다 — 화면에 토스트만 떴습니다.                          */
  opportunity: { src: 'assets/audio/sfx_opportunity.mp3', volume: 0.95 }
};

const Sound = {
  ctx: null,
  master: null, bgmGain: null, sfxGain: null,
  el: null, elSrc: null,          // 현재 재생 중인 배경음
  /* 지금 걸려 있는 페이즈. 맵이 바뀌었을 때 '라운드 중인가' 를 보고
   * 곡을 갈아 끼울지 정합니다(applyTheme 끝부분).                    */
  phaseKey: null,
  elNext: null, nextSrc: null,    // 크로스페이드 대상
  buffers: {},                    // 디코딩된 효과음
  missing: {},                    // 없는 파일 (재시도 방지)
  have: {},                       // 배경음 파일 존재 여부 (probe 결과 캐시)
  unlocked: false,
  muted: false,
  vol: { master: 0.8, bgm: 0.45, sfx: 0.85 },
  fadeTimer: null,

  /* 설정 저장/복원 (실패해도 무시) */
  load() {
    try {
      const raw = localStorage.getItem('ipg_audio');
      if (raw) {
        const s = JSON.parse(raw);
        if (s && s.vol) Object.assign(this.vol, s.vol);
        this.muted = !!(s && s.muted);
      }
    } catch (e) { /* 저장소를 못 쓰는 환경 */ }
  },
  save() {
    try {
      localStorage.setItem('ipg_audio', JSON.stringify({ vol: this.vol, muted: this.muted }));
    } catch (e) { /* 무시 */ }
  },

  /* 첫 사용자 제스처에서 호출해야 소리가 납니다 */
  unlock() {
    if (this.unlocked) return;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) { this.unlocked = true; return; }   // Web Audio 미지원이어도 배경음은 동작
    try {
      this.ctx = new AC();
      this.master = this.ctx.createGain();
      this.bgmGain = this.ctx.createGain();
      this.sfxGain = this.ctx.createGain();
      this.bgmGain.connect(this.master);
      this.sfxGain.connect(this.master);
      this.master.connect(this.ctx.destination);
      this.applyVolume();
      if (this.ctx.state === 'suspended') this.ctx.resume();
    } catch (e) {
      console.warn('[IPG] 오디오 초기화 실패:', e && e.message);
      this.ctx = null;
    }
    this.unlocked = true;
    for (const key of Object.keys(SFX)) this.preload(key);
  },

  applyVolume() {
    const m = this.muted ? 0 : this.vol.master;
    if (this.master) this.master.gain.value = m;
    if (this.sfxGain) this.sfxGain.gain.value = this.vol.sfx;
    if (this.el) this.el.volume = Math.min(1, m * this.vol.bgm);
    if (this.elNext) this.elNext.volume = 0;
  },

  setVolume(kind, value) {
    this.vol[kind] = Math.max(0, Math.min(1, value));
    this.applyVolume();
    this.save();
  },

  toggleMute() {
    this.muted = !this.muted;
    this.applyVolume();
    if (!this.muted && this.el && this.el.paused) this.el.play().catch(() => {});
    this.save();
    return this.muted;
  },

  /* ---------------- 배경음 ---------------- */
  /* 이 파일이 있는가. 결과는 have 에 캐시해 한 번만 물어봅니다.
   *
   * ★ 왜 <audio> 의 error 이벤트를 안 쓰는가
   *   없는 파일(404)에 대해 크롬은 error 를 쏘지 않습니다. stalled 만
   *   한 번 남기고 networkState 를 LOADING 에 둔 채 멈춰 있습니다
   *   (실측: loadstart 직후 → 3.3초 뒤 stalled · error 없음 · readyState 0).
   *   그 상태로 두면 '없으면 공통 곡으로'가 아예 동작하지 않고 배경음이
   *   조용히 안 나옵니다 — 맵별 곡을 아직 안 만든 지금이 바로 그 상태입니다.
   *   그래서 재생 전에 HEAD 로 한 번 물어봅니다. 같은 주소(?v= 포함)라
   *   실제 재생 요청은 캐시를 씁니다.                                */
  probe(src) {
    if (this.have[src] !== undefined) return Promise.resolve(this.have[src]);
    const done = (ok) => {
      this.have[src] = ok;
      if (!ok) {
        this.missing[src] = true;
        /* 맵별 곡은 '아직 안 만든 것'이 정상입니다 — 오류가 아니라 안내. */
        console.log('[IPG] 배경음 없음 → 다음 후보로: ' + src);
      }
      return ok;
    };
    return fetch(assetUrl(src), { method: 'HEAD' })
      .then((r) => done(r.ok))
      .catch(() => done(false));
  },

  playBgm(phaseKey) {
    if (!this.unlocked) return;
    this.phaseKey = phaseKey;
    /* ★ 반드시 '순서대로' 걸어야 합니다.
     *   종전에는 '있다고 확인된 아무 후보'를 먼저 찾았는데, 공통 곡이
     *   대기 화면에서 한 번 확인되고 나면 맵별 곡은 물어보지도 않고
     *   공통 곡으로 가 버립니다 — 맵별 음악이 영영 안 걸립니다.     */
    for (const c of bgmCandidates(phaseKey, currentTheme)) {
      if (this.have[c] === false) continue;          // 없는 것으로 확인됨
      if (this.have[c] === true) { this.startBgm(c); return; }
      /* 아직 모름 — 물어보고 다시 들어옵니다. 그 사이 페이즈가 바뀌었으면
       * 그때 것이 우선이므로 버립니다.                              */
      this.probe(c).then(() => {
        if (this.phaseKey === phaseKey) this.playBgm(phaseKey);
      });
      return;
    }
  },

  startBgm(src) {
    if (this.elSrc === src && this.el && !this.el.paused) return;   // 같은 곡이면 유지
    if (this.nextSrc === src) return;                // 이미 이 곡으로 넘어가는 중

    const next = new Audio(assetUrl(src));
    next.loop = true;
    next.volume = 0;
    next.preload = 'auto';
    /* ★ 이 핸들러는 '은퇴시킬 때' 반드시 떼야 합니다.
     *   크로스페이드가 끝나면 이전 곡의 src 를 비우는데, src 를 빈 문자열로
     *   두면 브라우저가 error 이벤트를 쏩니다(Empty src attribute).
     *   그걸 '파일이 없다'로 받아 missing 에 적어 버리면, 세 페이즈가 모두
     *   같은 파일을 쓰는 지금 구성에서는 첫 전환 한 번에 배경음이 영영
     *   꺼집니다. 실제로 그렇게 되고 있었습니다.                        */
    /* ★ probe 를 통과했는데도 재생이 안 되는 경우의 안전망입니다
     *   (파일은 있는데 깨졌거나 브라우저가 못 읽는 형식일 때).
     *   '없는 파일'은 여기가 아니라 probe 가 걸러냅니다.           */
    next._onErr = () => {
      if (this.el !== next && this.elNext !== next) return;   // 이미 은퇴한 요소
      this.missing[src] = true;
      this.have[src] = false;
      console.warn('[IPG] 배경음을 재생할 수 없습니다(형식 확인): ' + src);
      if (this.fadeTimer) { clearInterval(this.fadeTimer); this.fadeTimer = null; }
      if (this.elNext === next) { this.elNext = null; this.nextSrc = null; }
      /* ★ error 가 크로스페이드(0.9초)보다 늦게 올 수 있습니다. 그러면
       *   죽은 요소가 이미 this.el 로 승격된 뒤라, elNext 만 보고
       *   되돌리면 다음 페이즈 전환까지 무음이 됩니다 — 종전에 배경음이
       *   영영 꺼지던 것과 같은 모양의 버그입니다. 양쪽 다 봅니다. */
      if (this.el === next) { this.retire(next); this.el = null; this.elSrc = null; }
      this.playBgm(this.phaseKey);
    };
    next.addEventListener('error', next._onErr);

    const started = next.play();
    if (started && started.catch) {
      started.catch((err) => {
        // 자동재생 차단 등. 다음 클릭에서 다시 시도합니다.
        console.warn('[IPG] 배경음 재생 보류:', err && err.name);
      });
    }

    this.elNext = next;
    this.nextSrc = src;
    this.crossfade(900);
  },

  /* 오디오 요소 정리. src 를 비우기 전에 error 핸들러를 떼는 것이 핵심입니다. */
  retire(a) {
    if (!a) return;
    try {
      if (a._onErr) { a.removeEventListener('error', a._onErr); a._onErr = null; }
      a.pause();
      a.removeAttribute('src');
      a.load();            // 버퍼를 놓아 줍니다 (메모리)
    } catch (e) {}
  },

  crossfade(ms) {
    if (this.fadeTimer) clearInterval(this.fadeTimer);
    const from = this.el, to = this.elNext;
    const target = this.muted ? 0 : this.vol.master * this.vol.bgm;
    const t0 = performance.now();
    this.fadeTimer = setInterval(() => {
      const k = Math.min(1, (performance.now() - t0) / ms);
      if (to) { try { to.volume = target * k; } catch (e) {} }
      if (from) { try { from.volume = target * (1 - k); } catch (e) {} }
      if (k >= 1) {
        clearInterval(this.fadeTimer);
        this.fadeTimer = null;
        this.retire(from);
        this.el = to;
        this.elSrc = this.nextSrc;
        this.elNext = null;
        this.nextSrc = null;
      }
    }, 40);
  },

  stopBgm() {
    if (this.fadeTimer) { clearInterval(this.fadeTimer); this.fadeTimer = null; }
    for (const a of [this.el, this.elNext]) this.retire(a);
    this.el = this.elNext = null;
    this.elSrc = this.nextSrc = null;
  },

  /* ---------------- 효과음 ---------------- */
  preload(key) {
    const def = SFX[key];
    if (!def || !this.ctx || this.buffers[key] || this.missing[def.src]) return;
    fetch(assetUrl(def.src))
      .then((r) => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.arrayBuffer(); })
      .then((buf) => new Promise((res, rej) => {
        // 구형 문법 콜백까지 지원
        const p = this.ctx.decodeAudioData(buf, res, rej);
        if (p && p.then) p.then(res, rej);
      }))
      .then((decoded) => { this.buffers[key] = decoded; })
      .catch(() => { this.missing[def.src] = true; });
  },

  /**
   * 효과음 재생.
   *   opts.pos   : {x,y,z} 를 주면 카메라와의 거리로 음량을 줄입니다
   *   opts.rate  : 재생 속도(피치). 0.9~1.1 로 흔들면 반복이 덜 지루합니다
   *   opts.volume: 추가 배율
   */
  sfx(key, opts) {
    if (!this.unlocked || this.muted || !this.ctx) return;
    const def = SFX[key];
    const buf = this.buffers[key];
    if (!def || !buf) return;

    let vol = def.volume * (opts && opts.volume !== undefined ? opts.volume : 1);
    if (opts && opts.pos) {
      const d = Math.hypot(opts.pos.x - camTarget.x, opts.pos.y - camTarget.y, opts.pos.z - camTarget.z);
      vol *= Math.max(0, 1 - d / 60);
      if (vol <= 0.01) return;
    }

    try {
      const src = this.ctx.createBufferSource();
      src.buffer = buf;
      src.playbackRate.value = (opts && opts.rate) || 1;
      const g = this.ctx.createGain();
      g.gain.value = vol;
      src.connect(g);
      g.connect(this.sfxGain);
      src.start(0);
    } catch (e) { /* 재생 실패는 무시 */ }
  }
};
Sound.load();

/* ============================ 5. 3D 캐릭터 ============================== *
 * 두 가지 경로를 지원합니다.
 *
 *  A) assets/character.glb 가 있으면 → 진짜 3D 모델 + 스켈레탈 애니메이션
 *  B) 없으면 → 절차적 3D 치비 캐릭터 (지오메트리로 조립, 에셋 불필요)
 *
 * 두 경로 모두 동일한 인터페이스를 노출하므로 나머지 코드는 신경 쓰지 않습니다.
 * ======================================================================== */

/* 색의 상대 휘도 (WCAG). 이름표 글자색을 흑/백 중 무엇으로 할지 정합니다. */
function relLuminance(hex) {
  const c = new THREE.Color(hex);
  const f = (v) => (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
  return 0.2126 * f(c.r) + 0.7152 * f(c.g) + 0.0722 * f(c.b);
}

/* 배경색 위에 흑·백 중 어느 글자가 더 잘 읽히는지 — 대비비를 직접 재서
 * 큰 쪽을 돌려줍니다.
 *
 * ★ '휘도가 절반보다 밝으면 검정' 같은 감으로 잡은 임계값을 쓰면 안 됩니다.
 *   실제로 처음에 0.42 로 잡았다가 핑크(#ff5599, 휘도 0.30)에 흰 글자가
 *   붙었는데, 그 조합은 대비 3.0:1 인 반면 검정이면 7.0:1 이었습니다.
 *   경계는 0.5 근처가 아니라 √(1.05×0.05)−0.05 ≈ 0.179 이고, 이건
 *   외우는 것보다 두 값을 재서 비교하는 편이 안전합니다.
 *   (WCAG 대비비 = (밝은휘도+0.05) / (어두운휘도+0.05))               */
function inkOn(hex) {
  const L = relLuminance(hex);
  const vsWhite = 1.05 / (L + 0.05);      // 흰 글자를 올렸을 때
  const vsBlack = (L + 0.05) / 0.05;      // 검정 글자를 올렸을 때
  return vsBlack >= vsWhite ? '#0a0c10' : '#ffffff';
}

/* ── 이름표 ───────────────────────────────────────────────────────────
 * ★ 종전에는 배경이 전부 검정이고 왼쪽 5px 만 좌석 색이었습니다.
 *   이름표는 원거리에서 캐릭터보다 크게 보이는 유일한 요소인데, 320px 중
 *   1.5% 만 구분에 쓰고 있었던 셈입니다. 배경 전체를 좌석 색으로 칠하면
 *   이름 글자를 못 읽는 거리에서도 '색 덩어리'로 누군지 알 수 있습니다.
 *
 * ★ 좌석 번호 칩을 함께 답니다.
 *   색만으로 가면 적록색약에서 노랑(#ffcc00)과 연두(#66ff66)가 붙습니다.
 *   숫자는 색이 안 보여도 읽히므로, 발밑 링 모양(makeColorRing)과 함께
 *   '색에 의존하지 않는 구분 수단' 두 겹을 만듭니다.
 *
 * ★ 어두운 테두리는 필수입니다. 배경(하늘)이 밝은 테마에서 밝은 좌석 색
 *   이름표를 그대로 두면 하늘에 녹아 사라집니다.
 * ------------------------------------------------------------------ */
function makeNameplate(text, colorHex, seat) {
  const W = 320, H = 84, TOP = 16, BH = 52;
  const c = document.createElement('canvas');
  c.width = W; c.height = H;
  const g = c.getContext('2d');

  const ink = inkOn(colorHex);   // 흑/백 중 대비가 큰 쪽 (inkOn 주석 참고)

  // 바깥 어두운 테두리 → 밝은 하늘에서도 윤곽이 남습니다
  g.fillStyle = 'rgba(5,6,10,0.85)';
  g.fillRect(0, TOP - 3, W, BH + 6);
  // 본체 = 좌석 색
  g.fillStyle = colorHex;
  g.fillRect(3, TOP, W - 6, BH);

  // 좌석 번호 칩 (좌석이 없으면 = 관전자 등 생략)
  let textLeft = 3;
  if (seat !== undefined && seat !== null) {
    const CW = 52;
    g.fillStyle = 'rgba(5,6,10,0.86)';
    g.fillRect(3, TOP, CW, BH);
    g.font = '800 34px "Noto Sans KR", sans-serif';
    g.fillStyle = colorHex;
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    g.fillText(String(seat + 1), 3 + CW / 2, TOP + BH / 2 + 1);
    textLeft = 3 + CW;
  }

  g.font = '700 30px "Noto Sans KR", sans-serif';
  g.fillStyle = ink;
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.fillText(text, textLeft + (W - 3 - textLeft) / 2, TOP + BH / 2 + 1);

  const tex = new THREE.CanvasTexture(c);
  tex.encoding = THREE.sRGBEncoding;
  const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false }));
  spr.scale.set(7.2, 1.9, 1);
  spr.renderOrder = 999;
  return spr;
}

/* ---------------------------------------------------------------------------
