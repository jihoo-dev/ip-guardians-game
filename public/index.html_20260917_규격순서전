/* ══════════════════════════════════════════════════════════════════════
 * 알림(토스트)
 * ────────────────────────────────────────────────────────────────────
 * 테스터 의견: "효과 알림이 너무 잦게 떠서 몰입이 어렵다."
 * 세어 보니 한 회차에 뜨는 줄의 대부분이 <b>내가 몰라도 되는 것</b>이었습니다.
 *
 *   ① 이미 화면에 떠 있는 것을 또 말함
 *      어둠은 전면 배너(#darkAlert)가 켜져 있는 내내 화면을 덮고 있는데,
 *      토스트가 18초마다(지속 8초 + 간격 10초) 같은 말을 반복했습니다.
 *   ② 남이 한 일을 중계함
 *      "○○ 님이 선행기술을 조사합니다" 류. 5층 타일의 20%가 검색
 *      타일이라 4인 게임에서 가장 잦은 줄이 이것이었습니다. 게다가
 *      검색 펄스·폭발·되살아나는 타일은 <b>3D 화면에 이미 보입니다</b> —
 *      글자는 같은 사건을 두 번째로 말하는 것이었습니다.
 *   ③ 같은 줄이 연달아 뜸
 *      위치 보정, 착지 실패, 개입 거절처럼 원인이 지속되는 동안
 *      매번 새 줄이 쌓였습니다.
 *
 * 그래서 두 가지만 넣었습니다.
 *
 *   level: 'info'  — 남의 행동·입퇴장처럼 <b>몰라도 되는 것</b>. 기본으로
 *                     띄우지 않습니다. 화면에 이미 연출이 있습니다.
 *   key            — 같은 key 는 gapMs 안에 다시 뜨지 않습니다.
 *                     gapMs: Infinity 면 "회차당 한 번" 이 됩니다
 *                     (clearToastKeys 가 회차마다 비웁니다).
 *
 * ★ 전역 시간 제한(초당 몇 줄)은 일부러 넣지 않았습니다.
 *   중요한 줄 둘이 같은 순간에 오는 경우(착지 실패 + 탈락)가 실제로
 *   있는데, 시간으로 자르면 그때 어느 쪽이 사라질지 고를 수 없습니다.
 *   등급과 key 로 <b>무엇을</b> 줄일지 정하는 편이 예측 가능합니다.
 *
 * ★ 되살리는 법: 콘솔에서
 *     localStorage.setItem('ipg.toastInfo', '1')
 *   하고 새로고침하면 info 까지 전부 다시 뜹니다. 지운 것이 아니라
 *   꺼 둔 것이라, 행사장에서 "그 줄이 보고 싶다"가 나오면 바로 됩니다.
 * ══════════════════════════════════════════════════════════════════ */
const TOAST_DEDUP_MS = 6000;          // key 를 준 알림의 기본 재표시 간격
const toastSeen = new Map();          // key → 마지막으로 띄운 시각
let toastShowInfo = false;
try { toastShowInfo = localStorage.getItem('ipg.toastInfo') === '1'; } catch (e) {}

/* 회차가 바뀌면 "회차당 한 번" 짜리를 다시 쓸 수 있게 비웁니다. */
function clearToastKeys() { toastSeen.clear(); }

function toast(text, kind, opt) {
  const o = opt || {};
  if (o.level === 'info' && !toastShowInfo) return;
  if (o.key) {
    const now = Date.now();
    const gap = o.gapMs === undefined ? TOAST_DEDUP_MS : o.gapMs;
    const last = toastSeen.get(o.key);
    if (last !== undefined && now - last < gap) return;
    toastSeen.set(o.key, now);
  }
  const el = document.createElement('div');
  el.className = 'toast ' + (kind || '');
  el.textContent = text;
  dom.toasts.appendChild(el);
  setTimeout(() => {
    el.style.transition = 'opacity .35s';
    el.style.opacity = '0';
    setTimeout(() => el.remove(), 400);
  }, 3600);
  /* 동시 표시 2개. 종전 4개는 층 특성 3종이 겹치던 시절의 값이라
   * 화면 위쪽이 문구로 덮였습니다. 겹치면 읽히지 않으므로 줄입니다. */
  while (dom.toasts.children.length > 2) dom.toasts.firstChild.remove();
}

