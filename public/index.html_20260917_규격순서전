/* ============================ 3. three.js core ========================== */

/* ── 렌더 해상도 상한 (MAX_PIXEL_RATIO) ──────────────────────────────
 * ★ 성능이 안 나올 때 이 값부터 낮추고 싶어지는데, 그래봐야 소용없습니다.
 *
 * 카메라·조명·타일을 전부 고정하고 DPR 만 번갈아 재봤습니다
 * (타일 845개, 드로우콜 375 고정, 배치 6회×15프레임의 최솟값):
 *     DPR 2.0 → 6.27 / 6.35 ms   (3.45 Mpx)
 *     DPR 1.5 → 7.03 / 6.89 ms   (1.94 Mpx)
 *     DPR 1.0 → 6.05 ms          (0.86 Mpx)
 * 픽셀을 4배 줄여도 비용이 그대로입니다 — fill 병목이 아닙니다.
 *
 * 진짜 병목은 드로우콜입니다. 해상도를 고정한 채 보이는 타일 수만 바꾸면
 * 비용이 그대로 따라옵니다 (388콜 8.29ms / 129콜 3.22ms / 29콜 1.82ms
 * ≈ 콜당 18µs). 타일 하나하나가 개별 메시라서 그렇습니다.
 * 성능을 손보려면 여기가 아니라 InstancedMesh 쪽을 보세요.
 *
 * 층을 3→5 로 늘린 것 자체는 거의 영향이 없었습니다 — 프러스텀 컬링으로
 * 아래 층이 대부분 화면 밖입니다 (3층 32.6fps vs 5층 34.7fps, 노이즈 이내).
 * ------------------------------------------------------------------ */
/* ── 터치 기기 판정 (IS_TOUCH) ───────────────────────────────────────
 * ★ maxTouchPoints 만 보면 터치 패널 달린 노트북이 전부 걸립니다.
 *   묻고 싶은 것은 "터치가 되는가"가 아니라 "주 입력 장치가
 *   손가락인가" 이므로 pointer:coarse 와 함께 봐야 합니다.
 *   이 값이 조작 방식·화질 상한·HUD 배치를 한꺼번에 가릅니다.  */
const IS_TOUCH = (() => {
  /* ★ ?touch=1 / ?touch=0 으로 강제할 수 있습니다.
   *   행사 전 점검을 PC 에서 해야 하는데, 터치 조작은 실제 폰을
   *   붙이지 않으면 확인할 방법이 없었습니다. 반대로 터치 노트북에서
   *   키보드로 하고 싶을 때 끄는 용도이기도 합니다.               */
  try {
    const q = new URLSearchParams(location.search).get('touch');
    if (q === '1') return true;
    if (q === '0') return false;
    return matchMedia('(pointer: coarse)').matches &&
           (navigator.maxTouchPoints || 0) > 0;
  } catch (e) { return 'ontouchstart' in window; }
})();

/* ★ 폰은 DPR 이 3 인 것이 흔합니다. 데스크톱과 같은 상한 2 를 그대로
 *   쓰면 6.7인치 화면에 PC 모니터보다 많은 화소를 그리게 되고, 몇 분
 *   만에 발열로 클럭이 떨어집니다. 상한만 낮춰도 최고 단계의 화소가
 *   1/1.8 이 되며, 화면이 작아 흐려진 것은 눈에 띄지 않습니다.   */
const MAX_PIXEL_RATIO = IS_TOUCH ? 1.5 : 2;

/* ══════════════════════════════════════════════════════════════════════
 * 적응형 품질
 * ────────────────────────────────────────────────────────────────────
 * 개발 노트북에서는 렌더 6ms + 로직 0.7ms 로 예산 16.7ms 의 40% 였는데,
 * 사무용 PC 처럼 3배 느린 기기에서는 이게 그대로 예산을 넘겨 '툭툭
 * 끊기는' 증상이 됩니다. 기기를 바꿀 수 없으니 그리는 양을 기기에
 * 맞춥니다.
 *
 * ★ 무엇을 줄이고 무엇을 안 줄였는지 (전부 실측 기준)
 *
 *   줄인 것 — 픽셀 수.
 *     픽셀을 1/4 로 줄였을 때 19% 빨라졌습니다. 런타임에 바꿔도 셰이더
 *     재컴파일이 없어, 끊김 없이 적용되는 유일한 큰 손잡이입니다.
 *
 *   줄이지 않은 것 — 아래 층 숨기기.
 *     그럴듯해 보이지만 재보니 층을 3→5 로 늘려도 차이가 노이즈 이내
 *     였습니다(32.6 vs 34.7fps). 프러스텀 컬링이 이미 아래 층을 대부분
 *     걸러내고 있어서, 숨겨봐야 원래 안 그리던 것을 안 그릴 뿐입니다.
 *     반면 '구멍 아래가 보여야 어디로 떨어질지 고른다'는 설계는 깨집니다.
 *
 *   시작할 때만 정하는 것 — 안티앨리어싱 · 그림자.
 *     둘 다 런타임에 끄면 재질 1,683개의 셰이더가 한꺼번에 다시
 *     컴파일되어, 끊김을 없애려다 몇 초짜리 정지를 만듭니다.
 *     그래서 이 둘은 기기를 먼저 보고 '만들 때' 정하고 이후 건드리지
 *     않습니다. 타일은 그림자를 받기만 하지만(receiveShadow), 내장
 *     그래픽에서는 그 PCFSoft 샘플링 자체가 픽셀당 비용이라 큽니다.
 * ══════════════════════════════════════════════════════════════════ */

/* 0=정상 GPU · 1=약한 내장그래픽 · 2=소프트웨어 렌더러(드라이버 없음) */
function probeGpuTier() {
  let name = '';
  try {
    /* 진짜 렌더러를 만들기 전에 알아야 합니다 — antialias 는 컨텍스트를
     * 만든 뒤에는 못 바꿉니다. 1x1 임시 컨텍스트라 비용은 없습니다. */
    const probe = document.createElement('canvas').getContext('webgl');
    if (!probe) return 2;
    const ext = probe.getExtension('WEBGL_debug_renderer_info');
    if (ext) name = String(probe.getParameter(ext.UNMASKED_RENDERER_WEBGL) || '');
    const lose = probe.getExtension('WEBGL_lose_context');
    if (lose) lose.loseContext();
  } catch (e) { /* 정보를 막아 둔 브라우저 — 아래 코어/메모리로 판단 */ }

  /* ★ 모바일은 따로 가릅니다. 아래 코어/메모리 판정으로는 폰이
   *   거의 전부 '정상'으로 나옵니다 — 요즘 폰도 코어가 8개이고
   *   deviceMemory 는 iOS 가 아예 안 알려 주어 기본값 8 이 됩니다.
   *   그러면 최고 화질로 시작해 발열로 곧 내려오는데, 그 몇 초가
   *   '이 게임은 폰에서 안 된다'는 첫인상을 만듭니다.
   *   한 단계 낮게 시작하고, 여유가 있으면 적응형 품질이 스스로
   *   올려 줍니다(goodRuns).                                      */
  if (IS_TOUCH) {
    if (/swiftshader|software|llvmpipe/i.test(name)) return 2;
    /* 이름을 못 얻어도(정보 차단) 폰으로 봅니다 — 데스크톱과
     * 구분할 다른 단서가 없습니다.                               */
    return (!name || /adreno \(tm\) [78]\d\d|mali-g[78]\d|apple gpu/i.test(name))
      ? 1 : 2;
  }

  /* 사내 PC 에서 그래픽 드라이버가 없거나 정책으로 막혀 있으면 크롬이
   * 소프트웨어 렌더러로 떨어집니다. '툭툭 끊긴다'의 가장 흔한 정체입니다. */
  if (/swiftshader|software|llvmpipe|basic render|microsoft basic/i.test(name)) return 2;
  /* 구형 인텔 내장(HD/UHD 3xx~6xx)과 Mesa 소프트 경로 */
  if (/(hd|uhd) graphics (3|4|5|6)[0-9]{2}|intel.*(gma|g41|g45)|mesa/i.test(name)) return 1;

  const cores = navigator.hardwareConcurrency || 4;
  const mem = navigator.deviceMemory || 8;
  if (cores <= 2 || mem <= 2) return 2;
  if (cores <= 4 || mem <= 4) return 1;
  return 0;
}

/* 위가 좋고 아래가 가볍습니다. skip=1 이면 한 프레임 걸러 그립니다
 * (물리·전송은 60Hz 그대로). 30fps 로 흔들리느니 30fps 로 고정되는
 * 편이 훨씬 덜 끊겨 보입니다 — 마지막 수단입니다.                   */
const QLEVELS = [
  { name: '최고', pr: MAX_PIXEL_RATIO, skip: 0 },
  { name: '높음', pr: 1.25,            skip: 0 },
  { name: '보통', pr: 1.0,             skip: 0 },
  { name: '절약', pr: 0.8,             skip: 0 },
  { name: '최소', pr: 0.65,            skip: 1 }
];

const GPU_TIER = probeGpuTier();

const Quality = {
  level: 0,
  floor: 0,          // 여기보다 좋은 쪽으로는 다시 안 올라갑니다
  tier: GPU_TIER,
  auto: true,
  demotions: [0, 0, 0, 0, 0],
  acc: 0, frames: 0, goodRuns: 0, holdUntil: 0, told: false,

  /* 시작 단계: 기기 등급과 '지난번에 이 PC 가 정착한 값' 중 낮은 쪽.
   * 약한 PC 가 매번 최고 화질로 시작해 10초쯤 끊기다 내려가는 것을
   * 막습니다.                                                        */
  initialLevel() {
    let lv = this.tier === 2 ? 4 : this.tier === 1 ? 2 : 0;
    try {
      const saved = parseInt(localStorage.getItem('ipg.quality'), 10);
      if (saved >= 0 && saved < QLEVELS.length) lv = Math.max(lv, saved);
    } catch (e) {}
    return Math.min(QLEVELS.length - 1, lv);
  },

  apply() {
    const q = QLEVELS[this.level];
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, q.pr));
    renderer.setSize(window.innerWidth, window.innerHeight);
  },

  set(lv, why) {
    lv = Math.max(this.floor, Math.min(QLEVELS.length - 1, lv));
    if (lv === this.level) return;
    const down = lv > this.level;
    if (down) {
      this.demotions[this.level]++;
      /* 같은 단계에서 두 번 내려왔다면 그 단계는 이 PC 에 무리입니다.
       * 다시 올라가면 또 내려올 뿐이라 바닥을 올려 진동을 끊습니다. */
      if (this.demotions[this.level] >= 2) this.floor = this.level + 1;
    }
    this.level = lv;
    this.apply();
    try { localStorage.setItem('ipg.quality', String(lv)); } catch (e) {}
    /* 화질이 왜 변했는지 모르면 '게임이 이상해졌다'로 읽힙니다.
     * 다만 매번 띄우면 시끄러우므로 내려갈 때 한 번만 알립니다.     */
    if (down && !this.told) {
      this.told = true;
      toast('화면이 버거워 화질을 낮췄습니다 (' + QLEVELS[lv].name + ')', 'warn');
    }
    /* 화질이 바뀐 이유를 콘솔에 남깁니다. 몇 번 안 일어나고,
     * '왜 흐려졌지'를 확인할 유일한 단서입니다.                       */
    console.log('[IPG] 화질 ' + QLEVELS[lv].name + ' — ' + why);
  },

  /* 매 프레임 호출. dt 는 초, now 는 ms.                             */
  sample(dt, now) {
    if (!this.auto) return;
    /* 탭 복귀·GC·셰이더 컴파일 같은 일회성 정지는 판단에서 뺍니다.
     * 안 빼면 새로고침 직후 한 번 튀는 것만으로 화질이 떨어집니다. */
    if (dt > 0.25) { this.acc = 0; this.frames = 0; return; }
    this.acc += dt; this.frames++;
    if (this.acc < 1.5 || this.frames < 20) return;

    const fps = this.frames / this.acc;
    this.acc = 0; this.frames = 0;
    if (now < this.holdUntil) return;

    if (fps < 48 && this.level < QLEVELS.length - 1) {
      this.goodRuns = 0;
      this.holdUntil = now + 4000;
      this.set(this.level + 1, Math.round(fps) + 'fps');
    } else if (fps > 58 && this.level > this.floor) {
      /* 올라가는 것은 신중하게 — 한 창만 보고 올리면 내려갔다 올라갔다
       * 하면서 해상도가 계속 바뀌어 오히려 더 거슬립니다.           */
      if (++this.goodRuns >= 4) {
        this.goodRuns = 0;
        this.holdUntil = now + 4000;
        this.set(this.level - 1, Math.round(fps) + 'fps');
      }
    } else {
      this.goodRuns = 0;
    }
  },

  label() {
    return QLEVELS[this.level].name +
           ' · 픽셀비 ' + (Math.round(renderer.getPixelRatio() * 100) / 100) +
           (QLEVELS[this.level].skip ? ' · 30fps 고정' : '') +
           ' · 기기 ' + ['정상', '약함', '소프트웨어'][this.tier] +
           (IS_TOUCH ? '·터치' : '') +
           (this.floor > 0 ? ' · 하한 ' + QLEVELS[this.floor].name : '');
  }
};

/* 소프트웨어 렌더러에서 MSAA 는 전부 CPU 가 처리합니다 — 여기서 켜 두면
 * 아래에서 픽셀비를 아무리 낮춰도 따라오지 못합니다.                  */
const USE_AA = GPU_TIER === 0;
const renderer = new THREE.WebGLRenderer({ antialias: USE_AA, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, MAX_PIXEL_RATIO));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.outputEncoding = THREE.sRGBEncoding;
/* 그림자는 '받는 쪽'이 타일 1,600장이라 약한 기기에서 픽셀당 비용이
 * 큽니다. 소프트웨어 렌더러면 아예 끄고, 약한 내장이면 필터를 싼 것으로
 * 내립니다. 셰이더 재컴파일 때문에 여기서 한 번만 정합니다.          */
/* ★ 터치 기기에서는 그림자를 끕니다. 그림자 맵은 씬을 한 번 더 그리는
 *   일이라 드로우콜이 그대로 두 배가 되는데, 폰에서는 이 비용이 가장
 *   아깝습니다 — 6인치 화면에서 발밑 그림자는 거의 안 보이고, 대신
 *   그 예산으로 해상도를 지킬 수 있습니다.
 *   런타임에 못 바꾸는 값이라(재질 1,683개 재컴파일) 여기서 정합니다. */
renderer.shadowMap.enabled = GPU_TIER < 2 && !IS_TOUCH;
renderer.shadowMap.type = GPU_TIER === 0 ? THREE.PCFSoftShadowMap : THREE.PCFShadowMap;
Quality.level = Quality.initialLevel();
Quality.apply();
dom.stage.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x05060a);
scene.fog = new THREE.FogExp2(0x05060a, 0.0075);

const camera = new THREE.PerspectiveCamera(58, window.innerWidth / window.innerHeight, 0.1, 800);
camera.position.set(0, 40, 30);   // 층 높이가 낮아진 만큼 초기 위치도 내림

const hemiLight = new THREE.HemisphereLight(0x9fd8ff, 0x180a24, 0.75);
scene.add(hemiLight);

/* 주광 방향. 맵을 바꾸면 하늘의 해 위치에 맞춰 갱신됩니다. */
const keyLightDir = new THREE.Vector3(0.42, 0.82, 0.29).normalize();
const keyLight = new THREE.DirectionalLight(0xffffff, 1.15);
keyLight.position.set(38, 78, 26);
keyLight.castShadow = true;
/* 그림자 맵도 등급에 맞춥니다. 깊이 패스를 매 프레임 그 해상도로 그리므로,
 * 약한 기기에서 2048² 을 유지할 이유가 없습니다.                      */
keyLight.shadow.mapSize.set(GPU_TIER === 0 ? 2048 : 1024,
                            GPU_TIER === 0 ? 2048 : 1024);
keyLight.shadow.camera.near = 1;
keyLight.shadow.camera.far = 220;
keyLight.shadow.camera.left = -70;
keyLight.shadow.camera.right = 70;
keyLight.shadow.camera.top = 70;
keyLight.shadow.camera.bottom = -70;
keyLight.shadow.bias = -0.0009;
scene.add(keyLight);
scene.add(keyLight.target);

const rimLight = new THREE.DirectionalLight(0x00ffcc, 0.5);
rimLight.position.set(-30, 20, -34);
scene.add(rimLight);

/* 구름바다에서 위로 올라오는 반사광. 캐릭터 아랫면이 새까맣게 죽는 것을 막습니다. */
const bounceLight = new THREE.PointLight(0xffffff, 1.1, 150, 2);
bounceLight.position.set(0, -14, 0);
scene.add(bounceLight);

/* --- world groups ------------------------------------------------------- */
const worldGroup = new THREE.Group(); scene.add(worldGroup);
const tileGroup = new THREE.Group(); worldGroup.add(tileGroup);
/* 회전층(trait:'rotate') 타일 전용 그룹.
 * 타일 845장의 좌표를 매 프레임 고치는 대신 이 그룹의 rotation.y 하나만
 * 갱신합니다(드로우콜·CPU 비용 0). 타일 메시의 position 은 이미 층 로컬
 * 좌표라 그대로 맞고, 충돌 판정은 반대로 '질의점'을 돌립니다
 * (toLayerFrame 참고). 회전하지 않는 층 타일은 그냥 tileGroup 에 둡니다. */
const rotGroup = new THREE.Group(); worldGroup.add(rotGroup);
const actorGroup = new THREE.Group(); worldGroup.add(actorGroup);
const fxGroup = new THREE.Group(); worldGroup.add(fxGroup);

/* --- 텍스처 슬롯 --------------------------------------------------------- *
 * public/assets/ 에 파일을 넣으면 자동 적용됩니다.
 *   character.glb     3D 캐릭터 모델 (애니메이션 포함)  ← 캐릭터 핵심
 *   road_texture.png  1024x1024, 타일 상판 (선택, 그레이스케일)
 * 파일이 없으면 절차적 3D 캐릭터가 쓰이므로 게임은 항상 동작합니다.        */
const texLoader = new THREE.TextureLoader();
const TEX = { road: null };

function loadOptionalTexture(url, key, repeat) {
  texLoader.load(
    assetUrl(url),
    (t) => {
      t.wrapS = t.wrapT = THREE.RepeatWrapping;
      if (repeat) t.repeat.set(repeat, repeat);
      t.encoding = THREE.sRGBEncoding;
      t.anisotropy = renderer.capabilities.getMaxAnisotropy();
      TEX[key] = t;
      if (key === 'road') {
        /* 타일은 묶음 재질 몇 개로 그려집니다 — 타일마다 돌 필요가 없습니다. */
        for (const g of TileInst.groups) {
          g.mesh.material.map = t;
          g.mesh.material.needsUpdate = true;
        }
      }
    },
    undefined,
    () => { /* 파일 없음 — 폴백 유지 */ }
  );
}
loadOptionalTexture('assets/road_texture.png', 'road', 1);

/* --- 절차적 배경 (폴가이즈 헥사곤 방식) --------------------------------- *
 * 사진 배경을 쓰지 않습니다. 사진은 화면에서 확대되면 반드시 흐려지지만,
 * 아래 방식은 전부 실시간으로 계산되므로 4K 든 8K 든 항상 선명합니다.
 *
 *   1) 하늘   : 프래그먼트 셰이더로 그리는 그라데이션. 텍스처가 없어 무한 해상도
 *   2) 구름   : 구를 뭉쳐 만든 3D 덩어리. 실제 입체라 회전해도 자연스럽게 돕니다
 *   3) 소품   : 맵별로 떠다니는 링/큐브/섬. 원근감과 회전감을 만들어 줍니다
