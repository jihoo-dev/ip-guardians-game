<!-- three.js 와 로더는 자체 서버에서 내려줍니다.
     CDN(cdnjs / jsdelivr)이 막히면 글꼴처럼 모양만 나빠지는 게 아니라
     THREE 가 없어 게임이 아예 뜨지 않습니다. 사내망에서 가장 위험한
     실패 모드라 외부 의존을 없앴습니다.
     받아 오는 것은 tools/fetch_vendor.js — 버전을 올릴 때는 그 파일의
     THREE_VER 과 아래 ?v= 를 함께 바꾸세요. -->
<script src="vendor/three.min.js?v=r128"></script>
<script src="vendor/GLTFLoader.js?v=r128"></script>
<script src="vendor/DRACOLoader.js?v=r128"></script>
<script src="vendor/SkeletonUtils.js?v=r128"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
/* ===========================================================================
 * IP Guardians: Fast-Track Survival — WebGL client
 * ---------------------------------------------------------------------------
 *  · Three.js r128, no external control libs (custom orbit-follow rig)
 *  · Client-side prediction for the local runner (authoritative locally,
 *    relayed by the server) + dead reckoning for every remote runner
 *  · Server owns tile fuse timing so collapse is identical on all clients
 * ========================================================================= */
'use strict';

/* ── three.js 부재 방어 ───────────────────────────────────────────────
 * vendor/three.min.js 가 없거나 막히면 아래 코드 전체가 첫 줄에서 죽고
 * 화면에는 참가 폼만 남아 '눌러도 아무 일이 없는' 상태가 됩니다.
 * 사내망에서 실제로 겪을 수 있는 상황이라, 원인을 화면에 적어 둡니다. */
if (typeof THREE === 'undefined') {
  document.addEventListener('DOMContentLoaded', () => {
    document.body.innerHTML =
      '<div style="position:fixed;inset:0;display:flex;align-items:center;' +
      'justify-content:center;background:#05060a;color:#ece7d8;' +
      'font:15px/1.8 system-ui,sans-serif;text-align:center;padding:24px">' +
      '<div><div style="color:#ff2d2d;font-weight:700;margin-bottom:10px">' +
      '3D 엔진을 불러오지 못했습니다</div>' +
      'vendor/three.min.js 를 받지 못했습니다.<br>' +
      '서버의 public/vendor/ 폴더가 비어 있으면 ' +
      '<code>node tools/fetch_vendor.js</code> 를 실행하세요.</div></div>';
  });
  throw new Error('[IPG] THREE 미로드');
}

/* ── 에셋 버전 ────────────────────────────────────────────────────────
 * 에셋 주소 뒤에 ?v= 를 붙입니다. 서버는 버전이 붙은 요청만 1년 캐시로
 * 내려주므로(server.js 정적 미들웨어), 행사 도중 새로고침해도 캐릭터를
 * 다시 받지 않습니다.
 *
 * ★ assets/ 안의 파일을 갈아끼웠다면 이 숫자를 올리세요. 안 올리면
 *   이미 받은 사람은 1년 동안 옛 파일을 씁니다.                        */
const ASSET_VER = '7';   // 2026-09-17 보정 기회 효과음 추가   // 2026-09-17 배경음 128kbps 재인코딩
const assetUrl = (p) => p + (p.indexOf('?') >= 0 ? '&' : '?') + 'v=' + ASSET_VER;

/* ============================ 0. constants ============================== */

const PHYS = {
  GRAVITY: -62,
  JUMP_V: 21.5,
  MOVE: 15.0,
  SPRINT: 21.5,
  ACCEL_GROUND: 120,
  ACCEL_AIR: 42,
  FRICTION: 12,
  MAX_FALL: -90,
  STEP: 1 / 60
};

/* fall 액션 판정 기준.
 * 점프해서 같은 층 타일로 되돌아오는 것은 낙하가 아닙니다.
 * "출발한 바닥보다 이만큼 아래로 내려갔을 때" 만 진짜 낙하로 봅니다.
 *
 * 참고: 점프 최고 높이는 JUMP_V^2 / (2*GRAVITY) = 21.5^2 / 124 = 3.73
 *       즉 정상적인 점프는 출발 높이보다 아래로 내려가지 않으므로,
 *       같은 층 착지에서는 fall 이 절대 나오지 않습니다.               */
const FALL_DROP = {
  JUMPED: 2.2,   // 점프해서 떠 있을 때 (아래 층으로 떨어져야 fall)
  WALKED: 0.35   // 그냥 발을 헛디뎠을 때 (거의 즉시 fall)
};

const PLAYER = {
  HALF_X: 0.78,
  HALF_Z: 0.78,
  HEIGHT: 3.1
};

/* ── 주자간 충돌 (BUMP) ───────────────────────────────────────────────
 * 원칙 하나: 내 위치는 나만 바꾼다. 상대 좌표는 절대 쓰지 않습니다.
 * 상대 클라이언트도 자기 자신에게 같은 규칙을 적용하므로 둘은 결국
 * 떨어지고, 아무도 남의 좌표를 쓰지 않으므로 서버 중계만으로 20Hz 안에
 * 양쪽 화면이 다시 일치합니다. (관전자 장애물 넉백과 같은 패턴입니다)
 *
 * 판정 기준은 RemoteRunner.render — 화면에 실제로 그려지고 있는 위치입니다.
 * 최신 스냅샷이나 예측 위치를 쓰면 접촉 타이밍은 정확해지지만 "보이지도
 * 않는 사람에게 밀렸다"가 됩니다. 보이는 대로 밀리는 편이 배우기 쉽습니다.
 *
 * 원격 주자는 INTERP_DELAY_MS(110ms) 만큼 과거로 그려지므로, 마주 달리면
 * 두 화면의 접촉 시점이 타일 한 칸만큼 어긋납니다. 이건 없앨 수 없습니다.
 * 그래서 밀림은 '위치 밀어내기'가 아니라 '속도 더하기'로만 합니다 —
 * 어긋나도 유령에게 순간이동당하지는 않습니다.                       */
const BUMP = {
  RADIUS: PLAYER.HALF_X * 2,      // 1.56 — 두 주자의 반지름 합
  /* 분리 가속도. 실측으로 고른 값입니다 (스윕 결과):
   *    96 → 서로 밀어붙일 때 0.05~0.19 m 까지 겹침. 사실상 한 몸이 됩니다.
   *   200 → 정착 거리 1.28 m (접촉의 82%), 정지한 상대를 1.7 m 밀어냄. 채택.
   *   340 → 정착 2.45 m. 스치기만 해도 튕겨 날아가 조작감이 망가집니다.    */
  ACCEL: 200,
  /* 관통 방지 강도의 램프 기울기. 겹침 비율 × 이 값이 1 이 되면 완전 차단.
   * 4 면 접촉 거리의 75%(1.17 m)부터 완전히 막힙니다. 더 낮추면 살짝
   * 스쳐도 급정거해 옆으로 지나갈 수가 없습니다.                        */
  BLOCK_RAMP: 4,
  Y_GATE: PLAYER.HEIGHT * 0.9,    // 높이 차가 이보다 크면 서로 없는 것으로 봅니다
  AIR_SCALE: 0.45,                // 공중에서는 약하게 — 지연 오차가 가장 큰 구간입니다

  /* 밀려서 떨어질 수 있는가. 켜 두었습니다 — 밀어내기가 이 게임의 재미이고,
   * 서버 이동 검증(server.js 의 VALIDATE)이 들어가면서 "안 떨어졌다"고
   * 우기는 클라이언트를 되돌릴 근거도 생겼습니다.
   * 부당 탈락 항의가 많으면 이 값만 false 로 되돌리면 됩니다.        */
  PUSH_OFF_EDGE: true,

  START_GRACE_MS: 700,            // 라운드 시작 낙하 중에는 끕니다 (전원이 공중이라 난장판이 됩니다)
  SFX_DV: 0.35,                   // 이 이상 속도가 변하면 충돌음 (m/s)
  SFX_GAP_MS: 220,                // 충돌음 최소 간격 (붙어 있으면 매 프레임 울립니다)
  CREDIT_MS: 1200                 // 밀린 뒤 이 시간 안에 떨어지기 시작하면 그 사람 덕으로 봅니다
};

/* ══════════════════════════════════════════════════════════════════════
 * 적응형 보간 지연
 * ────────────────────────────────────────────────────────────────────
 * 스냅샷이 '얼마나 고르게 도착하는지'를 재서 버퍼 크기를 정합니다.
 *
 * ★ 왜 RTT 가 아니라 도착 간격을 재는가
 *   버퍼가 막아 주는 것은 지연 자체가 아니라 지연의 '흔들림'입니다.
 *   RTT 가 200ms 라도 일정하면 버퍼는 한 칸이면 되고, RTT 가 20ms 여도
 *   들쭉날쭉하면 버퍼가 커야 합니다. 그래서 도착 간격의 표준편차를
 *   1차 지표로 쓰고, RTT 는 보조로만 조금 얹습니다.
 *
 * ★ 왜 천천히 바꾸는가
 *   이 값을 바꾸면 원격 주자 전원의 렌더 시각이 한꺼번에 밀립니다.
 *   한 번에 40ms 를 바꾸면 모두가 순간이동한 것처럼 보입니다.
 *   그래서 초당 12ms 씩만 움직입니다 — 사람 눈에는 안 보이고,
 *   회선이 변해도 몇 초 안에 따라갑니다.
 * ══════════════════════════════════════════════════════════════════ */
const Interp = {
  gaps: [],            // 최근 스냅샷 도착 간격 (ms)
  last: 0,
  mean: 0, jitter: 0,
  target: 110,
  auto: true,

  note(now) {
    if (this.last) {
      const d = now - this.last;
      /* 탭이 백그라운드에 갔다 오면 간격이 수 초로 찍힙니다. 그걸 통계에
       * 넣으면 지터가 폭발해 버퍼가 최대로 벌어집니다 — 회선 탓이 아니라
       * 브라우저가 rAF 를 멈춘 것이므로 빼야 합니다.                  */
      if (d > 0 && d < 600) {
        this.gaps.push(d);
        if (this.gaps.length > 48) this.gaps.shift();
      } else {
        this.gaps.length = 0;      // 공백 뒤 통계는 처음부터 다시
      }
    }
    this.last = now;
  },

  recompute() {
    const n = this.gaps.length;
    if (n < 16) return;            // 표본이 적으면 판단하지 않습니다
    let sum = 0;
    for (const g of this.gaps) sum += g;
    this.mean = sum / n;
    let v = 0;
    for (const g of this.gaps) { const d = g - this.mean; v += d * d; }
    this.jitter = Math.sqrt(v / n);
    /* 스냅샷 한 칸 + 흔들림 여유 2.5σ + RTT 의 15%.
     * 2.5σ 는 정규분포라면 도착의 99% 를 덮습니다. 나머지 1% 는
     * 외삽(dead reckoning)이 메웁니다 — 그쪽이 더 싸게 먹힙니다.    */
    const t = this.mean + this.jitter * 2.5 + (G.rtt || 0) * 0.15;
    this.target = Math.max(NET.INTERP_MIN_MS, Math.min(NET.INTERP_MAX_MS, t));
  },

  slew(dt) {
    if (!this.auto) return;
    this.recompute();
    const d = this.target - NET.INTERP_DELAY_MS;
    if (Math.abs(d) < 0.5) return;
    const step = Math.sign(d) * Math.min(Math.abs(d), 12 * dt);   // 초당 12ms
    NET.INTERP_DELAY_MS += step;
    /* 외삽 한계도 같이 따라갑니다. 버퍼보다 훨씬 짧으면 버퍼가 마를 때
     * 외삽으로 못 메워 그 자리에 얼어붙습니다.
     *
     * ★ 다만 상한을 반드시 겁니다. 버퍼가 220ms 까지 벌어졌을 때 2.4배를
     *   그대로 쓰면 530ms 를 추측으로 그리게 되는데, 8m/s 로 달리는
     *   주자면 4m 를 허공에 그립니다 — 그쯤 되면 멈춰 있는 편이 덜
     *   틀립니다. 340 이면 기본값(110→264)은 종전과 같습니다.        */
    NET.EXTRAPOLATE_CAP_MS =
      Math.max(160, Math.min(340, Math.round(NET.INTERP_DELAY_MS * 2.4)));
  },

  label() {
    return Math.round(NET.INTERP_DELAY_MS) + 'ms' +
      (this.gaps.length < 16 ? ' (측정 중)'
        : ' · 목표 ' + Math.round(this.target) +
          ' · 간격 ' + this.mean.toFixed(0) + '±' + this.jitter.toFixed(0)) +
      (this.auto ? '' : ' · 수동');
  }
};

const NET = {
