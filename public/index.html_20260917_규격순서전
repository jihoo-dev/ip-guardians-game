}
.cta:hover{background:var(--paper)}
.keys{margin-top:20px;padding-top:16px;border-top:1px solid var(--rule);display:flex;flex-wrap:wrap;gap:6px 16px}
.keys span{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:rgba(236,231,216,.45)}
.keys b{color:var(--paper);font-weight:600}
/* 조작 안내와 같은 줄에 섞이되, 누를 수 있다는 것이 보여야 합니다 */
.sndBtn{font-family:var(--mono);font-size:10px;letter-spacing:.1em;
  color:rgba(236,231,216,.45);background:none;border:1px solid var(--rule);
  padding:3px 9px;cursor:pointer;margin-left:auto}
.sndBtn:hover{color:var(--paper);border-color:var(--rule2,rgba(236,231,216,.3))}
.sndBtn b{color:var(--mint,#00ffcc)}
.sndBtn.off b{color:var(--stamp,#ff2d2d)}
.sndBtn.off{color:rgba(236,231,216,.3)}
.sndBtn:focus-visible{outline:2px solid var(--mint,#00ffcc);outline-offset:2px}

#countdown{position:absolute;inset:0;display:none;align-items:center;justify-content:center;pointer-events:none;z-index:15}
#countdown.show{display:flex}
#cdNum{font-family:var(--mono);font-size:150px;font-weight:700;line-height:1;color:var(--l3);text-shadow:0 0 60px rgba(0,255,204,.5)}
#cdLabel{position:absolute;bottom:calc(50% - 118px);font-family:var(--mono);font-size:11px;letter-spacing:.36em;color:rgba(236,231,216,.55)}

/* ── 대기실 패널 ──────────────────────────────────────────────────────
 * 발판 위에 서 있는 동안(대기 중)만 보입니다.
 *
 * ★ 새 화면을 만들지 않았습니다.
 *   이미 각자 자기 발판에 서 있고, 명단이 오른쪽에 있고, 시작하면
 *   발판이 갈라지며 떨어지는 연출이 있습니다. 여기가 곧 대기실이라,
 *   버튼 한 줄만 얹으면 됩니다. 별도 로비 화면을 끼우면 그 연출이
 *   한 겹 뒤로 밀립니다.
 *
 * ★ 자리는 #spec 과 같습니다(화면 아래 가운데). 둘은 동시에 뜨지
 *   않습니다 — 대기 중에는 개입할 회차가 없습니다.               */
/* ★ #spec 과 달리 바닥에 붙이지 못합니다 — 대기 중에는 #hint(조작·타일
 *   규칙 세 줄)가 아래 가운데를 차지하고 있어서, 26px 에 두면 시작
 *   버튼이 그 글자 뒤로 들어갑니다. #hint 높이(약 75px) 위로 올립니다.
 *   관전 패널은 라운드 중에만 뜨고 그때는 #hint 가 한 줄이라 괜찮습니다. */
#ready{
  position:absolute;left:50%;bottom:104px;transform:translateX(-50%);
  display:none;flex-direction:column;align-items:center;gap:9px;width:min(560px,94vw);z-index:14;
  /* ★ #hud 는 통째로 pointer-events:none 입니다. 그 안에서 눌러야 하는
   *   것만 하나씩 되살리는 구조라(.panel{pointer-events:auto}), 여기에
   *   안 적으면 <b>버튼이 보이기만 하고 클릭이 그대로 통과합니다.</b>
   *   화면에 멀쩡히 있어서 눈으로는 절대 안 드러나는 종류의 실수입니다. */
  pointer-events:auto
}
#ready.show{display:flex}
/* 대기실이 떠 있는 동안에는 토스트도 그 위로 비켜 줍니다 */
body.lobby #toasts{bottom:232px}
#readyState{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;
  color:rgba(236,231,216,.6);background:rgba(11,14,22,.86);border:1px solid var(--rule);
  padding:6px 13px;text-align:center;word-break:keep-all}
#readyState b{color:var(--l3);font-weight:700}
#readyBtns{display:flex;gap:9px;width:100%}
.rbtn{
  flex:1;padding:13px;font-size:14px;font-weight:700;letter-spacing:.04em;
  background:var(--l3);color:var(--ink);transition:.16s;font-family:var(--kr)
}
.rbtn:hover:not(:disabled){background:var(--paper)}
.rbtn:disabled{background:rgba(236,231,216,.1);color:rgba(236,231,216,.38);cursor:default}
/* 준비를 누른 뒤 — 눌렀다는 것이 보여야 하고, 다시 누르면 풀린다는 것도 */
.rbtn.on{background:none;color:var(--l3);border:1px solid var(--l3)}
.rbtn.on:hover{background:rgba(0,255,204,.12)}
/* 가로 폰에서는 버튼 하나뿐이라 굳이 줄이지 않습니다 */
/* 터치에서는 #hint 가 위로 올라가 있어(body.touch #hint{top:…}) 아래가
 * 비어 있습니다. 대신 양 엄지가 차지하므로 바닥 가까이 둡니다. */
body.touch #ready{bottom:14px;width:min(420px,92vw)}
body.touch.lobby #toasts{bottom:92px}
body.touch .rbtn{padding:10px;font-size:13px}

/* 명단의 준비 표시. 층 번호 자리를 대기 중에만 빌려 씁니다 —
 * 대기 중에는 모두 같은 발판 위라 층이 정보가 아닙니다.          */
.rrow .rdy{font-family:var(--mono);font-size:9px;letter-spacing:.12em;
  margin-left:auto;color:var(--l3)}
.rrow .rdy.no{color:rgba(236,231,216,.3)}
.rrow .host{font-family:var(--mono);font-size:8px;letter-spacing:.1em;
  background:var(--gold);color:var(--ink);padding:1px 4px;margin-left:auto}

/* 대기 화면의 두 갈래 참가 버튼 */
.joinRow{display:flex;gap:9px;margin-top:22px}
.joinRow .cta{margin-top:0;width:auto;flex:1 1 0;min-width:0}
.joinRow .cta.alt{flex:0 0 auto;background:none;color:rgba(236,231,216,.75);
  border:1px solid var(--rule);font-size:13px;padding-left:20px;padding-right:20px;
  white-space:nowrap}
.joinRow .cta.alt:hover{background:rgba(236,231,216,.08);color:var(--paper);
  border-color:rgba(236,231,216,.34)}
@media (max-width:560px){.joinRow{flex-direction:column}
  .joinRow .cta.alt{flex:1 1 auto;width:auto}}

#result .card{text-align:center}
#resultRank{margin-top:20px;display:flex;flex-direction:column;gap:5px}
.rank{display:flex;gap:12px;align-items:center;padding:9px 13px;background:rgba(236,231,216,.05);border-left:3px solid;font-size:12.5px;text-align:left}
.rank .p{font-family:var(--mono);font-size:15px;font-weight:700;min-width:26px}
/* 순위 줄 오른쪽 끝에 붙는 '버틴 시간 · 내려간 곳' */
.rank .rt{margin-left:auto;font-family:var(--mono);font-size:10.5px;
  letter-spacing:.06em;color:rgba(236,231,216,.45);white-space:nowrap}
/* 내 기록 한 줄. 한 판이 짧은 게임이라 '얼마나 버텼나'가 다시 하게 만듭니다. */
#resultMine{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;
  margin:0 0 18px;padding:11px 14px;border:1px solid var(--rule);
  background:rgba(236,231,216,.04)}
#resultMine span{font-family:var(--mono);font-size:10px;letter-spacing:.14em;
  color:rgba(236,231,216,.5)}
#resultMine b{color:var(--l3);font-size:13px;font-weight:700;letter-spacing:.02em;margin-left:5px}
#resultHint{margin-top:20px;font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:rgba(236,231,216,.4)}

/* ── 나가기 ───────────────────────────────────────────────────────────
 * ★ 종전에는 나가는 길이 아예 없었습니다.
 *   한 번 참가하면 결과 화면에도 버튼이 없고 ESC 도 안 먹어서, 탭을
 *   닫는 것 말고는 방을 벗어날 방법이 없었습니다. 행사장처럼 한 대를
 *   여러 사람이 번갈아 쓰는 자리에서는 자리를 넘기는 동작이 게임
 *   자체만큼 자주 일어납니다.
 *
 * ★ 나가기 버튼은 일부러 약하게 보이게 둡니다.
 *   기본 동작은 "이대로 다음 회차" 이고 나가기는 예외입니다. 둘 다
 *   같은 세기로 칠하면 결과 화면이 갈림길처럼 보입니다.            */
/* ★ .cta 는 width:100% 입니다. flex 행에 그대로 두면 둘이 서로
 *   100% 를 요구해 한쪽이 글자 한 자 폭까지 눌립니다(실제로 "빠른
 *   참가" 가 세로로 한 글자씩 접혔습니다). 행 안에서는 폭을 flex 에
 *   맡겨야 합니다.                                                */
.btnRow{display:flex;gap:9px;margin-top:22px}
.btnRow .cta{margin-top:0;width:auto;flex:1 1 0;min-width:0}
.cta.ghost{background:none;color:rgba(236,231,216,.72);border:1px solid var(--rule);
  font-size:13px;font-weight:600}
.cta.ghost:hover{background:rgba(236,231,216,.08);color:var(--paper);
  border-color:rgba(236,231,216,.34)}
/* 좁은 화면(가로 폰)에서는 두 버튼이 한 줄에 다 안 들어갑니다 */
@media (max-width:560px){.btnRow{flex-direction:column}}
#leaveMenu .card{text-align:center}
#leaveMenu .lvWarn{margin-top:14px;padding:10px 13px;border:1px solid var(--rule);
  background:rgba(236,231,216,.04);font-size:11.5px;line-height:1.55;
  color:rgba(236,231,216,.66);word-break:keep-all}

/* ── 최종 처분 도장 (#verdict) ────────────────────────────────────────
 * 탈락과 승리가 '같은 언어'를 쓰게 하는 장치입니다.
 *   탈락 → 붉은 거절결정 도장이 화면에 쿵 찍힘
 *   승리 → 등록증이 먼저 펼쳐지고 그 위에 남색 등록결정 도장이 찍힘
 * 시작 연출이 '게이트가 열린다' 였으니 끝은 '도장이 찍힌다' 입니다.
 *
 * ★ 2D 로 만든 이유 — 도장과 등록증은 글자가 읽혀야 의미가 사는데,
 *   r128 + 후처리 없음 환경에서 3D 텍스트는 캔버스 텍스처를 거쳐야 하고
 *   각도에 따라 읽기 어려워집니다. 화면 정면에 찍히는 편이 훨씬 셉니다.
 *   빛기둥·카메라 공전 같은 '공간' 연출만 3D 로 갑니다.
 *
 * z-index 13 — deadFlash(12) 위, 카운트다운(15) 아래.                */
#verdict{position:absolute;inset:0;display:none;align-items:center;justify-content:center;
  pointer-events:none;z-index:13;perspective:900px}
#verdict.on{display:flex}

/* 등록증 — 승리에서만 보입니다 */
#verdict .cert{position:absolute;width:min(430px,74vw);padding:30px 30px 96px;
  background:linear-gradient(160deg,#fbf7ea,#efe6cd);color:#2a2418;text-align:center;
  border:1px solid #c9b98d;box-shadow:0 30px 70px -24px rgba(0,0,0,.85);
  opacity:0;transform:scale(.86) rotateX(22deg)}
#verdict.win .cert{animation:certIn .55s cubic-bezier(.16,1,.3,1) forwards}
#verdict .cert .ct{font-family:var(--mono,monospace);font-size:10px;letter-spacing:.34em;color:#9a7f3e}
#verdict .cert .cn{font-size:27px;font-weight:900;letter-spacing:.16em;margin:9px 0 4px}
#verdict .cert .cno{font-family:var(--mono,monospace);font-size:11px;color:#7a6a46;letter-spacing:.08em}
#verdict .cert hr{border:0;border-top:1px solid #d6c9a4;margin:16px 0}
#verdict .cert .crow{display:flex;justify-content:space-between;font-size:12px;margin:5px 0}
#verdict .cert .crow b{font-weight:700}
#verdict .cert .ck{color:#8a7a55}
#verdict .cert .cfoot{margin-top:18px;font-size:11px;color:#6e6047;line-height:1.6}

/* 도장 — 탈락/승리 공통. 색만 갈립니다 */
#verdict .seal{position:relative;width:188px;height:188px;border-radius:50%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  border:5px solid var(--sealC);color:var(--sealC);
  box-shadow:0 0 0 3px rgba(0,0,0,.05) inset,0 0 0 9px var(--sealBg) inset;
  background:var(--sealBg);opacity:0;transform:scale(3.1) rotate(-26deg)}
#verdict.on .seal{animation:sealIn .42s cubic-bezier(.3,1.5,.4,1) forwards}
/* 승리에서는 도장이 등록증 '우측 하단'에 찍힙니다.
 * 가운데에 찍으면 등록번호·특허권자 같은 본문을 덮어 버려서, 정작
 * 사진으로 남기고 싶은 정보가 안 보입니다. 실제 증서도 도장은
 * 본문을 피해 아래쪽에 찍힙니다. 그래서 등록증 하단에 여백(96px)을
 * 따로 두고 그 자리에 앉힙니다. */
#verdict.win .seal{animation-delay:.5s;position:absolute;left:50%;top:50%;
  width:148px;height:148px;border-width:4px;
  margin-left:calc(min(430px,74vw) / 2 - 172px);margin-top:22px}
#verdict.win .seal .sMain{font-size:26px}
#verdict.win .seal .sTop{font-size:8px;letter-spacing:.24em}
#verdict.win .seal .sEn{font-size:8.5px;letter-spacing:.2em}
#verdict.win .seal .sLaw{font-size:9px}
#verdict .seal .sTop{font-size:9.5px;letter-spacing:.3em;opacity:.92}
#verdict .seal .sMain{font-size:34px;font-weight:900;letter-spacing:.1em;line-height:1.05}
#verdict .seal .sEn{font-family:var(--mono,monospace);font-size:10px;letter-spacing:.26em;opacity:.9}
#verdict .seal .sLaw{font-size:10px;opacity:.85;margin-top:3px}
/* 도장이 찍힌 뒤 잉크가 한 번 번집니다 */
#verdict .seal::after{content:'';position:absolute;inset:-16px;border-radius:50%;
  border:2px solid var(--sealC);opacity:0}
#verdict.on .seal::after{animation:inkRing .7s .42s ease-out forwards}
#verdict.win .seal::after{animation-delay:.92s}

@keyframes certIn{
  from{opacity:0;transform:scale(.86) rotateX(22deg)}
  to{opacity:1;transform:scale(1) rotateX(0)}}
@keyframes sealIn{
  0%{opacity:0;transform:scale(3.1) rotate(-26deg)}
  70%{opacity:1;transform:scale(.93) rotate(-8deg)}
  85%{transform:scale(1.05) rotate(-10deg)}
  100%{opacity:1;transform:scale(1) rotate(-9deg)}}
@keyframes inkRing{from{opacity:.55;transform:scale(.82)}to{opacity:0;transform:scale(1.25)}}
#verdict.out{opacity:0;transition:opacity .45s ease}
@media (prefers-reduced-motion:reduce){
  #verdict .cert,#verdict .seal,#verdict .seal::after{animation-duration:.01s!important}}

#deadFlash{position:absolute;inset:0;background:radial-gradient(circle at 50% 60%,transparent 20%,rgba(255,58,18,.5));opacity:0;pointer-events:none;transition:opacity .35s;z-index:12}
#deadFlash.on{opacity:1}

/* ── 심사 가속 경보 (층 특성) ──────────────────────────────────────
 * 켜고 끄는 것은 전적으로 서버 layer_event 입니다. 여기 애니메이션은
 * 깜빡임만 담당하고 지속 시간은 모릅니다 — CSS 로 시간을 세면 서버가
 * 끄기 전에 화면에서 먼저 사라집니다.
 * deadFlash(z-index 12) 위, 카운트다운(15) 아래에 둡니다.          */
#accelAlert{position:absolute;inset:0;display:none;pointer-events:none;z-index:13}
#accelAlert.on{display:block}
#accelAlert .vig{
  position:absolute;inset:0;
  background:radial-gradient(circle at 50% 50%,transparent 42%,rgba(255,38,26,.52) 100%);
  animation:accelPulse .62s ease-in-out infinite
}
#accelAlert .tag{
  position:absolute;top:88px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:7px;
  font-family:var(--mono);text-align:center;animation:accelPulse .62s ease-in-out infinite
}
#accelAlert .tag b{
  font-size:30px;font-weight:700;letter-spacing:.3em;text-indent:.3em;color:#ff5140;
  text-shadow:0 0 30px rgba(255,58,18,.9),0 0 4px rgba(0,0,0,.8)
}
#accelAlert .tag i{font-style:normal;font-size:10px;letter-spacing:.26em;color:rgba(255,196,186,.85)}
#accelAlert .bar{
  position:absolute;left:0;right:0;height:3px;background:#ff2a1a;
  box-shadow:0 0 22px 3px rgba(255,42,26,.85);animation:accelPulse .62s ease-in-out infinite
}
#accelAlert .bar.t{top:0} #accelAlert .bar.b{bottom:0}
@keyframes accelPulse{0%,100%{opacity:.22}50%{opacity:1}}
/* 왼쪽 층 목록에서 지금 가속이 걸린 층을 함께 표시합니다 */
.doc.accel{border-color:#ff2a1a;box-shadow:-3px 0 0 #ff2a1a,0 0 26px -6px #ff2a1a}
.doc.accel .no{color:#ff8a7a;animation:accelPulse .62s ease-in-out infinite}

/* ── 어둠 경보 (층 특성) ───────────────────────────────────────────
 * 실제로 '가리는' 것은 3D 쪽(updateTiles)이 각자 자기 위치 기준으로
 * 합니다. 여기 오버레이는 화면 가장자리를 눌러 주는 분위기와 문구만
 * 담당합니다 — 이것만으로 가리면 타일이 아니라 화면을 가리게 되어
 * 자기 주변만 보이는 규칙이 성립하지 않습니다.
 * accelAlert(13) 와 같은 층위에 두되 그 아래로 깔립니다.            */
#darkAlert{position:absolute;inset:0;display:none;pointer-events:none;z-index:13}
#darkAlert.on{display:block}
#darkAlert .vig{
  position:absolute;inset:0;
  background:radial-gradient(circle at 50% 56%,transparent 26%,rgba(2,3,8,.72) 78%);
  opacity:0;transition:opacity .8s ease
}
#darkAlert.on .vig{opacity:1}
#darkAlert .tag{
  position:absolute;top:88px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;
  opacity:0;transition:opacity .5s ease .1s
}
#darkAlert.on .tag{opacity:1}
#darkAlert .tag b{
  font-size:17px;font-weight:700;letter-spacing:.04em;color:#dcd6ff;
  text-shadow:0 0 24px rgba(124,92,255,.9),0 2px 6px rgba(0,0,0,.9)
}
#darkAlert .tag i{
  font-style:normal;font-family:var(--mono);font-size:10px;letter-spacing:.26em;
  color:rgba(190,178,255,.75)
}
/* 왼쪽 층 목록 — 어둠이 걸린 층 */
.doc.dark{border-color:#7c5cff;box-shadow:-3px 0 0 #7c5cff,0 0 26px -6px #7c5cff}
.doc.dark .no{color:#b9a8ff}

/* ── 회전 방향 반전 배너 ───────────────────────────────────────────
 * 회전 자체는 3D 쪽에서 계속 돌고 있고, 이 배너는 '방향이 바뀐 순간'만
 * 잠깐 알립니다. 계속 띄우면 정보가 아니라 배경이 됩니다.           */
#rotAlert{
  position:absolute;top:88px;left:50%;transform:translateX(-50%) translateY(-8px);
  display:flex;align-items:center;gap:10px;padding:10px 18px;
  background:rgba(12,4,4,.9);border:1px solid #ff6a3d;border-left:4px solid #ff6a3d;
  font-size:14px;font-weight:700;letter-spacing:.02em;color:#ffd9cc;white-space:nowrap;
  opacity:0;pointer-events:none;z-index:14;transition:opacity .25s ease,transform .25s ease
}
#rotAlert.on{opacity:1;transform:translateX(-50%) translateY(0)}
#rotAlert .ico{font-size:17px;animation:accelPulse .5s ease-in-out infinite}
/* 왼쪽 층 목록 — 회전하는 층 */
.doc.rotate{border-color:#0088ff;box-shadow:-3px 0 0 #0088ff,0 0 26px -6px #0088ff}
.doc.rotate .no{color:#7cc4ff}
/* 회전 방향 표시. 반복되는 반전 배너 대신 여기서 조용히 읽힙니다. */
.rotmark{
  position:absolute;right:11px;bottom:9px;font-size:15px;line-height:1;
  color:#7cc4ff;text-shadow:0 0 10px rgba(0,136,255,.9)
}

#diag{
  position:absolute;left:18px;bottom:18px;display:none;min-width:270px;
  background:rgba(5,6,10,.94);border:1px solid var(--rule);border-left:3px solid var(--stamp);
  padding:10px 12px;font-family:var(--mono);font-size:10.5px;line-height:1.7;letter-spacing:.02em
}
#diag.show{display:block}
#diag b{display:block;color:var(--stamp);letter-spacing:.2em;margin-bottom:5px;font-size:9px}
#diag .ok{color:var(--l3)} #diag .no{color:var(--stamp)} #diag .wa{color:var(--gold)}
#btnAudio{border:none;text-align:left}
#btnAudio:hover .v{color:var(--l3)}
#btnAudio.off .v{color:var(--stamp)}
#mixer{
  position:fixed;right:14px;top:60px;z-index:12;display:none;flex-direction:column;gap:4px;
  background:rgba(5,6,10,.95);border:1px solid var(--rule);padding:12px 14px;width:186px
}
#mixer.show{display:flex}
#mixer label{
  font-family:var(--mono);font-size:9px;letter-spacing:.16em;color:rgba(236,231,216,.5);
  display:flex;justify-content:space-between
}
#mixer label span{color:var(--paper)}
#mixer input[type=range]{
  -webkit-appearance:none;appearance:none;width:100%;height:3px;
  background:rgba(236,231,216,.2);outline:none;margin:2px 0 8px
}
#mixer input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:12px;height:12px;background:var(--l3);cursor:pointer
}
#mixer input[type=range]::-moz-range-thumb{
  width:12px;height:12px;background:var(--l3);border:none;cursor:pointer
}
/* ★ 밝은 타일 위에 얹히는 글자입니다. 종전에는 투명도 .35 라 실측
   대비비가 1.04 였습니다 — 1.0 이 '명도가 완전히 같다'이고 작은 글자
   최소 권장치가 4.5 입니다. 색만 올려서는 배경이 층마다 달라 또
   묻히므로, 어두운 판을 깔고 그 위에 글자를 놓습니다. */
#hint{position:absolute;left:50%;bottom:20px;transform:translateX(-50%);
  font-family:var(--mono);font-size:11px;letter-spacing:.12em;line-height:1.7;
  color:rgba(236,231,216,.92);text-align:center;max-width:min(92vw,720px);
  padding:7px 14px;border-radius:4px;border:1px solid rgba(236,231,216,.10);
  background:rgba(5,6,10,.72);backdrop-filter:blur(6px)}
#hint .rules{display:block;margin-top:2px;font-size:10px;color:rgba(236,231,216,.6)}
#hint.hide{display:none}

@media (max-width:900px){
  #layerStack{width:150px;top:88px;left:12px} #roster{width:160px;top:88px;right:12px}
  .doc .nm{font-size:11px} h1{font-size:23px}
}
/* ══════════════════════════════════════════════════════════════════
 * 터치 조작 (가로 전용)
 * ────────────────────────────────────────────────────────────────
 * ★ touch-action 을 지정하지 않으면 화면을 쓰는 동작이 전부 브라우저
 *   제스처로 먹힙니다 — 스크롤, 당겨서 새로고침, 더블탭 확대.
 *   시점을 돌리려고 화면을 쓸면 페이지가 새로고침되던 것이 이것입니다.
 *   입력창만은 풀어 줍니다(이름 입력에 선택·확대가 필요합니다).
 * ------------------------------------------------------------------ */
body.touch{touch-action:none;overscroll-behavior:none;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
body.touch input{-webkit-user-select:auto;user-select:auto;touch-action:auto}

/* 노치·홈 인디케이터를 피합니다. viewport-fit=cover 는 이미 켜져 있어
   화면 끝까지 그리는데, 정작 HUD 가 그 밑에 깔려 있었습니다. */
body.touch #topbar{padding-top:env(safe-area-inset-top);
  padding-left:calc(10px + env(safe-area-inset-left));
  padding-right:calc(10px + env(safe-area-inset-right))}
body.touch #topbar .opt{display:none}   /* 가로 폰에 9칸은 안 들어갑니다 */
/* ★ 안내문을 위로 올립니다. 화면 아래 좌우는 양 엄지가 차지하고,
 *   가운데로 두어도 왼쪽 이동 영역과 실측 170px 겹쳤습니다(844px 기준).
 *   위쪽은 상단바 아래가 통째로 비어 있어 가릴 것이 없습니다.
 *   토스트는 그대로 아래 가운데입니다 — 안내(장소)는 위, 사건은 아래.  */
body.touch #hint{top:calc(58px + env(safe-area-inset-top));bottom:auto;
  font-size:10px;max-width:min(60vw,480px);padding:5px 10px}
body.touch #hint .rules{display:none}   /* 두 줄이면 층 안내와 겹칩니다 */
body.touch #toasts{bottom:calc(20px + env(safe-area-inset-bottom))}
body.touch #layerStack{transform:scale(.82);transform-origin:top left;top:70px}
body.touch #roster{transform:scale(.82);transform-origin:top right;top:70px}

/* ★ 스틱은 고정 위치가 아니라 엄지를 댄 자리에 생깁니다.
 *   가로 폰의 세로 폭은 390~430px 뿐이라 고정해 두면 손 크기와 쥐는
 *   방식에 따라 닿지 않는 사람이 생깁니다.                        */
#touch{position:fixed;inset:0;z-index:11;display:none;pointer-events:none;
  touch-action:none}
body.touch-run #touch{display:block}
#tMove{position:absolute;left:0;top:0;width:44%;height:100%;pointer-events:auto}
#tStick{position:absolute;width:132px;height:132px;margin:-66px 0 0 -66px;
  border-radius:50%;border:1.5px solid rgba(236,231,216,.26);
  background:rgba(5,6,10,.26);opacity:0;transition:opacity .12s;
  pointer-events:none}
#tStick.on{opacity:1}
#tKnob{position:absolute;left:50%;top:50%;width:52px;height:52px;
  margin:-26px 0 0 -26px;border-radius:50%;background:rgba(236,231,216,.8);
  box-shadow:0 0 14px rgba(0,0,0,.45)}
#tJump{position:absolute;pointer-events:auto;
  right:calc(24px + env(safe-area-inset-right));
  bottom:calc(24px + env(safe-area-inset-bottom));
  width:98px;height:98px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  border:1.5px solid rgba(236,231,216,.3);background:rgba(5,6,10,.42);
  font-family:var(--mono);font-size:12px;letter-spacing:.14em;
  color:rgba(236,231,216,.92);transition:transform .06s,background .06s}
#tJump.press{background:rgba(236,231,216,.24);transform:scale(.93)}

/* ★ 세로는 지원하지 않습니다. 3D 에서 다음 타일이 보이려면 시야가
 *   가로로 넓어야 하고, 세로로 들면 HUD 만으로 화면의 1/3 이 찹니다.
 *   막는 대신 왜 돌려야 하는지를 적습니다.                        */
#rotate{position:fixed;inset:0;z-index:60;display:none;flex-direction:column;
  align-items:center;justify-content:center;gap:14px;text-align:center;padding:24px;
  background:rgba(5,6,10,.97);font-family:var(--mono);letter-spacing:.1em}
#rotate b{font-size:15px;color:var(--paper);letter-spacing:.16em}
#rotate span{font-size:11px;color:rgba(236,231,216,.58);line-height:1.9}
#rotate .rIcon{width:78px;height:48px;border:2px solid rgba(236,231,216,.45);
  border-radius:7px;animation:rotHint 2.4s ease-in-out infinite}
@keyframes rotHint{0%,35%{transform:rotate(90deg) scale(.72)}
  65%,100%{transform:rotate(0deg) scale(1)}}
@media (orientation:portrait){body.touch #rotate{display:flex}}

@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>

<div id="stage"></div>
<div id="deadFlash"></div>

<!-- 최종 처분 도장. 내용은 showVerdict() 가 채웁니다 (탈락/승리 공용) -->
<div id="verdict" aria-hidden="true">
  <div class="cert" id="verdictCert"></div>
  <div class="seal" id="verdictSeal"></div>
</div>
<div id="accelAlert">
  <div class="vig"></div>
  <div class="bar t"></div><div class="bar b"></div>
  <div class="tag"><b>심사 가속</b><i id="accelSub">EXAMINATION ACCELERATION</i></div>
</div>
<div id="darkAlert">
  <div class="vig"></div>
  <div class="tag">
    <b>선행기술이 있는지 알 수 없다. 조사하고 판단해야 한다.</b>
    <i id="darkSub">PRIOR ART SEARCH</i>
  </div>
</div>
<div id="rotAlert"><span class="ico">⚠️</span><span>거절이유 발생, 심사관 검토 방향 변경</span></div>

<div id="hud">
  <div id="topbar">
    <div class="tb panel"><span class="k">ROOM</span><span class="v" id="vRoom">—</span></div>
    <div class="tb panel opt"><span class="k">MAP</span><span class="v" id="vMap">—</span></div>
    <div class="tb panel"><span class="k">생존</span><span class="v" id="vAlive">0/0</span></div>
    <!-- 구름바다까지 몇 층 남았는가. "떨어지면 죽는다"는 오해를 상시로
         반박하는 자리입니다 — 층이 곧 목숨이라는 걸 숫자로 보여 줍니다. -->
    <div class="tb panel"><span class="k">남은 층</span><span class="v" id="vFloors">—</span></div>
    <div class="tb opt" id="tbTitle"><span class="k" style="text-align:center">IP GUARDIANS</span><span class="v">특허 <b>패스트트랙</b> 서바이벌</span></div>
    <div class="tb panel opt"><span class="k">관전자</span><span class="v" id="vSpec">0</span></div>
    <div class="tb panel opt"><span class="k">RTT</span><span class="v" id="vPing">— ms</span></div>
    <div class="tb panel"><span class="k">FPS</span><span class="v" id="vFps">60</span></div>
    <button class="tb panel" id="btnAudio" title="소리 켜기/끄기 (M)">
      <span class="k">소리</span><span class="v" id="vAudio">ON</span>
    </button>
    <!-- ★ .opt 를 붙이지 않습니다 — 터치에서도 보여야 합니다.
         ESC 는 폰에 없고, 무엇보다 키가 있다는 것을 아무도 모릅니다.
         나가는 길은 화면에 있어야 길입니다. -->
    <button class="tb panel" id="btnMenu" title="메뉴 · 나가기 (ESC)">
      <span class="k">메뉴</span><span class="v">ESC</span>
    </button>
  </div>

  <!-- 층 안내문은 비워 둡니다. 서버 config.LAYERS 를 받은 뒤
       buildLayerStack() 이 층 수만큼 만들어 넣습니다. -->
  <div id="layerStack"></div>

  <!-- 개발 모드 UI. 평소에는 display:none 이고 body.dev 일 때만 나타납니다.
       #devLayers 의 버튼은 서버 config(LAYERS)로 만들어지므로 층이 5개가 되면
       버튼도 5개가 됩니다 (buildDevLayerButtons). -->
  <div id="devBadge"><div class="tag">DEV MODE</div><div class="flags" id="devFlags"></div></div>
  <div id="devLayers"><div class="hd">층 이동</div></div>

  <div id="roster"><div class="rname">출원인 명단</div><div id="rosterList"></div></div>

  <div id="specBanner">관전 중 · 다음 회차에 주자로 자동 참가합니다</div>
  <div id="layerBanner"><div class="lbNo"></div><div class="lbName"></div><div class="lbMarks"></div><div class="lbSafe"></div></div>
  <div id="toasts"></div>

  <!-- 대기실. 발판 위에 서 있는 동안만 보입니다(updateReadyUI). -->
  <div id="ready">
    <div id="readyState">출원인을 기다리는 중…</div>
    <div id="readyBtns">
      <button class="rbtn" id="btnReady" type="button">준비</button>
    </div>
  </div>

  <div id="spec" class="panel">
    <div id="specTargets"></div>
    <div id="specBtns">
      <!-- 기본은 비활성. 이번 회차에 뛰지 않는 관전자에게만 열립니다
           (updateActionCooldowns). 회차당 한 번만 쓸 수 있습니다. -->
      <button class="act" id="actCheer" disabled><span class="t">보정 기회 제공</span><span class="s">GRANT AMENDMENT</span><span class="cd"></span></button>
    </div>
  </div>

  <div id="diag" class="panel"><b>진단 F2</b><div id="diagBody">대기</div></div>
  <!-- 두 번째 줄(타일 규칙)은 buildRulesText 가 서버 상수로 채웁니다 -->
  <div id="hint"><span id="hintKeys">WASD 이동 · SPACE 점프 · SHIFT 질주 · 마우스 드래그로 시점 회전</span><span class="rules" id="hintRules"></span></div>
</div>

<!-- ── 터치 조작 (가로 전용) ─────────────────────────────────────────
     body.touch-run 일 때만 보입니다(주자일 때만 — 관전자는 이동이
     없습니다). #tMove 는 투명한 판이고 스틱은 엄지를 댄 자리에
     생깁니다. 이동을 별도 요소로 뺀 덕에 "왼쪽은 이동, 나머지는
     시점" 이 DOM 만으로 갈라집니다 — 좌표 비교가 필요 없습니다. -->
<div id="touch" aria-hidden="true">
  <div id="tMove"><div id="tStick"><i id="tKnob"></i></div></div>
  <button id="tJump" type="button">점프</button>
</div>

<div id="rotate">
  <div class="rIcon"></div>
  <b>가로로 돌려주세요</b>
  <span>세로 화면에서는 다음 타일이 보이지 않습니다</span>
</div>

<div id="mixer" class="panel">
  <label>배경음 <span id="mixBgmVal">45</span></label>
  <input type="range" id="mixBgm" min="0" max="100" value="45" />
  <label>효과음 <span id="mixSfxVal">85</span></label>
  <input type="range" id="mixSfx" min="0" max="100" value="85" />
</div>

<div id="countdown"><div id="cdNum">5</div><div id="cdLabel">심사 착수까지</div></div>

<!-- 낙하 속도선. 캔버스 위, 화면 오버레이(.screen z-index 20) 아래입니다. -->
<div id="speedLines"></div>

<div class="screen show" id="joinScreen">
